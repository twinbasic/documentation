inherits:												light;

/* main difference between this theme and the Light theme is the semantic highlighting is effectively turned off here */
SymbolAttributeFontStyle: 								normal;
SymbolAttributeFontWeight: 								normal;
SymbolAttributeTextDecoration: 							none;
