// Source for MonacoArchitecture.svg, beside the page that uses it. The SVG
// is a build artifact: tbdocs regenerates it whenever this file is newer.
// See the CEF twin's source for why Inter's metrics have to be installed
// before layout, and WIP.md, "Diagrams", for the mechanism.

digraph wv2_monaco {
    rankdir=LR
    bgcolor="transparent"
    nodesep=0.35
    ranksep=0.7
    splines=true

    node [
        shape=box
        style="rounded,filled"
        fontname="Inter,system-ui,-apple-system,Segoe UI,sans-serif"
        fontsize=12
        margin="0.16,0.09"
        fillcolor="#fef7e0"
        color="#f9ab00"
    ]
    edge [
        color="#7a8090"
        fontname="Inter,system-ui,-apple-system,Segoe UI,sans-serif"
        fontsize=11
        arrowsize=0.7
    ]
    graph [
        color="#7a8090"
        fontname="Inter,system-ui,-apple-system,Segoe UI,sans-serif"
        fontsize=13
        style="rounded"
        labeljust="l"
        margin=0
    ]

    subgraph cluster_form {
        margin=14
        label="twinBASIC form"

        WEBVIEW [label=<<B>WebView</B><BR/><I>Monaco editor</I>>]
        HANDLER [label=<JsMessage handler<BR/><I>(twinBASIC code)</I>>]
        PREVIEW [label=<<B>WebViewPreview</B><BR/><I>HTML preview</I>>]

        WEBVIEW -> HANDLER [label="postMessage(html)"]
        HANDLER -> PREVIEW [label="NavigateToString(html)"]
    }
}
