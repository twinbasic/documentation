// Source for Tools-Groups.svg, the map of the Tools and Scripts pages: one
// cluster per group page, one node per tool. The SVG is a build artifact:
// tbdocs regenerates it whenever this file is newer.
//
// There are no real edges. The invisible ones only lay the nodes out: a chain
// inside a cluster stacks a column, a rank=same block holds a row of the
// cluster together, and an edge from the bottom of one row of clusters to the
// top of the next puts that row below it. A tool added to a page goes into its
// cluster's chains and rows; keep the columns of a cluster within one node of
// the same length.
//
// The clusters side by side in one row must have the same number of node rows.
// dot spaces its ranks for the whole graph, so where a shorter cluster ends,
// the gap its border needs opens inside its taller neighbour too. The
// invisible nodes (cp1, cp2, dp) pad the shorter ones.
//
// Every node and cluster label is a link, set in the block at the end so the
// layout above stays readable: a node to its tool's entry, by the id its
// heading carries on the built page, and a cluster to its group page. The
// URLs are relative to the Tools page, which inlines this diagram. A tool
// added to a page gets a line there too; the build's link check reports one
// whose entry has gone. The build moves each cluster's label just before its
// first node (builder/inline-diagram.mjs), so a cluster's nodes are declared
// together, row by row.
//
// Graphviz has no font machinery and would otherwise measure these labels
// with Times; builder/dot-metrics.mjs installs Inter's real widths before
// layout, and scripts/check_dot_fit.mjs asserts afterwards that no label
// outgrew its box. See WIP.md, "Diagrams".

digraph tools_groups {
    rankdir=TB
    bgcolor="transparent"
    nodesep=0.22
    ranksep=0.12
    newrank=true
    // The nodes in the SVG in the order declared here, which is reading order:
    // the order a reader and the Tab key take the links in.
    outputorder=nodesfirst

    node [
        shape=box
        style="rounded,filled"
        fontname="Inter,system-ui,-apple-system,Segoe UI,sans-serif"
        fontsize=11
        margin="0.10,0.04"
        height=0.3
        fillcolor="#fef7e0"
        color="#f9ab00"
    ]
    // Heavy, so that a column stays packed rather than stretching towards the
    // light edges that place the next row of clusters.
    edge [style=invis weight=20]
    graph [
        color="#7a8090"
        fontname="Inter,system-ui,-apple-system,Segoe UI,sans-serif"
        fontsize=13
        style="rounded"
        labeljust="l"
        margin=0
    ]

    // ---- row 1 ----
    subgraph cluster_wrappers {
        margin=12
        label="Batch wrappers"
        w1 [label="build.bat"]      w2 [label="serve.bat"]          w3 [label="check.bat"]
        w4 [label="test.bat"]       w5 [label="book.bat"]           w6 [label="examples.bat"]
        w7 [label="addin-test.bat"] w8 [label="ide-test.bat"]       w9 [label="try-help-addin.bat"]
        w10 [label="package-tests.bat"]
        w1 -> w4 -> w7 -> w10
        w2 -> w5 -> w8
        w3 -> w6 -> w9
        { rank=same; w4 w5 w6 }
        { rank=same; w7 w8 w9 }
    }
    subgraph cluster_build {
        margin=12
        label="Build and Generation"
        b1 [label="tbdocs"]         b2 [label="render-book"]
        b3 [label="compare_trees"]  b4 [label="survey_tooling"]
        b5 [label="convert_em_dash_separators"] b6 [label="build_fonts.py"]
        b7 [label="build_dot_metrics"] b8 [label="twin-index"]
        b1 -> b3 -> b5 -> b7
        b2 -> b4 -> b6 -> b8
        { rank=same; b3 b4 }
        { rank=same; b5 b6 }
        { rank=same; b7 b8 }
    }

    // ---- row 2 ----
    subgraph cluster_site {
        margin=12
        label="Site Checks"
        s1 [label="check_links"]        s2 [label="crawl_check"]
        s3 [label="check_links_diff"]   s4 [label="check_tree_fresh"]
        s5 [label="check_dot_fit"]      s6 [label="check_a11y"]
        s7 [label="pick_a11y_sample"]   s8 [label="axe-scan"]
        s9 [label="check_a11y_fingerprint"] s10 [label="sweep_a11y"]
        s1 -> s3 -> s5 -> s7 -> s9
        s2 -> s4 -> s6 -> s8 -> s10
        { rank=same; s3 s4 }
        { rank=same; s5 s6 }
        { rank=same; s7 s8 }
        { rank=same; s9 s10 }
    }
    subgraph cluster_compiler {
        margin=12
        label="Compiler Harness"
        c1 [label="tbbuild"]            c2 [label="tbrun"]
        c3 [label="impexp"] c4 [label="check_tb_registry"]
        c6 [label="probe_build_twice"]
        cp1 [style=invis label=""]  cp2 [style=invis label=""]
        c1 -> c3 -> cp1 -> cp2
        c2 -> c4 -> c6
        { rank=same; c3 c4 }
        { rank=same; cp1 c6 }
    }

    // ---- row 3 ----
    subgraph cluster_tests {
        margin=12
        label="Toolchain Tests"
        t1  [label="check_publish_policy"] t2  [label="check_regex_safety"]
        t3  [label="check_code_regions"]   t4  [label="check_gate_lists"]
        t5  [label="check_ci_workflows"]   t6  [label="check_lint"]
        t7  [label="search.test"]          t8  [label="render.test"]
        t9  [label="strftime.test"]        t10 [label="png.test"]
        t11 [label="compact-image.test"]   t12 [label="svgshot.test"]
        t13 [label="example-batches.test"] t14 [label="ports.test"]
        t15 [label="addin-project.test"]   t16 [label="check_page_baseline"]
        t17 [label="check_book_coverage"]  t18 [label="check_symbol_index"]
        t19 [label="check_twin_parsers"]   t20 [label="check_attribute_sweep"]
        t21 [label="check_cli"]            t22 [label="check_pdf_shims_equiv"]
        t23 [label="check_impexp_parity"]  t24 [label="check_axe_patch_equiv"]
        t25 [label="indexer.test"]          t26 [label="check_package_tests"]
        t1 -> t5 -> t9  -> t13 -> t17 -> t21 -> t25
        t2 -> t6 -> t10 -> t14 -> t18 -> t22 -> t26
        t3 -> t7 -> t11 -> t15 -> t19 -> t23
        t4 -> t8 -> t12 -> t16 -> t20 -> t24
        { rank=same; t5  t6  t7  t8  }
        { rank=same; t9  t10 t11 t12 }
        { rank=same; t13 t14 t15 t16 }
        { rank=same; t17 t18 t19 t20 }
        { rank=same; t21 t22 t23 t24 }
        { rank=same; t25 t26 }
    }

    // ---- row 4 ----
    subgraph cluster_samples {
        margin=12
        label="Code Samples and Attributes"
        e1 [label="check_examples"]     e2 [label="gen_attribute_probes"]
        e3 [label="census_attributes"]  e4 [label="sweep_attributes"]
        e5 [label="package_tests"]
        e1 -> e3 -> e5
        e2 -> e4
        { rank=same; e3 e4 }
    }
    subgraph cluster_ide {
        margin=12
        label="IDE Automation"
        i1 [label="addin_test"]     i2 [label="ide_test"]
        i3 [label="try_help_addin"] i4 [label="shoot_docs"]
        i5 [label="imagestrip"]     i6 [label="probe_ide_image_labels"]
        i7 [label="svgshot/replay"] i8 [label="probe_theme_semicolon"]
        i1 -> i3 -> i5 -> i7
        i2 -> i4 -> i6 -> i8
        { rank=same; i3 i4 }
        { rank=same; i5 i6 }
        { rank=same; i7 i8 }
    }
    subgraph cluster_defects {
        margin=12
        label="Defect Reproducers"
        d1 [label="bug_repro"]
        d2 [label="vb6run"]
        dp [style=invis label=""]
        d1 -> d2 -> dp
    }

    // ---- rows ----
    { rank=same; w1 w2 w3 b1 b2 }
    { rank=same; s1 s2 c1 c2 }
    { rank=same; t1 t2 t3 t4 }
    { rank=same; e1 e2 i1 i2 d1 }
    edge [weight=1]
    w10 -> s1    b7 -> c1
    s9 -> t1    s10 -> t2   cp2 -> t3   c6 -> t4
    t25 -> e1   t22 -> i1   t24 -> d1

    // ---- links ----
    // Each link has a tooltip describing the tool or group, which a pointer shows on hover.
    // A subgraph named again is the same subgraph, so these set the clusters'.
    subgraph cluster_wrappers {
        URL="#batch-wrappers"
        tooltip="Lists the nine Windows batch files at the repository root that build, serve, check and test the site and run the compiler and IDE tools."
    }
    subgraph cluster_build {
        URL="Tools-Build"
        tooltip="Covers the site generator, the PDF book renderer, the build comparison and the generators of committed files."
    }
    subgraph cluster_site {
        URL="Tools-Site-Checks"
        tooltip="Covers the checks on a built site: its links, its freshness against the sources, its diagrams and its accessibility."
    }
    subgraph cluster_compiler {
        URL="Tools-Compiler"
        tooltip="Covers the tools that compile, build and run twinBASIC projects by operating the IDE on a private desktop, and that pack and unpack project files."
    }
    subgraph cluster_tests {
        URL="Tools-Toolchain-Tests"
        tooltip="Covers the tests of the toolchain itself, which test.bat runs and which would still mean something with no page in the tree."
    }
    subgraph cluster_samples {
        URL="Tools-Samples"
        tooltip="Covers the tools that compile the code samples of the documentation and that survey and probe where the compiler accepts each attribute."
    }
    subgraph cluster_ide {
        URL="Tools-IDE"
        tooltip="Covers the tools that operate the twinBASIC IDE to test add-ins and the IDE itself, to try the help add-in by hand and to take IDE screenshots."
    }
    subgraph cluster_defects {
        URL="Tools-Defects"
        tooltip="Covers the tools that build and verify reproducer projects for twinBASIC defects and that run VB6 code to compare it with twinBASIC."
    }

    w1 [URL="#buildbat"
        tooltip="Builds the online, offline and PDF source trees, and writes the help archive. Extra arguments pass through to tbdocs."]
    w2 [URL="#servebat"
        tooltip="Starts a live preview on port 4000 that rebuilds on each change under docs/ and reloads a connected browser."]
    w3 [URL="#checkbat"
        tooltip="Runs the gates that read the built site: freshness, accessibility, diagram fit and sample coverage. Run build.bat first."]
    w4 [URL="#testbat"
        tooltip="Runs the tests of the toolchain one after another and stops at the first that fails."]
    w5 [URL="#bookbat"
        tooltip="Renders the PDF book from the built _site-pdf/book.html, after checking that the tree is not older than the sources."]
    w6 [URL="#examplesbat"
        tooltip="Compiles the twinBASIC code samples marked check_build and reports the ones the compiler refuses. Samples marked check_run are also run."]
    w7 [URL="#addin-testbat"
        tooltip="Tests IDE add-ins by machine: builds each add-in, loads it into an IDE, operates the IDE and checks what the add-in did."]
    w8 [URL="#ide-testbat"
        tooltip="Tests the twinBASIC IDE itself by machine: opens a project, operates the IDE and checks what the IDE did."]
    w9 [URL="#try-help-addinbat"
        tooltip="Opens an IDE with the help add-in built and loaded, to try by hand, and restores the registry when the IDE is closed. It is not a gate."]
    w10 [URL="#package-testsbat"
        tooltip="Runs the test projects of the contributed packages and reports each case that no longer does what its expect.json records. It is not a gate."]

    b1 [URL="Tools-Build#tbdocs"
        tooltip="The static site generator. Builds the online, offline and PDF trees from docs/ and runs the link and integrity checks."]
    b2 [URL="Tools-Build#bookrender-bookmjs"
        tooltip="Renders the PDF book from the pre-built _site-pdf/book.html with puppeteer, paged.js and pdf-lib."]
    b3 [URL="Tools-Build#compare-trees"
        tooltip="Builds the site from a commit and from the working tree, and compares the online, offline and PDF trees byte for byte."]
    b4 [URL="Tools-Build#survey-tooling"
        tooltip="Surveys the tooling for duplicated code, repeated functions, argument reading, undeclared packages and the import graph. It is not a gate."]
    b5 [URL="Tools-Build#convert-em-dash-separators"
        tooltip="Converts literal en-dash and em-dash characters in markdown source under docs/ to the ASCII forms that the build turns into typographic dashes."]
    b6 [URL="Tools-Build#build-fonts"
        tooltip="Regenerates the subset webfonts under docs/assets/fonts/ from pinned upstream releases, verified by SHA-256. Needs Python and a network."]
    b7 [URL="Tools-Build#build-dot-metrics"
        tooltip="Measures the advance widths of Inter in a browser and writes builder/inter-metrics.json, which the build installs into Graphviz before it lays out a diagram."]
    b8 [URL="Tools-Build#twin-index"
        tooltip="Indexes the twinBASIC packages into api.json snapshots, lists the symbols that the reference has still to document, change or remove, and writes builder/package-api.json for the symbol index."]

    s1  [URL="Tools-Site-Checks#check-links"
         tooltip="Checks the links of a built tree on the filesystem, plus optional integrity checks. Several passes run in parallel."]
    s2  [URL="Tools-Site-Checks#crawl-check"
         tooltip="Crawls the deployed site from a start URL and verifies that every link the build follows responds with a 2xx status."]
    s3  [URL="Tools-Site-Checks#check-links-diff"
         tooltip="Runs the standalone link checker and the link check of the build over the same bytes and compares their findings."]
    s4  [URL="Tools-Site-Checks#check-tree-fresh"
         tooltip="Refuses a built tree that is older than the sources that produced it, so a check never audits a previous build."]
    s5  [URL="Tools-Site-Checks#check-dot-fit"
         tooltip="Renders every committed diagram with the real webfont and fails if a label sits outside the box Graphviz drew for it."]
    s6  [URL="Tools-Site-Checks#check-a11y"
         tooltip="Scans a sample of pages with axe-core in headless Chromium, in both themes at two viewports, and reports accessibility violations."]
    s7  [URL="Tools-Site-Checks#pick-a11y-sample"
         tooltip="Derives the page list of the accessibility scan and checks that it still covers every markup construct the site uses."]
    s8  [URL="Tools-Site-Checks#axe-scan"
         tooltip="A shared module, not a command. Defines the accessibility scan: its pages, themes, viewports, axe options and source patches."]
    s9  [URL="Tools-Site-Checks#check-a11y-fingerprint"
         tooltip="Gates any change to what the accessibility scan runs, by comparing the findings of two schemes over the full page, theme and viewport matrix."]
    s10 [URL="Tools-Site-Checks#sweep-a11y"
         tooltip="Runs the accessibility scan over every page in both themes and both viewports. It takes about twenty minutes, so no commit gate runs it."]

    c1 [URL="Tools-Compiler#tbbuild"
        tooltip="Compiles a .twinproj in the IDE on a private desktop and prints its diagnostics. Windows only."]
    c2 [URL="Tools-Compiler#tbrun"
        tooltip="Builds a probe project and captures what it writes to the Debug Console of the IDE, to show what code prints rather than whether it compiles."]
    c3 [URL="Tools-Compiler#impexp"
        tooltip="Unpacks a .twinproj or .twinpack into source files and packs them back, with the same commands as the compiler's own command line. A Node edition, a Python edition and a twinBASIC edition behave the same."]
    c4 [URL="Tools-Compiler#check-tb-registry"
        tooltip="Tests the code that restores the registry entries of the IDE after a harness run, on a scratch copy of the keys."]
    c6 [URL="Tools-Compiler#probe-build-twice"
        tooltip="Builds one project twice in fresh IDEs and compares the two exes, to show what differs between builds of an unchanged project."]

    t1  [URL="Tools-Toolchain-Tests#check-publish-policy"
         tooltip="Verifies that the publish allowlist still refuses the file types it should. Needs neither a browser nor a built tree."]
    t2  [URL="Tools-Toolchain-Tests#check-regex-safety"
         tooltip="Refuses any regex in the tooling that can backtrack exponentially, by parsing every .mjs file and classifying each pattern."]
    t3  [URL="Tools-Toolchain-Tests#check-code-regions"
         tooltip="Verifies that no pre-render rewrite alters the contents of a code fence, an indented code block or an inline code span."]
    t4  [URL="Tools-Toolchain-Tests#check-gate-lists"
         tooltip="Verifies that the gate lists in the documentation match the wrappers that run them, and that no page states a gate count in prose."]
    t5  [URL="Tools-Toolchain-Tests#check-ci-workflows"
         tooltip="Verifies that both CI workflows run every gate that test.bat and check.bat run, with the same arguments and in the same order."]
    t6  [URL="Tools-Toolchain-Tests#check-lint"
         tooltip="Runs Biome over the tooling and fails on any lint finding, warning or formatting difference."]
    t7  [URL="Tools-Toolchain-Tests#search-test"
         tooltip="Runs unit tests for the site search: what each search entry holds, built from small synthetic pages."]
    t8  [URL="Tools-Toolchain-Tests#render-test"
         tooltip="Runs unit tests for the markdown-it plugins in builder/render.mjs, with input that no page holds."]
    t9  [URL="Tools-Toolchain-Tests#strftime-test"
         tooltip="Runs unit tests for the formatter of the Page last modified date, which no build calls."]
    t10 [URL="Tools-Toolchain-Tests#png-test"
         tooltip="Runs unit tests for the PNG reading, writing and comparing that the pictures of a bug reproducer use."]
    t11 [URL="Tools-Toolchain-Tests#compact-image-test"
         tooltip="Runs unit tests for what an embedded image keeps: its pixels and any ownership notice, without the metadata of an editor."]
    t12 [URL="Tools-Toolchain-Tests#svgshot-test"
         tooltip="Runs unit tests for the converter that draws a screenshot of the IDE as SVG."]
    t13 [URL="Tools-Toolchain-Tests#example-batches-test"
         tooltip="Runs the probes of check_examples.mjs under the test runner of Node, with no IDE. They cover how samples are packed and judged."]
    t14 [URL="Tools-Toolchain-Tests#ports-test"
         tooltip="Runs unit tests for the claiming of DevTools ports, so that runs started together never take the same port."]
    t15 [URL="Tools-Toolchain-Tests#addin-project-test"
         tooltip="Runs unit tests for the packing of the add-in folder of the help add-in into the project file that the build publishes."]
    t16 [URL="Tools-Toolchain-Tests#check-page-baseline"
         tooltip="Verifies that the page-count drift guard still refuses what it exists to refuse, with probes on a scratch baseline file."]
    t17 [URL="Tools-Toolchain-Tests#check-book-coverage"
         tooltip="Verifies that the build still warns about a page that docs/_book.yml does not mention."]
    t18 [URL="Tools-Toolchain-Tests#check-symbol-index"
         tooltip="Verifies that the symbol index still places each kind of symbol and that its drift guard still refuses a URL the index has stopped publishing."]
    t19 [URL="Tools-Toolchain-Tests#check-twin-parsers"
         tooltip="Verifies that the scanners of twinBASIC source and of the attribute reference still read the shapes each once misread."]
    t20 [URL="Tools-Toolchain-Tests#check-attribute-sweep"
         tooltip="Verifies the logic of sweep_attributes.mjs, the tool that asks the compiler where each attribute is legal."]
    t21 [URL="Tools-Toolchain-Tests#check-cli"
         tooltip="Verifies lib/cli.mjs, through which the tools read their command lines, and the recorded command-line errors of each tool."]
    t22 [URL="Tools-Toolchain-Tests#check-pdf-shims-equiv"
         tooltip="Verifies that the pdf-lib patches of the book write the same PDF objects as stock pdf-lib does."]
    t23 [URL="Tools-Toolchain-Tests#check-impexp-parity"
         tooltip="Verifies that the Node, Python and (when named) twinBASIC editions of impexp behave the same: same tests, exit codes, output and files."]
    t24 [URL="Tools-Toolchain-Tests#check-axe-patch-equiv"
         tooltip="Checks that the patched axe source computes the same colour values as the stock source, for the color-contrast rule."]
    t25 [URL="Tools-Toolchain-Tests#indexer-test"
         tooltip="Runs unit tests for the package indexer: VB6 preprocessing, package files, the api.json model and the differ."]
    t26 [URL="Tools-Toolchain-Tests#check-package-tests"
         tooltip="Verifies that every NOTE and WARNING of a contributed package's section names the test cases behind it, and that each package test project is in order."]

    e1 [URL="Tools-Samples#check-examples"
        tooltip="Compiles the code samples marked check_build and reports each diagnostic against the page line it came from. Samples marked check_run are also run."]
    e2 [URL="Tools-Samples#gen-attribute-probes"
        tooltip="Generates twinBASIC probe projects from the Applicable to lines in Reference/Attributes.md, for tbbuild to compile."]
    e3 [URL="Tools-Samples#census-attributes"
        tooltip="Reports which enclosing construct and which kind of declaration each attribute decorates in the .twin sources of the shipped packages."]
    e4 [URL="Tools-Samples#sweep-attributes"
        tooltip="Writes each attribute at each declaration site, asks the compiler where it is legal, and compares the answers with the Applicable to lines."]
    e5 [URL="Tools-Samples#package-tests"
        tooltip="Runs the test projects of the contributed packages with tbrun and judges each case against the package's expect.json: documented, fixed or changed."]

    i1 [URL="Tools-IDE#addin-test"
        tooltip="Runs the add-in scenarios under test/addin/, each lane in its own process with a private copy of the twinBASIC install."]
    i2 [URL="Tools-IDE#ide-test"
        tooltip="Runs the scenarios under test/ide/ that operate the IDE itself, with the same runner as addin_test.mjs."]
    i3 [URL="Tools-IDE#try-help-addin"
        tooltip="Opens an IDE with the help add-in built and loaded, to try it by hand, and waits until the IDE is closed."]
    i4 [URL="Tools-IDE#shoot-docs"
        tooltip="Takes the screenshots of the IDE for the documentation, so that one run regenerates them after a new BETA."]
    i5 [URL="Tools-IDE#imagestrip"
        tooltip="A twinBASIC console program that copies a CSS or SVG file, keeping the pixels and ownership notices of embedded images and dropping editor metadata."]
    i6 [URL="Tools-IDE#probe-ide-image-labels"
        tooltip="Lists the images in the style sheets of the IDE that are labelled with a media type their bytes do not have."]
    i7 [URL="Tools-IDE#replay"
        tooltip="Draws the SVG of each picture again from its saved bundle, with the converter as it is now. Starts no IDE and takes no picture."]
    i8 [URL="Tools-IDE#probe-theme-semicolon"
        tooltip="Lists the properties that the IDE silently drops when it loads the theme files it ships, because a property lacks its semicolon."]

    d1 [URL="Tools-Defects#bug-repro"
        tooltip="Builds, runs and verifies the reproducer projects for the entries of BUGS-TO-REPORT.md, one folder for each entry."]
    d2 [URL="Tools-Defects#vb6run"
        tooltip="Builds and runs VB6 code, to compare what a documented sample prints in twinBASIC with what it prints in VB6."]
}
