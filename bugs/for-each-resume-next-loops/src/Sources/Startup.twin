' A For Each whose enumerator cannot be had, under On Error Resume Next, never ends: the
' error resumes into the loop body, and its Next raises error 91 and goes back to the body,
' again and again. Each case counts how often the expression after In is evaluated
' (header=) and lists the error each pass of the body finds (body=), and leaves the loop
' after six passes, so that a case that would never end ends. VB6 evaluates the expression
' once and continues after Next (the VB6 side is in vb6/).

Private Class NoEnum
    Public Value As Long
End Class

Private Class EnumNothing
    [Enumerator]
    Public Function NewEnum() As IUnknown
        Set NewEnum = Nothing
    End Function
End Class

Private Class EnumRaises
    [Enumerator]
    Public Function NewEnum() As IUnknown
        Err.Raise 5
    End Function
End Class

Module Startup

    Private Calls As Long

    Private Function Source(ByVal Kind As Long) As Object
        Calls = Calls + 1
        Select Case Kind
            Case 0
                Dim ok As New Collection
                ok.Add "item"
                Set Source = ok
            Case 1
                Set Source = Nothing
            Case 2
                Set Source = New NoEnum
            Case 3
                Set Source = New EnumNothing
            Case 4
                Set Source = New EnumRaises
        End Select
    End Function

    Private Sub ResumeNext(ByVal Label As String, ByVal Kind As Long)
        Dim v As Variant, body As Long, trace As String
        Calls = 0
        On Error Resume Next
        For Each v In Source(Kind)
            body = body + 1
            trace = trace & " " & Err.Number
            Err.Clear
            If body = 6 Then Exit For
        Next
        trace = trace & " | after Next: " & Err.Number
        On Error GoTo 0
        Debug.Print Label & ": header=" & Calls & " body=" & body & " errors:" & trace
    End Sub

    Private Sub HandlerResumeNext(ByVal Label As String, ByVal Kind As Long)
        Dim v As Variant, body As Long, hits As Long, trace As String
        Calls = 0
        On Error GoTo Handler
        For Each v In Source(Kind)
            body = body + 1
            trace = trace & " body"
            If body = 6 Then Exit For
        Next
    Done:
        On Error GoTo 0
        Debug.Print Label & ": header=" & Calls & " body=" & body & " passes:" & trace
        Exit Sub
    Handler:
        hits = hits + 1
        trace = trace & " error " & Err.Number
        If hits = 6 Then Resume Done
        Resume Next
    End Sub

    Public Sub Main()
        ResumeNext "Collection (control)", 0
        ResumeNext "Nothing", 1
        ResumeNext "Class with no enumerator", 2
        ResumeNext "Enumerator returns Nothing", 3
        ResumeNext "Enumerator raises error 5", 4
        HandlerResumeNext "Nothing, handler with Resume Next", 1
        HandlerResumeNext "Class with no enumerator, handler with Resume Next", 2
        HandlerResumeNext "Enumerator returns Nothing, handler with Resume Next", 3
        HandlerResumeNext "Enumerator raises error 5, handler with Resume Next", 4
    End Sub

End Module
