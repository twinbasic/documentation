' Each case makes one file statement or function fail and prints the error it raises.
Module Startup

    Private Declare PtrSafe Function GetLogicalDrives Lib "kernel32" () As Long

    ' A drive letter that no drive has, from Z down.
    Private Function NoDrive() As String
        Dim m As Long, i As Long
        m = GetLogicalDrives()
        For i = 25 To 3 Step -1
            If (m And (2 ^ i)) = 0 Then NoDrive = Chr$(65 + i): Exit Function
        Next
    End Function

    Private Sub Show(ByVal Label As String)
        Debug.Print Label & ": " & Err.Number & " " & Err.Description
    End Sub

    Private Sub MakeFile(ByVal FilePath As String)
        Dim f As Integer
        f = FreeFile
        Open FilePath For Output As #f
        Print #f, "x"
        Close #f
    End Sub

    Public Sub Main()
        Dim d As String, f As Integer, n As Variant, s As String, b As Byte
        d = Environ$("TEMP") & "\FileErrorsUnspecified-" & Hex$(Timer * 100)
        MkDir d
        MakeFile d & "\exists.txt"
        MakeFile d & "\readonly.txt"
        SetAttr d & "\readonly.txt", vbReadOnly
        MkDir d & "\full"
        MakeFile d & "\full\a.txt"

        On Error Resume Next

        Err.Clear
        f = FreeFile
        Open d & "\missing.txt" For Input As #f
        Show "Open missing file For Input"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\nofolder\x.txt" For Output As #f
        Show "Open in missing folder For Output"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\nofolder\x.txt" For Append As #f
        Show "Open in missing folder For Append"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\nofolder\x.txt" For Binary As #f
        Show "Open in missing folder For Binary"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\nofolder\x.txt" For Random As #f
        Show "Open in missing folder For Random"
        Close #f

        Err.Clear
        f = FreeFile
        Open d For Input As #f
        Show "Open a folder For Input"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\readonly.txt" For Output As #f
        Show "Open read-only file For Output"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\a|b.txt" For Output As #f
        Show "Open invalid name For Output"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\exists.txt" For Input As #f
        Open d & "\readonly.txt" For Input As #f
        Show "Open with a file number in use"
        Close #f

        Err.Clear
        n = GetAttr(d & "\missing.txt")
        Show "GetAttr missing file"

        Err.Clear
        n = GetAttr(d & "\nofolder\x.txt")
        Show "GetAttr in missing folder"

        Err.Clear
        n = FileLen(d & "\missing.txt")
        Show "FileLen missing file"

        Err.Clear
        n = FileDateTime(d & "\missing.txt")
        Show "FileDateTime missing file"

        Err.Clear
        SetAttr d & "\missing.txt", vbNormal
        Show "SetAttr missing file"

        Err.Clear
        f = FreeFile
        Open d & "\exists.txt" For Input As #f
        SetAttr d & "\exists.txt", vbNormal
        Show "SetAttr open file"
        Close #f

        Err.Clear
        Kill d & "\missing.txt"
        Show "Kill missing file"

        Err.Clear
        Kill d & "\*.zzz"
        Show "Kill pattern with no match"

        Err.Clear
        Kill d & "\readonly.txt"
        Show "Kill read-only file"

        Err.Clear
        f = FreeFile
        Open d & "\open1.txt" For Output As #f
        Kill d & "\open1.txt"
        Show "Kill open file"
        Close #f

        Err.Clear
        Name d & "\missing.txt" As d & "\new.txt"
        Show "Name missing file"

        Err.Clear
        Name d & "\exists.txt" As d & "\readonly.txt"
        Show "Name onto an existing file"

        Err.Clear
        f = FreeFile
        Open d & "\open2.txt" For Output As #f
        Name d & "\open2.txt" As d & "\renamed.txt"
        Show "Name open file"
        Close #f

        Err.Clear
        MkDir d & "\full"
        Show "MkDir existing folder"

        Err.Clear
        MkDir d & "\nofolder\sub"
        Show "MkDir in missing folder"

        Err.Clear
        RmDir d & "\nofolder"
        Show "RmDir missing folder"

        Err.Clear
        RmDir d & "\full"
        Show "RmDir folder not empty"

        Err.Clear
        ChDir d & "\nofolder"
        Show "ChDir missing folder"

        Err.Clear
        FileCopy d & "\missing.txt", d & "\copy.txt"
        Show "FileCopy missing source"

        Err.Clear
        FileCopy d & "\exists.txt", d & "\nofolder\copy.txt"
        Show "FileCopy into missing folder"

        Err.Clear
        n = EOF(99)
        Show "EOF of file number 99, not open"

        Err.Clear
        n = LOF(99)
        Show "LOF of file number 99, not open"

        Err.Clear
        n = Loc(99)
        Show "Loc of file number 99, not open"

        Err.Clear
        n = Seek(99)
        Show "Seek of file number 99, not open"

        Err.Clear
        n = FileAttr(99, 1)
        Show "FileAttr of file number 99, not open"

        Err.Clear
        Get #99, 1, b
        Show "Get from file number 99, not open"

        Err.Clear
        Put #99, 1, b
        Show "Put to file number 99, not open"

        Err.Clear
        Print #99, "x"
        Show "Print to file number 99, not open"

        Err.Clear
        Line Input #99, s
        Show "Line Input from file number 99, not open"

        Err.Clear
        Close #99
        Show "Close file number 99, not open"

        Err.Clear
        f = FreeFile
        Open d & "\exists.txt" For Input As #f
        Line Input #f, s
        Line Input #f, s
        Show "Line Input past the end of the file"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\exists.txt" For Binary As #f
        Seek #f, 0
        Show "Seek to position 0"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\record.dat" For Random As #f Len = 4
        Put #f, 1, "longer than four bytes"
        Show "Put a record longer than Len"
        Close #f

        ' ---- added by batch 7 of the run-time errors work (WIP.Errors.md)
        Dim i As Long, here As String

        Err.Clear
        ChDir d & "\exists.txt"
        Show "ChDir to a file"

        Err.Clear
        ChDir ""
        Show "ChDir to a zero-length string"

        Err.Clear
        ChDir d & "\*"
        Show "ChDir to a wildcard"

        Err.Clear
        ChDrive NoDrive()
        Show "ChDrive to a drive that does not exist"

        Err.Clear
        ChDrive "1"
        Show "ChDrive to a character that is not a letter"

        Err.Clear
        s = CurDir(NoDrive())
        Show "CurDir of a drive that does not exist"

        Err.Clear
        s = CurDir("1")
        Show "CurDir of a character that is not a letter"

        Err.Clear
        s = Dir(d & "\missing.txt")
        Err.Clear
        s = Dir()
        Show "Dir without a pathname after it returned a zero-length string"

        Err.Clear
        s = Dir(d & "\exists.txt\")
        Show "Dir of a file name with a backslash at its end"

        Err.Clear
        s = Dir(d & "\" & String(256, "a"))
        Show "Dir of a name longer than 255 characters"

        Err.Clear
        f = FreeFile
        Open d & "\exists.txt" For Input As #f
        n = FileAttr(f, 2)
        Show "FileAttr with a returntype of 2"
        Close #f

        Err.Clear
        FileCopy "", d & "\copy.txt"
        Show "FileCopy from a zero-length string"

        Err.Clear
        FileCopy d & "\*.txt", d & "\copy.txt"
        Show "FileCopy from a wildcard"

        Err.Clear
        n = FileLen(d & "\nofolder\x.txt")
        Show "FileLen in missing folder"

        Err.Clear
        n = FileLen(d & "\z*")
        Show "FileLen of a wildcard that matches nothing"

        Err.Clear
        For i = 1 To 255
            Open d & "\n" & i & ".txt" For Output As #i
        Next
        Err.Clear
        f = FreeFile
        Show "FreeFile with every file number from 1 to 255 in use"
        For i = 1 To 255
            Close #i
        Next

        Err.Clear
        n = GetAttr(d & "\*.txt")
        Show "GetAttr of a wildcard"

        Err.Clear
        n = GetAttr(d & "\a<b")
        Show "GetAttr of a name with a character a name cannot hold"

        Err.Clear
        f = FreeFile
        Open d & "\exists.txt" For Input As #f
        s = Input(4, #f)
        Show "Input past the end of the file"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\output.txt" For Output As #f
        s = Input(1, #f)
        Show "Input from a file open For Output"
        Close #f

        Err.Clear
        f = FreeFile
        Open d & "\exists.txt" For Input As #f
        s = Input(-1, #f)
        Show "Input of a negative number of characters"
        Close #f

        Err.Clear
        s = Input(1, #99)
        Show "Input from file number 99, not open"

        Err.Clear
        f = FreeFile
        Open d & "\exists.txt" For Input As #f
        s = InputB(4, #f)
        Show "InputB past the end of the file"
        Close #f

        Err.Clear
        Kill d & "\full"
        Show "Kill of a folder"

        Err.Clear
        Kill d & "\read*"
        Show "Kill of a pattern that matches a read-only file"

        Err.Clear
        MkDir ""
        Show "MkDir of a zero-length string"

        Err.Clear
        RmDir d & "\exists.txt"
        Show "RmDir of a file"

        Err.Clear
        here = CurDir$
        MkDir d & "\cwd"
        ChDrive d
        ChDir d & "\cwd"
        Err.Clear
        RmDir d & "\cwd"
        Show "RmDir of the current directory"
        ChDrive here
        ChDir here
        RmDir d & "\cwd"

        Err.Clear
        SetAttr d & "\*.txt", vbNormal
        Show "SetAttr of a wildcard"

        Err.Clear
        Width #99, 5
        Show "Width of file number 99, not open"

        Err.Clear
        SetAttr d & "\readonly.txt", vbNormal
        Kill d & "\*.*"
        Kill d & "\full\*.*"
        RmDir d & "\full"
        RmDir d
    End Sub

End Module
