' A UDT with methods and properties declared in the Type (a twinBASIC extension), and
' the arrays and holders that RegressionTests calls them through.
Module Startup

    Public Type Pair
        X As Long
        Y As Long

        Property Get Sum() As Long
            Return Me.X + Me.Y
        End Property

        Sub Bump()
            Me.X += 1
        End Sub

        Function Const1() As Long
            Return 1
        End Function

        Function Diff(ByVal other As Pair) As Pair
            Diff.X = Me.X - other.X
            Diff.Y = Me.Y - other.Y
        End Function
    End Type

    ' One byte, as GdiPlus's PathPointType is.
    Public Type Flags
        Value As Byte

        Property Get IsClosed() As Boolean
            Return (Me.Value And &H80) <> 0
        End Property
    End Type

    Public Type Holder
        One As Pair
        Many(1 To 3) As Pair
    End Type

    ' A conversion is a member procedure the compiler calls for you.
    Public Type Converts
        X As Long

        Private Function Type_Conversion() As String
            Return "C" & CStr(Me.X)
        End Function
    End Type

    Public Type ConvertsHolder
        One As Converts
        Many(1 To 3) As Converts
    End Type

    ' Type_Assignment on an element works: the element's address reaches it.
    Public Type Assigns
        X As Long

        Private Sub Type_Assignment(ByVal RHS As Long)
            Me.X = RHS
        End Sub
    End Type

    Public ModuleConverts(1 To 3) As Converts

    Public ModuleLevel(1 To 3) As Pair

    Public Sub Main()
        Dim a(1 To 3) As Pair
        a(1).X = 5
        Debug.Print "a(1).X = " & a(1).X
        Debug.Print "a(1).Sum = " & a(1).Sum
    End Sub

End Module
