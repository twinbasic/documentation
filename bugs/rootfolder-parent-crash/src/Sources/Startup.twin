' An add-in. Once a project is open, it prints a line, reads the Parent of
' the virtual file system's root folder (twinbasic:/) into an Object, and
' prints a second line. The compiler crashes in the read, so the second line
' is never printed; the IDE restarts the compiler, which loads the add-in
' again and crashes again.
Module Startup
    [DllExport]
    Public Function tbCreateCompilerAddin(ByVal Host As Host) As AddIn
        Return New ReproAddin(Host)
    End Function
End Module

Private Class ReproAddin
    Implements AddIn
    Private WithEvents Host As Host

    Public Sub New(ByVal Host As Host)
        Set Me.Host = Host
    End Sub

    Private Property Get AddIn_Name() As String
        Return "RootFolder Parent repro"
    End Property

    Private Sub Host_OnProjectLoaded()
        Host.DebugConsole.PrintText "before Parent"
        Dim o As Object = Host.FileSystem.RootFolder.Parent
        Host.DebugConsole.PrintText "after Parent"
    End Sub
End Class
