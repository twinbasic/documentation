' ByVal 0& for the ByRef 8th parameter of a Declare. Count returns 5 (the length of the UTF-8
' text). With LLVM on in a 64-bit build the call faults inside WideCharToMultiByte (0xC0000005, no
' message box), in the exe and in the IDE run. 32-bit with LLVM, and 64-bit without it, return 5.
' The fault depends on what the stack held before the call: the same call in a procedure with fewer
' locals can pass on a clean stack. The 1st to 7th parameters, and a ByRef LongPtr 8th, are right.
Module Startup

    Private Declare PtrSafe Function WideCharToMultiByte Lib "kernel32" (ByVal CodePage As Long, ByVal dwFlags As Long, ByVal lpWideCharStr As LongPtr, ByVal cchWideChar As Long, ByVal lpMultiByteStr As LongPtr, ByVal cbMultiByte As Long, ByVal lpDefaultChar As LongPtr, ByRef lpUsedDefaultChar As Long) As Long
    Private Declare PtrSafe Sub ExitProcess Lib "kernel32" (ByVal uExitCode As Long)

    Private Function Count() As Long
        Dim text As String, n As Long, a As String, b As String, c As Long, d As Double
        text = "hello"
        a = "x": b = "y": c = 1: d = 2
        n = WideCharToMultiByte(65001, 0, StrPtr(text), Len(text), 0&, 0&, 0&, ByVal 0&)
        If Len(a & b) + c + d = 5 Then Count = n
    End Function

    Public Sub Main()
        If App.IsInIDE Then
            Debug.Print "Count = " & Count()
        Else
            ExitProcess Count()
        End If
    End Sub

    [RunAfterBuild]
    Private Sub Built()
        Debug.Cls
        Main
    End Sub

End Module
