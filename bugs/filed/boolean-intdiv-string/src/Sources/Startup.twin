' Boolean \ String and Boolean Mod String convert the String to Boolean, not to a number.
Module Startup

    Public Sub Main()
        Dim b As Boolean = True
        Dim s As String = "2"

        Debug.Print "b \ ""2""   = "; b \ "2"; " "; TypeName(b \ "2")       ' expected Long 0, got Boolean True
        Debug.Print "b Mod ""2"" = "; b Mod "2"; " "; TypeName(b Mod "2")   ' expected Long -1, got Boolean False
        Debug.Print "b \ s     = "; b \ s; " "; TypeName(b \ s)
        Debug.Print "b Mod s   = "; b Mod s; " "; TypeName(b Mod s)

        ' The same operators with the number 2.0, and with the operands the other way round.
        Debug.Print "b \ 2.0   = "; b \ 2#; " "; TypeName(b \ 2#)
        Debug.Print "b Mod 2.0 = "; b Mod 2#; " "; TypeName(b Mod 2#)
        Debug.Print """2"" \ b   = "; "2" \ b; " "; TypeName("2" \ b)
        Debug.Print "b + ""2""   = "; b + "2"; " "; TypeName(b + "2")
    End Sub

End Module
