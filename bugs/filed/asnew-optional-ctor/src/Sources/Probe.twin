' As New refuses a class whose only constructor has all-Optional arguments (TB5121), though the same class passes the COM-exposure check.
Class COpt
    Public V As Long
    Public Sub New(Optional ByVal n As Long = 3)
        V = n
    End Sub
End Class

Module Probe
    Public Sub T()
        Dim x As New COpt
        Debug.Print x.V
    End Sub
End Module
