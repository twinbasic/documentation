' A Variant shift multiplies a fractional value, and a large count gives Empty.
Module Startup

    Public Sub Main()
        Dim d As Variant = CDbl(7.9)
        Dim c As Variant = CCur(7.9)
        Dim m As Variant = CDec(7.9)
        Debug.Print "Double   7.9 << 1 = "; d << 1       ' expected 14, got 15.8
        Debug.Print "Currency 7.9 << 1 = "; c << 1       ' expected 14, got 15.8
        Debug.Print "Decimal  7.9 << 1 = "; m << 1       ' expected 14, got 15.8
        Debug.Print "Double   7.9 >> 1 = "; d >> 1       ' 3
        Debug.Print "Currency 7.9 >> 1 = "; c >> 1       ' expected 3, got 3.95
        Debug.Print "Decimal  7.9 >> 1 = "; m >> 1       ' 3

        Dim i As Variant = CInt(1)
        Dim l As Variant = CLng(1)
        Debug.Print "Integer 1 << 20 is "; TypeName(i << 20)   ' expected Integer 0, got Empty
        Debug.Print "Long    1 << 32 is "; TypeName(l << 32)    ' expected Long 0, got Empty
        Debug.Print "Long    1 << 31 is "; TypeName(l << 31); " "; l << 31

        Dim n As Long = 1
        Debug.Print "Long variable 1 << 32 = "; n << 32        ' 0
    End Sub

End Module
