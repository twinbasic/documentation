Module Startup

    Public Sub Main()
        Debug.Print "one space:    [" & StrConv("a b", vbProperCase) & "]"
        Debug.Print "two spaces:   [" & StrConv("a  b", vbProperCase) & "]"
        Debug.Print "three spaces: [" & StrConv("a   b", vbProperCase) & "]"
        Debug.Print "vbCrLf:       [" & Replace(StrConv("a" & vbCrLf & "b", vbProperCase), vbCrLf, "<CRLF>") & "]"
    End Sub

End Module
