' FileCopy of an open file raises &H80004005, where VB6 raises error 55 or copies it.
Module Startup

    Public Sub Main()
        Dim f As String = Environ$("TEMP") & "\filecopy-probe.txt"
        Open f For Output As #1: Print #1, "one": Close #1

        On Error Resume Next

        Open f For Append As #2
        FileCopy f, f & ".copy"
        Debug.Print "open For Append: "; Err.Number; Err.Description     ' VB6: 55 File already open
        Err.Clear
        Close #2

        Open f For Input As #2
        FileCopy f, f & ".copy"
        Debug.Print "open For Input:  "; Err.Number; Err.Description     ' VB6: copies, no error
        Err.Clear
        Close #2

        FileCopy f, f & ".copy"
        Debug.Print "closed:          "; Err.Number; Err.Description     ' no error
        Err.Clear

        Kill f
        Kill f & ".copy"
    End Sub

End Module
