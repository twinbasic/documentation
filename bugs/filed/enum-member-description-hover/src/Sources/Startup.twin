' Hover over Shade and over Light where UseThem uses them. project.optionExplicit is true.
Module DescProbe
    [Description("A colour.")]
    Public Enum Shade
        [Description("The light one.")]
        Light = 1
        Dark = 2
    End Enum

    Public Sub UseThem()
        Debug.Print Shade.Light, Dark
    End Sub

    Public Sub Main()
        UseThem
    End Sub
End Module
