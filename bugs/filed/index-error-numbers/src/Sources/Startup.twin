' An out-of-range index raises &H8002000B or &H80004005, where VBA raises error 9.
Module Startup

    Private Sub Show(ByVal what As String)
        Debug.Print what; ": "; Err.Number; " "; Hex$(Err.Number); " "; Err.Description
        Err.Clear
    End Sub

    Public Sub Main()
        On Error Resume Next

        Dim a(5) As Long
        a(7) = 1
        Show "a(7) = 1, past a fixed array"                 ' VBA: 9

        Dim v As Variant = Array(1, 2, 3)
        v(9) = 1
        Show "v(9) = 1, past a Variant array"               ' VBA: 9

        Dim s As String = Split("x y")(5)
        Show "Split(""x y"")(5)"                            ' VBA: 9

        Dim u() As Integer
        u(8) = 234
        Show "u(8) = 234, an array never dimensioned"       ' VBA: 9

        Dim c As New Collection
        c.Add 1, "one"
        v = c(5)
        Show "c(5), a missing Collection index"             ' VBA: 9
        v = c("nokey")
        Show "c(""nokey""), a missing Collection key"

        Err.Raise 9
        Show "Err.Raise 9"                                  ' 9
    End Sub

End Module
