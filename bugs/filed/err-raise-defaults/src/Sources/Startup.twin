Module Startup

    Private Sub Show(ByVal Label As String)
        Debug.Print Label & ": [" & Err.Source & "] [" & Err.Description & "]"
    End Sub

    Public Sub Main()
        On Error Resume Next

        Err.Clear
        Err.Raise 5
        Show "Raise 5"

        Err.Clear
        Err.Raise 1
        Show "Raise 1"

        Err.Clear
        Err.Raise 513
        Show "Raise 513"

        Err.Clear
        Err.Raise 1000
        Show "Raise 1000"

        Err.Clear
        Err.Raise 1000, "A.Src", "B desc"
        Err.Raise 5
        Show "Raise 5 after a full Raise"
    End Sub

End Module
