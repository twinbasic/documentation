' For Each over the WebView2 package's WebView2HeadersCollection crashes: its Next
' writes pCeltFetched, which For Each passes as a null pointer. The package's
' iterator interface is Private, so this declares a copy with the same IID and
' hands the package's own enumerator a fake iterator holding two headers.

[InterfaceId("0702fc30-f43b-47bb-ab52-a42cb552ad9f")]
Private Interface IFakeHeadersIterator Extends stdole.IUnknown
    Sub GetCurrentHeader(ByRef name As LongPtr, ByRef value As LongPtr)
    Property Get HasCurrentHeader() As Long
    Function MoveNext() As Long
End Interface

' IEnumVARIANT, to call the package's Next directly in the control.
[InterfaceId("00020404-0000-0000-C000-000000000046")]
Private Interface IMyEnumVARIANT Extends stdole.IUnknown
    Sub Next(ByVal celt As Long, ByRef rgVar As Variant, ByRef pCeltFetched As Long)
    Sub Skip(ByVal celt As Long)
    Sub Reset()
    Function Clone() As IMyEnumVARIANT
End Interface

Private Module Mem
    Public Declare PtrSafe Function CoTaskMemAlloc Lib "ole32" (ByVal cb As LongPtr) As LongPtr
    Public Declare PtrSafe Sub CopyMemory Lib "kernel32" Alias "RtlMoveMemory" (ByVal dst As LongPtr, ByVal src As LongPtr, ByVal cb As LongPtr)

    ' A CoTaskMem copy of s, NUL-terminated, as WebView2 hands out.
    Public Function WStr(ByVal s As String) As LongPtr
        Dim cb As LongPtr = (Len(s) + 1) * 2
        Dim p As LongPtr = CoTaskMemAlloc(cb)
        CopyMemory p, StrPtr(s), cb
        Return p
    End Function
End Module

Private Class FakeIterator
    Implements IFakeHeadersIterator
    Private Index As Long

    Private Sub GetCurrentHeader(ByRef name As LongPtr, ByRef value As LongPtr) Implements IFakeHeadersIterator.GetCurrentHeader
        name = WStr("Name" & Index)
        value = WStr("Value" & Index)
    End Sub

    Private Property Get HasCurrentHeader() As Long Implements IFakeHeadersIterator.HasCurrentHeader
        Return IIf(Index < 2, 1, 0)
    End Property

    Private Function MoveNext() As Long Implements IFakeHeadersIterator.MoveNext
        Index += 1
        Return IIf(Index < 2, 1, 0)
    End Function
End Class

' What WebView2RequestHeaders does: an [Enumerator] returning the collection.
Private Class Holder
    [Enumerator]
    Public Function _NewEnum() As stdole.IUnknown
        Dim it As stdole.IUnknown
        Set it = New FakeIterator
        Return New WebView2HeadersCollection(it)
    End Function
End Class

Module Startup

    Public Sub Main()
        ' Control: the same Next, called directly with a pCeltFetched to write.
        Dim it As stdole.IUnknown
        Set it = New FakeIterator
        Dim e As IMyEnumVARIANT
        Set e = New WebView2HeadersCollection(it)
        Dim v As Variant, fetched As Long, k As Long
        For k = 1 To 3
            fetched = -1
            e.Next 1, v, fetched
            Debug.Print "direct Next " & k & ": fetched " & fetched & IIf(fetched = 1, " " & v.Name & ": " & v.Value, "")
        Next

        ' The bug: For Each over the same collection.
        Debug.Print "before For Each"
        Dim h As New Holder
        Dim x As Variant
        For Each x In h
            Debug.Print x.Name & ": " & x.Value
        Next
        Debug.Print "after For Each"
    End Sub

End Module
