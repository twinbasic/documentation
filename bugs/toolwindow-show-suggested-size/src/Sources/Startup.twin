' An add-in with one tool window, hidden, which suggests a size of 500 by 600
' pixels, and a toolbar button that shows the window and hides it again. On BETA
' 1042, each time the button shows the floating window it is 500 by 600 again,
' whatever size it was resized to, by hand or by a panel layout.
Module Startup
    [DllExport]
    Public Function tbCreateCompilerAddin(ByVal Host As Host) As AddIn
        Return New ReproAddin(Host)
    End Function
End Module

Private Class ReproAddin
    Implements AddIn
    Private WithEvents Host As Host
    Private WithEvents ToggleButton As Button
    Private Pane As ToolWindow
    Private Shown As Boolean

    Public Sub New(ByVal Host As Host)
        Set Me.Host = Host
    End Sub

    Private Property Get AddIn_Name() As String
        Return "ToolwindowShowSuggestedSize AddIn"
    End Property

    Private Sub Host_OnProjectLoaded()
        Set ToggleButton = Host.Toolbars(0).AddButton("ReproToggle", "Show or hide the tool window")
        Set Pane = Host.ToolWindows.Add("Repro", "ReproPane")
        Pane.Title = "REPRO WINDOW"
        With Pane.RootDomElement
            .Properties.suggestedWidth = "500px"
            .Properties.suggestedHeight = "600px"
            .ChildDomElements.Add("reproText", "div").Properties.innerText = "the add-in's tool window"
        End With
    End Sub

    Private Sub ToggleButton_OnClick()
        Shown = Not Shown
        Pane.Visible = Shown
    End Sub
End Class
