' An add-in with one tool window, hidden, and a toolbar button that shows it.
' When the IDE closes the window, as applying a panel layout does, OnClose prints
' "OnClose" to the DEBUG CONSOLE and the add-in adds the window again, hidden, as
' an add-in that keeps its window does. On BETA 1042, applying a layout while the
' window floats shown, or is docked, takes the window out of the page, and OnClose
' never runs: the window is gone, and the add-in does not know.
Module Startup
    [DllExport]
    Public Function tbCreateCompilerAddin(ByVal Host As Host) As AddIn
        Return New ReproAddin(Host)
    End Function
End Module

Private Class ReproAddin
    Implements AddIn
    Private WithEvents Host As Host
    Private WithEvents ShowButton As Button
    Private WithEvents Pane As ToolWindow

    Public Sub New(ByVal Host As Host)
        Set Me.Host = Host
    End Sub

    Private Property Get AddIn_Name() As String
        Return "LayoutLosesAddinToolwindow AddIn"
    End Property

    Private Sub Host_OnProjectLoaded()
        Set ShowButton = Host.Toolbars(0).AddButton("ReproShow", "Show the tool window")
        MakePane
        Host.DebugConsole.PrintText "loaded"
    End Sub

    Private Sub MakePane()
        Set Pane = Host.ToolWindows.Add("Repro", "ReproPane")
        Pane.Title = "REPRO WINDOW"
        Pane.RootDomElement.ChildDomElements.Add("reproText", "div").Properties.innerText = "the add-in's tool window"
    End Sub

    Private Sub ShowButton_OnClick()
        Pane.Visible = True
        Host.DebugConsole.PrintText "shown"
    End Sub

    Private Sub Pane_OnClose()
        Host.DebugConsole.PrintText "OnClose"
        MakePane
    End Sub
End Class
