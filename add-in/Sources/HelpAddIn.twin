' F1 shows the documentation page for the selection or for the name under the
' cursor in the help pane, a tool window with a search box, a list of results
' and the page in a frame. The toolbar's Help button shows the pane for a
' search. For the name under the cursor the compiler is asked where it is
' declared, through its hover (CompilerHover), so that c.Add finds
' Collection.Add when c is a Collection; a selection is looked up as it is.
' The pages come from the add-in's own server when it was built with the help
' archive (HelpServer), and from the live site otherwise. The pane's Hover
' help box turns on links to the pages at the cursor and under the mouse
' (HoverHelp).
' Every line it prints to the DEBUG CONSOLE starts "[tbDocsHelp] ", except
' "open <url>" (see OpenUrl).
Private Class HelpAddIn
    Implements AddIn
    Private WithEvents Host As Host
    Private WithEvents HelpButton As Button
    Private WithEvents Pane As ToolWindow
    Private Index As SymbolIndex

    Private SearchBox As HtmlElement
    Private ResultsElement As HtmlElement
    Private Results As Object               ' the list view widget
    Private Frame As HtmlElement
    Private Summary As HtmlElement          ' shown in place of the frame (ShowSummary)
    Private BrowserButton As HtmlElement
    Private ResultIds As Collection         ' the index entries in Results
    Private LastSearch As String
    Private PageUrl As String               ' the site path the frame was given
    Private HoverSink As HtmlElement        ' where the compiler's answers come
    Private AskSeq As Long                  ' the number of the last question
    Private Asked As String                 ' its word, "" once answered
    Private Server As HelpServer            ' Nothing unless the add-in has the archive
    Private WithEvents Hovering As HoverHelp ' Nothing without an index
    Private HoverBox As HtmlElement         ' the pane's Hover help checkbox

    Private Const BASE_URL As String = "https://docs.twinbasic.com"
    Private Const TAG As String = "[tbDocsHelp] "
    ' The pane's id: a tool window given none shares the id "" with every other.
    Private Const PANE_ID As String = "tbDocsHelpPane"
    ' SaveSetting's application name; test/addin/lanes.mjs names it too.
    Private Const SETTINGS_APP As String = "tbDocsHelp"
    Private Const SEARCH_LIMIT As Long = 100

    Public Sub New(ByVal Host As Host)
        Set Me.Host = Host
    End Sub

    Private Property Get AddIn_Name() As String
        Return "twinBASIC Documentation Help"
    End Property

    ' Runs again in a new instance after every compiler restart, which empties
    ' the pane; the page it showed is kept with SaveSetting.
    Private Sub Host_OnProjectLoaded()
        Set HelpButton = Host.Toolbars(0).AddButton("tbDocsHelp", "Help")
        Host.KeyboardShortcuts.Add "f1", AddressOf OnF1
        Dim indexState As String = LoadIndex()
        If Not Index Is Nothing Then Set Hovering = New HoverHelp(Host, Index, BASE_URL)
        StartServer
        PageUrl = GetSetting(SETTINGS_APP, "Pane", "Page", "")
        BuildPane
        ' The scenarios wait for this line, and check the switch in it before
        ' pressing anything.
        Host.DebugConsole.PrintText TAG & "loaded, " & indexState & ", test switch " & _
            IIf(TestSwitchOn(), "on", "off")
    End Sub

    Private Function LoadIndex() As String
        On Error GoTo Failed
        Dim data() As Byte = LoadResDataInternal("symbols.json", "SYMBOLS")
        Set Index = New SymbolIndex
        Index.Load StrConv(data, VbStrConv.vbFromUTF8)
        Return "index " & Index.Count & " entries"
    Failed:
        Set Index = Nothing
        Return "no index (" & Err.Description & ")"
    End Function

    ' Serves the pages from the archive, when the add-in was built with one
    ' (HelpServer). The line it prints names the origin, which the scenarios
    ' read.
    Private Sub StartServer()
        Set Server = New HelpServer
        Dim serving As String = Server.Start()
        If Len(serving) > 0 Then Host.DebugConsole.PrintText TAG & serving
        If Len(Server.Origin) = 0 Then Set Server = Nothing
    End Sub

    Private Sub Class_Terminate()
        If Not Server Is Nothing Then Server.CloseAll
    End Sub

    ' Where the pane's pages come from: the add-in's own server when it has the
    ' archive, otherwise the site.
    Private Function PagesUrl() As String
        If Not Server Is Nothing Then Return Server.Origin
        Return SiteUrl()
    End Function

    ' The site, which Open in browser always opens. Under the test harness
    ' TB_DOCS_HELP_SITE can name another, a copy of the site the lane serves
    ' itself.
    Private Function SiteUrl() As String
        If TestSwitchOn() Then
            Dim site As String = Environ$("TB_DOCS_HELP_SITE")
            If Len(site) > 0 Then
                If Right$(site, 1) = "/" Then site = Left$(site, Len(site) - 1)
                Return site
            End If
        End If
        Return BASE_URL
    End Function

    ' The frame's URL for a site path: the site reads ?theme= before its first
    ' paint, so the page matches the IDE's theme rather than WebView2's colour
    ' scheme, and ?pane=1, so the page shows without the site's navigation and
    ' header. The parameters go before any fragment.
    Private Function FrameUrl(ByVal url As String) As String
        Dim query As String = "?pane=1"
        Dim group As String = Host.Themes.ActiveThemeNameGroup
        If group = "light" Or group = "dark" Then query = "?theme=" & group & "&pane=1"
        Dim hash As Long = InStr(url, "#")
        If hash = 0 Then hash = Len(url) + 1
        Return PagesUrl() & Left$(url, hash - 1) & query & Mid$(url, hash)
    End Function

    ' A theme change loads the page again with the new theme. The pane itself
    ' follows the theme through the IDE's CSS variables (pane.css).
    Private Sub Host_OnChangedTheme(ByVal ThemeName As String)
        If Len(PageUrl) > 0 And Not Frame Is Nothing Then Frame.Properties.src = FrameUrl(PageUrl)
    End Sub

    ' The pane's elements. Showing a tool window sets its root's display to
    ' block, so the flex layout is on a wrapper inside it.
    Private Sub BuildPane()
        ' Kept apart from the box: a property read straight after it is set
        ' can still give the old value.
        Dim hoverOn As Boolean = GetSetting(SETTINGS_APP, "Hover", "On", "0") = "1"
        Set Pane = Host.ToolWindows.Add("tbDocsHelp", PANE_ID)
        Pane.Title = "TWINBASIC HELP"
        Pane.ApplyCss StrConv(LoadResDataInternal("pane.css", "STYLESHEETS"), VbStrConv.vbFromUTF8)
        With Pane.RootDomElement
            ' Used only the first time the pane opens floating.
            .Properties.suggestedWidth = "480px"
            .Properties.suggestedHeight = "640px"
            .Properties.style.height = "100%"
            With .ChildDomElements.Add("helpWrap", "div")
                With .ChildDomElements.Add("helpBar", "div")
                    Set SearchBox = .ChildDomElements.Add("helpSearch", "input")
                    SearchBox.Properties.type = "search"
                    SearchBox.Properties.placeholder = "Search the documentation"
                    ' input also comes from the box's clear button, which
                    ' sends no key.
                    SearchBox.AddEventListener("input", AddressOf SearchChanged)
                    SearchBox.AddEventListener("keyup", AddressOf SearchKeyUp)
                    Set BrowserButton = .ChildDomElements.Add("helpBrowser", "button")
                    BrowserButton.Properties.innerText = "Open in browser"
                    BrowserButton.AddEventListener("click", AddressOf BrowserClicked)
                    With .ChildDomElements.Add("helpHoverLabel", "label")
                        Set HoverBox = .ChildDomElements.Add("helpHover", "input")
                        HoverBox.Properties.type = "checkbox"
                        HoverBox.Properties.checked = hoverOn
                        HoverBox.Properties.disabled = Hovering Is Nothing
                        HoverBox.AddEventListener("change", AddressOf HoverToggled)
                        .ChildDomElements.Add("helpHoverText", "span").Properties.innerText = "Hover help"
                    End With
                End With
                Set ResultsElement = .ChildDomElements.Add("helpResults", "listview")
                Set Results = ResultsElement.Properties.listview
                Results.setShowScrollbarH(False)
                Results.AddEventListener("onPick", AddressOf ResultPicked)
                ResultsElement.Properties.style.display = "none"
                Set Summary = .ChildDomElements.Add("helpSummary", "div")
                Summary.Properties.style.display = "none"
                Set Frame = .ChildDomElements.Add("helpPage", "iframe")
                Set HoverSink = .ChildDomElements.Add("helpAsk", "div")
                HoverSink.Properties.style.display = "none"
                HoverSink.AddEventListener(HOVER_EVENT, AddressOf HoverAnswered)
                If Not Hovering Is Nothing Then
                    Dim cursorSink As HtmlElement = .ChildDomElements.Add("helpAskCursor", "div")
                    Dim mouseSink As HtmlElement = .ChildDomElements.Add("helpAskMouse", "div")
                    cursorSink.Properties.style.display = "none"
                    mouseSink.Properties.style.display = "none"
                    Hovering.Attach cursorSink, mouseSink
                    Hovering.Enabled = hoverOn
                End If
            End With
        End With
        Set ResultIds = New Collection
        LastSearch = ""
        If Len(PageUrl) > 0 Then Frame.Properties.src = FrameUrl(PageUrl)
    End Sub

    ' Hover help is off until the box is ticked, and stays as it was left.
    Private Sub HoverToggled(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        Dim isOn As Boolean = HoverBox.Properties.checked
        SaveSetting SETTINGS_APP, "Hover", "On", IIf(isOn, "1", "0")
        Hovering.Enabled = isOn
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    Private Sub Hovering_Pick(ByVal url As String)
        ShowPage url
    End Sub

    Private Sub Pane_OnClose()
        BuildPane
    End Sub

    Private Sub OnF1()
        ShowHelp
    End Sub

    Private Sub HelpButton_OnClick()
        ShowPaneForSearch
    End Sub

    Private Sub ShowPaneForSearch()
        Pane.Visible = True
        SearchBox.Properties.focus()
    End Sub

    Private Sub ShowHelp()
        On Error GoTo Failed
        Dim line As Long, character As Long
        Dim word As String = WordToLookUp(line, character)
        If Len(word) = 0 Then
            ShowPaneForSearch
            Exit Sub
        End If
        If Index Is Nothing Then
            Host.ShowNotification "No help: the add-in has no symbol index"
            Exit Sub
        End If
        If line < 0 Then
            LookUp word, ""
        Else
            ' The answer comes to HoverAnswered, always: an empty one when the
            ' compiler cannot be asked or does not answer in time. A question
            ' asked again before then replaces this one.
            AskSeq = AskSeq + 1
            Asked = word
            HoverSink.Properties.innerHTML = HoverQuestion(AskSeq, line, character)
        End If
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    Private Sub HoverAnswered(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        If CLng(eventInfo.seq) <> AskSeq Or Len(Asked) = 0 Then Exit Sub
        Dim word As String = Asked
        Asked = ""
        Dim status As String = eventInfo.status
        If status = "error" Then Host.DebugConsole.PrintText TAG & "hover failed: " & eventInfo.value
        LookUp word, IIf(status = "ok", CStr(eventInfo.value), "")
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Shows the page for word, or the choice of its pages (SymbolIndex.Pages).
    ' hover is the compiler's hover for it, or "". A name with no page because
    ' it is declared outside the documented packages shows its declaration and
    ' description instead (ShowSummary).
    Private Sub LookUp(ByVal word As String, ByVal hover As String)
        If AtDeclaration(hover) Then
            Host.ShowNotification "No help for '" & word & "': it is declared here"
            Exit Sub
        End If
        Dim pages As Collection = Index.Pages(word, hover)
        If pages Is Nothing Then
            ShowSummary hover
            Exit Sub
        End If

        Select Case pages.Count
            Case 0
                Host.ShowNotification "No help for '" & word & "'"
            Case 1
                ShowPage Index.Url(pages(1))
            Case Else
                SearchBox.Properties.value = word
                LastSearch = word
                ShowResults pages
                Pane.Visible = True
        End Select
    End Sub

    Private Sub ShowPage(ByVal url As String)
        PageUrl = url
        Frame.Properties.src = FrameUrl(url)
        Summary.Properties.style.display = "none"
        Frame.Properties.style.display = ""
        BrowserButton.Properties.disabled = False
        Pane.Visible = True
        SaveSetting SETTINGS_APP, "Pane", "Page", url
    End Sub

    ' Shows what the compiler's hover says about a name the documentation has
    ' no page for, in place of the page: the declaration, its [Description] or
    ' a type library's help string, and where it is declared. Open in browser
    ' has no page to open meanwhile. The saved page stays, for after a restart.
    Private Sub ShowSummary(ByVal hover As String)
        Dim declaration As String, description As String, where As String
        ReadSummary hover, declaration, description, where
        Summary.Properties.innerHTML = "<pre class='declaration'>" & HtmlText(declaration) & "</pre>" & _
            IIf(Len(description) > 0, "<p class='description'>" & HtmlText(description) & "</p>", _
                "<p class='description none'>No description.</p>") & _
            IIf(Len(where) > 0, "<p class='where'>Declared in " & HtmlText(where) & "</p>", "")
        Frame.Properties.style.display = "none"
        Summary.Properties.style.display = ""
        BrowserButton.Properties.disabled = True
        Pane.Visible = True
    End Sub

    ' Fills the list with the entries ids, or hides it when there is no search.
    ' The list draws its rows out of flow, so it is given the height of its
    ' rows, which pane.css caps.
    Private Sub ShowResults(ByVal ids As Collection)
        Set ResultIds = ids
        Results.clear()
        Dim i As Variant
        For Each i In ids
            ' Only the entry's number goes into the handler; the text is escaped.
            Results.addItem("<div class='hit' onclick='raiseEvent(""onPick"", event, true, " & _
                CLng(i) & ")'><span class='label'>" & HtmlText(Index.Label(i)) & _
                "</span><span class='kind'>" & HtmlText(Index.Kind(i)) & "</span></div>")
        Next
        Dim rows As Long = ids.Count
        If rows = 0 And Len(LastSearch) > 0 Then
            Results.addItem("<div class='none'>No matches</div>")
            rows = 1
        End If
        ResultsElement.Properties.style.height = "calc(" & rows & " * var(--helpRow))"
        ResultsElement.Properties.style.display = IIf(rows > 0, "", "none")
    End Sub

    ' Searches again when the text has changed.
    Private Sub SearchAgain()
        If Index Is Nothing Then Exit Sub
        Dim text As String = Trim$(SearchBox.Properties.value)
        If text <> LastSearch Then
            LastSearch = text
            ShowResults Index.Search(text, SEARCH_LIMIT)
        End If
    End Sub

    Private Sub SearchChanged(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        SearchAgain
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    Private Sub SearchKeyUp(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        If Index Is Nothing Then Exit Sub
        SearchAgain
        If eventInfo.key = "Enter" And ResultIds.Count > 0 Then ShowPage Index.Url(ResultIds(1))
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    Private Sub ResultPicked(ByVal eventInfo As HtmlEventProperties)
        ShowPage Index.Url(CLng(eventInfo.customData0))
    End Sub

    ' Opens the page the add-in last gave the frame, or the site's home page.
    ' A link followed inside the frame is not seen: the live site is on
    ' another origin, whose location the IDE's page cannot read.
    Private Sub BrowserClicked(ByVal eventInfo As HtmlEventProperties)
        OpenUrl Host, SiteUrl() & IIf(Len(PageUrl) > 0, PageUrl, "/")
    End Sub

    ' The selection when it is on one line, line then -1; else the name under
    ' the cursor, with line and character the place of its character there
    ' that the compiler is asked about, both counted from 0, as it counts.
    Private Function WordToLookUp(ByRef line As Long, ByRef character As Long) As String
        line = -1
        If Host.ActiveEditors.Count = 0 Then Return ""
        Dim ed As Editor
        Set ed = Host.ActiveEditors(0)
        If Not TypeOf ed Is CodeEditor Then Return ""
        Dim code As CodeEditor
        Set code = ed
        Dim startLine As Long, startColumn As Long, endLine As Long, endColumn As Long
        code.GetSelectionInfo startLine, startColumn, endLine, endColumn
        If startLine = endLine And startColumn <> endColumn Then
            Dim selected As String = Trim$(code.SelectedText)
            If Len(selected) > 0 Then Return selected
        End If
        Dim text As String = LineOf(code.Text, startLine)
        line = startLine - 1
        character = NameColumn(text, startColumn) - 1
        Return NameAt(text, startColumn)
    End Function

End Class
