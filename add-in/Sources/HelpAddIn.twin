' F1 shows the documentation page for the selection or for the name under the
' cursor in the help pane, a tool window with a search box, a list of results
' and the page in a frame. The toolbar's Help button shows the pane for a
' search. For the name under the cursor the compiler is asked where it is
' declared, through its hover (CompilerHover), so that c.Add finds
' Collection.Add when c is a Collection; a selection is looked up as it is.
' The pages come from the add-in's own server when it was built with the help
' archive (HelpServer), and from the live site otherwise. The gear at the
' right end of the pane's bar opens a panel of settings, each view with its
' own; its Hover help box turns on links to the pages in the IDE's hover under
' the mouse (HoverHelp). The pane's Detach button moves the whole pane into a
' window of the add-in's own (HelpWindow), which can go to another monitor; the window's
' Attach button brings it back. While it is detached everything that would show
' in the pane shows in the window, and the pane's frame is not loaded. The pane
' keeps the state either way: the window is another view of it. The window's
' title bar is one row drawn in its page, in the style of a tool window's
' header, with Attach, Minimize, Maximize and Close in it; its X hides the
' window, as the pane's X hides the pane, and the help stays detached until F1,
' the Help button or a hover link shows the window again (without activating
' it, except for the Help button). Whether the window was shown is kept, so a
' hidden window stays hidden after a compiler restart. When the IDE's option
' "Show real OS titlebar" is on, the window has the Windows title bar instead,
' dark or light with the theme, and the page draws none; the option is read
' each time the window is shown. Every line it prints to the DEBUG CONSOLE
' starts "[tbDocsHelp] ", except "open <url>" (see OpenUrl).
Private Class HelpAddIn
    Implements AddIn
    Private WithEvents Host As Host
    Private WithEvents HelpButton As Button
    Private WithEvents Pane As ToolWindow
    Private Index As SymbolIndex

    Private SearchBox As HtmlElement
    Private ResultsElement As HtmlElement
    Private Results As Object               ' the list view widget
    Private Frame As HtmlElement
    Private Summary As HtmlElement          ' shown in place of the frame (ShowSummary)
    Private BrowserButton As HtmlElement
    Private ResultIds As Collection         ' the index entries in Results
    Private LastSearch As String
    Private PageUrl As String               ' the site path the frame was given
    Private HoverSink As HtmlElement        ' where the compiler's answers come
    Private AskSeq As Long                  ' the number of the last question
    Private Asked As String                 ' its word, "" once answered
    Private Server As HelpServer            ' Nothing unless the add-in has the archive
    Private WithEvents Hovering As HoverHelp ' Nothing without an index
    Private HoverBox As HtmlElement         ' the pane's Hover help checkbox
    Private DetachButton As HtmlElement
    Private SettingsButton As HtmlElement   ' the gear at the bar's right end
    Private SettingsPanel As HtmlElement    ' the rows the gear opens
    Private SettingsShade As HtmlElement    ' over the pane while the panel is open
    Private SettingsOpen As Boolean         ' the pane's panel shows; each view has its own
    Private WithEvents HelpWin As HelpWindow ' Nothing until the first Detach, then kept
    Private Detached As Boolean             ' the window shows the help, the pane is hidden
    Private WindowShown As Boolean          ' Detached, and the window is not hidden
    Private NativeFrame As Boolean          ' the window has the Windows title bar
    Private FocusOnReady As Boolean         ' the search box gets the focus when the page is ready
    Private LoadedFrame As String           ' the src the pane's frame was given
    Private SearchText As String            ' what the search box holds, in either view
    Private HoverOn As Boolean              ' what the Hover help box holds, in either view
    Private SummaryHtml As String           ' what ShowSummary shows
    Private ShowingSummary As Boolean       ' the summary shows in place of the page

    Private Const BASE_URL As String = "https://docs.twinbasic.com"
    Private Const TAG As String = "[tbDocsHelp] "
    ' The pane's id: a tool window given none shares the id "" with every other.
    Private Const PANE_ID As String = "tbDocsHelpPane"
    ' SaveSetting's application name; test/addin/lanes.mjs names it too.
    Private Const SETTINGS_APP As String = "tbDocsHelp"
    Private Const SEARCH_LIMIT As Long = 100
    ' The settings button's gear, in the button's text colour; shell.html has
    ' the same drawing.
    Private Const GEAR_SVG As String = "<svg viewBox='0 0 16 16' aria-hidden='true'>" & _
        "<circle cx='8' cy='8' r='4.6' stroke-width='1.4'/><circle cx='8' cy='8' r='1.8' stroke-width='1.4'/>" & _
        "<path stroke-width='2' d='M12.6 8H15M3.4 8H1M8 12.6V15M8 3.4V1M11.25 11.25L12.95 12.95" & _
        "M4.75 11.25L3.05 12.95M4.75 4.75L3.05 3.05M11.25 4.75L12.95 3.05'/></svg>"
    ' The window's settings: whether it is detached, whether it is shown, and
    ' where it is, in pixels.
    Private Const WINDOW_SECTION As String = "Window"

    Public Sub New(ByVal Host As Host)
        Set Me.Host = Host
    End Sub

    Private Property Get AddIn_Name() As String
        Return "twinBASIC Documentation Help"
    End Property

    ' Runs again in a new instance after every compiler restart, which empties
    ' the pane; the page it showed is kept with SaveSetting.
    Private Sub Host_OnProjectLoaded()
        Set HelpButton = Host.Toolbars(0).AddButton("tbDocsHelp", "Help")
        Host.KeyboardShortcuts.Add "f1", AddressOf OnF1
        Dim indexState As String = LoadIndex()
        If Not Index Is Nothing Then Set Hovering = New HoverHelp(Host, Index, BASE_URL)
        StartServer
        PageUrl = GetSetting(SETTINGS_APP, "Pane", "Page", "")
        ' Known before the pane is built, so that its frame is not loaded for
        ' a help that is in the window.
        Detached = GetSetting(SETTINGS_APP, WINDOW_SECTION, "Detached", "0") = "1"
        BuildPane
        ' The scenarios wait for this line, and check the switch in it before
        ' pressing anything.
        Host.DebugConsole.PrintText TAG & "loaded, " & indexState & ", test switch " & _
            IIf(TestSwitchOn(), "on", "off")
        ' A compiler restart ends the window with the compiler: this instance
        ' opens it again, unless it was hidden, which it stays until the help is
        ' asked for (ShowView).
        If Detached And GetSetting(SETTINGS_APP, WINDOW_SECTION, "Shown", "1") = "1" Then Detach
    End Sub

    Private Function LoadIndex() As String
        On Error GoTo Failed
        Dim data() As Byte = LoadResDataInternal("symbols.json", "SYMBOLS")
        Set Index = New SymbolIndex
        Index.Load StrConv(data, VbStrConv.vbFromUTF8)
        Return "index " & Index.Count & " entries"
    Failed:
        Set Index = Nothing
        Return "no index (" & Err.Description & ")"
    End Function

    ' Serves the pages from the archive, when the add-in was built with one
    ' (HelpServer). The line it prints names the origin, which the scenarios
    ' read.
    Private Sub StartServer()
        Set Server = New HelpServer
        Dim serving As String = Server.Start()
        If Len(serving) > 0 Then Host.DebugConsole.PrintText TAG & serving
        If Len(Server.Origin) = 0 Then Set Server = Nothing
    End Sub

    ' The window goes with the compiler, so its place is saved here as well as
    ' when it is attached or closed, and the window's own procedure put back.
    Private Sub Class_Terminate()
        If Not HelpWin Is Nothing Then SaveWindowPlace
        EndWindowHook
        If Not Server Is Nothing Then Server.CloseAll
    End Sub

    ' Where the pane's pages come from: the add-in's own server when it has the
    ' archive, otherwise the site.
    Private Function PagesUrl() As String
        If Not Server Is Nothing Then Return Server.Origin
        Return SiteUrl()
    End Function

    ' The site, which Open in browser always opens. Under the test harness
    ' TB_DOCS_HELP_SITE can name another, a copy of the site the lane serves
    ' itself.
    Private Function SiteUrl() As String
        If TestSwitchOn() Then
            Dim site As String = Environ$("TB_DOCS_HELP_SITE")
            If Len(site) > 0 Then
                If Right$(site, 1) = "/" Then site = Left$(site, Len(site) - 1)
                Return site
            End If
        End If
        Return BASE_URL
    End Function

    ' The frame's URL for a site path: the site reads ?theme= before its first
    ' paint, so the page matches the IDE's theme rather than WebView2's colour
    ' scheme, and ?pane=1, so the page shows without the site's navigation and
    ' header. The parameters go before any fragment.
    Private Function FrameUrl(ByVal url As String) As String
        Dim query As String = "?pane=1"
        Dim group As String = Host.Themes.ActiveThemeNameGroup
        If group = "light" Or group = "dark" Then query = "?theme=" & group & "&pane=1"
        Dim hash As Long = InStr(url, "#")
        If hash = 0 Then hash = Len(url) + 1
        Return PagesUrl() & Left$(url, hash - 1) & query & Mid$(url, hash)
    End Function

    ' A theme change loads the page again with the new theme: in the pane's
    ' frame, or in the window, which is also sent the theme's properties and,
    ' with the Windows title bar, has it made dark or light. The pane itself
    ' follows the theme through the IDE's CSS variables (pane.css).
    Private Sub Host_OnChangedTheme(ByVal ThemeName As String)
        On Error GoTo Failed
        If Detached Then
            PostToWindow "theme:" & ThemeMessage()
            If Len(PageUrl) > 0 And Not ShowingSummary Then PostToWindow "page:" & FrameUrl(PageUrl)
            If Not HelpWin Is Nothing Then ApplyTitleBarTheme
        ElseIf Len(PageUrl) > 0 And Not Frame Is Nothing Then
            LoadedFrame = FrameUrl(PageUrl)
            Frame.Properties.src = LoadedFrame
        End If
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' What the window is told of the theme: the group, for the plain palette it
    ' falls back on, a line break, and the rule with the theme's properties.
    Private Function ThemeMessage() As String
        Return Host.Themes.ActiveThemeNameGroup & vbLf & ThemeRule(Host.Themes.ActiveThemeName)
    End Function

    ' The pane's elements. Showing a tool window sets its root's display to
    ' block, so the flex layout is on a wrapper inside it.
    Private Sub BuildPane()
        ' Kept apart from the box: a property read straight after it is set
        ' can still give the old value.
        HoverOn = GetSetting(SETTINGS_APP, "Hover", "On", "0") = "1"
        Set Pane = Host.ToolWindows.Add("tbDocsHelp", PANE_ID)
        Pane.Title = "TWINBASIC HELP"
        Pane.ApplyCss StrConv(LoadResDataInternal("pane.css", "STYLESHEETS"), VbStrConv.vbFromUTF8)
        With Pane.RootDomElement
            ' Used only the first time the pane opens floating.
            .Properties.suggestedWidth = "480px"
            .Properties.suggestedHeight = "640px"
            .Properties.style.height = "100%"
            With .ChildDomElements.Add("helpWrap", "div")
                With .ChildDomElements.Add("helpBar", "div")
                    Set SearchBox = .ChildDomElements.Add("helpSearch", "input")
                    SearchBox.Properties.type = "search"
                    SearchBox.Properties.placeholder = "Search the documentation"
                    ' input also comes from the box's clear button, which
                    ' sends no key.
                    SearchBox.AddEventListener("input", AddressOf SearchChanged)
                    SearchBox.AddEventListener("keyup", AddressOf SearchKeyUp)
                    Set BrowserButton = .ChildDomElements.Add("helpBrowser", "button")
                    BrowserButton.Properties.innerText = "Open in browser"
                    BrowserButton.AddEventListener("click", AddressOf BrowserClicked)
                    Set DetachButton = .ChildDomElements.Add("helpDetach", "button")
                    DetachButton.Properties.innerText = "Detach"
                    DetachButton.AddEventListener("click", AddressOf DetachClicked)
                    With .ChildDomElements.Add("helpSettingsWrap", "div")
                        Set SettingsButton = .ChildDomElements.Add("helpSettings", "button")
                        SettingsButton.Properties.title = "Settings"
                        SettingsButton.Properties.ariaLabel = "Settings"
                        SettingsButton.Properties.ariaExpanded = "false"
                        SettingsButton.Properties.innerHTML = GEAR_SVG
                        SettingsButton.AddEventListener("click", AddressOf SettingsClicked)
                        ' One row for each setting: a label holding its control
                        ' and its text.
                        Set SettingsPanel = .ChildDomElements.Add("helpSettingsPanel", "div")
                        SettingsPanel.Properties.style.display = "none"
                        With SettingsPanel.ChildDomElements.Add("helpHoverLabel", "label")
                            Set HoverBox = .ChildDomElements.Add("helpHover", "input")
                            HoverBox.Properties.type = "checkbox"
                            HoverBox.Properties.checked = HoverOn
                            HoverBox.Properties.disabled = Hovering Is Nothing
                            HoverBox.AddEventListener("change", AddressOf HoverToggled)
                            .ChildDomElements.Add("helpHoverText", "span").Properties.innerText = "Hover help"
                        End With
                    End With
                End With
                Set SettingsShade = .ChildDomElements.Add("helpSettingsShade", "div")
                SettingsShade.Properties.style.display = "none"
                SettingsShade.AddEventListener("click", AddressOf SettingsShadeClicked)
                .AddEventListener("keyup", AddressOf PaneKeyUp)
                Set ResultsElement = .ChildDomElements.Add("helpResults", "listview")
                Set Results = ResultsElement.Properties.listview
                Results.setShowScrollbarH(False)
                Results.AddEventListener("onPick", AddressOf ResultPicked)
                ResultsElement.Properties.style.display = "none"
                Set Summary = .ChildDomElements.Add("helpSummary", "div")
                Summary.Properties.style.display = "none"
                Set Frame = .ChildDomElements.Add("helpPage", "iframe")
                Set HoverSink = .ChildDomElements.Add("helpAsk", "div")
                HoverSink.Properties.style.display = "none"
                HoverSink.AddEventListener(HOVER_EVENT, AddressOf HoverAnswered)
                If Not Hovering Is Nothing Then
                    Dim mouseSink As HtmlElement = .ChildDomElements.Add("helpAskMouse", "div")
                    mouseSink.Properties.style.display = "none"
                    Hovering.Attach mouseSink
                    Hovering.Enabled = HoverOn
                End If
            End With
        End With
        Set ResultIds = New Collection
        LastSearch = ""
        SearchText = ""
        SettingsOpen = False
        ShowingSummary = False
        LoadedFrame = ""
        If Len(PageUrl) > 0 And Not Detached Then
            LoadedFrame = FrameUrl(PageUrl)
            Frame.Properties.src = LoadedFrame
        End If
    End Sub

    ' Hover help is off until the box is ticked, and stays as it was left.
    Private Sub HoverToggled(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        SetHover HoverBox.Properties.checked
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Turns hover help on or off, from the pane's box or the window's, and
    ' shows it in both.
    Private Sub SetHover(ByVal isOn As Boolean)
        HoverOn = isOn
        SaveSetting SETTINGS_APP, "Hover", "On", IIf(isOn, "1", "0")
        Hovering.Enabled = isOn
        HoverBox.Properties.checked = isOn
        If Detached Then PostToWindow "hover:" & IIf(isOn, "1", "0")
    End Sub

    ' The gear opens the settings panel, or closes it.
    Private Sub SettingsClicked(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        ShowSettings Not SettingsOpen
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' A click on the shade is a click outside the panel. The page's frame takes
    ' every click that reaches it, so the pane cannot listen for one itself.
    Private Sub SettingsShadeClicked(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        ShowSettings False
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Esc closes the panel and gives the gear the focus, from wherever in the
    ' pane the focus was; a key in the page's frame does not reach the pane.
    Private Sub PaneKeyUp(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        If eventInfo.key = "Escape" And SettingsOpen Then
            ShowSettings False
            SettingsButton.Properties.focus()
        End If
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Shows or hides the settings panel and the shade under it, and tells the
    ' gear which it is. A setting changed in the panel leaves it open.
    Private Sub ShowSettings(ByVal isOpen As Boolean)
        SettingsOpen = isOpen
        SettingsPanel.Properties.style.display = IIf(isOpen, "", "none")
        SettingsShade.Properties.style.display = IIf(isOpen, "", "none")
        SettingsButton.Properties.ariaExpanded = IIf(isOpen, "true", "false")
    End Sub

    Private Sub Hovering_Pick(ByVal url As String)
        ShowPage url
    End Sub

    Private Sub Pane_OnClose()
        BuildPane
    End Sub

    Private Sub OnF1()
        ShowHelp
    End Sub

    Private Sub HelpButton_OnClick()
        ShowPaneForSearch
    End Sub

    ' Shows the view that has the help, and puts the focus in its search box.
    Private Sub ShowPaneForSearch()
        ShowView True
        If Not Detached Then
            SearchBox.Properties.focus()
        ElseIf HelpWin.IsReady Then
            HelpWin.Post "focus:"
        Else
            FocusOnReady = True
        End If
    End Sub

    ' Shows the view that has the help: the pane, or the detached window, which
    ' is left where it is unless it is hidden or minimized. Then it is shown
    ' without taking the focus from the editor the user is typing in, unless
    ' activate says the user asked for the window itself.
    Private Sub ShowView(Optional ByVal activate As Boolean = False)
        If Not Detached Then
            Pane.Visible = True
        ElseIf Not WindowShown Then
            OpenWindow activate
        ElseIf IsMinimized(HelpWin.hWnd) Then
            If activate Then RestoreWindow HelpWin.hWnd Else ShowWithoutActivating HelpWin.hWnd
        End If
    End Sub

    Private Sub ShowHelp()
        On Error GoTo Failed
        Dim line As Long, character As Long
        Dim word As String = WordToLookUp(line, character)
        If Len(word) = 0 Then
            ShowPaneForSearch
            Exit Sub
        End If
        If Index Is Nothing Then
            Host.ShowNotification "No help: the add-in has no symbol index"
            Exit Sub
        End If
        If line < 0 Then
            LookUp word, ""
        Else
            ' The answer comes to HoverAnswered, always: an empty one when the
            ' compiler cannot be asked or does not answer in time. A question
            ' asked again before then replaces this one.
            AskSeq = AskSeq + 1
            Asked = word
            HoverSink.Properties.innerHTML = HoverQuestion(AskSeq, line, character)
        End If
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    Private Sub HoverAnswered(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        If CLng(eventInfo.seq) <> AskSeq Or Len(Asked) = 0 Then Exit Sub
        Dim word As String = Asked
        Asked = ""
        Dim status As String = eventInfo.status
        If status = "error" Then Host.DebugConsole.PrintText TAG & "hover failed: " & eventInfo.value
        LookUp word, IIf(status = "ok", CStr(eventInfo.value), "")
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Shows the page for word, or the choice of its pages (SymbolIndex.Pages).
    ' hover is the compiler's hover for it, or "". A name with no page because
    ' it is declared outside the documented packages shows its declaration and
    ' description instead (ShowSummary).
    Private Sub LookUp(ByVal word As String, ByVal hover As String)
        If AtDeclaration(hover) Then
            Host.ShowNotification "No help for '" & word & "': it is declared here"
            Exit Sub
        End If
        Dim pages As Collection = Index.Pages(word, hover)
        If pages Is Nothing Then
            ShowSummary hover
            Exit Sub
        End If

        Select Case pages.Count
            Case 0
                Host.ShowNotification "No help for '" & word & "'"
            Case 1
                ShowPage Index.Url(pages(1))
            Case Else
                SetSearchText word
                LastSearch = word
                ShowResults pages
                ShowView
        End Select
    End Sub

    ' Puts text in the search box, in whichever view shows it.
    Private Sub SetSearchText(ByVal text As String)
        SearchText = text
        SearchBox.Properties.value = text
        If Detached Then PostToWindow "search:" & text
    End Sub

    ' Shows a page in the pane's frame, or in the window's, in place of a
    ' summary. The frame that is hidden is not given the page, so that no page
    ' is loaded twice; Attach gives it the page it missed.
    Private Sub ShowPage(ByVal url As String)
        PageUrl = url
        ShowingSummary = False
        Summary.Properties.style.display = "none"
        Frame.Properties.style.display = ""
        BrowserButton.Properties.disabled = False
        If Detached Then
            PostToWindow "page:" & FrameUrl(url)
            PostToWindow "browser:1"
        Else
            LoadedFrame = FrameUrl(url)
            Frame.Properties.src = LoadedFrame
        End If
        ShowView
        SaveSetting SETTINGS_APP, "Pane", "Page", url
    End Sub

    ' Shows what the compiler's hover says about a name the documentation has
    ' no page for, in place of the page: the declaration, its [Description] or
    ' a type library's help string, and where it is declared. Open in browser
    ' has no page to open meanwhile. The saved page stays, for after a restart.
    Private Sub ShowSummary(ByVal hover As String)
        Dim declaration As String, description As String, where As String
        ReadSummary hover, declaration, description, where
        SummaryHtml = "<pre class='declaration'>" & HtmlText(declaration) & "</pre>" & _
            IIf(Len(description) > 0, "<p class='description'>" & HtmlText(description) & "</p>", _
                "<p class='description none'>No description.</p>") & _
            IIf(Len(where) > 0, "<p class='where'>Declared in " & HtmlText(where) & "</p>", "")
        ShowingSummary = True
        Summary.Properties.innerHTML = SummaryHtml
        Frame.Properties.style.display = "none"
        Summary.Properties.style.display = ""
        BrowserButton.Properties.disabled = True
        If Detached Then
            PostToWindow "summary:" & SummaryHtml
            PostToWindow "browser:0"
            If TestSwitchOn() Then Host.DebugConsole.PrintText TAG & "window summary"
        End If
        ShowView
    End Sub

    ' Fills the list with the entries ids, or hides it when there is no search.
    ' The list draws its rows out of flow, so it is given the height of its
    ' rows, which pane.css caps.
    Private Sub ShowResults(ByVal ids As Collection)
        Set ResultIds = ids
        Results.clear()
        Dim i As Variant
        For Each i In ids
            ' Only the entry's number goes into the handler; the text is escaped.
            Results.addItem("<div class='hit' onclick='raiseEvent(""onPick"", event, true, " & _
                CLng(i) & ")'>" & ResultText(i) & "</div>")
        Next
        Dim rows As Long = ids.Count
        If rows = 0 And Len(LastSearch) > 0 Then
            Results.addItem("<div class='none'>No matches</div>")
            rows = 1
        End If
        ResultsElement.Properties.style.height = "calc(" & rows & " * var(--helpRow))"
        ResultsElement.Properties.style.display = IIf(rows > 0, "", "none")
        If Detached Then PostResults
    End Sub

    ' A row's label and kind, escaped.
    Private Function ResultText(ByVal i As Long) As String
        Return "<span class='label'>" & HtmlText(Index.Label(i)) & "</span><span class='kind'>" & _
            HtmlText(Index.Kind(i)) & "</span>"
    End Function

    ' Sends the window the rows ShowResults gave the list. The window's rows
    ' carry the entry's number for it to post back; nothing else of the text
    ' is trusted.
    Private Sub PostResults()
        If HelpWin Is Nothing Then Exit Sub
        Dim html As String
        Dim i As Variant
        For Each i In ResultIds
            html = html & "<div class='hit' data-pick='" & CLng(i) & "'>" & ResultText(i) & "</div>"
        Next
        If ResultIds.Count = 0 And Len(LastSearch) > 0 Then html = "<div class='none'>No matches</div>"
        PostToWindow "results:" & html
        If TestSwitchOn() Then Host.DebugConsole.PrintText TAG & "window results " & ResultIds.Count
    End Sub

    ' Searches again when the text, from either view's search box, has changed.
    Private Sub SearchAgain(ByVal text As String)
        If Index Is Nothing Then Exit Sub
        SearchText = text
        text = Trim$(text)
        If text <> LastSearch Then
            LastSearch = text
            ShowResults Index.Search(text, SEARCH_LIMIT)
        End If
    End Sub

    Private Sub SearchChanged(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        SearchAgain SearchBox.Properties.value
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    Private Sub SearchKeyUp(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        If Index Is Nothing Then Exit Sub
        SearchAgain SearchBox.Properties.value
        If eventInfo.key = "Enter" Then ShowFirstResult
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Enter in a search box shows the first of the results.
    Private Sub ShowFirstResult()
        If ResultIds.Count > 0 Then ShowPage Index.Url(ResultIds(1))
    End Sub

    Private Sub ResultPicked(ByVal eventInfo As HtmlEventProperties)
        On Error GoTo Failed
        PickResult CLng(eventInfo.customData0)
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Shows the page of entry i, which has to be one of the results: the window
    ' names it in a message, which is only as good as the page that posted it.
    Private Sub PickResult(ByVal i As Long)
        Dim id As Variant
        For Each id In ResultIds
            If CLng(id) = i Then
                ShowPage Index.Url(i)
                Exit Sub
            End If
        Next
    End Sub

    Private Sub BrowserClicked(ByVal eventInfo As HtmlEventProperties)
        OpenInBrowser
    End Sub

    ' Opens the page the add-in last gave the frame, or the site's home page.
    ' A link followed inside the frame is not seen: the live site is on
    ' another origin, whose location the IDE's page cannot read.
    Private Sub OpenInBrowser()
        OpenUrl Host, SiteUrl() & IIf(Len(PageUrl) > 0, PageUrl, "/")
    End Sub

    ' ------------------------------------------------------------ the window

    Private Sub DetachClicked(ByVal eventInfo As HtmlEventProperties)
        Detach
    End Sub

    ' Hides the pane and shows the window, which is made the first time and
    ' kept after, with the page it has. The page says "ready" once it has
    ' loaded, and is sent the state then; a window already loaded is sent it
    ' now.
    Private Sub Detach()
        On Error GoTo Failed
        Detached = True
        Pane.Visible = False
        OpenWindow True
        SaveSetting SETTINGS_APP, WINDOW_SECTION, "Detached", "1"
        If HelpWin.IsReady Then SendWindowState
        If TestSwitchOn() Then Host.DebugConsole.PrintText TAG & "detached"
        Exit Sub
    Failed:
        ' The help stays in the pane.
        Detached = False
        Pane.Visible = True
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Shows the window, made the first time, in the frame the IDE's option asks
    ' for. A window that is made, or that the user asked for, is activated;
    ' another is shown without it, so that F1 does not take the focus from the
    ' editor. The place it was left at is used the first time only.
    Private Sub OpenWindow(ByVal activate As Boolean)
        Dim first As Boolean = HelpWin Is Nothing
        If first Then Set HelpWin = New HelpWindow
        ApplyFrame
        If first Or activate Then
            HelpWin.Show vbModeless
            If IsMinimized(HelpWin.hWnd) Then RestoreWindow HelpWin.hWnd
        Else
            ShowWithoutActivating HelpWin.hWnd
        End If
        If first Then RestoreWindowPlace
        WindowShown = True
        SaveSetting SETTINGS_APP, WINDOW_SECTION, "Shown", "1"
        If TestSwitchOn() Then
            Host.DebugConsole.PrintText TAG & "window shown"
            Host.DebugConsole.PrintText TAG & "window chrome " & IIf(NativeFrame, "native", "custom") & _
                " style " & Hex$(WindowStyle(HelpWin.hWnd))
        End If
    End Sub

    ' Hides the window and leaves the help detached: F1, the Help button or a
    ' hover link shows it again. The page is kept.
    Private Sub HideWindow()
        On Error GoTo Failed
        SaveWindowPlace
        HelpWin.Hide
        WindowShown = False
        SaveSetting SETTINGS_APP, WINDOW_SECTION, "Shown", "0"
        If TestSwitchOn() Then Host.DebugConsole.PrintText TAG & "window hidden"
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Whether the window has the Windows title bar: the IDE's option "Show real
    ' OS titlebar". Under the test switch TB_DOCS_HELP_REAL_TITLEBAR, 1 or 0,
    ' decides instead, so that a test never changes the IDE's own options.
    Private Function WantsNativeFrame() As Boolean
        If TestSwitchOn() Then
            Dim forced As String = Environ$("TB_DOCS_HELP_REAL_TITLEBAR")
            If Len(forced) > 0 Then Return forced = "1"
        End If
        Return ShowsRealTitlebar()
    End Function

    ' Gives the window the frame the option asks for, and tells the page, which
    ' draws its own title bar for the frame that has none.
    Private Sub ApplyFrame()
        NativeFrame = WantsNativeFrame()
        HelpWin.UseNativeFrame NativeFrame
        KeepControlInClientArea HelpWin.hWnd, HelpWin.ControlHandle
        LimitMaximizeToWorkArea HelpWin.hWnd, Not NativeFrame
        ApplyTitleBarTheme
        PostToWindow "chrome:" & IIf(NativeFrame, "native", "custom")
    End Sub

    ' Makes the Windows title bar dark with a dark IDE theme, light otherwise.
    ' The page draws its own in the theme's colours.
    Private Sub ApplyTitleBarTheme()
        If NativeFrame Then SetDarkTitleBar HelpWin.hWnd, Host.Themes.ActiveThemeNameGroup = "dark"
    End Sub

    ' Sends the page a message, if the window has been made.
    Private Sub PostToWindow(ByVal text As String)
        If Not HelpWin Is Nothing Then HelpWin.Post text
    End Sub

    ' Hides the window and shows the pane again, with the search box as it was
    ' left in the window and the page the pane's frame has not been given yet.
    Private Sub Attach()
        On Error GoTo Failed
        SaveWindowPlace
        HelpWin.Hide
        WindowShown = False
        Detached = False
        SaveSetting SETTINGS_APP, WINDOW_SECTION, "Detached", "0"
        SearchBox.Properties.value = SearchText
        If Len(PageUrl) > 0 And Not ShowingSummary Then
            If LoadedFrame <> FrameUrl(PageUrl) Then
                LoadedFrame = FrameUrl(PageUrl)
                Frame.Properties.src = LoadedFrame
            End If
        End If
        Pane.Visible = True
        If TestSwitchOn() Then Host.DebugConsole.PrintText TAG & "attached"
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Alt+F4 and the system menu's Close hide the window, as the X does.
    Private Sub HelpWin_Closing()
        HideWindow
    End Sub

    ' The window was minimized, maximized or restored.
    Private Sub HelpWin_StateChanged(ByVal state As String)
        PostToWindow "state:" & state
        If TestSwitchOn() Then Host.DebugConsole.PrintText TAG & "window state " & state
    End Sub

    Private Sub HelpWin_Failed(ByVal text As String)
        Host.DebugConsole.PrintText TAG & text
    End Sub

    ' What the window's page posts: "verb:payload" (shell.js).
    Private Sub HelpWin_Message(ByVal text As String)
        On Error GoTo Failed
        Dim verb As String = text
        Dim payload As String
        Dim colon As Long = InStr(text, ":")
        If colon > 0 Then
            verb = Left$(text, colon - 1)
            payload = Mid$(text, colon + 1)
        End If
        Select Case verb
            Case "ready"
                If Detached Then SendWindowState
            Case "search"
                SearchAgain payload
            Case "enter"
                ShowFirstResult
            Case "pick"
                PickResult CLng(payload)
            Case "hover"
                SetHover payload = "1"
            Case "attach"
                Attach
            Case "close"
                HideWindow
            Case "minimize"
                MinimizeWindow HelpWin.hWnd
            Case "maxrestore"
                MaximizeOrRestore HelpWin.hWnd
            Case "drag"
                If TestSwitchOn() Then Host.DebugConsole.PrintText TAG & "window drag"
                StartWindowDrag HelpWin.hWnd
            Case "browser"
                OpenInBrowser
            Case "geometry"
                If TestSwitchOn() Then
                    Host.DebugConsole.PrintText TAG & "window geometry " & WindowGeometry(HelpWin.hWnd, HelpWin.ControlHandle)
                End If
            Case "frame"
                If TestSwitchOn() Then Host.DebugConsole.PrintText TAG & "window page " & payload
        End Select
        Exit Sub
    Failed:
        Host.DebugConsole.PrintText TAG & "error " & Err.Number & ": " & Err.Description
    End Sub

    ' Gives the window all that the pane shows: the frame it has, its state,
    ' the theme, the search box, the Hover help box, the results, and the page
    ' or the summary.
    Private Sub SendWindowState()
        HelpWin.Post "chrome:" & IIf(NativeFrame, "native", "custom")
        HelpWin.Post "state:" & StateOfWindow(HelpWin.hWnd)
        HelpWin.Post "theme:" & ThemeMessage()
        HelpWin.Post "hoverdisabled:" & IIf(Hovering Is Nothing, "1", "0")
        HelpWin.Post "hover:" & IIf(HoverOn, "1", "0")
        HelpWin.Post "search:" & SearchText
        PostResults
        If ShowingSummary Then
            HelpWin.Post "summary:" & SummaryHtml
            HelpWin.Post "browser:0"
        Else
            If Len(PageUrl) > 0 Then HelpWin.Post "page:" & FrameUrl(PageUrl)
            HelpWin.Post "browser:1"
        End If
        If FocusOnReady Then
            FocusOnReady = False
            HelpWin.Post "focus:"
        End If
    End Sub

    ' The window's place is kept from one session to the next: its position
    ' and size in pixels.
    Private Sub SaveWindowPlace()
        On Error Resume Next
        Dim x As Long, y As Long, w As Long, h As Long
        If Not WindowPlace(HelpWin.hWnd, x, y, w, h) Then Exit Sub
        SaveSetting SETTINGS_APP, WINDOW_SECTION, "Left", CStr(x)
        SaveSetting SETTINGS_APP, WINDOW_SECTION, "Top", CStr(y)
        SaveSetting SETTINGS_APP, WINDOW_SECTION, "Width", CStr(w)
        SaveSetting SETTINGS_APP, WINDOW_SECTION, "Height", CStr(h)
    End Sub

    ' Puts the window where it was, if that is on a monitor that is still
    ' there; otherwise it stays where Windows put it.
    Private Sub RestoreWindowPlace()
        Dim x As Long = Val(GetSetting(SETTINGS_APP, WINDOW_SECTION, "Left", "0"))
        Dim y As Long = Val(GetSetting(SETTINGS_APP, WINDOW_SECTION, "Top", "0"))
        Dim w As Long = Val(GetSetting(SETTINGS_APP, WINDOW_SECTION, "Width", "0"))
        Dim h As Long = Val(GetSetting(SETTINGS_APP, WINDOW_SECTION, "Height", "0"))
        If w > 0 And h > 0 And IsOnScreen(x, y, w, h) Then PlaceWindow HelpWin.hWnd, x, y, w, h
    End Sub

    ' The selection when it is on one line, line then -1; else the name under
    ' the cursor, with line and character the place of its character there
    ' that the compiler is asked about, both counted from 0, as it counts.
    Private Function WordToLookUp(ByRef line As Long, ByRef character As Long) As String
        line = -1
        If Host.ActiveEditors.Count = 0 Then Return ""
        Dim ed As Editor
        Set ed = Host.ActiveEditors(0)
        If Not TypeOf ed Is CodeEditor Then Return ""
        Dim code As CodeEditor
        Set code = ed
        Dim startLine As Long, startColumn As Long, endLine As Long, endColumn As Long
        code.GetSelectionInfo startLine, startColumn, endLine, endColumn
        If startLine = endLine And startColumn <> endColumn Then
            Dim selected As String = Trim$(code.SelectedText)
            If Len(selected) > 0 Then Return selected
        End If
        Dim text As String = LineOf(code.Text, startLine)
        line = startLine - 1
        character = NameColumn(text, startColumn) - 1
        Return NameAt(text, startColumn)
    End Function

End Class
