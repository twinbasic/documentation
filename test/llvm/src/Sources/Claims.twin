    [CompilerOptions("+llvm")]
    Private Function SingleLlvm(ByVal x As Single) As String
        Dim v As Single, r As String
        Dim ten As Single = 10, tenth As Single = 0.1, two As Single = 2, zero As Single = 0
        On Error Resume Next
        v = 1: Err.Clear: v = x + x
        r = r & "+ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = -x - x
        r = r & "- " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x * ten
        r = r & "* " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x ^ two
        r = r & "^ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x / tenth
        r = r & "/ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x / zero
        r = r & "/0 " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        SingleLlvm = r
    End Function

    [CompilerOptions("")]
    Private Function SinglePlain(ByVal x As Single) As String
        Dim v As Single, r As String
        Dim ten As Single = 10, tenth As Single = 0.1, two As Single = 2, zero As Single = 0
        On Error Resume Next
        v = 1: Err.Clear: v = x + x
        r = r & "+ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = -x - x
        r = r & "- " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x * ten
        r = r & "* " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x ^ two
        r = r & "^ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x / tenth
        r = r & "/ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x / zero
        r = r & "/0 " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 3.4E+38, "inf", IIf(v < -3.4E+38, "-inf", CStr(v))))) & "; "
        SinglePlain = r
    End Function

    [CompilerOptions("+llvm")]
    Private Function StepLlvm(ByVal x As Long, ByRef b As Boolean) As String
        Dim i As Long, count As Long
        For i = 1 To 7 Step x
            count = count + 1
        Next
        StepLlvm = count & " " & i
    End Function

    [CompilerOptions("")]
    Private Function StepPlain(ByVal x As Long, ByRef b As Boolean) As String
        Dim i As Long, count As Long
        For i = 1 To 7 Step x
            count = count + 1
        Next
        StepPlain = count & " " & i
    End Function

End Module
