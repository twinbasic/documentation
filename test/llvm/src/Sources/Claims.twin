    ' The long sample of the page.
    [CompilerOptions("+llvm,+optimize,+optimizesize,+aes,+avx,+avx2,+bmi2,+fma,+fxsr,+lzcnt,+popcnt,+rdseed,+sha,+sse,+sse2,+sse3,+sse4.1,+sse4.2,+ssse3,+xsave,+xsavec,+xsaveopt,+xsaves")]
    Private Function AllCpu(ByVal x As Double) As String
        Dim facts As String
        Evaluated = False
        Debug.Assert MarkEvaluated()
        facts = IIf(Evaluated, "assert evaluated", "assert skipped")
        #If Win64 = False Then
            facts = facts & IIf(InternalGetReturnAddress() = 0, ", return address 0", ", return address set")
        #End If
        On Error Resume Next
        Sink = x * 10
        facts = facts & ", overflow error " & Err.Number
        AllCpu = facts
    End Function

    [CompilerOptions("+llvm")]
    Private Sub AssertFalseLlvm()
        Debug.Assert False
    End Sub

    [CompilerOptions("+llvm,+optimize")]
    Private Function TotalLlvm(Values() As Long) As Long
        Dim i As Long
        For i = LBound(Values) To UBound(Values)
            UnrollLoop 8
            TotalLlvm += Values(i)
        Next
    End Function

    [CompilerOptions("+llvm")]
    Private Function DoubleLlvm(ByVal x As Double) As String
        Dim v As Double, r As String
        Dim ten As Double = 10, tenth As Double = 0.1, two As Double = 2, zero As Double = 0
        On Error Resume Next
        v = 1: Err.Clear: v = x + x
        r = r & "+ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = -x - x
        r = r & "- " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x * ten
        r = r & "* " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x ^ two
        r = r & "^ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x / tenth
        r = r & "/ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x / zero
        r = r & "/0 " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        DoubleLlvm = r
    End Function

    [CompilerOptions("+llvm,+sse2")]
    Private Function DoubleLlvmSse2(ByVal x As Double) As String
        Dim v As Double, r As String
        Dim ten As Double = 10, tenth As Double = 0.1, two As Double = 2, zero As Double = 0
        On Error Resume Next
        v = 1: Err.Clear: v = x + x
        r = r & "+ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = -x - x
        r = r & "- " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x * ten
        r = r & "* " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x ^ two
        r = r & "^ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x / tenth
        r = r & "/ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x / zero
        r = r & "/0 " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        DoubleLlvmSse2 = r
    End Function

    [CompilerOptions("+llvm")]
    [FloatingPointErrorChecks(True)]
    Private Function DoubleLlvmChecks(ByVal x As Double) As String
        Dim v As Double, r As String
        Dim ten As Double = 10, tenth As Double = 0.1, two As Double = 2, zero As Double = 0
        On Error Resume Next
        v = 1: Err.Clear: v = x + x
        r = r & "+ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = -x - x
        r = r & "- " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x * ten
        r = r & "* " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x ^ two
        r = r & "^ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x / tenth
        r = r & "/ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        v = 1: Err.Clear: v = x / zero
        r = r & "/0 " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
        DoubleLlvmChecks = r
    End Function

    [CompilerOptions("")]
    Private Function DoublePlain(ByVal x As Double) As String
        Dim v As Double, r As String
        Dim ten As Double = 10, tenth As Double = 0.1, two As Double = 2, zero As Double = 0
        On Error Resume Next
        v = 1: Err.Clear: v = x + x
        r = r & "+ " & Err.Number & " " & IIf(v = 1, "kept", IIf(v = 0, "0", IIf(v > 1E+308, "inf", IIf(v < -1E+308, "-inf", CStr(v))))) & "; "
