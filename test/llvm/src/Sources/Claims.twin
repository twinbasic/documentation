' The claims the documentation makes about code compiled with LLVM, each printed as one line
' "key: value". test/llvm/run.mjs runs this project in 32-bit and 64-bit, with LLVM off and on
' for the whole project, in an IDE run and in the built exe, and compares every line with
' expect.json. README.md beside run.mjs names the page that states each claim.
'
' Which procedures LLVM compiled is read three ways, since no one way works everywhere: whether
' Debug.Assert evaluated its condition (it does only in an IDE run of code compiled without
' LLVM), whether InternalGetReturnAddress returned 0 (it does under LLVM; 32-bit only, since a
' 64-bit build cannot generate code for it: gra64/), and the error a Double multiplication that
' overflows raised (6 without LLVM; none with it, except in 32-bit code built for SSE2).
'
' Under LLVM for the whole project (run.mjs's llvm modes), a procedure that is not compiled
' with LLVM must not call one that is: an IDE run ends in an access violation (the WARNING
' under Per-procedure LLVM options). So MarkEvaluated, which every variant calls, is marked
' [CompilerOptions("")] too, and the variants call nothing else of this project.
Module Claims

    Private Sink As Double
    Private Evaluated As Boolean

    [RunAfterBuild]
    Public Sub Built()
        Debug.Cls
        Report
    End Sub

    Public Sub Report()
        Dim big As Double = 1E+308

        ' Per-procedure LLVM options: which spellings turn LLVM on, and the long sample.
        Out "default", Default(big)
        Out "llvm", Llvm(big)
        Out "llvm-comma", LlvmComma(big)
        Out "llvm-space", LlvmSpace(big)
        Out "llvm-comma-space", LlvmCommaSpace(big)
        Out "optimize-only", OptimizeOnly(big)
        Out "optimize-size-only", OptimizeSizeOnly(big)
        Out "cpu-only", CpuOnly(big)
        Out "empty", EmptyString(big)
        Out "llvm-sse", LlvmSse(big)
        Out "llvm-sse2", LlvmSse2(big)
        Out "all-cpu", AllCpu(big)

        ' Debug.Assert under LLVM does not stop.
        AssertFalseLlvm
        Out "assert-false-llvm-went-on", True

        ' UnrollLoop does not change what the loop does.
        Dim values(1 To 100) As Long
        Dim n As Long
        For n = 1 To 100
            values(n) = n
        Next
        Out "unroll-llvm", TotalLlvm(values)

        ' Arithmetic that overflows: each operation's error, and what the variable then holds.
        Out "double-llvm", DoubleLlvm(big)
        Out "double-llvm-sse2", DoubleLlvmSse2(big)
        Out "double-llvm-checks", DoubleLlvmChecks(big)
        Out "double-plain", DoublePlain(big)
        Out "single-llvm", SingleLlvm(3E+38)
        Out "single-plain", SinglePlain(3E+38)

        ' For...Next with a ByVal step and a later ByRef Boolean: the count of passes, and i after.
        Dim flag As Boolean
        Out "for-step-llvm", StepLlvm(3, flag)
        Out "for-step-plain", StepPlain(3, flag)
    End Sub

    Private Sub Out(ByVal key As String, ByVal value As Variant)
        TbRun.Out key & ": " & CStr(value)
    End Sub

    [CompilerOptions("")]
    Private Function MarkEvaluated() As Boolean
        Evaluated = True
        MarkEvaluated = True
    End Function

    ' The project's own options.
    Private Function Default(ByVal x As Double) As String
        Dim facts As String
        Evaluated = False
        Debug.Assert MarkEvaluated()
        facts = IIf(Evaluated, "assert evaluated", "assert skipped")
        #If Win64 = False Then
            facts = facts & IIf(InternalGetReturnAddress() = 0, ", return address 0", ", return address set")
        #End If
        On Error Resume Next
        Sink = x * 10
        facts = facts & ", overflow error " & Err.Number
        Default = facts
    End Function

    [CompilerOptions("+llvm")]
    Private Function Llvm(ByVal x As Double) As String
        Dim facts As String
        Evaluated = False
        Debug.Assert MarkEvaluated()
        facts = IIf(Evaluated, "assert evaluated", "assert skipped")
        #If Win64 = False Then
            facts = facts & IIf(InternalGetReturnAddress() = 0, ", return address 0", ", return address set")
        #End If
        On Error Resume Next
        Sink = x * 10
        facts = facts & ", overflow error " & Err.Number
        Llvm = facts
    End Function

