    Private Sub C26()
        DSay "== c26 Print: ReturnDC"
        Dim d As New cDialogPrint
        Dim r As Boolean
        Dim p As String = DefaultPrinter()
        ' The default ReturnDC = True makes the dialog create a device context for the printer
        ' chosen. That is not printing, but only a Microsoft virtual printer is used for it: the
        ' scenario chooses "Microsoft Print to PDF" in the dialog, cancels when the list has no such
        ' printer, and checks that the default printer is the same afterwards.
        DSay "  ReturnDC=" & d.ReturnDC
        DArm "c26", "cbfind 1139 Microsoft Print to PDF|needfind|wait 1|ctl 1139|ok"
        r = d.ShowDialog()
        DDisarm
        DSay "  ShowDialog=" & r & " hDC<>0: " & (d.hDC <> 0) & " Copies=" & d.Copies
        DSay "  the default printer is the same as before: " & (DefaultPrinter() = p)
        If d.hDC <> 0 Then
            DSay "  HORZRES=" & GetDeviceCaps(d.hDC, 8) & " LOGPIXELSX=" & GetDeviceCaps(d.hDC, 88)
            DSay "  DeleteDC returned " & DeleteDC(d.hDC)
        End If
        DWrap "c26"
    End Sub

    '=========================================================================================
    ' cDialogPageSetup
    '=========================================================================================

    Private Function Pg(ByVal d As cDialogPageSetup) As String
        Pg = "Paper=" & d.PaperWidth & "x" & d.PaperHeight & " Margins L/R/T/B=" & d.MarginLeft & "/" & d.MarginRight & "/" & d.MarginTop & "/" & d.MarginBottom & " Orientation=" & d.Orientation & " Unit=" & d.Unit
    End Function

    Private Sub C31()
        DSay "== c31 Page Setup: defaults, conversions, ToDescription"
        Dim d As New cDialogPageSetup
        DSay "  defaults: " & Pg(d)
        DSay "  AllowMargins=" & d.AllowMargins & " AllowOrientation=" & d.AllowOrientation & " AllowPaper=" & d.AllowPaper & " DefaultMinMargins=" & d.DefaultMinMargins & " OwnerHwnd=" & d.OwnerHwnd
        DSay "  ToDescription=" & DQ(d.ToDescription())
        DSay "  printable " & d.GetPrintableWidth() & " x " & d.GetPrintableHeight()
        d.SetA4Size
        DSay "  SetA4Size: " & Pg(d)
        d.SetLegalSize
        DSay "  SetLegalSize: " & Pg(d)
        d.SetLetterSize
        d.SetNarrowMargins
        DSay "  SetLetterSize, SetNarrowMargins: " & Pg(d) & " printable " & d.GetPrintableWidth() & " x " & d.GetPrintableHeight()
        d.SetDefaultMargins
        DSay "  SetDefaultMargins: " & Pg(d)
        d.SetA4Size
        d.Unit = MeasurementUnit.Millimeters
        DSay "  A4, Unit=Millimeters: " & Pg(d)
        DSay "  ToDescription=" & DQ(d.ToDescription())
        d.Orientation = PaperOrientation.Landscape
        DSay "  Orientation=Landscape: paper is still " & d.PaperWidth & "x" & d.PaperHeight & " ToDescription=" & DQ(d.ToDescription())
        d.Unit = MeasurementUnit.Inches
        d.Reset
        DSay "  after Reset: " & Pg(d)
        DSay "  mDialog: InchesToTwips(1)=" & InchesToTwips(1) & " PAPER_A4_WIDTH=" & PAPER_A4_WIDTH
    End Sub

