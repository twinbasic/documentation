    Private Sub C25()
        DSay "== c25 Print: AllowSelection, AllowPageRange, HidePrintToFile, AllowPrintToFile, PrintToFile"
        Dim d As New cDialogPrint
        Dim d2 As New cDialogPrint
        Dim d3 As New cDialogPrint
        Dim d4 As New cDialogPrint
