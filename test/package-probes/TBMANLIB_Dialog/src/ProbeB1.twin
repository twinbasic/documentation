    '=========================================================================================
    ' cDialogFindReplace
    '=========================================================================================

    Private Function Fr(ByVal d As cDialogFindReplace) As String
        Fr = "FindWhat=" & DQ(d.FindWhat) & " ReplaceWith=" & DQ(d.ReplaceWith) & " MatchCase=" & d.MatchCase & " WholeWord=" & d.WholeWord & " Direction=" & d.Direction & " Mode=" & d.Mode & " LastAction=" & d.LastAction & " LastError=" & d.LastError & " IsVisible=" & d.IsVisible() & " hWnd<>0: " & (d.hWnd <> 0)
    End Function

    Private Sub C41()
        DSay "== c41 Find: defaults, MessageId, UpdateFromFlags with no dialog"
        Dim d As New cDialogFindReplace
        Dim d2 As New cDialogFindReplace
        DSay "  defaults: " & Fr(d)
        DSay "  AllowUpDown=" & d.AllowUpDown & " AllowMatchCase=" & d.AllowMatchCase & " AllowWholeWord=" & d.AllowWholeWord & " OwnerHwnd=" & d.OwnerHwnd
        DSay "  MessageId=" & d.MessageId & " same as RegisterWindowMessage(commdlg_FindReplace): " & (d.MessageId = RegisterWindowMessageW(StrPtr("commdlg_FindReplace"))) & " second object: " & (d2.MessageId = d.MessageId)
        DSay "  ToDescription=" & DQ(d.ToDescription())
        d.FindWhat = "alpha"
        d.ReplaceWith = "beta"
        d.MatchCase = True
        d.Direction = SearchDirection.Up
        DSay "  ToDescription=" & DQ(d.ToDescription())
        d.Mode = DialogMode.ReplaceMode
        DSay "  Mode=ReplaceMode: ToDescription=" & DQ(d.ToDescription())
        DSay "  FindWhat before UpdateFromFlags=" & DQ(d.FindWhat)
        d.UpdateFromFlags 1 + 4 + 8
        DSay "  UpdateFromFlags(FR_DOWN|FR_MATCHCASE|FR_FINDNEXT): " & Fr(d)
        d.UpdateFromFlags 2 + 16
        DSay "  UpdateFromFlags(FR_WHOLEWORD|FR_REPLACE): " & Fr(d)
        d.UpdateFromFlags 32
        DSay "  UpdateFromFlags(FR_REPLACEALL): " & Fr(d)
        d.UpdateFromFlags &H40
        DSay "  UpdateFromFlags(FR_DIALOGTERM): " & Fr(d)
        d.UpdateFromFlags 0
        DSay "  UpdateFromFlags(0): " & Fr(d)
        d.UpdateFromFlags 8 + 32
        DSay "  UpdateFromFlags(FR_FINDNEXT|FR_REPLACEALL): " & Fr(d)
        d.Reset
        DSay "  after Reset: " & Fr(d)
        DSay "  enums: DialogMode.ReplaceMode=" & DialogMode.ReplaceMode & " SearchDirection.Down=" & SearchDirection.Down & " FindAction.DialogClosed=" & FindAction.DialogClosed & " FindAction.ReplaceAll=" & FindAction.ReplaceAll
    End Sub

    Private Sub C42()
        DSay "== c42 Find: ShowFind and ShowReplace with no owner window"
        Dim d As New cDialogFindReplace
        Dim d2 As New cDialogFindReplace
        Dim r As Boolean
        d.FindWhat = "x"
        DArm "c42a", "rec|cancel"
        r = d.ShowFind()
        DDisarm
        DSay "  ShowFind with OwnerHwnd=0: " & r & " " & Fr(d) & " LastError hex=&H" & Hex$(d.LastError)
        DWrap "c42a"
        DArm "c42b", "rec|cancel"
        r = d2.ShowReplace()
        DDisarm
        DSay "  ShowReplace with OwnerHwnd=0: " & r & " " & Fr(d2) & " LastError hex=&H" & Hex$(d2.LastError)
        DWrap "c42b"
    End Sub

    ' The owner window: it receives the find message that the dialog sends.
    Public Function OwnerProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
        If mFindMsg <> 0 And uMsg = mFindMsg Then
            OnFindMessage lParam
            OwnerProc = 0
        Else
            OwnerProc = DefWindowProcW(hWnd, uMsg, wParam, lParam)
        End If
    End Function

    Private Function FlagsOffset() As Long
        #If Win64 Then
            FlagsOffset = 24
        #Else
            FlagsOffset = 12
        #End If
    End Function

    Private Sub OnFindMessage(ByVal lParam As LongPtr)
        Dim flags As Long
        Dim sz As Long
        Dim own As LongPtr
        mFound = mFound + 1
        sz = PeekL(lParam)
        own = PeekP(lParam + PtrSz())
        flags = PeekL(lParam + FlagsOffset())
        DSay "    owner received the find message #" & mFound & ": lStructSize=" & sz & " hwndOwner is the owner: " & (own = mOwner) & " Flags=&H" & Hex$(flags)
        If mReadStruct Then
            DSay "      lpstrFindWhat<>0: " & (PeekP(lParam + FlagsOffset() + PtrSz()) <> 0)
        End If
        If Not (mFR Is Nothing) Then
            mFR.UpdateFromFlags flags
            DSay "    after UpdateFromFlags: " & Fr(mFR)
        Else
            DSay "    the text in the buffer: " & DQ(Left$(mBuf, InStr(mBuf, vbNullChar) - 1))
        End If
    End Sub

    Private Function MakeOwner() As Boolean
        Dim wc As WNDCLASSEXB1
        Dim inst As LongPtr = GetModuleHandleW(0)
        wc.cbSize = IIf(PtrSz() = 8, 80, 48)
        wc.lpfnWndProc = AddressOf OwnerProc
        wc.hInstance = inst
        wc.lpszClassName = StrPtr(OwnerClassName)
        If RegisterClassExW(wc) = 0 Then
            DSay "  RegisterClassExW failed"
            Exit Function
        End If
        mOwner = CreateWindowExW(0, StrPtr(OwnerClassName), StrPtr("probe owner"), 0, 0, 0, 100, 100, 0, 0, inst, 0)
        If mOwner = 0 Then
            DSay "  CreateWindowExW failed"
            Exit Function
        End If
        mFindMsg = RegisterWindowMessageW(StrPtr("commdlg_FindReplace"))
        MakeOwner = True
    End Function

    Private Sub FreeOwner()
        If mOwner <> 0 Then DestroyWindow mOwner
        mOwner = 0
        UnregisterClassW StrPtr(OwnerClassName), GetModuleHandleW(0)
    End Sub

    Private Sub C43()
        DSay "== c43 Find: ShowFind with an owner window; Find Next; Cancel"
        Dim r As Boolean
        If Not MakeOwner() Then Exit Sub
        Set mFR = New cDialogFindReplace
        mFR.OwnerHwnd = mOwner
        mFR.FindWhat = "alpha"
        mFR.MatchCase = True
        mFR.WholeWord = False
        mFound = 0
        r = mFR.ShowFind()
        DSay "  ShowFind=" & r & " " & Fr(mFR) & " hWnd is a window: " & (mFR.hWnd <> 0)
        DArm "c43", "rec|settext 1152 beta gamma|click 1041|wait 1|click 1|wait 2|cancel|wait 2|quit"
        DPump
        DDisarm
        DSay "  the Find window still exists: " & (IsWindow(mFR.hWnd) <> 0)
        DSay "  messages received: " & mFound & "; at the end: " & Fr(mFR)
        DWrap "c43"
        FreeOwner
    End Sub

    Private Sub C44()
        DSay "== c44 Find: ShowReplace; Replace; Replace All; Cancel"
        Dim r As Boolean
        If Not MakeOwner() Then Exit Sub
        Set mFR = New cDialogFindReplace
        mFR.OwnerHwnd = mOwner
        mFR.FindWhat = "old"
        mFR.ReplaceWith = "new"
        mFound = 0
        r = mFR.ShowReplace()
        DSay "  ShowReplace=" & r & " " & Fr(mFR)
        DArm "c44", "rec|settext 1152 one|settext 1153 two|wait 1|click 1024|wait 2|click 1025|wait 2|click 1|wait 2|cancel|wait 2|quit"
        DPump
        DDisarm
        DSay "  messages received: " & mFound & "; at the end: " & Fr(mFR)
        DWrap "c44"
        FreeOwner
    End Sub

    Private Sub C45()
        DSay "== c45 Find: AllowUpDown, AllowMatchCase, AllowWholeWord, Direction"
        Dim r As Boolean
        If Not MakeOwner() Then Exit Sub
        Set mFR = New cDialogFindReplace
        mFR.OwnerHwnd = mOwner
        mFR.AllowUpDown = False
        mFR.AllowMatchCase = False
        mFR.AllowWholeWord = False
        r = mFR.ShowFind()
        DArm "c45a", "rec|cancel|wait 2|quit"
        DPump
        DDisarm
        DSay "  (a) all three Allow = False: " & Fr(mFR)
        Set mFR = New cDialogFindReplace
        mFR.OwnerHwnd = mOwner
        mFR.Direction = SearchDirection.Up
        mFR.WholeWord = True
        mFR.MatchCase = True
        r = mFR.ShowFind()
        DArm "c45b", "rec|click 1|wait 2|cancel|wait 2|quit"
        DPump
        DDisarm
        DSay "  (b) Direction=Up WholeWord MatchCase: " & Fr(mFR)
        FreeOwner
    End Sub

    ' Calls FindText as cDialogFindReplace.ShowFind does, with the structure in a variable of
    ' this procedure (useStatic = False) or in a variable of the module (useStatic = True).
    Private Function ShowFindDirect(ByVal useStatic As Boolean) As LongPtr
        Dim localFr As FINDREPLACEB1
        mBuf = "alpha" & String$(251, 0)
        If useStatic Then
            With mStaticFr
                .lStructSize = IIf(PtrSz() = 8, 80, 40)
                .hwndOwner = mOwner
                .flags = 1
                .lpstrFindWhat = StrPtr(mBuf)
                .wFindWhatLen = 256
            End With
            ShowFindDirect = FindTextB1(mStaticFr)
        Else
            With localFr
                .lStructSize = IIf(PtrSz() = 8, 80, 40)
                .hwndOwner = mOwner
                .flags = 1
                .lpstrFindWhat = StrPtr(mBuf)
                .wFindWhatLen = 256
            End With
            ShowFindDirect = FindTextB1(localFr)
        End If
    End Function

    Private Sub C47()
        DSay "== c47 Find: FindText called directly, the structure in a module-level variable"
        Dim h As LongPtr
        If Not MakeOwner() Then Exit Sub
        Set mFR = Nothing
        mFound = 0
        h = ShowFindDirect(True)
        DSay "  FindText returned a window: " & (h <> 0)
        DArm "c47", "settext 1152 beta gamma|wait 1|click 1|wait 2|cancel|wait 2|quit"
        DPump
        DDisarm
        DSay "  the Find window still exists: " & (IsWindow(h) <> 0)
        DSay "  messages received: " & mFound
        DWrap "c47"
        FreeOwner
    End Sub

    Private Sub C48()
        DSay "== c48 Find: FindText called directly, the structure in a local variable"
        Dim h As LongPtr
        If Not MakeOwner() Then Exit Sub
        Set mFR = Nothing
        mFound = 0
        h = ShowFindDirect(False)
        DSay "  FindText returned a window: " & (h <> 0)
        DArm "c48", "settext 1152 beta gamma|wait 1|click 1|wait 2|cancel|wait 2|quit"
        DPump
        DDisarm
        DSay "  the Find window still exists: " & (IsWindow(h) <> 0)
        DSay "  messages received: " & mFound
        DWrap "c48"
        FreeOwner
    End Sub

    Private Sub StackFill()
        Dim a(0 To 2047) As Long
        Dim i As Long
        For i = 0 To 2047
            a(i) = &H41414141
        Next
        mSink = a(2047)
    End Sub

    Private Sub C46()
        DSay "== c46 Find: what the owner window receives, with the stack reused in between"
        Dim r As Boolean
        If Not MakeOwner() Then Exit Sub
        mReadStruct = True
        Set mFR = New cDialogFindReplace
        mFR.OwnerHwnd = mOwner
        mFR.FindWhat = "alpha"
        mFound = 0
        r = mFR.ShowFind()
        StackFill
        DSay "  ShowFind=" & r & ", the stack below the caller overwritten"
        DArm "c46", "settext 1152 beta|wait 1|click 1|wait 2|cancel|wait 2|quit"
        DPump
        DDisarm
        DSay "  messages received: " & mFound & "; at the end: " & Fr(mFR)
        DWrap "c46"
        mReadStruct = False
        FreeOwner
    End Sub

End Module
