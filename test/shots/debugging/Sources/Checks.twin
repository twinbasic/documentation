Module Checks

    ' The "Running and debugging" chapter's error example: on the fourth pass idx is 7, past
    ' the last index of a.
    Public Sub FillTable()
        Dim a(5) As Long
        Dim i As Long
        Dim idx As Long
        Dim total As Long
        For i = 1 To 6
            idx = Choose(i, 1, 3, 5, 7, 2, 4)
            a(idx) = i * 10
            total = total + i
            Debug.Print "i = " & i & ", idx = " & idx & ", total = " & total
        Next i
        Debug.Print "loop finished, i = " & i & ", total = " & total
    End Sub

    ' A program that the program starts, short-lived and with no window: the PROCESS box.
    Public Sub PingLater()
        Shell "ping -n 20 127.0.0.1", vbHide
    End Sub

    ' A run that waits a minute at most, for the Run menu while a program runs.
    Public Sub WaitAWhile()
        Dim started As Double
        started = Timer
        Do While Timer - started < 60
            DoEvents
        Loop
    End Sub

End Module
