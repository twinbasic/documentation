Module MainModule

    ' The program behind the WebView2 section's picture of a running program
    ' (scripts/shoot_docs.mjs, setup webview2). Its command line names the scene. TB_SHOT_SIGNALS,
    ' when it is set, names a folder through which the tool and the program take turns: the
    ' program writes "shown" once its form is drawn with the page loaded, and ends when "end"
    ' appears or the form is closed. The texts are the fixture's own: nothing is read from the
    ' machine or the network.
    '
    ' The scene lays its form out in pixels at 96 DPI (FitClient), so that it looks the same at
    ' any DPI.

    Private Declare PtrSafe Sub Sleep Lib "kernel32" (ByVal Milliseconds As Long)
    Private Declare PtrSafe Function SetForegroundWindow Lib "user32" (ByVal hWnd As LongPtr) As Long
    Private Declare PtrSafe Function GetForegroundWindow Lib "user32" () As LongPtr
    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, _
        ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
    Private Declare PtrSafe Function GetTickCount Lib "kernel32" () As Long
    Private Const WM_NCACTIVATE As Long = &H86

    ' How long the control may take to start and load its page, in milliseconds.
    Private Const LOAD_LIMIT As Long = 60000

    Private Doing As String

    Public Sub Main()
        ' Command$ is the command line as written, quotes included
        Dim scene As String = LCase$(Trim$(Replace(Command$, """", "")))
        Dim f As Form = frmWeb
        Load f
        On Error GoTo Failed
        f.AutoRedraw = True
        f.ForeColor = vbBlack
        Doing = "set up"
        Select Case scene
            Case "page": PageScene f
            Case Else: Err.Raise 5, , "no scene named " & scene
        End Select
        f.Show
        Activate f
        f.Refresh
        DoEvents
        Doing = "load"
        WaitForPage
        Doing = "script"
        frmWeb.Web1.JsRun "setNote", "This line was set by the form's code, which called the page's setNote function with JsRun."
        Settle f, 1000
    Shown:
        On Error GoTo 0
        Signal "shown"
        If WaitFor("end", f) Then Unload f
        Exit Sub
    Failed:
        ' The tool fails the picture with this text, rather than wait for a form that never shows.
        Signal "error", "error " & Err.Number & " in " & scene & " (" & Doing & "): " & Err.Description
        f.Show
        Resume Shown
    End Sub

    ' The form with a line of text and the control under it, the page a light grey-blue against
    ' the form's own colour, so that the control's edges show.
    Private Sub PageScene(ByVal f As Form)
        FitClient f, 600, 350
        Text f, "A WebView2 control on a form, showing a page:", 14, 10
        frmWeb.Web1.Move 14, 36, 572, 300
    End Sub

    ' Waits until the page has loaded; raises the control's failure, or one at the limit.
    Private Sub WaitForPage()
        Dim t0 As Long = GetTickCount()
        Do Until frmWeb.Loaded
            If Len(frmWeb.Failure) Then Err.Raise 5, , frmWeb.Failure
            If GetTickCount() - t0 > LOAD_LIMIT Then Err.Raise 5, , "the page had not loaded after " & LOAD_LIMIT \ 1000 & " s"
            KeepActive frmWeb
            DoEvents
            Sleep 50
        Loop
    End Sub

    ' Lets the control draw what the script changed: messages pumped for `ms` milliseconds.
    Private Sub Settle(ByVal f As Form, ByVal ms As Long)
        Dim t0 As Long = GetTickCount()
        Do While GetTickCount() - t0 < ms
            KeepActive f
            DoEvents
            Sleep 50
        Loop
        f.Refresh
    End Sub

    ' The form's client area made `Width` by `Height` pixels at 96 DPI, and its scale those pixels.
    Private Sub FitClient(ByVal f As Form, ByVal Width As Single, ByVal Height As Single)
        f.ScaleMode = vbTwips
        f.Width = f.Width + (Width * 15 - f.ScaleWidth)
        f.Height = f.Height + (Height * 15 - f.ScaleHeight)
        f.Scale (0, 0)-(Width, Height)
    End Sub

    ' Text printed on the form at (x, y).
    Private Sub Text(ByVal f As Form, ByVal s As String, ByVal x As Single, ByVal y As Single)
        f.CurrentX = x
        f.CurrentY = y
        f.Print s
    End Sub

    ' Makes the form the active window, as it is when a person starts the program. On the
    ' tool's private desktop, which has no input, the foreground is not dependable, so while
    ' the form waits it draws its frame as the active window's whenever it is not the
    ' foreground window.
    Private Sub Activate(ByVal f As Form)
        SetForegroundWindow f.hWnd
        DoEvents
        KeepActive f
    End Sub

    Private Sub KeepActive(ByVal f As Form)
        If f.Visible And GetForegroundWindow() <> f.hWnd Then SendMessageW f.hWnd, WM_NCACTIVATE, 1, 0
    End Sub

    ' The folder of the signals, or "" when no tool runs the program.
    Private Function Signals() As String
        Return Environ$("TB_SHOT_SIGNALS")
    End Function

    Private Sub Signal(ByVal Name As String, Optional ByVal Text As String)
        If Len(Signals()) = 0 Then Exit Sub
        Dim n As Integer = FreeFile
        Open Signals() & "\" & Name For Output As #n
        If Len(Text) Then Print #n, Text
        Close #n
    End Sub

    ' Waits until the signal is there (True), or until the form is closed (False).
    Private Function WaitFor(ByVal Name As String, ByVal f As Form) As Boolean
        Do
            If Len(Signals()) Then
                If Len(Dir$(Signals() & "\" & Name)) Then Return True
            End If
            If Not IsLoaded(f) Then Return False
            KeepActive f
            DoEvents
            Sleep 50
        Loop
    End Function

    Private Function IsLoaded(ByVal f As Form) As Boolean
        Dim g As Object
        For Each g In Forms
            If g Is f Then Return True
        Next
        Return False
    End Function

End Module
