Module MainModule

    ' The program behind the VBComDlg and AutoCompleteLib sections' pictures (scripts/shoot_docs.mjs,
    ' setup dialogs). Its command line names the scene: a dialog of a CommonDialog, or the form
    ' frmAuto with text typed into a text box that an AutoComplete serves. TB_SHOT_SIGNALS names a
    ' folder through which the tool and the program take turns: the program writes "shown" once
    ' its dialog or form is in the state the picture shows; the tool ends a dialog's program
    ' itself, and a form's program ends when "end" appears or the form is closed. The texts are
    ' the fixture's own, and the folders the Folder Browser shows are made by the program in the
    ' folder of the signals: nothing is read from the machine.

    Private Declare PtrSafe Sub Sleep Lib "kernel32" (ByVal Milliseconds As Long)
    Private Declare PtrSafe Function SetForegroundWindow Lib "user32" (ByVal hWnd As LongPtr) As Long
    Private Declare PtrSafe Function GetForegroundWindow Lib "user32" () As LongPtr
    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, _
        ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
    Private Declare PtrSafe Function SetTimer Lib "user32" (ByVal hWnd As LongPtr, ByVal nIDEvent As LongPtr, _
        ByVal uElapse As Long, ByVal lpTimerFunc As LongPtr) As LongPtr
    Private Declare PtrSafe Function FindWindowW Lib "user32" (ByVal lpClassName As LongPtr, ByVal lpWindowName As LongPtr) As LongPtr
    Private Declare PtrSafe Function GetDlgItem Lib "user32" (ByVal hDlg As LongPtr, ByVal nIDDlgItem As Long) As LongPtr
    Private Declare PtrSafe Function FindWindowExW Lib "user32" (ByVal hWndParent As LongPtr, ByVal hWndChildAfter As LongPtr, _
        ByVal lpszClass As LongPtr, ByVal lpszWindow As LongPtr) As LongPtr
    Private Declare PtrSafe Function HideCaret Lib "user32" (ByVal hWnd As LongPtr) As Long
    Private Declare PtrSafe Function IsWindowVisible Lib "user32" (ByVal hWnd As LongPtr) As Long
    Private Declare PtrSafe Function RedrawWindow Lib "user32" (ByVal hWnd As LongPtr, ByVal lprcUpdate As LongPtr, _
        ByVal hrgnUpdate As LongPtr, ByVal flags As Long) As Long
    Private Const WM_NCACTIVATE As Long = &H86
    Private Const CB_FINDSTRINGEXACT As Long = &H158
    Private Const CB_SETTOPINDEX As Long = &H15C
    Private Const TVM_SETEXTENDEDSTYLE As Long = &H112C
    Private Const TVS_EX_FADEINOUTEXPANDOS As Long = &H40
    ' The Font dialog's list of font names (cmb1)
    Private Const FONT_NAMES As Long = &H470
    Private Const WM_CHAR As Long = &H102
    Private Const WM_CHANGEUISTATE As Long = &H127
    Private Const UIS_SET As Long = 1
    Private Const UISF_HIDEFOCUS As Long = 1
    Private Const UISF_HIDEACCEL As Long = 2
    Private Const RDW_INVALIDATE As Long = &H1
    Private Const RDW_ERASE As Long = &H4
    Private Const RDW_FRAME As Long = &H400
    Private Const RDW_ALLCHILDREN As Long = &H80
    Private Const RDW_UPDATENOW As Long = &H100

    ' The title of the scene's dialog, by which the timer finds it, and whether it has been put
    ' in the state the picture shows.
    Private DialogTitle As String
    Private DialogKept As Boolean

    ' The AutoComplete scene's object, and the text it types.
    Private AC As AutoComplete
    Private Const TYPED As String = "Ap"

    Public Sub Main()
        ' Command$ is the command line as written, quotes included
        Dim scene As String = LCase$(Trim$(Replace(Command$, """", "")))
        On Error GoTo Failed
        Select Case scene
            Case "suggest", "append", "suggestappend"
                AutoCompleteScene scene
            Case Else
                DialogScene scene
        End Select
        Exit Sub
    Failed:
        ' The tool fails the picture with this text, rather than wait for a window that never shows.
        Signal "error", "error " & Err.Number & " in " & scene & ": " & Err.Description
        Signal "shown"
    End Sub

    ' ---------------------------------------------------------------- the dialogs

    ' A dialog of a CommonDialog. While a modal dialog waits, a timer keeps it (KeepDialog); a
    ' modeless one (Find, Replace) is kept by the program's own loop. The tool ends the program
    ' once it has the picture, so the dialog is never closed.
    Private Sub DialogScene(ByVal scene As String)
        Dim dlg As New CommonDialog
        Select Case scene
            Case "color-full", "color-basic"
                DialogTitle = "Color"
                dlg.Color = RGB(64, 128, 192)
                dlg.Flags = CdlCCRGBInit Or IIf(scene = "color-full", CdlCCFullOpen, CdlCCPreventFullOpen)
                SetTimer 0, 0, 100, AddressOf KeepDialog
                dlg.ShowColor
            Case "font"
                DialogTitle = "Font"
                dlg.FontName = "Microsoft Sans Serif"
                dlg.FontSize = 10
                dlg.FontBold = True
                dlg.Color = RGB(0, 0, 160)
                dlg.Flags = CdlCFScreenFonts Or CdlCFEffects
                SetTimer 0, 0, 100, AddressOf KeepDialog
                dlg.ShowFont
            Case "folder-new", "folder-old"
                DialogTitle = "Browse For Folder"
                Dim root As String = Folders()
                dlg.RootFolder = root
                dlg.InitDir = root & "\Reports"
                dlg.DialogTitle = "Choose the folder for the reports."
                dlg.Flags = IIf(scene = "folder-new", CdlBIFUseNewUI, CdlBIFReturnOnlyFSDirs)
                SetTimer 0, 0, 100, AddressOf KeepDialog
                dlg.ShowFolderBrowser
            Case "find", "replace"
                DialogTitle = IIf(scene = "find", "Find", "Replace")
                dlg.FindWhat = "total"
                dlg.ReplaceWith = "sum"
                dlg.Flags = CdlFRDown Or CdlFRMatchCase
                If scene = "find" Then dlg.ShowFind Else dlg.ShowReplace
                Do
                    KeepDialog 0, 0, 0, 0
                    DoEvents
                    Sleep 50
                Loop
            Case Else
                Err.Raise 5, , "no scene " & scene
        End Select
    End Sub

    ' A folder of the fixture's own, Projects, with three folders in it, in the folder of the
    ' signals: the root of the Folder Browser's tree.
    Private Function Folders() As String
        Dim root As String = Signals() & "\Projects"
        If Len(Dir$(root, vbDirectory)) = 0 Then MkDir root
        Dim name As Variant
        For Each name In Array("Invoices", "Reports", "Templates")
            If Len(Dir$(root & "\" & name, vbDirectory)) = 0 Then MkDir root & "\" & name
        Next
        Return root
    End Function

    ' The dialog drawn as the active window whenever it is not the foreground window, and, once,
    ' put in the state a dialog opened by a mouse user has: no focus rectangle and no underlined
    ' access keys (test/shots/vb does the same).
    Private Sub KeepDialog(ByVal hWnd As LongPtr, ByVal Msg As Long, ByVal Id As LongPtr, ByVal Time As Long)
        Dim box As LongPtr = FindWindowW(StrPtr("#32770"), StrPtr(DialogTitle))
        If box = 0 Then Exit Sub
        If Not DialogKept Then
            ' The Font dialog's list scrolled to start at a font that comes with Windows, so that
            ' its rows show the fonts beside Microsoft Sans Serif and none that a person installed.
            If DialogTitle = "Font" Then
                Dim names As LongPtr = GetDlgItem(box, FONT_NAMES)
                Dim first As LongPtr = SendMessageW(names, CB_FINDSTRINGEXACT, -1, StrPtr("Microsoft Himalaya"))
                If first >= 0 Then SendMessageW names, CB_SETTOPINDEX, first, 0
            End If
            SendMessageW box, WM_CHANGEUISTATE, UIS_SET Or (UISF_HIDEFOCUS Or UISF_HIDEACCEL) * &H10000, 0
            RedrawWindow box, 0, 0, RDW_INVALIDATE Or RDW_ERASE Or RDW_FRAME Or RDW_ALLCHILDREN Or RDW_UPDATENOW
            DialogKept = True
            Signal "shown"
        End If
        SteadyTree box
        If GetForegroundWindow() <> box Then SendMessageW box, WM_NCACTIVATE, 1, 0
    End Sub

    ' The new-style Folder Browser's tree fades its expand buttons in and out with the focus and
    ' the mouse, so that a capture shows them or not: the fading is switched off, and the button
    ' of the expanded root always shows. The tree is inside the dialog's namespace control.
    Private Sub SteadyTree(ByVal box As LongPtr)
        Dim host As LongPtr = FindWindowExW(box, 0, StrPtr("SHBrowseForFolder ShellNameSpace Control"), 0)
        If host = 0 Then Exit Sub
        Dim tree As LongPtr = FindWindowExW(host, 0, StrPtr("SysTreeView32"), 0)
        If tree <> 0 Then SendMessageW tree, TVM_SETEXTENDEDSTYLE, TVS_EX_FADEINOUTEXPANDOS, 0
    End Sub

    ' ---------------------------------------------------------------- AutoComplete

    ' frmAuto, its text box served by an AutoComplete with a list of its own and the scene's
    ' option, and "Ap" typed into it as the keyboard types it.
    Private Sub AutoCompleteScene(ByVal scene As String)
        Dim f As Form = frmAuto
        Load f
        Set AC = New AutoComplete
        AC.CustomSource = Array("Apple", "Apricot", "Avocado", "Banana", "Blackberry", "Blueberry", "Cherry")
        AC.Init f.Controls("Text1").hWnd, AutoCompleteSourceCustomSource
        Dim l As Label = f.Controls("Label1")
        Select Case scene
            Case "suggest"
                AC.Options = AutoCompleteOptionSuggest
                l.Caption = "Options = AutoCompleteOptionSuggest"
            Case "append"
                AC.Options = AutoCompleteOptionAppend
                l.Caption = "Options = AutoCompleteOptionAppend"
            Case "suggestappend"
                AC.Options = AutoCompleteOptionSuggestAppend
                l.Caption = "Options = AutoCompleteOptionSuggestAppend"
        End Select
        f.Show
        Activate f
        DoEvents
        TypeText scene, f
        Signal "shown"
        If WaitFor("end", scene, f) Then Unload f
    End Sub

    ' The text box emptied, given the focus and sent TYPED a character at a time, then the
    ' messages dispatched until the completion has shown.
    Private Sub TypeText(ByVal scene As String, ByVal f As Form)
        Dim t As TextBox = f.Controls("Text1")
        t.Text = ""
        t.SetFocus
        DoEvents
        Dim i As Long
        For i = 1 To Len(TYPED)
            SendMessageW t.hWnd, WM_CHAR, AscW(Mid$(TYPED, i, 1)), 1
            DoEvents
        Next
        Dim n As Long
        For n = 1 To 20
            DoEvents
            Sleep 25
        Next
        HideCaret t.hWnd
    End Sub

    ' The suggestion list closes when the text box loses the focus, which the tool's making the
    ' form active can do: the text is typed again whenever the list should show and does not.
    Private Sub KeepTyping(ByVal scene As String, ByVal f As Form)
        If scene = "append" Then Exit Sub
        Dim list As LongPtr = FindWindowW(StrPtr("Auto-Suggest Dropdown"), 0)
        If list = 0 Then
            TypeText scene, f
        ElseIf IsWindowVisible(list) = 0 Then
            TypeText scene, f
        End If
    End Sub

    ' ---------------------------------------------------------------- taking turns with the tool

    ' Makes the form the active window, as it is when a person starts the program. On the
    ' tool's private desktop, which has no input, the foreground is not dependable, so while
    ' the form waits it draws its frame as the active window's whenever it is not the
    ' foreground window (test/shots/programs does the same).
    Private Sub Activate(ByVal f As Form)
        SetForegroundWindow f.hWnd
        DoEvents
        KeepActive f
    End Sub

    Private Sub KeepActive(ByVal f As Form)
        If GetForegroundWindow() <> f.hWnd Then SendMessageW f.hWnd, WM_NCACTIVATE, 1, 0
    End Sub

    ' The folder of the signals, or "" when no tool runs the program.
    Private Function Signals() As String
        Return Environ$("TB_SHOT_SIGNALS")
    End Function

    Private Sub Signal(ByVal Name As String, Optional ByVal Text As String)
        If Len(Signals()) = 0 Then Exit Sub
        Dim n As Integer = FreeFile
        Open Signals() & "\" & Name For Output As #n
        If Len(Text) Then Print #n, Text
        Close #n
    End Sub

    ' Waits until the signal is there (True), or until the form is closed (False), keeping the
    ' form active and its completion shown.
    Private Function WaitFor(ByVal Name As String, ByVal scene As String, ByVal f As Form) As Boolean
        Do
            If Len(Signals()) Then
                If Len(Dir$(Signals() & "\" & Name)) Then Return True
            End If
            If Not IsLoaded(f) Then Return False
            KeepActive f
            KeepTyping scene, f
            ' a blinking caret would show or not in the capture
            HideCaret f.Controls("Text1").hWnd
            DoEvents
            Sleep 50
        Loop
    End Function

    Private Function IsLoaded(ByVal f As Form) As Boolean
        Dim g As Form
        For Each g In Forms
            If g Is f Then Return True
        Next
        Return False
    End Function

End Module
