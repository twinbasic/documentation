' TBMANLIB_Aes, cAes: the output of each cipher mode against the published test vectors.
'
' Every case uses NoPadding, so the output is the vector and nothing else, and the keys of
' NIST SP 800-38A Appendix F as they are. CFB here is CFB128, the CFB of SP 800-38A F.3.13 to
' F.3.18 and of OpenSSL's aes-N-cfb. The sources of the vectors are in AesVec.
[TestFixture]
Module StandardVectorTests

    ' ---- FIPS 197, Appendix C: one block, the mode ECB

    [TestCase]
    Public Sub EncryptBytes_Ecb_Aes128_GivesTheBlockOfFips197C1()
        Expect.Begin
        AesVec.EncryptAndCheck "AES-128 (FIPS 197 C.1)", AesCipherMode.ECB, 128, "000102030405060708090a0b0c0d0e0f", "", "00112233445566778899aabbccddeeff", "69c4e0d86a7b0430d8cdb78070b4c55a"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Ecb_Aes192_GivesTheBlockOfFips197C2()
        Expect.Begin
        AesVec.EncryptAndCheck "AES-192 (FIPS 197 C.2)", AesCipherMode.ECB, 192, "000102030405060708090a0b0c0d0e0f1011121314151617", "", "00112233445566778899aabbccddeeff", "dda97ca4864cdfe06eaf70a0ec0d7191"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Ecb_Aes256_GivesTheBlockOfFips197C3()
        Expect.Begin
        AesVec.EncryptAndCheck "AES-256 (FIPS 197 C.3)", AesCipherMode.ECB, 256, "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "", "00112233445566778899aabbccddeeff", "8ea2b7ca516745bfeafc49904b496089"
        Expect.Done
    End Sub

    ' ---- NIST SP 800-38A F.1: ECB

    [TestCase]
    Public Sub EncryptBytes_Ecb_Aes128_GivesTheVectorOfSp80038aF11()
        Expect.Begin
        AesVec.EncryptAndCheck "ECB-AES128.Encrypt (F.1.1)", AesCipherMode.ECB, 128, AesVec.Key128, "", AesVec.Plain4, "3ad77bb40d7a3660a89ecaf32466ef97f5d3d58503b9699de785895a96fdbaaf43b1cd7f598ece23881b00e3ed0306887b0c785e27e8ad3f8223207104725dd4"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Ecb_Aes192_GivesTheVectorOfSp80038aF13()
        Expect.Begin
        AesVec.EncryptAndCheck "ECB-AES192.Encrypt (F.1.3)", AesCipherMode.ECB, 192, AesVec.Key192, "", AesVec.Plain4, "bd334f1d6e45f25ff712a214571fa5cc974104846d0ad3ad7734ecb3ecee4eefef7afd2270e2e60adce0ba2face6444e9a4b41ba738d6c72fb16691603c18e0e"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Ecb_Aes256_GivesTheVectorOfSp80038aF15()
        Expect.Begin
        AesVec.EncryptAndCheck "ECB-AES256.Encrypt (F.1.5)", AesCipherMode.ECB, 256, AesVec.Key256, "", AesVec.Plain4, "f3eed1bdb5d2a03c064b5a7e3db181f8591ccb10d410ed26dc5ba74a31362870b6ed21b99ca6f4f9f153e7b1beafed1d23304b7a39f9f3ff067d8d8f9e24ecc7"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub DecryptBytes_Ecb_Aes128_GivesThePlaintextOfSp80038aF12()
        Expect.Begin
        AesVec.DecryptAndCheck "ECB-AES128.Decrypt (F.1.2)", AesCipherMode.ECB, 128, AesVec.Key128, "", "3ad77bb40d7a3660a89ecaf32466ef97f5d3d58503b9699de785895a96fdbaaf43b1cd7f598ece23881b00e3ed0306887b0c785e27e8ad3f8223207104725dd4", AesVec.Plain4
        Expect.Done
    End Sub

    ' ---- NIST SP 800-38A F.2: CBC, IV 000102...0f

    [TestCase]
    Public Sub EncryptBytes_Cbc_Aes128_GivesTheVectorOfSp80038aF21()
        Expect.Begin
        AesVec.EncryptAndCheck "CBC-AES128.Encrypt (F.2.1)", AesCipherMode.CBC, 128, AesVec.Key128, AesVec.Iv16, AesVec.Plain4, "7649abac8119b246cee98e9b12e9197d5086cb9b507219ee95db113a917678b273bed6b8e3c1743b7116e69e222295163ff1caa1681fac09120eca307586e1a7"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Cbc_Aes192_GivesTheVectorOfSp80038aF23()
        Expect.Begin
        AesVec.EncryptAndCheck "CBC-AES192.Encrypt (F.2.3)", AesCipherMode.CBC, 192, AesVec.Key192, AesVec.Iv16, AesVec.Plain4, "4f021db243bc633d7178183a9fa071e8b4d9ada9ad7dedf4e5e738763f69145a571b242012fb7ae07fa9baac3df102e008b0e27988598881d920a9e64f5615cd"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Cbc_Aes256_GivesTheVectorOfSp80038aF25()
        Expect.Begin
        AesVec.EncryptAndCheck "CBC-AES256.Encrypt (F.2.5)", AesCipherMode.CBC, 256, AesVec.Key256, AesVec.Iv16, AesVec.Plain4, "f58c4c04d6e5f1ba779eabfb5f7bfbd69cfc4e967edb808d679f777bc6702c7d39f23369a9d9bacfa530e26304231461b2eb05e2c39be9fcda6c19078c6a9d1b"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub DecryptBytes_Cbc_Aes128_GivesThePlaintextOfSp80038aF22()
        Expect.Begin
        AesVec.DecryptAndCheck "CBC-AES128.Decrypt (F.2.2)", AesCipherMode.CBC, 128, AesVec.Key128, AesVec.Iv16, "7649abac8119b246cee98e9b12e9197d5086cb9b507219ee95db113a917678b273bed6b8e3c1743b7116e69e222295163ff1caa1681fac09120eca307586e1a7", AesVec.Plain4
        Expect.Done
    End Sub

    ' ---- NIST SP 800-38A F.3: CFB128

    [TestCase]
    Public Sub EncryptBytes_Cfb_Aes128_GivesTheVectorOfSp80038aF313()
        Expect.Begin
        AesVec.EncryptAndCheck "CFB128-AES128.Encrypt (F.3.13)", AesCipherMode.CFB, 128, AesVec.Key128, AesVec.Iv16, AesVec.Plain4, "3b3fd92eb72dad20333449f8e83cfb4ac8a64537a0b3a93fcde3cdad9f1ce58b26751f67a3cbb140b1808cf187a4f4dfc04b05357c5d1c0eeac4c66f9ff7f2e6"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Cfb_Aes192_GivesTheVectorOfSp80038aF315()
        Expect.Begin
        AesVec.EncryptAndCheck "CFB128-AES192.Encrypt (F.3.15)", AesCipherMode.CFB, 192, AesVec.Key192, AesVec.Iv16, AesVec.Plain4, "cdc80d6fddf18cab34c25909c99a417467ce7f7f81173621961a2b70171d3d7a2e1e8a1dd59b88b1c8e60fed1efac4c9c05f9f9ca9834fa042ae8fba584b09ff"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Cfb_Aes256_GivesTheVectorOfSp80038aF317()
        Expect.Begin
        AesVec.EncryptAndCheck "CFB128-AES256.Encrypt (F.3.17)", AesCipherMode.CFB, 256, AesVec.Key256, AesVec.Iv16, AesVec.Plain4, "dc7e84bfda79164b7ecd8486985d386039ffed143b28b1c832113c6331e5407bdf10132415e54b92a13ed0a8267ae2f975a385741ab9cef82031623d55b1e471"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub DecryptBytes_Cfb_Aes128_GivesThePlaintextOfSp80038aF314()
        Expect.Begin
        AesVec.DecryptAndCheck "CFB128-AES128.Decrypt (F.3.14)", AesCipherMode.CFB, 128, AesVec.Key128, AesVec.Iv16, "3b3fd92eb72dad20333449f8e83cfb4ac8a64537a0b3a93fcde3cdad9f1ce58b26751f67a3cbb140b1808cf187a4f4dfc04b05357c5d1c0eeac4c66f9ff7f2e6", AesVec.Plain4
        Expect.Done
    End Sub

    ' ---- NIST SP 800-38A F.4: OFB

    [TestCase]
    Public Sub EncryptBytes_Ofb_Aes128_GivesTheVectorOfSp80038aF41()
        Expect.Begin
        AesVec.EncryptAndCheck "OFB-AES128.Encrypt (F.4.1)", AesCipherMode.OFB, 128, AesVec.Key128, AesVec.Iv16, AesVec.Plain4, "3b3fd92eb72dad20333449f8e83cfb4a7789508d16918f03f53c52dac54ed8259740051e9c5fecf64344f7a82260edcc304c6528f659c77866a510d9c1d6ae5e"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Ofb_Aes192_GivesTheVectorOfSp80038aF43()
        Expect.Begin
        AesVec.EncryptAndCheck "OFB-AES192.Encrypt (F.4.3)", AesCipherMode.OFB, 192, AesVec.Key192, AesVec.Iv16, AesVec.Plain4, "cdc80d6fddf18cab34c25909c99a4174fcc28b8d4c63837c09e81700c11004018d9a9aeac0f6596f559c6d4daf59a5f26d9f200857ca6c3e9cac524bd9acc92a"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Ofb_Aes256_GivesTheVectorOfSp80038aF45()
        Expect.Begin
        AesVec.EncryptAndCheck "OFB-AES256.Encrypt (F.4.5)", AesCipherMode.OFB, 256, AesVec.Key256, AesVec.Iv16, AesVec.Plain4, "dc7e84bfda79164b7ecd8486985d38604febdc6740d20b3ac88f6ad82a4fb08d71ab47a086e86eedf39d1c5bba97c4080126141d67f37be8538f5a8be740e484"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub DecryptBytes_Ofb_Aes128_GivesThePlaintextOfSp80038aF42()
        Expect.Begin
        AesVec.DecryptAndCheck "OFB-AES128.Decrypt (F.4.2)", AesCipherMode.OFB, 128, AesVec.Key128, AesVec.Iv16, "3b3fd92eb72dad20333449f8e83cfb4a7789508d16918f03f53c52dac54ed8259740051e9c5fecf64344f7a82260edcc304c6528f659c77866a510d9c1d6ae5e", AesVec.Plain4
        Expect.Done
    End Sub

    ' ---- NIST SP 800-38A F.5: CTR, initial counter block f0f1...ff

    [TestCase]
    Public Sub EncryptBytes_Ctr_Aes128_GivesTheVectorOfSp80038aF51()
        Expect.Begin
        AesVec.EncryptAndCheck "CTR-AES128.Encrypt (F.5.1)", AesCipherMode.CTR, 128, AesVec.Key128, AesVec.CtrIv, AesVec.Plain4, "874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff5ae4df3edbd5d35e5b4f09020db03eab1e031dda2fbe03d1792170a0f3009cee"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Ctr_Aes192_GivesTheVectorOfSp80038aF53()
        Expect.Begin
        AesVec.EncryptAndCheck "CTR-AES192.Encrypt (F.5.3)", AesCipherMode.CTR, 192, AesVec.Key192, AesVec.CtrIv, AesVec.Plain4, "1abc932417521ca24f2b0459fe7e6e0b090339ec0aa6faefd5ccc2c6f4ce8e941e36b26bd1ebc670d1bd1d665620abf74f78a7f6d29809585a97daec58c6b050"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EncryptBytes_Ctr_Aes256_GivesTheVectorOfSp80038aF55()
        Expect.Begin
        AesVec.EncryptAndCheck "CTR-AES256.Encrypt (F.5.5)", AesCipherMode.CTR, 256, AesVec.Key256, AesVec.CtrIv, AesVec.Plain4, "601ec313775789a5b7a7f504bbf3d228f443e3ca4d62b59aca84e990cacaf5c52b0930daa23de94ce87017ba2d84988ddfc9c58db67aada613c2dd08457941a6"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub DecryptBytes_Ctr_Aes128_GivesThePlaintextOfSp80038aF52()
        Expect.Begin
        AesVec.DecryptAndCheck "CTR-AES128.Decrypt (F.5.2)", AesCipherMode.CTR, 128, AesVec.Key128, AesVec.CtrIv, "874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff5ae4df3edbd5d35e5b4f09020db03eab1e031dda2fbe03d1792170a0f3009cee", AesVec.Plain4
        Expect.Done
    End Sub

End Module
