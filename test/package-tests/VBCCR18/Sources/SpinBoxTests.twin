    Public Sub NumberStyle_OutOfRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.SpinBox1.NumberStyle = 2
        Expect.AreEqual 380, Err.Number, "NumberStyle = 2"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub TextAlignment_OutOfRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.SpinBox1.TextAlignment = 3
        Expect.AreEqual 380, Err.Number, "TextAlignment = 3"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelLength_Negative_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.SpinBox1.SelLength = -1
        Expect.AreEqual 380, Err.Number, "SelLength = -1"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelStart_Negative_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.SpinBox1.SelStart = -1
        Expect.AreEqual 380, Err.Number, "SelStart = -1"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelText_Assigned_ReplacesTheSelection()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.SpinBox1.Value = 12
        f.SpinBox1.SelStart = 1
        f.SpinBox1.SelLength = 1
        Expect.AreEqual "2", f.SpinBox1.SelText, "SelText"
        f.SpinBox1.SelText = "9"
        Expect.AreEqual "19", f.SpinBox1.Text, "Text after SelText = ""9"""
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SetAcceleration_BadArrays_RaiseErrors()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim e() As Long
        On Error Resume Next
        Err.Clear
        f.SpinBox1.SetAcceleration Array(1, 2), Array(5)
        Expect.AreEqual 5, Err.Number, "SetAcceleration of arrays with other bounds"
        Err.Clear
        f.SpinBox1.SetAcceleration 5, Array(5)
        Expect.AreEqual 380, Err.Number, "SetAcceleration of a number"
        Err.Clear
        f.SpinBox1.SetAcceleration e, Array(5)
        Expect.AreEqual 91, Err.Number, "SetAcceleration of an array that is not allocated"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SetAcceleration_Empty_RestoresIncrement()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.SpinBox1
            .Increment = 3
            .SetAcceleration Array(0, 2), Array(1, 10)
            Expect.AreEqual 1, .Increment, "Increment with a list set"
            .SetAcceleration Empty, Empty
            Expect.AreEqual 3, .Increment, "Increment after two Empty"
        End With
        Unload f
        Expect.Done
    End Sub

End Module

' The events of a SpinBox, written to Rig.Log. With CancelClicks the handler of BeforeChange sets Delta to 0.
Class SpinBoxSink

    Public WithEvents Ctl As VBCCR18.SpinBox
    Public CancelClicks As Boolean

    Private Sub Ctl_Change() Handles Ctl.Change
        Rig.Ev "Change " & Ctl.Value
    End Sub

    Private Sub Ctl_TextChange() Handles Ctl.TextChange
        Rig.Ev "TextChange [" & Ctl.Text & "]"
    End Sub

    Private Sub Ctl_BeforeChange(ByVal Value As Long, Delta As Long) Handles Ctl.BeforeChange
        Rig.Ev "BeforeChange " & Value & " " & Delta
        If CancelClicks Then Delta = 0
    End Sub

    Private Sub Ctl_UpClick() Handles Ctl.UpClick
        Rig.Ev "UpClick"
    End Sub

    Private Sub Ctl_DownClick() Handles Ctl.DownClick
        Rig.Ev "DownClick"
    End Sub

End Class
