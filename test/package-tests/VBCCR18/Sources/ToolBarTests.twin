    [TestCase]
    Public Sub Button_Visible_False_MovesTheLaterButtonsUp()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            Dim leftOfB As Single
            leftOfB = .Buttons("b").Left
            Expect.IsTrue leftOfB > 0, "Left of the second button"
            .Buttons("a").Visible = False
            Expect.IsFalse .Buttons("a").Visible, "Visible after Visible = False"
            Expect.AreEqual 1, .Buttons("a").Position, "Position of the hidden button"
            Expect.AreEqual 1, .Buttons("a").Index, "Index of the hidden button"
            Expect.AreEqual 0, CLng(.Buttons("b").Left), "Left of the second button after the first is hidden"
            Expect.AreEqual 0, CLng(.Buttons("a").Width), "Width of the hidden button"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Button_CustomWidth_SetsTheWidth()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As TbrButton, b As TbrButton
        Set a = f.ToolBar1.Buttons.Add(, "a", "A")
        Set b = f.ToolBar1.Buttons.Add(, "b", "B")
        a.CustomWidth = 1500
        Expect.IsTrue Abs(a.Width - 1500) < 15, "Width after CustomWidth = 1500"
        Expect.IsTrue Abs(b.Left - a.Width) < 15, "Left of the next button after CustomWidth = 1500"
        a.CustomWidth = 0
        Expect.IsTrue a.Width < 1500, "Width after CustomWidth = 0"
        On Error Resume Next
        Err.Clear
        a.CustomWidth = -1
        Expect.AreEqual 380, Err.Number, "CustomWidth = -1"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Button_AutoSize_WidthFollowsTheCaption()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As TbrButton, b As TbrButton
        Set a = f.ToolBar1.Buttons.Add(, "a", "A")
        Set b = f.ToolBar1.Buttons.Add(, "b", "Bbbbbbbbbbbbbbbbbbbbbbbb")
        Dim standard As Single
        standard = a.Width
        a.AutoSize = True
        b.AutoSize = True
        Expect.IsTrue a.Width < standard, "Width of a short caption with AutoSize"
        Expect.IsTrue b.Width > standard, "Width of a long caption with AutoSize"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Button_Tag_NewButton_IsAnEmptyString()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim b As TbrButton
        Set b = f.ToolBar1.Buttons.Add(, "a", "A")
        Expect.AreEqual "", b.Tag, "Tag of a new button"
        b.Tag = 5
        Expect.AreEqual 5, b.Tag, "Tag after Tag = 5"
        Set b.Tag = f.ProgressBar1
        Expect.AreEqual "ProgressBar", TypeName(b.Tag), "TypeName of Tag after Set Tag = a ProgressBar"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ButtonMenus_Add_AtAnIndex_MovesTheLaterMenus()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim b As TbrButton, m As TbrButtonMenu
        Set b = f.ToolBar1.Buttons.Add(, "d", "D", TbrButtonStyleDropDown)
        Set m = b.ButtonMenus.Add(, "m1", "One")
        Expect.AreEqual "One", m.Text, "Text of a new menu"
        Expect.IsTrue m.Enabled And m.Visible And Not m.Checked And Not m.Separator, "the defaults of a new menu: Enabled, Visible, not Checked, not Separator"
        Expect.IsTrue m.Picture Is Nothing, "Picture of a new menu is Nothing"
        Expect.AreEqual "d", KeyOf(m.Parent), "the key of Parent of the menu"
        b.ButtonMenus.Add 1, "m0", "Zero"
        Expect.AreEqual 2, b.ButtonMenus("m1").Index, "Index of the first menu after another is added at 1"
        b.ButtonMenus.Remove 1
        Expect.AreEqual 1, b.ButtonMenus("m1").Index, "Index of the menu after the one before it is removed"
        Expect.AreEqual 1, b.ButtonMenus.Count, "Count after Remove"
        b.ButtonMenus.Clear
        Expect.AreEqual 0, b.ButtonMenus.Count, "Count after Clear"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ButtonMenus_Add_RefusedArguments_RaiseTheirErrors()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim b As TbrButton
        Set b = f.ToolBar1.Buttons.Add(, "d", "D", TbrButtonStyleDropDown)
        b.ButtonMenus.Add , "m1", "One"
        On Error Resume Next
        Err.Clear
        b.ButtonMenus.Add 7
        Expect.AreEqual 35600, Err.Number, "Add at 7 with one menu"
        Err.Clear
        b.ButtonMenus.Add , "M1", "again"
        Expect.AreEqual 457, Err.Number, "Add with the key of another menu"
        Err.Clear
        Debug.Print b.ButtonMenus("q").Text
        Expect.AreEqual 5, Err.Number, "ButtonMenus(""q"")"
        Err.Clear
        Debug.Print b.ButtonMenus(9).Text
        Expect.AreEqual 9, Err.Number, "ButtonMenus(9)"
        On Error GoTo 0
        Expect.AreEqual 1, b.ButtonMenus.Count, "Count after the refused calls"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ButtonMenu_Key_Assigned_RenamesTheItem()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim b As TbrButton
        Set b = f.ToolBar1.Buttons.Add(, "d", "D", TbrButtonStyleDropDown)
        b.ButtonMenus.Add , "m1", "One"
        b.ButtonMenus.Add , "m2", "Two"
        b.ButtonMenus("m1").Key = "first"
        Expect.IsFalse b.ButtonMenus.Exists("m1"), "Exists of the old key"
        Expect.AreEqual 1, b.ButtonMenus("first").Index, "Index of the item found by the new key"
        On Error Resume Next
        Err.Clear
        b.ButtonMenus("first").Key = "M2"
        Expect.AreEqual 457, Err.Number, "Key = the key of another item"
        On Error GoTo 0
        Expect.AreEqual "first", b.ButtonMenus(1).Key, "Key after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub HitTest_PointOnAButton_ReturnsTheButton()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            Dim b As TbrButton
            Set b = .Buttons("b")
            Expect.AreEqual "b", KeyOf(.HitTest(b.Left + b.Width / 2, b.Top + b.Height / 2)), "the key of the button HitTest returns for the middle of the second button"
            Expect.AreEqual "Nothing", KeyOf(.HitTest(.Width * 20, 5)), "the button HitTest returns for a point far to the right"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindMnemonic_CharacterOfAMnemonicOrOfAFirstLetter_ReturnsTheButton()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "&Open"
            .Buttons.Add , "b", "Save"
            .Buttons.Add , "c", "&Close"
            Expect.AreEqual "c", KeyOf(.FindMnemonic(Asc("C"))), "the button FindMnemonic returns for ""C"""
            Expect.AreEqual "c", KeyOf(.FindMnemonic(Asc("c"))), "the button FindMnemonic returns for ""c"""
            Expect.AreEqual "b", KeyOf(.FindMnemonic(Asc("S"))), "the button FindMnemonic returns for the first letter of a caption without a mnemonic"
            Expect.AreEqual "a", KeyOf(.FindMnemonic(Asc("O"))), "the button FindMnemonic returns for ""O"""
            Expect.AreEqual "Nothing", KeyOf(.FindMnemonic(Asc("Z"))), "the button FindMnemonic returns for a letter no caption has"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub InsertMark_Set_IsReadBackWithItsSide()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            Dim after As Boolean
            Expect.AreEqual "Nothing", KeyOf(.InsertMark), "the button InsertMark returns before one is set"
            Set .InsertMark(True) = .Buttons("b")
            Expect.AreEqual "b", KeyOf(.InsertMark(after)), "the key of InsertMark after it is set after the second button"
            Expect.IsTrue after, "After of InsertMark set after a button"
            Set .InsertMark(False) = .Buttons("b")
            Expect.AreEqual "b", KeyOf(.InsertMark(after)), "the key of InsertMark after it is set before the second button"
            Expect.IsFalse after, "After of InsertMark set before a button"
            Set .InsertMark = Nothing
            Expect.AreEqual "Nothing", KeyOf(.InsertMark), "the button InsertMark returns after it is set to Nothing"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub HitTestInsertMark_HalfOfAButton_GivesTheSide()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            Dim b As TbrButton, after As Boolean
            Set b = .Buttons("b")
            after = True
            Expect.AreEqual "b", KeyOf(.HitTestInsertMark(b.Left + b.Width * 0.1, b.Top + b.Height / 2, after)), "the button for a point in the left half of the second button"
            Expect.IsFalse after, "After for a point in the left half"
            Expect.AreEqual "b", KeyOf(.HitTestInsertMark(b.Left + b.Width * 0.9, b.Top + b.Height / 2, after)), "the button for a point in the right half of the second button"
            Expect.IsTrue after, "After for a point in the right half"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetIdealSize_ReachesTheLastButton()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            Dim w As Single, h As Single
            .GetIdealSize w, h
            Expect.IsTrue Abs(w - (.Buttons("b").Left + .Buttons("b").Width)) < 15, "the width GetIdealSize gives, against the right edge of the last button"
            Expect.IsTrue Abs(h - .Height) < 15, "the height GetIdealSize gives, against Height"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Height_Assigned_FollowsTheButtons()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            Dim h As Single
            h = .Height
            .Height = h * 3
            Expect.IsTrue Abs(.Height - h) < 15, "Height after it is set to three times the height of the buttons"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ButtonClick_AMouseClick_IsRaisedBetweenMouseDownAndMouseUp()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ToolBarSink
        Set sink.Bar = f.ToolBar1
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            Dim p As LongPtr
            p = PointParam(f, .Buttons("b").Left + 40, .Buttons("b").Top + 40)
            Rig.ClearLog
            SendMessageW .hWnd, WM_LBUTTONDOWN, 1, p
            SendMessageW .hWnd, WM_LBUTTONUP, 0, p
        End With
        Expect.AreEqual "MouseDown | ButtonClick b | MouseUp | Click", Rig.Events(), "the events of a click on the second button"
        Set sink.Bar = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ButtonClick_ASeparator_RaisesNoButtonClick()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ToolBarSink
        Set sink.Bar = f.ToolBar1
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "s", "", TbrButtonStyleSeparator
            .Buttons.Add , "b", "B"
            Dim p As LongPtr
            p = PointParam(f, .Buttons("s").Left + .Buttons("s").Width / 2, .Buttons("s").Top + 40)
            Rig.ClearLog
            SendMessageW .hWnd, WM_LBUTTONDOWN, 1, p
            SendMessageW .hWnd, WM_LBUTTONUP, 0, p
        End With
        Expect.AreEqual "MouseDown | MouseUp | Click", Rig.Events(), "the events of a click on a separator"
        Set sink.Bar = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ButtonHotChanged_HotAssigned_RaisesTheNewButtonBeforeTheOldOne()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ToolBarSink
        Set sink.Bar = f.ToolBar1
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            Rig.ClearLog
            .Buttons("a").Hot = True
            .Buttons("b").Hot = True
            Set .HotItem = Nothing
        End With
        Expect.AreEqual "ButtonHotChanged a True | ButtonHotChanged b True | ButtonHotChanged a False | ButtonHotChanged b False", Rig.Events(), "the events of a.Hot = True, b.Hot = True and HotItem = Nothing"
        Set sink.Bar = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ButtonMouseEnter_MouseTrackTrue_RaisedAfterMouseEnterAndBeforeMouseLeave()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ToolBarSink
        Set sink.Bar = f.ToolBar1
        With f.ToolBar1
            .MouseTrack = True
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            Dim pa As LongPtr, pb As LongPtr
            pa = PointParam(f, .Buttons("a").Left + 40, .Buttons("a").Top + 40)
            pb = PointParam(f, .Buttons("b").Left + 40, .Buttons("b").Top + 40)
            Rig.ClearLog
            SendMessageW .hWnd, WM_MOUSEMOVE, 0, pa
            SendMessageW .hWnd, WM_MOUSEMOVE, 0, pb
            SendMessageW .hWnd, WM_MOUSELEAVE, 0, 0
        End With
        Expect.AreEqual "MouseEnter | ButtonMouseEnter a | MouseMove | ButtonMouseLeave a | ButtonMouseEnter b | MouseMove | ButtonMouseLeave b | MouseLeave", Rig.Events(), "the events of a move onto the first button, a move onto the second and the pointer leaving"
        Set sink.Bar = Nothing
        Unload f
        Expect.Done
    End Sub

End Module

' The events of a ToolBar, written to Rig.Log.
Class ToolBarSink

    Public WithEvents Bar As VBCCR18.ToolBar

    Private Sub Bar_ButtonClick(ByVal Button As TbrButton) Handles Bar.ButtonClick
        Rig.Ev "ButtonClick " & Button.Key
    End Sub

    Private Sub Bar_ButtonHotChanged(ByVal Button As TbrButton, ByVal Hot As Boolean) Handles Bar.ButtonHotChanged
        Rig.Ev "ButtonHotChanged " & Button.Key & " " & Hot
    End Sub

    Private Sub Bar_ButtonMouseEnter(ByVal Button As TbrButton) Handles Bar.ButtonMouseEnter
        Rig.Ev "ButtonMouseEnter " & Button.Key
    End Sub

    Private Sub Bar_ButtonMouseLeave(ByVal Button As TbrButton) Handles Bar.ButtonMouseLeave
        Rig.Ev "ButtonMouseLeave " & Button.Key
    End Sub

    Private Sub Bar_Click() Handles Bar.Click
        Rig.Ev "Click"
    End Sub

    Private Sub Bar_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single) Handles Bar.MouseDown
        Rig.Ev "MouseDown"
    End Sub

    Private Sub Bar_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single) Handles Bar.MouseMove
        Rig.Ev "MouseMove"
    End Sub

    Private Sub Bar_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single) Handles Bar.MouseUp
        Rig.Ev "MouseUp"
    End Sub

    Private Sub Bar_MouseEnter() Handles Bar.MouseEnter
        Rig.Ev "MouseEnter"
    End Sub

    Private Sub Bar_MouseLeave() Handles Bar.MouseLeave
        Rig.Ev "MouseLeave"
    End Sub

End Class
