        Set f = Rig.NewForm()
        Dim b As TbrButton
        Set b = f.ToolBar1.Buttons.Add(, "a", "A")
        f.ToolBar1.TextAlignment = TbrTextAlignRight
        b.Enabled = False
        Expect.IsFalse f.ToolBar1.Buttons("a").Enabled, "Enabled of the button after a variable that held it before TextAlignment changed is set to False"
        Expect.AreEqual 1, b.Position, "Position of the button the variable held, after TextAlignment changed"
        Unload f
        Expect.Done
    End Sub

