        Dim b As TbrButton
        Set b = f.ToolBar1.Buttons.Add(, "a", "A", , "red")
        Expect.AreEqual 1, b.ImageIndex, "ImageIndex of a button given the key ""red"""
        Unload f
        Expect.Done
    End Sub

