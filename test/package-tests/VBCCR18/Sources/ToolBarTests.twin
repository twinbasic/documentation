' ToolBarTests: the ToolBar control, its TbrButtons collection, its TbrButton items and their
' TbrButtonMenus. A mouse click is made by sending the window messages a click makes to the
' control's window, since the form is never shown. A picture is a bitmap of one color made here.
[TestFixture]
Module ToolBarTests

    Private Type PictDesc
        Size As Long
        Kind As Long
        Handle As LongPtr
        Palette As LongPtr
    End Type

    Private Type PictGuid
        Data1 As Long
        Data2 As Integer
        Data3 As Integer
        Data4(0 To 7) As Byte
    End Type

    Private Declare PtrSafe Function GetDC Lib "user32" (ByVal hWnd As LongPtr) As LongPtr
    Private Declare PtrSafe Function ReleaseDC Lib "user32" (ByVal hWnd As LongPtr, ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function CreateCompatibleDC Lib "gdi32" (ByVal hDC As LongPtr) As LongPtr
    Private Declare PtrSafe Function CreateCompatibleBitmap Lib "gdi32" (ByVal hDC As LongPtr, ByVal W As Long, ByVal H As Long) As LongPtr
    Private Declare PtrSafe Function SelectObject Lib "gdi32" (ByVal hDC As LongPtr, ByVal hObject As LongPtr) As LongPtr
    Private Declare PtrSafe Function CreateSolidBrush Lib "gdi32" (ByVal Color As Long) As LongPtr
    Private Declare PtrSafe Function PatBlt Lib "gdi32" (ByVal hDC As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal W As Long, ByVal H As Long, ByVal Rop As Long) As Long
    Private Declare PtrSafe Function DeleteObject Lib "gdi32" (ByVal hObject As LongPtr) As Long
    Private Declare PtrSafe Function DeleteDC Lib "gdi32" (ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function OleCreatePictureIndirect Lib "oleaut32" (ByRef Desc As PictDesc, ByRef IID As PictGuid, ByVal Own As Long, ByRef Pic As IPictureDisp) As Long
    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal Msg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr

    Private Declare PtrSafe Function ImageList_Create Lib "comctl32" (ByVal cx As Long, ByVal cy As Long, ByVal Flags As Long, ByVal cInitial As Long, ByVal cGrow As Long) As LongPtr
    Private Declare PtrSafe Function ImageList_Destroy Lib "comctl32" (ByVal hImageList As LongPtr) As Long

    Private Const PATCOPY As Long = &HF00021
    Private Const ILC_COLOR32 As Long = &H20
    Private Const TB_BUTTONCOUNT As Long = &H418
    Private Const WM_MOUSEMOVE As Long = &H200
    Private Const WM_LBUTTONDOWN As Long = &H201
    Private Const WM_LBUTTONUP As Long = &H202
    Private Const WM_MOUSELEAVE As Long = &H2A3

    ' A bitmap of one color.
    Private Function ColorSquare(ByVal Color As Long, Optional ByVal Width As Long = 16, Optional ByVal Height As Long = 16) As StdPicture
        Dim screenDC As LongPtr, memDC As LongPtr, bmp As LongPtr, brush As LongPtr, oldBmp As LongPtr, oldBrush As LongPtr
        screenDC = GetDC(0)
        memDC = CreateCompatibleDC(screenDC)
        bmp = CreateCompatibleBitmap(screenDC, Width, Height)
        brush = CreateSolidBrush(Color)
        oldBmp = SelectObject(memDC, bmp)
        oldBrush = SelectObject(memDC, brush)
        PatBlt memDC, 0, 0, Width, Height, PATCOPY
        SelectObject memDC, oldBrush
        SelectObject memDC, oldBmp
        DeleteObject brush
        DeleteDC memDC
        ReleaseDC 0, screenDC
        Dim desc As PictDesc, iid As PictGuid, pic As IPictureDisp
        desc.Size = LenB(desc)
        desc.Kind = 1
        desc.Handle = bmp
        ' IID_IPictureDisp, {7BF80981-BF32-101A-8BBB-00AA00300CAB}
        iid.Data1 = &H7BF80981
        iid.Data2 = &HBF32
        iid.Data3 = &H101A
        iid.Data4(0) = &H8B
        iid.Data4(1) = &HBB
        iid.Data4(3) = &HAA
        iid.Data4(5) = &H30
        iid.Data4(6) = &HC
        iid.Data4(7) = &HAB
        OleCreatePictureIndirect desc, iid, 1, pic
        Set ColorSquare = pic
    End Function

    ' The keys of the buttons, in the order of the collection, as one string.
    Private Function Keys(ByVal Bar As VBCCR18.ToolBar) As String
        Dim i As Long
        For i = 1 To Bar.Buttons.Count
            Keys = Keys & Bar.Buttons(i).Key
        Next
    End Function

    ' The keys of the buttons, in the order the toolbar shows them.
    Private Function KeysByPosition(ByVal Bar As VBCCR18.ToolBar) As String
        Dim i As Long, j As Long
        For i = 1 To Bar.Buttons.Count
            For j = 1 To Bar.Buttons.Count
                If Bar.Buttons(j).Position = i Then KeysByPosition = KeysByPosition & Bar.Buttons(j).Key
            Next
        Next
    End Function

    ' The key of a button, or "Nothing", so that a wrong answer fails the case instead of raising.
    Private Function KeyOf(ByVal Button As TbrButton) As String
        If Button Is Nothing Then KeyOf = "Nothing" Else KeyOf = Button.Key
    End Function

    ' The pixel position of a point of the form, as the low and high words of a message's lParam.
    Private Function PointParam(ByVal f As HostForm, ByVal X As Single, ByVal Y As Single) As LongPtr
        Dim px As Long, py As Long
        px = CLng(f.ScaleX(X, f.ScaleMode, vbPixels))
        py = CLng(f.ScaleY(Y, f.ScaleMode, vbPixels))
        PointParam = CLngPtr((py * &H10000) Or px)
    End Function

    [TestCase]
    Public Sub Buttons_Add_AtAnIndex_MovesTheLaterButtons()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            .Buttons.Add 1, "c", "C"
            Expect.AreEqual "cab", Keys(f.ToolBar1), "the keys of the buttons after Add at 1"
            Expect.AreEqual "cab", KeysByPosition(f.ToolBar1), "the keys of the buttons in the order the toolbar shows them after Add at 1"
            Expect.AreEqual 2, .Buttons("a").Index, "Index of the first button added after Add at 1"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Buttons_Add_IndexOutOfRange_Raises35600()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ToolBar1.Buttons.Add , "a", "A"
        On Error Resume Next
        Err.Clear
        f.ToolBar1.Buttons.Add 3
        Expect.AreEqual 35600, Err.Number, "Add at 3 with one button"
        Err.Clear
        f.ToolBar1.Buttons.Add -1
        Expect.AreEqual 35600, Err.Number, "Add at -1"
        On Error GoTo 0
        Expect.AreEqual 1, f.ToolBar1.Buttons.Count, "Count after the refused calls"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Buttons_Add_StyleOutOfRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ToolBar1.Buttons.Add , "a", "A", 9
        Expect.AreEqual 380, Err.Number, "Add with the style 9"
        On Error GoTo 0
        Expect.AreEqual 0, f.ToolBar1.Buttons.Count, "Count after the refused Add"
        Expect.AreEqual 0, CLng(SendMessageW(f.ToolBar1.hWnd, TB_BUTTONCOUNT, 0, 0)), "the buttons the window has after the refused Add"
        Unload f
        Expect.Done
    End Sub

