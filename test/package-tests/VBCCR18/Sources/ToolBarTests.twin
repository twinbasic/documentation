    [TestCase]
    Public Sub ImageList_ListOfAnotherSize_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , "red", ColorSquare(vbRed, 16, 16)
        Set f.ToolBar1.ImageList = f.ImageList1
