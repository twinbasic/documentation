    [TestCase]
    Public Sub Button_Value_CheckGroup_UnpressesTheOthers()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "A", TbrButtonStyleCheckGroup
            .Buttons.Add , "b", "B", TbrButtonStyleCheckGroup
            .Buttons.Add , "c", "C", TbrButtonStyleCheck
            .Buttons("a").Value = TbrButtonValuePressed
            .Buttons("b").Value = TbrButtonValuePressed
            .Buttons("c").Value = TbrButtonValuePressed
            Expect.AreEqual CLng(TbrButtonValueUnpressed), CLng(.Buttons("a").Value), "Value of the first group button after the second is pressed"
            Expect.AreEqual CLng(TbrButtonValuePressed), CLng(.Buttons("b").Value), "Value of the second group button"
            Expect.AreEqual CLng(TbrButtonValuePressed), CLng(.Buttons("c").Value), "Value of the check button"
            .Buttons("c").Value = TbrButtonValueUnpressed
            Expect.AreEqual CLng(TbrButtonValuePressed), CLng(.Buttons("b").Value), "Value of the group button after the check button is unpressed"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Button_Style_Assigned_ChangesTheStyleAndKeepsTheCaption()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim b As TbrButton
        Set b = f.ToolBar1.Buttons.Add(, "a", "Alpha", TbrButtonStyleCheck)
        b.Value = TbrButtonValuePressed
        b.Style = TbrButtonStyleDropDown
        Expect.AreEqual CLng(TbrButtonStyleDropDown), CLng(b.Style), "Style after Style = TbrButtonStyleDropDown"
        Expect.AreEqual "Alpha", b.Caption, "Caption after the style changes"
        Expect.AreEqual CLng(TbrButtonValueUnpressed), CLng(b.Value), "Value after the style of a pressed button changes"
        On Error Resume Next
        Err.Clear
        b.Style = 9
        Expect.AreEqual 380, Err.Number, "Style = 9"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Button_Image_FromTheImageList_ByKeyAndNumber()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , "red", ColorSquare(vbRed)
        f.ImageList1.ListImages.Add , "green", ColorSquare(vbGreen)
        Set f.ToolBar1.ImageList = f.ImageList1
        Dim b As TbrButton
        Set b = f.ToolBar1.Buttons.Add(, "a", "A", , "green")
        Expect.AreEqual 2, b.ImageIndex, "ImageIndex of a button given the key ""green"""
        Expect.AreEqual "green", CStr(b.Image), "Image of that button"
        b.Image = 1
        Expect.AreEqual 1, b.ImageIndex, "ImageIndex after Image = 1"
        On Error Resume Next
        Err.Clear
        b.Image = "nope"
        Expect.AreEqual 35601, Err.Number, "Image = a key the list does not have"
        Err.Clear
        b.Image = -2
        Expect.AreEqual 35600, Err.Number, "Image = -2"
        On Error GoTo 0
        Expect.AreEqual 1, b.ImageIndex, "ImageIndex after the refused assignments"
        Unload f
        Expect.Done
    End Sub

