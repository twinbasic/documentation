    Public Sub Buttons_Add_DuplicateKey_AddsNothingToTheWindow()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ToolBar1.Buttons.Add , "a", "A"
        On Error Resume Next
        f.ToolBar1.Buttons.Add , "a", "again"
        On Error GoTo 0
        Expect.AreEqual 1, CLng(SendMessageW(f.ToolBar1.hWnd, TB_BUTTONCOUNT, 0, 0)), "the buttons the window of the toolbar has after the refused Add"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Buttons_Item_NumberOutOfRange_Raises9()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ToolBar1.Buttons.Add , "a", "A"
        On Error Resume Next
        Err.Clear
        Debug.Print KeyOf(f.ToolBar1.Buttons(2))
        Expect.AreEqual 9, Err.Number, "Buttons(2) with one button"
        Err.Clear
        Debug.Print KeyOf(f.ToolBar1.Buttons(0))
        Expect.AreEqual 9, Err.Number, "Buttons(0)"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Buttons_Item_UnknownKey_Raises5()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ToolBar1.Buttons.Add , "a", "A"
        On Error Resume Next
        Err.Clear
        Debug.Print KeyOf(f.ToolBar1.Buttons("zz"))
        Expect.AreEqual 5, Err.Number, "Buttons(""zz"")"
        On Error GoTo 0
        Expect.AreEqual "a", KeyOf(f.ToolBar1.Buttons("A")), "the key of Buttons(""A"") for the key ""a"""
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Buttons_Exists_SaysWhetherTheListHasTheNumberOrKey()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ToolBar1.Buttons.Add , "a", "A"
        Expect.IsTrue f.ToolBar1.Buttons.Exists("a"), "Exists of a key the list has"
        Expect.IsTrue f.ToolBar1.Buttons.Exists(1), "Exists(1) with one button"
        Expect.IsFalse f.ToolBar1.Buttons.Exists("zz"), "Exists of a key the list does not have"
        Expect.IsFalse f.ToolBar1.Buttons.Exists(2), "Exists(2) with one button"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Buttons_Remove_RenumbersTheLaterButtons()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            Dim removed As TbrButton
            Set removed = .Buttons.Add(, "a", "A")
            .Buttons.Add , "b", "B"
            .Buttons.Add , "c", "C"
            .Buttons.Remove "a"
            Expect.AreEqual 0, removed.Position, "Position of the button that was removed"
            Expect.AreEqual 2, .Buttons.Count, "Count after Remove"
            Expect.AreEqual 1, .Buttons("b").Index, "Index of the second button after the first is removed"
            Expect.AreEqual 2, .Buttons("c").Index, "Index of the third button after the first is removed"
            Expect.AreEqual 2, CLng(SendMessageW(.hWnd, TB_BUTTONCOUNT, 0, 0)), "the buttons the window has after Remove"
            .Buttons.Clear
            Expect.AreEqual 0, .Buttons.Count, "Count after Clear"
            Expect.AreEqual 0, CLng(SendMessageW(.hWnd, TB_BUTTONCOUNT, 0, 0)), "the buttons the window has after Clear"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Button_Key_Assigned_RenamesTheButton()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            .Buttons("a").Key = "open"
            Expect.IsFalse .Buttons.Exists("a"), "Exists of the old key"
            Expect.AreEqual 1, .Buttons("open").Index, "Index of the button found by the new key"
            On Error Resume Next
            Err.Clear
            .Buttons("open").Key = "B"
            Expect.AreEqual 457, Err.Number, "Key = the key of another button"
            On Error GoTo 0
            Expect.AreEqual "open", .Buttons(1).Key, "Key after the refused assignment"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Button_Position_MovesTheButtonNotItsIndex()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ToolBar1
            .Buttons.Add , "a", "A"
            .Buttons.Add , "b", "B"
            .Buttons.Add , "c", "C"
            .Buttons("a").Position = 3
            Expect.AreEqual "bca", KeysByPosition(f.ToolBar1), "the keys in the order the toolbar shows them after a.Position = 3"
            Expect.AreEqual "abc", Keys(f.ToolBar1), "the keys in the order of the collection after a.Position = 3"
            Expect.AreEqual 1, .Buttons("a").Index, "Index after a.Position = 3"
            Expect.AreEqual 3, .Buttons("a").Position, "Position after a.Position = 3"
        End With
        Unload f
        Expect.Done
    End Sub

