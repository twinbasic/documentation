    [TestCase]
    Public Sub MaxTextRows_MoreThanOneWithTextAlignRight_Raises383()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ToolBar1.MaxTextRows = 3
        Expect.AreEqual 3, CLng(f.ToolBar1.MaxTextRows), "MaxTextRows after MaxTextRows = 3"
        f.ToolBar1.TextAlignment = TbrTextAlignRight
        Expect.AreEqual 1, CLng(f.ToolBar1.MaxTextRows), "MaxTextRows after TextAlignment = TbrTextAlignRight"
        On Error Resume Next
        Err.Clear
        f.ToolBar1.MaxTextRows = 2
        Expect.AreEqual 383, Err.Number, "MaxTextRows = 2 with TextAlignment = TbrTextAlignRight"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ButtonHeight_SmallerThanTheMinimum_IsRaisedToIt()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim min As Single
        f.ToolBar1.ButtonHeight = 1
        min = f.ToolBar1.ButtonHeight
        Expect.IsTrue min > 1, "ButtonHeight after ButtonHeight = 1 twip"
        f.ToolBar1.ButtonHeight = min * 2
        Expect.IsTrue f.ToolBar1.ButtonHeight > min, "ButtonHeight after ButtonHeight is set to twice the minimum"
        f.ToolBar1.ButtonHeight = 1
        Expect.IsTrue Abs(f.ToolBar1.ButtonHeight - min) < 1, "ButtonHeight after it is set to 1 twip again"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Buttons_HeldAcrossTextAlignmentChange_StillReachTheirButtons()
        Expect.Begin
