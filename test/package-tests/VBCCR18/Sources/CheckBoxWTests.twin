' CheckBoxWTests: the value, the Click event, the styles and the image list of the CheckBoxW.
[TestFixture]
Module CheckBoxWTests

    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
    Private Const BM_CLICK As Long = &HF5
    Private Const WM_KEYDOWN As Long = &H100
    Private Const WM_KEYUP As Long = &H101

    [TestCase]
    Public Sub Click_ByTheUser_ChecksAndUnchecks()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        SendMessageW f.CheckBoxW1.hWnd, BM_CLICK, 0, 0
        Expect.AreEqual 1, CLng(f.CheckBoxW1.Value), "Value after a click on an unchecked box"
        SendMessageW f.CheckBoxW1.hWnd, WM_KEYDOWN, vbKeySpace, 0
        SendMessageW f.CheckBoxW1.hWnd, WM_KEYUP, vbKeySpace, 0
        Expect.AreEqual 0, CLng(f.CheckBoxW1.Value), "Value after the space key on a checked box"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Click_ByTheUser_OnGrayed_Unchecks()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.CheckBoxW1.Value = vbGrayed
        SendMessageW f.CheckBoxW1.hWnd, BM_CLICK, 0, 0
        Expect.AreEqual 0, CLng(f.CheckBoxW1.Value), "Value after a click on a grayed box"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Value_TrueAndFalse_AreCheckedAndUnchecked()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.CheckBoxW1.Value = True
        Expect.AreEqual 1, CLng(f.CheckBoxW1.Value), "Value after Value = True"
        f.CheckBoxW1.Value = False
        Expect.AreEqual 0, CLng(f.CheckBoxW1.Value), "Value after Value = False"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Value_OutOfRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.CheckBoxW1.Value = vbChecked
        On Error Resume Next
        Err.Clear
        f.CheckBoxW1.Value = 3
        Expect.AreEqual 380, Err.Number, "Value = 3"
        On Error GoTo 0
        Expect.AreEqual 1, CLng(f.CheckBoxW1.Value), "Value after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Click_RaisedForEachChangeOfValue()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New CheckBoxWSink
        Set sink.Box = f.CheckBoxW1
        Rig.ClearLog
        With f.CheckBoxW1
            .Value = vbChecked
            .Value = vbChecked
            .Value = vbGrayed
            .Value = vbUnchecked
        End With
        Expect.AreEqual "Click 1 | Click 2 | Click 0", Rig.Events(), "the events of Value = 1, Value = 1, Value = 2, Value = 0"
        Rig.ClearLog
        SendMessageW f.CheckBoxW1.hWnd, BM_CLICK, 0, 0
        Expect.AreEqual "Click 1", Rig.Events(), "the events of a click by the user"
        Set sink.Box = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Style_GraphicalInOwnerDrawMode_Raises383()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.CheckBoxW1.DrawMode = ChkDrawModeOwnerDraw
        On Error Resume Next
        Err.Clear
        f.CheckBoxW1.Style = vbButtonGraphical
        Expect.AreEqual 383, Err.Number, "Style = vbButtonGraphical with DrawMode ChkDrawModeOwnerDraw"
        On Error GoTo 0
        Expect.AreEqual 0, CLng(f.CheckBoxW1.Style), "Style after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub DrawMode_OwnerDraw_MakesStyleStandard()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.CheckBoxW1.Style = vbButtonGraphical
        Expect.AreEqual 1, CLng(f.CheckBoxW1.Style), "Style after Style = vbButtonGraphical"
        f.CheckBoxW1.DrawMode = ChkDrawModeOwnerDraw
        Expect.AreEqual 0, CLng(f.CheckBoxW1.Style), "Style after DrawMode = ChkDrawModeOwnerDraw"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Appearance_SetsForeColor()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.CheckBoxW1.Appearance = CCAppearanceFlat
        Expect.AreEqual CLng(vbWindowText), CLng(f.CheckBoxW1.ForeColor), "ForeColor after Appearance = CCAppearanceFlat"
        f.CheckBoxW1.Appearance = CCAppearance3D
        Expect.AreEqual CLng(vbButtonText), CLng(f.CheckBoxW1.ForeColor), "ForeColor after Appearance = CCAppearance3D"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Hot_Assigned_Raises383()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.CheckBoxW1.Hot = True
        Expect.AreEqual 383, Err.Number, "Hot = True"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageList_TakesAControlANameOrAHandle()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , , f.Image
        Dim h As LongPtr
        h = f.ImageList1.hImageList
        f.CheckBoxW1.ImageList = f.ImageList1
        Expect.AreEqual "ImageList", TypeName(f.CheckBoxW1.ImageList), "the type of ImageList after ImageList = the control"
        f.CheckBoxW1.ImageList = Nothing
        f.CheckBoxW1.ImageList = "ImageList1"
        Expect.AreEqual "ImageList", TypeName(f.CheckBoxW1.ImageList), "the type of ImageList after ImageList = the control's name"
        f.CheckBoxW1.ImageList = h
        Expect.IsTrue f.CheckBoxW1.ImageList = h, "ImageList after ImageList = a handle is that handle"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageList_UnknownName_IsNothing()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , , f.Image
        f.CheckBoxW1.ImageList = f.ImageList1
        f.CheckBoxW1.ImageList = "NoSuchImageList"
        Expect.AreEqual "Nothing", TypeName(f.CheckBoxW1.ImageList), "the type of ImageList after ImageList = a name no control has"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageList_OtherObject_Raises35610()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        Set f.CheckBoxW1.ImageList = f.CommandButtonW1
        Expect.AreEqual 35610, Err.Number, "Set ImageList = a CommandButtonW"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageList_OtherType_Raises13()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.CheckBoxW1.ImageList = 5
        Expect.AreEqual 13, Err.Number, "ImageList = 5, an Integer"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageListMargin_Negative_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.CheckBoxW1.ImageListMargin = -1
        Expect.AreEqual 380, Err.Number, "ImageListMargin = -1"
        On Error GoTo 0
        Expect.AreEqual 0, CLng(f.CheckBoxW1.ImageListMargin), "ImageListMargin after the refused assignment"
        Unload f
        Expect.Done
    End Sub

End Module

' The events of a CheckBoxW, written to Rig.Log.
Class CheckBoxWSink

    Public WithEvents Box As VBCCR18.CheckBoxW

    Private Sub Box_Click() Handles Box.Click
        Rig.Ev "Click " & Box.Value
    End Sub

End Class
