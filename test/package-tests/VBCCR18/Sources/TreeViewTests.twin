' TreeViewTests: the TreeView control, its TvwNodes collection, its TvwNode items and its
' TvwSelectedNodes collection: adding and moving nodes, the pictures, opening, selecting and
' checking nodes with the events each raises, and sorting.
[TestFixture]
Module TreeViewTests

    Private Type PictDesc
        Size As Long
        Kind As Long
        Handle As LongPtr
        Palette As LongPtr
    End Type

    Private Type PictGuid
        Data1 As Long
        Data2 As Integer
        Data3 As Integer
        Data4(0 To 7) As Byte
    End Type

    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal Msg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
    Private Declare PtrSafe Function GetDC Lib "user32" (ByVal hWnd As LongPtr) As LongPtr
    Private Declare PtrSafe Function ReleaseDC Lib "user32" (ByVal hWnd As LongPtr, ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function CreateCompatibleDC Lib "gdi32" (ByVal hDC As LongPtr) As LongPtr
    Private Declare PtrSafe Function CreateCompatibleBitmap Lib "gdi32" (ByVal hDC As LongPtr, ByVal W As Long, ByVal H As Long) As LongPtr
    Private Declare PtrSafe Function SelectObject Lib "gdi32" (ByVal hDC As LongPtr, ByVal hObject As LongPtr) As LongPtr
    Private Declare PtrSafe Function CreateSolidBrush Lib "gdi32" (ByVal Color As Long) As LongPtr
    Private Declare PtrSafe Function PatBlt Lib "gdi32" (ByVal hDC As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal W As Long, ByVal H As Long, ByVal Rop As Long) As Long
    Private Declare PtrSafe Function DeleteObject Lib "gdi32" (ByVal hObject As LongPtr) As Long
    Private Declare PtrSafe Function DeleteDC Lib "gdi32" (ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function OleCreatePictureIndirect Lib "oleaut32" (ByRef Desc As PictDesc, ByRef IID As PictGuid, ByVal Own As Long, ByRef Pic As IPictureDisp) As Long

    Private Const PATCOPY As Long = &HF00021
    Private Const TVM_GETIMAGELIST As Long = &H1108

    ' A bitmap of one color.
    Private Function ColorSquare(ByVal Color As Long, Optional ByVal Width As Long = 16, Optional ByVal Height As Long = 16) As StdPicture
        Dim screenDC As LongPtr, memDC As LongPtr, bmp As LongPtr, brush As LongPtr, oldBmp As LongPtr, oldBrush As LongPtr
        screenDC = GetDC(0)
        memDC = CreateCompatibleDC(screenDC)
        bmp = CreateCompatibleBitmap(screenDC, Width, Height)
        brush = CreateSolidBrush(Color)
        oldBmp = SelectObject(memDC, bmp)
        oldBrush = SelectObject(memDC, brush)
        PatBlt memDC, 0, 0, Width, Height, PATCOPY
        SelectObject memDC, oldBrush
        SelectObject memDC, oldBmp
        DeleteObject brush
        DeleteDC memDC
        ReleaseDC 0, screenDC
        Dim desc As PictDesc, iid As PictGuid, pic As IPictureDisp
        desc.Size = LenB(desc)
        desc.Kind = 1
        desc.Handle = bmp
        ' IID_IPictureDisp, {7BF80981-BF32-101A-8BBB-00AA00300CAB}
        iid.Data1 = &H7BF80981
        iid.Data2 = &HBF32
        iid.Data3 = &H101A
        iid.Data4(0) = &H8B
        iid.Data4(1) = &HBB
        iid.Data4(3) = &HAA
        iid.Data4(5) = &H30
        iid.Data4(6) = &HC
        iid.Data4(7) = &HAB
        OleCreatePictureIndirect desc, iid, 1, pic
        Set ColorSquare = pic
    End Function

    ' The texts of a node and of the nodes after it in its branch, separated by spaces.
    Private Function Siblings(ByVal Node As TvwNode) As String
        Do While Not Node Is Nothing
            Siblings = Siblings & IIf(Len(Siblings) > 0, " ", "") & Node.Text
            Set Node = Node.NextSibling
        Loop
    End Function

    ' ------------------------------------------------------------------ adding nodes

    [TestCase]
    Public Sub Add_Relationships_PlaceTheNewNode()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim fruit As TvwNode
        With f.TreeView1.Nodes
            Set fruit = .Add(, , "fruit", "Fruit")
            .Add fruit, TvwNodeRelationshipChild, "pear", "Pear"
            .Add fruit, TvwNodeRelationshipChild, "apple", "Apple"
            .Add "pear", TvwNodeRelationshipPrevious, "fig", "Fig"
            Expect.AreEqual "Fig Pear Apple", Siblings(fruit.Child), "the children of a node after two Add with Child and one with Previous"
            .Add "pear", TvwNodeRelationshipFirst, "first", "First"
            .Add "pear", TvwNodeRelationshipLast, "last", "Last"
            .Add "apple", TvwNodeRelationshipNext, "next", "Next"
            Expect.AreEqual "First Fig Pear Apple Next Last", Siblings(fruit.Child), "the children after Add with First, Last and Next beside them"
            .Add fruit, TvwNodeRelationshipChild, "child", "Child"
            Expect.AreEqual "First Fig Pear Apple Next Last Child", Siblings(fruit.Child), "the children after one more Add with Child"
            Expect.AreEqual 1, CLng(.Item("first").Level), "Level of a node added with First beside a child"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_NoRelative_GoesToTheRootLevel()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim first As TvwNode
        With f.TreeView1.Nodes
            Set first = .Add(, , "r", "R")
            .Add , TvwNodeRelationshipFirst, "f", "F"
            .Add , TvwNodeRelationshipLast, "l", "L"
            .Add , TvwNodeRelationshipNext, "n", "N"
            .Add , TvwNodeRelationshipChild, "c", "C"
            Expect.AreEqual "F R L N C", Siblings(first.FirstSibling), "the root level after Add without Relative and with First, Last, Next and Child"
            Expect.AreEqual 0, CLng(.Item("c").Level), "Level of a node added with Child and no Relative"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_DuplicateKey_Raises457_AddsNothing()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        With f.TreeView1.Nodes
            .Add , , "fruit", "Fruit"
            On Error Resume Next
            Err.Clear
            Set n = .Add(, , "FRUIT", "Other")
            Expect.AreEqual 457, Err.Number, "Add with a key that another node has, in other letter case"
            On Error GoTo 0
            Expect.AreEqual 1, CLng(.Count), "Count after the Add that raised"
            Expect.AreEqual "Fruit", .Item("fruit").Text, "Text of the node that has the key"
        End With
        Unload f
        Expect.Done
    End Sub

