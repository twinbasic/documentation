    ' ------------------------------------------------------------------ opening and selecting

    [TestCase]
    Public Sub Expanded_Change_RaisesTheEvents()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New TreeViewSink
        Set sink.Tree = f.TreeView1
        Dim r As TvwNode, a As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            Set a = .Add(r, TvwNodeRelationshipChild, "a", "A")
        End With
        Rig.ClearLog
        r.Expanded = True
        Expect.AreEqual "BeforeExpand R | Expand R", Rig.Events(), "the events of Expanded = True on a closed branch"
        Rig.ClearLog
        r.Expanded = True
        Expect.AreEqual "", Rig.Events(), "the events of Expanded = True on an open branch"
        r.Expanded = False
        Rig.ClearLog
        r.Expanded = True
        Expect.AreEqual "BeforeExpand R | Expand R", Rig.Events(), "the events of opening the branch a second time"
        Rig.ClearLog
        r.Expanded = False
        Expect.AreEqual "BeforeCollapse R | Collapse R", Rig.Events(), "the events of Expanded = False on an open branch"
        Rig.ClearLog
        a.Selected = True
        Expect.AreEqual "NodeBeforeSelect A | BeforeExpand R | Expand R | NodeSelect A", Rig.Events(), "the events of selecting a node in a closed branch"
        Set sink.Tree = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Expanded_NodeWithoutChildren_IsRememberedUntilItGetsOne()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New TreeViewSink
        Set sink.Tree = f.TreeView1
        Dim b As TvwNode, x As TvwNode
        Set b = f.TreeView1.Nodes.Add(, , "b", "B")
        Rig.ClearLog
        Expect.IsFalse b.Expanded, "Expanded of a node without children"
        b.Expanded = True
        Expect.IsTrue b.Expanded, "Expanded after True was assigned to a node without children"
        Expect.AreEqual "", Rig.Events(), "the events of Expanded = True on a node without children"
        Set x = f.TreeView1.Nodes.Add(b, TvwNodeRelationshipChild, "x", "X")
        Expect.IsTrue b.Expanded, "Expanded after the node got a child"
        Expect.IsTrue x.Visible, "Visible of the first child of a node set to Expanded before"
        Set sink.Tree = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Expanded_BeforeExpandCancelled_LeavesTheNodeCollapsed()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New TreeViewSink
        Set sink.Tree = f.TreeView1
        Dim r As TvwNode, a As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            Set a = .Add(r, TvwNodeRelationshipChild, "a", "A")
        End With
        sink.CancelBefore = True
        r.Expanded = True
        Expect.IsFalse r.Expanded, "Expanded after Expanded = True with BeforeExpand cancelled"
        Expect.IsFalse a.Visible, "Visible of the child after Expanded = True with BeforeExpand cancelled"
        Set sink.Tree = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Visible_ClosedBranch_IsFalse()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim r As TvwNode, a As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            Set a = .Add(r, TvwNodeRelationshipChild, "a", "A")
        End With
        Expect.IsTrue r.Visible, "Visible of a node of the root level"
        Expect.IsFalse a.Visible, "Visible of a child in a closed branch"
        r.Expanded = True
        Expect.IsTrue a.Visible, "Visible of the child after the branch was opened"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Selected_Change_RaisesTheEvents()
        Expect.Begin
