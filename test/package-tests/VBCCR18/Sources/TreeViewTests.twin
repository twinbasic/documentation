    [TestCase]
    Public Sub Nodes_Exists_SaysWhetherTheTreeHasTheNumberOrKey()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.TreeView1.Nodes
            .Add , , "a", "A"
            .Add , , , "B"
            Expect.IsTrue .Exists("a"), "Exists(""a"") in a tree with that key"
            Expect.IsFalse .Exists("b"), "Exists(""b"") in a tree without that key"
            Expect.IsTrue .Exists(2), "Exists(2) in a tree of two nodes"
            Expect.IsFalse .Exists(3), "Exists(3) in a tree of two nodes"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Nodes_Remove_RemovesTheChildrenToo()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim r As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            .Add r, TvwNodeRelationshipChild, "c1", "C1"
            .Add "c1", TvwNodeRelationshipChild, "g1", "G1"
            .Add r, TvwNodeRelationshipChild, "c2", "C2"
            .Add , , "s", "S"
            .Remove "c1"
            Expect.AreEqual 3, CLng(.Count), "Count after the removal of a node that had a child"
            Expect.IsFalse .Exists("g1"), "Exists(""g1"") after its parent was removed"
            Expect.AreEqual 2, CLng(.Item("c2").Index), "Index of C2 after the removal"
            Expect.AreEqual 3, CLng(.Item("s").Index), "Index of S after the removal"
            .Remove "r"
            Expect.AreEqual 1, CLng(.Count), "Count after the removal of a node with a child"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Nodes_Remove_RemovedNode_IsEmpty()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim r As TvwNode, a As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            Set a = .Add(r, TvwNodeRelationshipChild, "a", "A")
            .Add a, TvwNodeRelationshipChild, "b", "B"
            .Remove "a"
            Expect.AreEqual "", a.Text, "Text of a removed node"
            Expect.AreEqual 0, CLng(a.Children), "Children of a removed node"
            Expect.AreEqual "Nothing", TypeName(a.Parent), "TypeName of Parent of a removed node"
            Expect.AreEqual 2, CLng(a.Index), "Index of a removed node"
            Expect.AreEqual "a", a.Key, "Key of a removed node"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Nodes_Clear_RemovesEveryNode()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim r As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            .Add r, TvwNodeRelationshipChild, "a", "A"
            .Clear
            Expect.AreEqual 0, CLng(.Count), "Count after Clear"
            Expect.IsFalse .Exists("a"), "Exists(""a"") after Clear"
            .Add , , "a", "A again"
            Expect.AreEqual 1, CLng(.Item("a").Index), "Index of a node added after Clear"
        End With
        Unload f
        Expect.Done
    End Sub

    ' ------------------------------------------------------------------ a node

    [TestCase]
    Public Sub Key_Assigned_ChangesTheKey()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        With f.TreeView1.Nodes
            Set n = .Add(, , "a", "A")
            .Add , , "b", "B"
            n.Key = "z"
            Expect.AreEqual "z", n.Key, "Key after Key = ""z"""
            Expect.IsFalse .Exists("a"), "Exists(""a"") after the key changed"
            Expect.AreEqual 1, CLng(.Item("z").Index), "Index of the node found by its new key"
            n.Key = ""
            Expect.AreEqual "", n.Key, "Key after Key = an empty string"
            Expect.AreEqual "A", .Item(1).Text, "Text of the node numbered 1 after its key was taken away"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Key_Duplicate_Raises457()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        With f.TreeView1.Nodes
            Set n = .Add(, , "a", "A")
            .Add , , "b", "B"
            On Error Resume Next
            Err.Clear
            n.Key = "b"
            Expect.AreEqual 457, Err.Number, "Key = a key that another node has"
            On Error GoTo 0
            Expect.AreEqual "a", n.Key, "Key after the refused assignment"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Child_Set_Raises383()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        Set n = f.TreeView1.Nodes.Add(, , "a", "A")
        On Error Resume Next
        Err.Clear
        Set n.Child = n
        Expect.AreEqual 383, Err.Number, "Set Child"
        Err.Clear
        Set n.Root = n
        Expect.AreEqual 383, Err.Number, "Set Root"
        Err.Clear
        Set n.NextVisible = n
        Expect.AreEqual 383, Err.Number, "Set NextVisible"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Root_OfANodeInALaterBranch_IsItsTopLevelAncestor()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim r As TvwNode, a As TvwNode, b As TvwNode, c As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            Set a = .Add(, , "a", "A")
            Set b = .Add(r, TvwNodeRelationshipChild, "b", "B")
            Set c = .Add(a, TvwNodeRelationshipChild, "c", "C")
        End With
        Expect.AreEqual "R", b.Root.Text, "Root of a node in the first branch"
        Expect.AreEqual "A", c.Root.Text, "Root of a node in the second branch"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Text_LongerThan259_IsReadBackWhole()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        Set n = f.TreeView1.Nodes.Add(, , "a", String$(300, "x"))
        Expect.AreEqual 300, Len(n.Text), "Len of Text for a node added with 300 characters"
        n.Text = String$(1000, "y")
        Expect.AreEqual 1000, Len(n.Text), "Len of Text after 1000 characters were assigned"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FullPath_UsesThePathSeparator()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode, t As TvwNode
        With f.TreeView1
            Set n = .Nodes.Add(, , "r", "Root")
            Set t = .Nodes.Add(n, TvwNodeRelationshipChild, "a", "Sub")
            Set t = .Nodes.Add(t, TvwNodeRelationshipChild, "b", "Leaf")
            Expect.AreEqual "Root\Sub\Leaf", t.FullPath, "FullPath with the default separator"
            .PathSeparator = " > "
            Expect.AreEqual "Root > Sub > Leaf", t.FullPath, "FullPath with the separator "" > """
            .PathSeparator = ""
            Expect.AreEqual "RootSubLeaf", t.FullPath, "FullPath with an empty separator"
            Expect.AreEqual "Root", n.FullPath, "FullPath of a node of the root level"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub PathSeparator_AnyString_IsUsedByFullPath()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        With f.TreeView1
            Set n = .Nodes.Add(, , "r", "A")
            Set n = .Nodes.Add(n, TvwNodeRelationshipChild, "b", "B")
            .PathSeparator = "<>"
            Expect.AreEqual "<>", .PathSeparator, "PathSeparator after the assignment of ""<>"""
            Expect.AreEqual "A<>B", n.FullPath, "FullPath with the separator ""<>"""
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Tag_HoldsAnyValue()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode, k As TvwNode
        Set n = f.TreeView1.Nodes.Add(, , "a", "A")
        Set k = f.TreeView1.Nodes.Add(, , "b", "B")
        Expect.AreEqual "String", TypeName(n.Tag), "TypeName of the Tag of a new node"
        Expect.AreEqual "", CStr(n.Tag), "the Tag of a new node"
        n.Tag = 42
        Expect.AreEqual 42, CLng(n.Tag), "Tag after 42 was assigned"
        Set n.Tag = k
        Expect.AreEqual "TvwNode", TypeName(n.Tag), "TypeName of Tag after a node was assigned with Set"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub NodeColors_MinusOne_FollowsTheTree()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        Set n = f.TreeView1.Nodes.Add(, , "a", "A")
        Expect.IsTrue n.BackColor = f.TreeView1.BackColor, "BackColor of a new node equals the tree's"
        Expect.IsTrue n.ForeColor = f.TreeView1.ForeColor, "ForeColor of a new node equals the tree's"
        n.BackColor = vbRed
        n.ForeColor = vbYellow
        Expect.IsTrue n.BackColor = vbRed, "BackColor after vbRed was assigned"
        Expect.IsTrue n.ForeColor = vbYellow, "ForeColor after vbYellow was assigned"
        n.BackColor = -1
        n.ForeColor = -1
        Expect.IsTrue n.BackColor = f.TreeView1.BackColor, "BackColor after -1 was assigned"
        Expect.IsTrue n.ForeColor = f.TreeView1.ForeColor, "ForeColor after -1 was assigned"
        n.ForeColor = vbYellow
        f.TreeView1.ResetForeColors
        Expect.IsTrue n.ForeColor = f.TreeView1.ForeColor, "ForeColor after ResetForeColors"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
