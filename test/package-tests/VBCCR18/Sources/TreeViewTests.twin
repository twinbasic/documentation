    [TestCase]
    Public Sub Add_RelativeNumberOutOfRange_Raises9()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        With f.TreeView1.Nodes
            .Add , , "a", "A"
            On Error Resume Next
            Err.Clear
            Set n = .Add(9, TvwNodeRelationshipChild, "b", "B")
            Expect.AreEqual 9, Err.Number, "Add with a Relative that is a number beyond Count"
            On Error GoTo 0
            Set n = .Add(1, TvwNodeRelationshipChild, "c", "C")
