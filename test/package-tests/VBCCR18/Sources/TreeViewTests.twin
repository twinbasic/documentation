    [TestCase]
    Public Sub CheckBox_False_TakesTheBoxAway()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        f.TreeView1.Checkboxes = True
        Set n = f.TreeView1.Nodes.Add(, , "a", "A")
        Expect.IsTrue n.CheckBox, "CheckBox of a new node in a tree with Checkboxes"
        n.CheckBox = False
        Expect.IsFalse n.CheckBox, "CheckBox after False was assigned"
        n.Checked = True
        Expect.IsFalse n.Checked, "Checked after True was assigned to a node without a box"
        n.CheckBox = True
        Expect.IsTrue n.CheckBox, "CheckBox after True was assigned"
        Expect.IsFalse n.Checked, "Checked of a node that got its box back"
        Unload f
