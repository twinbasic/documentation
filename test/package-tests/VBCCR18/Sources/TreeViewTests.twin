    [TestCase]
    Public Sub Selected_BeforeSelectCancelled_KeepsTheSelection()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New TreeViewSink
        Set sink.Tree = f.TreeView1
        Dim a As TvwNode, b As TvwNode
        With f.TreeView1.Nodes
            Set a = .Add(, , "a", "A")
            Set b = .Add(, , "b", "B")
        End With
        sink.CancelBefore = True
