    ' ------------------------------------------------------------------ several nodes

    [TestCase]
    Public Sub SelectedNodes_ProgramSelecting_ListsTheNewestFirst()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As TvwNode, b As TvwNode, c As TvwNode, n As TvwNode, s As String
        With f.TreeView1
            Set a = .Nodes.Add(, , "a", "A")
            Set b = .Nodes.Add(, , "b", "B")
            Set c = .Nodes.Add(, , "c", "C")
            .MultiSelect = TvwMultiSelectAll
            Expect.AreEqual 0, CLng(.SelectedNodes.Count), "Count of SelectedNodes before a node is selected"
            a.Selected = True
            c.Selected = True
            b.Selected = True
            For Each n In .SelectedNodes
                s = s & n.Text
            Next
            Expect.AreEqual "BCA", s, "the nodes of SelectedNodes after A, C and B were selected"
            Expect.AreEqual 3, CLng(.SelectedNodes.Count), "Count of SelectedNodes"
            Expect.AreEqual "A", .SelectedItem.Text, "SelectedItem after A, C and B were selected"
            Expect.AreEqual 1, CLng(b.SelectedIndex), "SelectedIndex of the node selected last"
            Expect.AreEqual 3, CLng(a.SelectedIndex), "SelectedIndex of the node selected first"
            b.Selected = False
            Expect.AreEqual 0, CLng(b.SelectedIndex), "SelectedIndex of a node that was deselected"
            Expect.AreEqual 2, CLng(.SelectedNodes.Count), "Count of SelectedNodes after one node was deselected"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelectedNodes_MultiSelectNone_Raises91()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As Long
