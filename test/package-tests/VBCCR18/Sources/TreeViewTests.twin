        n = f.TreeView1.SelectedNodes.Count
        Expect.AreEqual 91, Err.Number, "SelectedNodes while MultiSelect is TvwMultiSelectNone"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MultiSelect_Changed_KeepsOnlyTheFocusedNode()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As TvwNode, c As TvwNode
        With f.TreeView1
            Set a = .Nodes.Add(, , "a", "A")
            .Nodes.Add , , "b", "B"
            Set c = .Nodes.Add(, , "c", "C")
            .MultiSelect = TvwMultiSelectAll
            a.Selected = True
            c.Selected = True
            Expect.AreEqual 2, CLng(.SelectedNodes.Count), "Count of SelectedNodes with two nodes selected"
            .MultiSelect = TvwMultiSelectVisibleOnly
            Expect.AreEqual 1, CLng(.SelectedNodes.Count), "Count of SelectedNodes after MultiSelect changed"
            Expect.IsTrue a.Selected, "Selected of the node that has the focus after MultiSelect changed"
            Expect.IsFalse c.Selected, "Selected of the other node after MultiSelect changed"
        End With
        Unload f
        Expect.Done
    End Sub

