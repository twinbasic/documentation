    ' ------------------------------------------------------------------ sorting

    [TestCase]
    Public Sub Sorted_SortsTheRootLevel()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        With f.TreeView1
            Set n = .Nodes.Add(, , "p", "pear")
            .Nodes.Add , , "a", "Apple"
            .Nodes.Add , , "f", "fig"
            Expect.AreEqual "pear Apple fig", Siblings(n.FirstSibling), "the root level before Sorted"
            .Sorted = True
            Expect.AreEqual "Apple fig pear", Siblings(n.FirstSibling), "the root level after Sorted = True"
            .SortOrder = TvwSortOrderDescending
            Expect.AreEqual "pear fig Apple", Siblings(n.FirstSibling), "the root level after SortOrder = TvwSortOrderDescending"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Sorted_OfANode_SortsItsChildren()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        With f.TreeView1
            Set n = .Nodes.Add(, , "p", "pear")
            .Nodes.Add n, TvwNodeRelationshipChild, "k", "kiwi"
            .Nodes.Add n, TvwNodeRelationshipChild, "b", "banana"
            .Sorted = True
            Expect.AreEqual "kiwi banana", Siblings(n.Child), "the children of a node when the tree's Sorted is True"
            n.Sorted = True
            Expect.AreEqual "banana kiwi", Siblings(n.Child), "the children of a node after its Sorted was set to True"
            n.SortOrder = TvwSortOrderDescending
            Expect.AreEqual "kiwi banana", Siblings(n.Child), "the children after its SortOrder was set to TvwSortOrderDescending"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Sorted_NodeAddedLater_TakesItsSortedPlace()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        With f.TreeView1
            Set n = .Nodes.Add(, , "p", "pear")
            .Nodes.Add , , "a", "apple"
            .Sorted = True
            .Nodes.Add , , "z", "zebra"
            .Nodes.Add , TvwNodeRelationshipFirst, "m", "mango"
            Expect.AreEqual "apple mango pear zebra", Siblings(n.FirstSibling), "the root level after two nodes were added to a sorted tree"
            n.Sorted = True
            .Nodes.Add n, TvwNodeRelationshipChild, "k", "kiwi"
            .Nodes.Add n, TvwNodeRelationshipChild, "b", "banana"
            Expect.AreEqual "banana kiwi", Siblings(n.Child), "the children of a node whose Sorted is True after two were added"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub NodeSortOrder_NotAMember_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        Set n = f.TreeView1.Nodes.Add(, , "a", "A")
        On Error Resume Next
        Err.Clear
        n.SortOrder = 5
        Expect.AreEqual 380, Err.Number, "SortOrder of a node = 5"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub NodeSortType_NotAMember_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        Set n = f.TreeView1.Nodes.Add(, , "a", "A")
        On Error Resume Next
        Err.Clear
        n.SortType = 5
        Expect.AreEqual 380, Err.Number, "SortType of a node = 5"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    ' ------------------------------------------------------------------ positions and scrolling

    ' The key of a node, or "Nothing" for no node, so that a wrong answer fails the case instead of raising.
    Private Function KeyOf(ByVal Node As TvwNode) As String
        If Node Is Nothing Then KeyOf = "Nothing" Else KeyOf = Node.Key
    End Function

    [TestCase]
    Public Sub HitTest_GivesTheNodeUnderThePosition()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim h As TvwNode, after As Boolean
        ' The tree of HostForm is 40 pixels high: short labels and no pictures keep it free of scroll bars, so that both rows are in view.
        With f.TreeView1
            .Style = TvwStyleTextOnly
            .Nodes.Add , , "a", "First row"
            .Nodes.Add , , "b", "Second row"
            Expect.AreEqual "a", KeyOf(.HitTest(300, 100)), "Key of HitTest(300, 100)"
            Expect.AreEqual "b", KeyOf(.HitTest(300, 350)), "Key of HitTest(300, 350)"
            Expect.AreEqual "Nothing", KeyOf(.HitTest(300, 3000)), "Key of HitTest below the last node"
            Set h = .HitTestInsertMark(300, 20, after)
            Expect.AreEqual "a", KeyOf(h), "Key of HitTestInsertMark in the upper half of the first row"
            Expect.IsFalse after, "After for the upper half of the first row"
            Set h = .HitTestInsertMark(300, 200, after)
            Expect.AreEqual "a", KeyOf(h), "Key of HitTestInsertMark in the lower half of the first row"
            Expect.IsTrue after, "After for the lower half of the first row"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FirstVisible_OfAnyNode_IsTheTopItem()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim i As Long
        With f.TreeView1
            For i = 1 To 40
                .Nodes.Add , , "k" & i, "Node " & i
            Next
            Set .TopItem = .Nodes("k20")
            Expect.AreEqual "Node 20", .TopItem.Text, "TopItem after TopItem was set to Node 20"
            Expect.AreEqual "Node 20", .Nodes("k3").FirstVisible.Text, "FirstVisible of Node 3 while Node 20 is at the top"
            Expect.AreEqual "Node 20", .Nodes("k39").FirstVisible.Text, "FirstVisible of Node 39 while Node 20 is at the top"
            Expect.IsTrue .Nodes("k39").Visible, "Visible of a node scrolled out of the window"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub TopItem_Set_ScrollsTheNodeToTheTop()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim i As Long
        With f.TreeView1
            For i = 1 To 40
                .Nodes.Add , , "k" & i, "Node " & i
            Next
            Expect.AreEqual "Node 1", .TopItem.Text, "TopItem of a new tree"
            Set .TopItem = .Nodes("k20")
            Expect.AreEqual "Node 20", .TopItem.Text, "TopItem after Node 20 was assigned"
            .Nodes("k5").EnsureVisible
            Expect.AreEqual "Node 5", .TopItem.Text, "TopItem after EnsureVisible of Node 5 scrolled up to it"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub TopItem_SetToNothing_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TreeView1.Nodes.Add , , "a", "A"
        On Error Resume Next
        Err.Clear
        Set f.TreeView1.TopItem = Nothing
        Expect.AreEqual 380, Err.Number, "Set TopItem to Nothing"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub LastVisible_OfAnyNode_IsTheLastShownNode()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim r As TvwNode, a As TvwNode, b As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            Set a = .Add(r, TvwNodeRelationshipChild, "a", "A")
            Set b = .Add(, , "b", "B")
            .Add b, TvwNodeRelationshipChild, "x", "X"
        End With
        Expect.AreEqual "B", r.LastVisible.Text, "LastVisible while both branches are closed"
        b.Expanded = True
        Expect.AreEqual "X", r.LastVisible.Text, "LastVisible after the last branch was opened"
        Expect.AreEqual "X", a.LastVisible.Text, "LastVisible of another node"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub DropHighlight_SetAndCleared()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.TreeView1
            .Nodes.Add , , "a", "A"
            .Nodes.Add , , "b", "B"
            Expect.AreEqual "Nothing", TypeName(.DropHighlight), "TypeName of DropHighlight in a new tree"
            Set .DropHighlight = .Nodes("b")
            Expect.AreEqual "B", .DropHighlight.Text, "DropHighlight after a node was assigned"
            Set .DropHighlight = Nothing
            Expect.AreEqual "Nothing", TypeName(.DropHighlight), "TypeName of DropHighlight after Nothing was assigned"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub InsertMark_SetAndRead()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim after As Boolean
        With f.TreeView1
            .Nodes.Add , , "a", "A"
            .Nodes.Add , , "b", "B"
            Expect.AreEqual "Nothing", TypeName(.InsertMark), "TypeName of InsertMark in a new tree"
            Set .InsertMark(True) = .Nodes("b")
            Expect.AreEqual "B", .InsertMark(after).Text, "InsertMark after a node was assigned"
            Expect.IsTrue after, "After of InsertMark after the node was assigned with After True"
            Set .InsertMark = Nothing
            Expect.AreEqual "Nothing", TypeName(.InsertMark), "TypeName of InsertMark after Nothing was assigned"
        End With
        Unload f
        Expect.Done
    End Sub

    ' ------------------------------------------------------------------ the properties

    [TestCase]
    Public Sub Properties_NotAMember_Raise380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        With f.TreeView1
            Err.Clear: .BorderStyle = 7
            Expect.AreEqual 380, Err.Number, "BorderStyle = 7"
            Err.Clear: .Style = 8
            Expect.AreEqual 380, Err.Number, "Style = 8"
            Err.Clear: .LineStyle = 2
            Expect.AreEqual 380, Err.Number, "LineStyle = 2"
            Err.Clear: .LabelEdit = 3
            Expect.AreEqual 380, Err.Number, "LabelEdit = 3"
            Err.Clear: .SortOrder = 2
            Expect.AreEqual 380, Err.Number, "SortOrder = 2"
            Err.Clear: .SortType = 2
            Expect.AreEqual 380, Err.Number, "SortType = 2"
            Err.Clear: .MultiSelect = 4
            Expect.AreEqual 380, Err.Number, "MultiSelect = 4"
            Err.Clear: .VisualTheme = 2
            Expect.AreEqual 380, Err.Number, "VisualTheme = 2"
            Err.Clear: .OLEDragMode = 2
            Expect.AreEqual 380, Err.Number, "OLEDragMode = 2"
            Err.Clear: .OLEDragExpandTime = -2
            Expect.AreEqual 380, Err.Number, "OLEDragExpandTime = -2"
            Err.Clear: .Indentation = -1
            Expect.AreEqual 380, Err.Number, "Indentation = -1"
            Err.Clear: .LineHeight = -5
            Expect.AreEqual 380, Err.Number, "LineHeight = -5"
            Err.Clear: .IMEMode = 11
            Expect.AreEqual 380, Err.Number, "IMEMode = 11"
        End With
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Defaults_OfANewTree()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.TreeView1
            Expect.AreEqual 3, CLng(.BorderStyle), "BorderStyle of a new tree"
            Expect.AreEqual 7, CLng(.Style), "Style of a new tree"
            Expect.AreEqual 0, CLng(.LineStyle), "LineStyle of a new tree"
            Expect.AreEqual 0, CLng(.LabelEdit), "LabelEdit of a new tree"
            Expect.IsFalse .Checkboxes, "Checkboxes of a new tree"
            Expect.IsFalse .ShowTips, "ShowTips of a new tree"
            Expect.IsTrue .HideSelection, "HideSelection of a new tree"
            Expect.IsFalse .FullRowSelect, "FullRowSelect of a new tree"
            Expect.IsFalse .HotTracking, "HotTracking of a new tree"
            Expect.AreEqual 0, CLng(.Indentation), "Indentation of a new tree"
            Expect.AreEqual "\", .PathSeparator, "PathSeparator of a new tree"
            Expect.IsTrue .Scroll, "Scroll of a new tree"
            Expect.IsFalse .SingleSel, "SingleSel of a new tree"
            Expect.IsFalse .Sorted, "Sorted of a new tree"
            Expect.AreEqual 0, CLng(.SortOrder), "SortOrder of a new tree"
            Expect.AreEqual 0, CLng(.SortType), "SortType of a new tree"
            Expect.IsTrue .DoubleBuffer, "DoubleBuffer of a new tree"
            Expect.IsTrue .Redraw, "Redraw of a new tree"
            Expect.AreEqual 0, CLng(.MultiSelect), "MultiSelect of a new tree"
            Expect.AreEqual 0, CLng(.VisualTheme), "VisualTheme of a new tree"
            Expect.AreEqual 0, CLng(.OLEDragMode), "OLEDragMode of a new tree"
            Expect.IsTrue .OLEDragDropScroll, "OLEDragDropScroll of a new tree"
            Expect.AreEqual -1, CLng(.OLEDragExpandTime), "OLEDragExpandTime of a new tree"
            Expect.AreEqual 0, CLng(.IMEMode), "IMEMode of a new tree"
            Expect.IsTrue .BackColor = vbWindowBackground, "BackColor of a new tree"
            Expect.IsTrue .ForeColor = vbWindowText, "ForeColor of a new tree"
            Expect.IsTrue .LineColor = vbGrayText, "LineColor of a new tree"
            Expect.IsTrue .InsertMarkColor = vbBlack, "InsertMarkColor of a new tree"
        End With
        Unload f
        Expect.Done
    End Sub

End Module

' The events of a TreeView, written to Rig.Log. CancelBefore makes each Before event cancel.
Class TreeViewSink

    Public WithEvents Tree As VBCCR18.TreeView
    Public CancelBefore As Boolean

    Private Sub Tree_BeforeExpand(ByVal Node As TvwNode, Cancel As Boolean) Handles Tree.BeforeExpand
        Rig.Ev "BeforeExpand " & Node.Text
        Cancel = CancelBefore
    End Sub

    Private Sub Tree_Expand(ByVal Node As TvwNode) Handles Tree.Expand
        Rig.Ev "Expand " & Node.Text
    End Sub

    Private Sub Tree_BeforeCollapse(ByVal Node As TvwNode, Cancel As Boolean) Handles Tree.BeforeCollapse
        Rig.Ev "BeforeCollapse " & Node.Text
        Cancel = CancelBefore
    End Sub

    Private Sub Tree_Collapse(ByVal Node As TvwNode) Handles Tree.Collapse
        Rig.Ev "Collapse " & Node.Text
    End Sub

    Private Sub Tree_NodeBeforeSelect(ByVal Node As TvwNode, Cancel As Boolean) Handles Tree.NodeBeforeSelect
        Rig.Ev "NodeBeforeSelect " & Node.Text
        Cancel = CancelBefore
    End Sub

    Private Sub Tree_NodeSelect(ByVal Node As TvwNode) Handles Tree.NodeSelect
        Rig.Ev "NodeSelect " & Node.Text
    End Sub

    Private Sub Tree_NodeBeforeCheck(ByVal Node As TvwNode, Cancel As Boolean) Handles Tree.NodeBeforeCheck
        Rig.Ev "NodeBeforeCheck " & Node.Text
        Cancel = CancelBefore
    End Sub

    Private Sub Tree_NodeCheck(ByVal Node As TvwNode) Handles Tree.NodeCheck
        Rig.Ev "NodeCheck " & Node.Text
    End Sub

    Private Sub Tree_BeforeLabelEdit(Cancel As Boolean) Handles Tree.BeforeLabelEdit
        Rig.Ev "BeforeLabelEdit"
        Cancel = CancelBefore
    End Sub

End Class
