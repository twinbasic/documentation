    End Sub

    [TestCase]
    Public Sub Add_RelativeOfAnotherType_Raises13()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As TvwNode
        With f.TreeView1.Nodes
            .Add , , "a", "A"
            On Error Resume Next
            Err.Clear
            Set n = .Add(1.5, TvwNodeRelationshipChild, "b", "B")
            Expect.AreEqual 13, Err.Number, "Add with a Relative that is a Double"
            On Error GoTo 0
            Expect.AreEqual 1, CLng(.Count), "Count after the Add that raised"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_Image_NumberAndKey()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , "red", ColorSquare(vbRed)
        f.ImageList1.ListImages.Add , "blue", ColorSquare(vbBlue)
        Set f.TreeView1.ImageList = f.ImageList1
        Dim n As TvwNode
        With f.TreeView1.Nodes
            Set n = .Add(, , "a", "A", "blue", 1)
            Expect.AreEqual 2, CLng(n.ImageIndex), "ImageIndex of a node added with the key ""blue"""
            Expect.AreEqual 1, CLng(n.SelectedImageIndex), "SelectedImageIndex of a node added with the number 1"
            Set n = .Add(, , "b", "B", 9)
            Expect.AreEqual 9, CLng(n.ImageIndex), "ImageIndex of a node added with the number 9, which the list does not have"
            On Error Resume Next
            Err.Clear
            Set n = .Add(, , "c", "C", "nokey")
            Expect.AreEqual 35601, Err.Number, "Add with an image key the list does not have"
            Err.Clear
            Set n = .Add(, , "d", "D", -1)
            Expect.AreEqual 35600, Err.Number, "Add with the image number -1"
            On Error GoTo 0
            Expect.AreEqual 2, CLng(.Count), "Count after the two Add that raised"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Image_KeyWithoutAnImageListControl_Raises35601()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , "red", ColorSquare(vbRed)
        Dim n As TvwNode
        On Error Resume Next
        Err.Clear
        Set n = f.TreeView1.Nodes.Add(, , "a", "A", "red")
        Expect.AreEqual 35601, Err.Number, "Add with an image key in a tree that has no image list"
        On Error GoTo 0
        f.TreeView1.ImageList = f.ImageList1.hImageList
        On Error Resume Next
        Err.Clear
        Set n = f.TreeView1.Nodes.Add(, , "b", "B", "red")
        Expect.AreEqual 35601, Err.Number, "Add with an image key in a tree that has the handle of an image list"
        On Error GoTo 0
        Set n = f.TreeView1.Nodes.Add(, , "c", "C", 1)
        Expect.AreEqual 1, CLng(n.ImageIndex), "ImageIndex of a node added with the number 1 in a tree that has the handle"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Style_WithoutPicture_TakesTheImageListFromTheWindow()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , "red", ColorSquare(vbRed)
        Set f.TreeView1.ImageList = f.ImageList1
        Expect.IsTrue SendMessageW(f.TreeView1.hWnd, TVM_GETIMAGELIST, 0, 0) = f.ImageList1.hImageList, "the image list of the window after ImageList was assigned, with the default Style"
        f.TreeView1.Style = TvwStyleTextOnly
        Expect.IsTrue SendMessageW(f.TreeView1.hWnd, TVM_GETIMAGELIST, 0, 0) = 0, "the image list of the window with Style TvwStyleTextOnly"
        Expect.AreEqual "ImageList", TypeName(f.TreeView1.ImageList), "TypeName of ImageList with Style TvwStyleTextOnly"
        f.TreeView1.Style = TvwStyleTreeLinesPictureText
        Expect.IsTrue SendMessageW(f.TreeView1.hWnd, TVM_GETIMAGELIST, 0, 0) = f.ImageList1.hImageList, "the image list of the window after Style changed to TvwStyleTreeLinesPictureText"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageList_TakesAControlANameOrAHandle()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , "red", ColorSquare(vbRed)
        With f.TreeView1
            Set .ImageList = f.ImageList1
            Expect.AreEqual "ImageList", TypeName(.ImageList), "TypeName of ImageList after the control was assigned"
            .ImageList = f.ImageList1.hImageList
            Expect.IsTrue .ImageList = f.ImageList1.hImageList, "ImageList after the handle was assigned"
            .ImageList = "ImageList1"
            Expect.AreEqual "ImageList", TypeName(.ImageList), "TypeName of ImageList after the name ""ImageList1"" was assigned"
            .ImageList = "NoSuchList"
            Expect.AreEqual "Nothing", TypeName(.ImageList), "TypeName of ImageList after a name no control has was assigned"
            Set .ImageList = f.ImageList1
            Set .ImageList = Nothing
            Expect.AreEqual "Nothing", TypeName(.ImageList), "TypeName of ImageList after Nothing was assigned"
            Expect.IsTrue SendMessageW(.hWnd, TVM_GETIMAGELIST, 0, 0) = 0, "the image list of the window after Nothing was assigned"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageList_EmptyList_IsNotTaken()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Set f.TreeView1.ImageList = f.ImageList1
        Expect.AreEqual "Nothing", TypeName(f.TreeView1.ImageList), "TypeName of ImageList after an image list with no picture was assigned"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageList_NotAnImageList_Raises()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.TreeView1.ImageList = f.TreeView1
        Expect.AreEqual 35610, Err.Number, "ImageList = the TreeView itself"
        Err.Clear
        f.TreeView1.ImageList = 3.5
        Expect.AreEqual 13, Err.Number, "ImageList = 3.5"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    ' ------------------------------------------------------------------ the collection

    [TestCase]
    Public Sub Nodes_Index_IsTheOrderOfAddition()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.TreeView1.Nodes
            .Add , , "x", "X"
            .Add , , "y", "Y"
            .Add "x", TvwNodeRelationshipNext, "z", "Z"
            Expect.AreEqual 3, CLng(.Item("z").Index), "Index of the node added last, between X and Y"
            Expect.AreEqual "Z", .Item("x").NextSibling.Text, "the node after X"
            Expect.AreEqual "Y", .Item(2).Text, "the node numbered 2"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Nodes_Index_AfterRemove_IsRenumbered()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.TreeView1.Nodes
            .Add , , "a", "A"
            .Add , , "b", "B"
            .Add , , "c", "C"
            .Remove "a"
            Expect.AreEqual 1, CLng(.Item("b").Index), "Index of B after A was removed"
            Expect.AreEqual 2, CLng(.Item("c").Index), "Index of C after A was removed"
            Expect.AreEqual "c", .Item(2).Key, "Key of the node numbered 2 after A was removed"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Nodes_Item_KeyIgnoresCase()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.TreeView1.Nodes
            .Add , , "fruit", "Fruit"
            Expect.AreEqual "Fruit", .Item("FRUIT").Text, "Text of Item(""FRUIT"") for the key ""fruit"""
            Expect.IsTrue .Exists("Fruit"), "Exists(""Fruit"") for the key ""fruit"""
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Nodes_Item_NumberOutOfRange_Raises9()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TreeView1.Nodes.Add , , "a", "A"
        Dim n As TvwNode
        On Error Resume Next
        Err.Clear
        Set n = f.TreeView1.Nodes(5)
        Expect.AreEqual 9, Err.Number, "Item(5) in a tree of one node"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Nodes_Item_UnknownKey_Raises5()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TreeView1.Nodes.Add , , "a", "A"
        Dim n As TvwNode
        On Error Resume Next
        Err.Clear
        Set n = f.TreeView1.Nodes("nokey")
        Expect.AreEqual 5, Err.Number, "Item(""nokey"")"
        On Error GoTo 0
