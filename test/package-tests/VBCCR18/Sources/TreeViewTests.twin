    ' ------------------------------------------------------------------ moving

    [TestCase]
    Public Sub Move_KeepsTheStateAndTheChildren()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim r As TvwNode, a As TvwNode, b As TvwNode, h As LongPtr
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            Set a = .Add(r, TvwNodeRelationshipChild, "a", "A")
            Set b = .Add(r, TvwNodeRelationshipChild, "b", "B")
            .Add a, TvwNodeRelationshipChild, "c", "C"
        End With
        a.Expanded = True
        a.Selected = True
        h = a.Handle
        a.Move b, TvwNodeRelationshipNext
        Expect.IsTrue h <> a.Handle, "Handle of a node after Move"
        Expect.IsTrue a.Expanded, "Expanded after Move"
        Expect.IsTrue a.Selected, "Selected after Move"
        Expect.AreEqual "A", f.TreeView1.SelectedItem.Text, "SelectedItem after Move"
        Expect.AreEqual 1, CLng(a.Children), "Children after Move"
        Expect.AreEqual 2, CLng(a.Index), "Index after Move"
        Expect.AreEqual "A", b.NextSibling.Text, "the node after B after A moved there"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Move_NoRelative_GoesToTheRootLevel()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim r As TvwNode, a As TvwNode, b As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            Set a = .Add(r, TvwNodeRelationshipChild, "a", "A")
            Set b = .Add(r, TvwNodeRelationshipChild, "b", "B")
        End With
        a.Move
        Expect.AreEqual 0, CLng(a.Level), "Level of a node moved with no Relative"
        Expect.AreEqual "A", r.LastSibling.Text, "the last node of the root level after Move with no Relative"
        b.Move , TvwNodeRelationshipFirst
        Expect.AreEqual "B", r.FirstSibling.Text, "the first node of the root level after Move with First and no Relative"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Move_IntoItsOwnBranch_Raises35614()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim r As TvwNode, a As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            Set a = .Add(r, TvwNodeRelationshipChild, "a", "A")
        End With
        On Error Resume Next
        Err.Clear
        r.Move a, TvwNodeRelationshipChild
        Expect.AreEqual 35614, Err.Number, "Move of a node to be a child of its own child"
        Err.Clear
        r.Move a, TvwNodeRelationshipNext
        Expect.AreEqual 35614, Err.Number, "Move of a node to follow its own child"
        Err.Clear
        Set r.Parent = a
        Expect.AreEqual 35614, Err.Number, "Set Parent of a node to its own child"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Parent_Set_MovesTheNodeAsFirstChild()
        Expect.Begin
