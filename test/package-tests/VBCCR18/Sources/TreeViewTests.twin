        Set f = Rig.NewForm()
        Dim r As TvwNode, a As TvwNode, c As TvwNode
        With f.TreeView1.Nodes
            Set r = .Add(, , "r", "R")
            Set a = .Add(r, TvwNodeRelationshipChild, "a", "A")
            Set c = .Add(, , "c", "C")
        End With
        Set c.Parent = r
        Expect.AreEqual "R", c.Parent.Text, "Parent after Set Parent"
        Expect.AreEqual "C A", Siblings(r.Child), "the children of R after C was given R as its Parent"
        Expect.AreEqual 1, CLng(c.Level), "Level after Set Parent"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Parent_SetToNothing_Raises35610()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim r As TvwNode, a As TvwNode
        With f.TreeView1.Nodes
