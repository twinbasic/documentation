' ImageListTests: the ImageList control, its ImlListImages collection and its ImlListImage items.
' The pictures are bitmaps of one color made here, and what an item draws is read back from a
' memory device context, so that no case needs a file.
[TestFixture]
Module ImageListTests

    Private Type PictDesc
        Size As Long
        Kind As Long
        Handle As LongPtr
        Palette As LongPtr
    End Type

    Private Type PictGuid
        Data1 As Long
        Data2 As Integer
        Data3 As Integer
        Data4(0 To 7) As Byte
    End Type

    Private Declare PtrSafe Function GetDC Lib "user32" (ByVal hWnd As LongPtr) As LongPtr
    Private Declare PtrSafe Function ReleaseDC Lib "user32" (ByVal hWnd As LongPtr, ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function CreateCompatibleDC Lib "gdi32" (ByVal hDC As LongPtr) As LongPtr
    Private Declare PtrSafe Function CreateCompatibleBitmap Lib "gdi32" (ByVal hDC As LongPtr, ByVal W As Long, ByVal H As Long) As LongPtr
    Private Declare PtrSafe Function SelectObject Lib "gdi32" (ByVal hDC As LongPtr, ByVal hObject As LongPtr) As LongPtr
    Private Declare PtrSafe Function CreateSolidBrush Lib "gdi32" (ByVal Color As Long) As LongPtr
    Private Declare PtrSafe Function PatBlt Lib "gdi32" (ByVal hDC As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal W As Long, ByVal H As Long, ByVal Rop As Long) As Long
    Private Declare PtrSafe Function DeleteObject Lib "gdi32" (ByVal hObject As LongPtr) As Long
    Private Declare PtrSafe Function DeleteDC Lib "gdi32" (ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function GetPixel Lib "gdi32" (ByVal hDC As LongPtr, ByVal X As Long, ByVal Y As Long) As Long
    Private Declare PtrSafe Function OleCreatePictureIndirect Lib "oleaut32" (ByRef Desc As PictDesc, ByRef IID As PictGuid, ByVal Own As Long, ByRef Pic As IPictureDisp) As Long
    Private Declare PtrSafe Function ImageList_GetImageCount Lib "comctl32" (ByVal hImageList As LongPtr) As Long

    Private Const PATCOPY As Long = &HF00021
    Private Const WHITENESS As Long = &HFF0062
    Private Const SILVER As Long = &HC0C0C0

    ' A bitmap of one color.
    Private Function ColorSquare(ByVal Color As Long, Optional ByVal Width As Long = 16, Optional ByVal Height As Long = 16) As StdPicture
        Dim screenDC As LongPtr, memDC As LongPtr, bmp As LongPtr, brush As LongPtr, oldBmp As LongPtr, oldBrush As LongPtr
        screenDC = GetDC(0)
        memDC = CreateCompatibleDC(screenDC)
        bmp = CreateCompatibleBitmap(screenDC, Width, Height)
        brush = CreateSolidBrush(Color)
        oldBmp = SelectObject(memDC, bmp)
        oldBrush = SelectObject(memDC, brush)
        PatBlt memDC, 0, 0, Width, Height, PATCOPY
        SelectObject memDC, oldBrush
        SelectObject memDC, oldBmp
        DeleteObject brush
        DeleteDC memDC
        ReleaseDC 0, screenDC
        Dim desc As PictDesc, iid As PictGuid, pic As IPictureDisp
        desc.Size = LenB(desc)
        desc.Kind = 1
        desc.Handle = bmp
        ' IID_IPictureDisp, {7BF80981-BF32-101A-8BBB-00AA00300CAB}
        iid.Data1 = &H7BF80981
        iid.Data2 = &HBF32
        iid.Data3 = &H101A
        iid.Data4(0) = &H8B
        iid.Data4(1) = &HBB
        iid.Data4(3) = &HAA
        iid.Data4(5) = &H30
        iid.Data4(6) = &HC
        iid.Data4(7) = &HAB
        OleCreatePictureIndirect desc, iid, 1, pic
        Set ColorSquare = pic
    End Function

    ' The color of a pixel of an item drawn on a white ground: white where the item draws nothing.
    Private Function DrawnColor(ByVal Image As ImlListImage, Optional ByVal Style As ImlDrawConstants) As Long
        Dim screenDC As LongPtr, memDC As LongPtr, bmp As LongPtr, oldBmp As LongPtr
        screenDC = GetDC(0)
        memDC = CreateCompatibleDC(screenDC)
        bmp = CreateCompatibleBitmap(screenDC, 64, 64)
        oldBmp = SelectObject(memDC, bmp)
        PatBlt memDC, 0, 0, 64, 64, WHITENESS
        Image.Draw memDC, 0, 0, Style
        DrawnColor = GetPixel(memDC, 2, 2)
        SelectObject memDC, oldBmp
        DeleteObject bmp
        DeleteDC memDC
        ReleaseDC 0, screenDC
    End Function

    ' ---- the ImageList control ----

    [TestCase]
    Public Sub ImageWidth_NewList_IsZero()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Expect.AreEqual 0, CLng(f.ImageList1.ImageWidth), "ImageWidth of a new list"
        Expect.AreEqual 0, CLng(f.ImageList1.ImageHeight), "ImageHeight of a new list"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_FirstPicture_SetsImageWidthAndImageHeight()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , , ColorSquare(vbRed, 24, 20)
        Expect.AreEqual 24, CLng(f.ImageList1.ImageWidth), "ImageWidth after a bitmap 24 pixels wide is added to a new list"
        Expect.AreEqual 20, CLng(f.ImageList1.ImageHeight), "ImageHeight after a bitmap 20 pixels high is added to a new list"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageWidth_ListWithPictures_Raises35611()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , , ColorSquare(vbRed)
        On Error Resume Next
        Err.Clear
        f.ImageList1.ImageWidth = 32
        Expect.AreEqual 35611, Err.Number, "ImageWidth = 32 in a list with a picture"
        On Error GoTo 0
        Expect.AreEqual 16, CLng(f.ImageList1.ImageWidth), "ImageWidth after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageHeight_ListWithPictures_Raises35611()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , , ColorSquare(vbRed)
        On Error Resume Next
        Err.Clear
        f.ImageList1.ImageHeight = 32
        Expect.AreEqual 35611, Err.Number, "ImageHeight = 32 in a list with a picture"
        On Error GoTo 0
        Expect.AreEqual 16, CLng(f.ImageList1.ImageHeight), "ImageHeight after the refused assignment"
        Unload f
        Expect.Done
    End Sub

