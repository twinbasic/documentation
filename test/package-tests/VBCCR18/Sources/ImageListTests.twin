    [TestCase]
    Public Sub hImageList_EmptyList_IsZero()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Expect.IsTrue f.ImageList1.hImageList = 0, "hImageList of a new list is 0"
        f.ImageList1.ListImages.Add , , ColorSquare(vbRed)
        Expect.IsTrue f.ImageList1.hImageList <> 0, "hImageList of a list with a picture is not 0"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub hImageList_ImageWidthAndImageHeightSet_IsNotZero()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ImageWidth = 32
        Expect.IsTrue f.ImageList1.hImageList = 0, "hImageList of an empty list with ImageWidth alone set is 0"
        f.ImageList1.ImageHeight = 32
        Expect.IsTrue f.ImageList1.hImageList <> 0, "hImageList of an empty list with ImageWidth and ImageHeight set is not 0"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Clear_ResetsTheSizeAndTheHandle()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1
            .ImageWidth = 32: .ImageHeight = 32
            .ListImages.Add , , ColorSquare(vbRed, 32, 32)
            .ListImages.Add , , ColorSquare(vbBlue, 32, 32)
            .ListImages.Clear
            Expect.AreEqual 0, CLng(.ListImages.Count), "Count after Clear"
            Expect.AreEqual 0, CLng(.ImageWidth), "ImageWidth after Clear, in a list whose ImageWidth the program had set to 32"
            Expect.AreEqual 0, CLng(.ImageHeight), "ImageHeight after Clear"
            Expect.IsTrue .hImageList = 0, "hImageList after Clear is 0"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Remove_LastPicture_ResetsTheSizeAndTheHandle()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1
            .ListImages.Add , , ColorSquare(vbRed)
            .ListImages.Add , , ColorSquare(vbBlue)
            .ListImages.Remove 1
            Expect.AreEqual 16, CLng(.ImageWidth), "ImageWidth after one of two pictures is removed"
            .ListImages.Remove 1
            Expect.AreEqual 0, CLng(.ImageWidth), "ImageWidth after the only picture left is removed"
            Expect.AreEqual 0, CLng(.ImageHeight), "ImageHeight after the only picture left is removed"
            Expect.IsTrue .hImageList = 0, "hImageList after the only picture left is removed is 0"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_Icon_IsScaledToTheList()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim icon As StdPicture
        With f.ImageList1
            ' An icon of 32 by 32 pixels, taken from a list of that size.
            .ListImages.Add , , ColorSquare(vbRed, 32, 32)
            Set icon = .ListImages(1).ExtractIcon
            .ListImages.Clear
            .ImageWidth = 16: .ImageHeight = 16
            .ListImages.Add , , icon
            Expect.AreEqual 1, ImageList_GetImageCount(.hImageList), "the pictures in the Windows image list of 16 by 16 after an icon of 32 by 32 is added"
            Expect.AreEqual CLng(vbRed), DrawnColor(.ListImages(1)), "the color the item of the icon draws"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_BitmapSmallerThanTheList_IsInTheWindowsList()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1
            .ImageWidth = 32: .ImageHeight = 32
            .ListImages.Add , , ColorSquare(vbRed, 16, 16)
            Expect.AreEqual 1, ImageList_GetImageCount(.hImageList), "the pictures in the Windows image list of 32 by 32 after a bitmap of 16 by 16 is added"
            .ListImages.Add , , ColorSquare(vbBlue, 32, 32)
            Expect.AreEqual CLng(vbRed), DrawnColor(.ListImages(1)), "the color the first item draws, a red bitmap of 16 by 16, after a blue one of 32 by 32 is added"
            Expect.AreEqual CLng(vbBlue), DrawnColor(.ListImages(2)), "the color the second item draws, a blue bitmap of 32 by 32"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_BitmapWiderThanTheList_AddsOnePicture()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1
            .ListImages.Add , , ColorSquare(vbRed, 16, 16)
            .ListImages.Add , , ColorSquare(vbGreen, 32, 16)
            Expect.AreEqual 2, CLng(.ListImages.Count), "Count after a bitmap of 16 by 16 and one of 32 by 16 are added"
            Expect.AreEqual 2, ImageList_GetImageCount(.hImageList), "the pictures in the Windows image list of 16 by 16 after a bitmap of 16 by 16 and one of 32 by 16 are added"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_BitmapOfTheMaskColor_IsTransparent()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1
            .ListImages.Add , , ColorSquare(SILVER)
            .ListImages.Add , , ColorSquare(vbRed)
            Expect.AreEqual CLng(vbWhite), DrawnColor(.ListImages(1)), "the color drawn on white by a bitmap of the default MaskColor, &HC0C0C0"
            Expect.AreEqual CLng(vbRed), DrawnColor(.ListImages(2)), "the color drawn on white by a red bitmap, with the default MaskColor"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MaskColor_Changed_LeavesThePicturesInTheList()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1
            .MaskColor = vbRed
            .ListImages.Add , , ColorSquare(vbRed)
            .MaskColor = vbBlue
            Expect.AreEqual CLng(vbWhite), DrawnColor(.ListImages(1)), "the color drawn on white by a red bitmap added with MaskColor red, after MaskColor = vbBlue"
            .ListImages.Add , , ColorSquare(vbRed)
            Expect.AreEqual CLng(vbRed), DrawnColor(.ListImages(2)), "the color drawn on white by a red bitmap added with MaskColor blue"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_UseMaskColorFalse_KeepsTheMaskColor()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1
            .UseMaskColor = False
            .ListImages.Add , , ColorSquare(SILVER)
            Expect.AreEqual SILVER, DrawnColor(.ListImages(1)), "the color drawn on white by a bitmap of the MaskColor added with UseMaskColor False"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub UseBackColor_True_DrawsTheTransparentPartsInBackColor()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1
            .ListImages.Add , , ColorSquare(SILVER)
            .BackColor = vbBlue
            Expect.AreEqual CLng(vbWhite), DrawnColor(.ListImages(1)), "the color drawn on white by a transparent picture, BackColor blue and UseBackColor False"
            .UseBackColor = True
            Expect.AreEqual CLng(vbBlue), DrawnColor(.ListImages(1)), "the color drawn on white by a transparent picture, BackColor blue and UseBackColor True"
            .UseBackColor = False
            Expect.AreEqual CLng(vbWhite), DrawnColor(.ListImages(1)), "the color drawn on white by a transparent picture after UseBackColor = False again"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ImageList_OfAControl_EmptyList_IsNotTaken()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.CheckBoxW1.ImageList = f.ImageList1
        Expect.AreEqual "Nothing", TypeName(f.CheckBoxW1.ImageList), "the type of CheckBoxW1.ImageList after an empty ImageList is assigned"
        f.ImageList1.ListImages.Add , , ColorSquare(vbRed)
        f.CheckBoxW1.ImageList = f.ImageList1
        Expect.AreEqual "ImageList", TypeName(f.CheckBoxW1.ImageList), "the type of CheckBoxW1.ImageList after an ImageList with a picture is assigned"
        f.CheckBoxW1.ImageList = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Overlay_TwoPictures_ReturnsAnIcon()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim icon As StdPicture
        With f.ImageList1
            .ListImages.Add , "file", ColorSquare(vbWhite)
            .ListImages.Add , "arrow", ColorSquare(vbBlue)
            Set icon = .Overlay("file", "arrow")
            Expect.IsFalse icon Is Nothing, "Overlay of two pictures returns a picture"
            If Not icon Is Nothing Then Expect.AreEqual CLng(vbPicTypeIcon), CLng(icon.Type), "the Type of the picture Overlay returns"
            Expect.AreEqual 2, CLng(.ListImages.Count), "Count after Overlay"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Overlay_EmptyList_ReturnsNothing()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Expect.IsTrue f.ImageList1.Overlay(1, 2) Is Nothing, "Overlay(1, 2) of an empty list is Nothing"
        Unload f
        Expect.Done
    End Sub

    ' ---- the ImlListImages collection ----

    [TestCase]
    Public Sub Add_AtAnIndex_MovesTheLaterPicturesUp()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1.ListImages
            .Add , "open", ColorSquare(vbRed)
            .Add , "save", ColorSquare(vbBlue)
            .Add 1, "new", ColorSquare(vbGreen)
            Expect.AreEqual "new open save", .Item(1).Key & " " & .Item(2).Key & " " & .Item(3).Key, "the keys in order after Add 1 before two pictures"
            Expect.AreEqual 2, CLng(.Item("open").Index), "Index of the picture that was first, after Add 1"
            Expect.AreEqual 3, CLng(.Item("save").Index), "Index of the picture that was second, after Add 1"
            Expect.AreEqual CLng(vbGreen), DrawnColor(.Item(1)), "the color the item 1 draws after a green bitmap is added at 1"
            Expect.AreEqual CLng(vbRed), DrawnColor(.Item(2)), "the color the item 2 draws, the red bitmap that was first"
            Expect.AreEqual CLng(vbBlue), DrawnColor(.Item(3)), "the color the item 3 draws, the blue bitmap that was second"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Remove_RenumbersTheLaterPictures()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1.ListImages
            .Add , "open", ColorSquare(vbRed)
            .Add , "save", ColorSquare(vbBlue)
            .Add , "print", ColorSquare(vbGreen)
            .Remove "open"
            Expect.AreEqual 2, CLng(.Count), "Count after one of three pictures is removed"
            Expect.AreEqual 1, CLng(.Item("save").Index), "Index of the second picture after the first is removed"
            Expect.AreEqual 2, CLng(.Item("print").Index), "Index of the third picture after the first is removed"
            Expect.AreEqual CLng(vbBlue), DrawnColor(.Item(1)), "the color the item 1 draws after the first picture is removed"
            Expect.AreEqual CLng(vbGreen), DrawnColor(.Item(2)), "the color the item 2 draws after the first picture is removed"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Item_ByKey_IgnoresCase()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1.ListImages
            .Add , "open", ColorSquare(vbRed)
            .Add , "Save", ColorSquare(vbBlue)
            Expect.AreEqual 2, CLng(.Item("SAVE").Index), "Index of Item(""SAVE"") where the key is ""Save"""
            Expect.AreEqual "Save", .Item("save").Key, "Key of Item(""save"") where the key is ""Save"""
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Item_NumberOutOfRange_Raises9()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim image As ImlListImage
        f.ImageList1.ListImages.Add , "open", ColorSquare(vbRed)
        On Error Resume Next
        Err.Clear
        Set image = f.ImageList1.ListImages(2)
        Expect.AreEqual 9, Err.Number, "Item(2) of a list with one picture"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Item_UnknownKey_Raises5()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim image As ImlListImage
        f.ImageList1.ListImages.Add , "open", ColorSquare(vbRed)
        On Error Resume Next
        Err.Clear
        Set image = f.ImageList1.ListImages("save")
        Expect.AreEqual 5, Err.Number, "Item(""save"") of a list with no such key"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_NoPicture_Raises35607()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ImageList1.ListImages.Add
        Expect.AreEqual 35607, Err.Number, "Add without a picture"
        Err.Clear
        f.ImageList1.ListImages.Add , , Nothing
        Expect.AreEqual 35607, Err.Number, "Add with Nothing"
        Err.Clear
        f.ImageList1.ListImages.Add , , LoadPicture("")
        Expect.AreEqual 35607, Err.Number, "Add with LoadPicture("""")"
        On Error GoTo 0
        Expect.AreEqual 0, CLng(f.ImageList1.ListImages.Count), "Count after the refused calls"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_IndexOutOfRange_Raises35600()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , , ColorSquare(vbRed)
        On Error Resume Next
        Err.Clear
        f.ImageList1.ListImages.Add 3, , ColorSquare(vbBlue)
        Expect.AreEqual 35600, Err.Number, "Add 3 in a list with one picture"
        Err.Clear
        f.ImageList1.ListImages.Add -1, , ColorSquare(vbBlue)
        Expect.AreEqual 35600, Err.Number, "Add -1"
        On Error GoTo 0
        Expect.AreEqual 1, CLng(f.ImageList1.ListImages.Count), "Count after the refused calls"
        f.ImageList1.ListImages.Add 2, , ColorSquare(vbBlue)
        Expect.AreEqual 2, CLng(f.ImageList1.ListImages.Count), "Count after Add 2 in a list with one picture"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_DuplicateKey_Raises457()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , "open", ColorSquare(vbRed)
        On Error Resume Next
        Err.Clear
        f.ImageList1.ListImages.Add , "OPEN", ColorSquare(vbBlue)
        Expect.AreEqual 457, Err.Number, "Add with the key ""OPEN"" in a list that has the key ""open"""
        On Error GoTo 0
        Expect.AreEqual 1, CLng(f.ImageList1.ListImages.Count), "Count after the refused call"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_DuplicateKey_LeavesTheWindowsListAsItWas()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , "open", ColorSquare(vbRed)
        On Error Resume Next
        f.ImageList1.ListImages.Add , "open", ColorSquare(vbBlue)
        On Error GoTo 0
        Expect.AreEqual 1, ImageList_GetImageCount(f.ImageList1.hImageList), "the pictures in the Windows image list of a list with one picture, after an Add that raised error 457 for its key"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Exists_SaysWhetherTheListHasTheNumberOrKey()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1.ListImages
            .Add , "open", ColorSquare(vbRed)
            .Add , , ColorSquare(vbBlue)
            Expect.IsTrue .Exists("open"), "Exists(""open"") in a list with that key"
            Expect.IsFalse .Exists("save"), "Exists(""save"") in a list without that key"
            Expect.IsTrue .Exists(2), "Exists(2) in a list of two pictures"
            Expect.IsFalse .Exists(3), "Exists(3) in a list of two pictures"
        End With
        Unload f
        Expect.Done
    End Sub

    ' ---- the ImlListImage item ----

    [TestCase]
    Public Sub Key_Assigned_RenamesThePicture()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1.ListImages
            .Add , "open", ColorSquare(vbRed)
            .Add , "save", ColorSquare(vbBlue)
            .Item("open").Key = "load"
            Expect.AreEqual "load", .Item(1).Key, "Key of the first picture after Key = ""load"""
            Expect.IsFalse .Exists("open"), "Exists of the old key"
            Expect.AreEqual 1, CLng(.Item("load").Index), "Index of the picture found by its new key"
            Expect.AreEqual 2, CLng(.Item("save").Index), "Index of the other picture"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Key_Empty_TakesTheKeyAway()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1.ListImages
            .Add , "open", ColorSquare(vbRed)
            .Item(1).Key = ""
            Expect.AreEqual 0, Len(.Item(1).Key), "Len(Key) after Key = """""
            Expect.IsFalse .Exists("open"), "Exists of the old key"
            Expect.AreEqual 1, CLng(.Count), "Count after the key is taken away"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Key_OfAnotherPicture_Raises457()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , "open", ColorSquare(vbRed)
        f.ImageList1.ListImages.Add , "save", ColorSquare(vbBlue)
        On Error Resume Next
        Err.Clear
        f.ImageList1.ListImages(2).Key = "open"
        Expect.AreEqual 457, Err.Number, "Key = ""open"" on the second picture, where the first has that key"
        On Error GoTo 0
        Expect.AreEqual "save", f.ImageList1.ListImages(2).Key, "Key after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Picture_Assigned_Raises383()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , , ColorSquare(vbRed)
        On Error Resume Next
        Err.Clear
        Set f.ImageList1.ListImages(1).Picture = ColorSquare(vbBlue)
        Expect.AreEqual 383, Err.Number, "Set Picture on an item"
        On Error GoTo 0
        Expect.AreEqual CLng(vbRed), DrawnColor(f.ImageList1.ListImages(1)), "the color the item draws after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Tag_NewPicture_IsAnEmptyString()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageList1.ListImages.Add , , ColorSquare(vbRed)
        Expect.AreEqual CLng(vbString), CLng(VarType(f.ImageList1.ListImages(1).Tag)), "VarType(Tag) of a new picture"
        Expect.AreEqual 0, Len(f.ImageList1.ListImages(1).Tag), "Len(Tag) of a new picture"
        f.ImageList1.ListImages(1).Tag = 42
        Expect.AreEqual 42, CLng(f.ImageList1.ListImages(1).Tag), "Tag after Tag = 42"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Draw_Transparent_IgnoresBackColor()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1
            .ListImages.Add , , ColorSquare(SILVER)
            .BackColor = vbBlue
            .UseBackColor = True
            Expect.AreEqual CLng(vbBlue), DrawnColor(.ListImages(1), ImlDrawNormal), "the color drawn on white by a transparent picture with ImlDrawNormal, BackColor blue in use"
            Expect.AreEqual CLng(vbWhite), DrawnColor(.ListImages(1), ImlDrawTransparent), "the color drawn on white by a transparent picture with ImlDrawTransparent, BackColor blue in use"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Draw_NoMask_DrawsTheMaskedPixelsBlack()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageList1
            .ListImages.Add , , ColorSquare(SILVER)
            .ListImages.Add , , ColorSquare(vbRed)
            Expect.AreEqual CLng(vbBlack), DrawnColor(.ListImages(1), ImlDrawNoMask), "the color drawn with ImlDrawNoMask by a bitmap of the mask color"
            Expect.AreEqual CLng(vbRed), DrawnColor(.ListImages(2), ImlDrawNoMask), "the color drawn with ImlDrawNoMask by a red bitmap"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ExtractIcon_ReturnsAnIcon()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim icon As StdPicture
        f.ImageList1.ListImages.Add , , ColorSquare(vbRed)
        Set icon = f.ImageList1.ListImages(1).ExtractIcon
        Expect.IsFalse icon Is Nothing, "ExtractIcon returns a picture"
        If Not icon Is Nothing Then Expect.AreEqual CLng(vbPicTypeIcon), CLng(icon.Type), "the Type of the picture ExtractIcon returns"
        Expect.AreEqual CLng(vbPicTypeBitmap), CLng(f.ImageList1.ListImages(1).Picture.Type), "the Type of Picture of an item added from a bitmap"
        Unload f
        Expect.Done
    End Sub

End Module
