    Public Sub BackColor_NotAColor_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ImageList1.BackColor = -1
        Expect.AreEqual 380, Err.Number, "BackColor = -1"
        On Error GoTo 0
        Expect.IsTrue f.ImageList1.BackColor = vbWindowBackground, "BackColor of a new list, after the refused assignment, is vbWindowBackground"
