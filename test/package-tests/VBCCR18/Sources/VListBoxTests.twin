' VListBoxTests: the events through which a VListBox asks for its items and has them searched,
' and the members that depend on them.
[TestFixture]
Module VListBoxTests

    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal Msg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr

    Private Const WM_CHAR As Long = &H102
    Private Const WM_MOUSEMOVE As Long = &H200

    [TestCase]
    Public Sub List_RaisesGetVirtualItem()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New VListBoxSink
        Set sink.List = f.VListBox1
        f.VListBox1.ListCount = 1000
        sink.LogItems = True
        Rig.ClearLog
        Expect.AreEqual "Item 5", f.VListBox1.List(5), "List(5), with a handler that gives ""Item "" and the index"
        Expect.AreEqual "GetVirtualItem 5", Rig.Events(), "the events of reading List(5)"
        sink.LogItems = False
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub List_NoHandler_IsEmpty()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.VListBox1.ListCount = 3
        Expect.AreEqual "", f.VListBox1.List(1), "List(1) with no handler of GetVirtualItem"
        Expect.AreEqual -1, f.VListBox1.FindItem("Item 1"), "FindItem with no handler of FindVirtualItem"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub List_NoSuchItem_Raises5()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim s As String
        f.VListBox1.ListCount = 10
        On Error Resume Next
        Err.Clear
        s = f.VListBox1.List(-1)
        Expect.AreEqual 5, Err.Number, "reading List(-1)"
        Err.Clear
        s = f.VListBox1.List(10)
        Expect.AreEqual 5, Err.Number, "reading List(10) of a list of ten"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ListCount_Negative_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.VListBox1.ListCount = 10
        On Error Resume Next
        Err.Clear
        f.VListBox1.ListCount = -1
        Expect.AreEqual 380, Err.Number, "ListCount = -1"
        On Error GoTo 0
        Expect.AreEqual 10, f.VListBox1.ListCount, "ListCount after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ListCount_Assigned_RemovesTheSelection()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New VListBoxSink
        Set sink.List = f.VListBox1
        f.VListBox1.ListCount = 10
        f.VListBox1.ListIndex = 1
        Rig.ClearLog
        f.VListBox1.ListCount = 50
        Expect.AreEqual -1, f.VListBox1.ListIndex, "ListIndex after ListCount = 50 with item 1 selected"
        Expect.AreEqual "", Rig.Events(), "the events of ListCount = 50"
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ListIndex_Assigned_SelectsAndRaisesClick()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New VListBoxSink
        Set sink.List = f.VListBox1
        f.VListBox1.ListCount = 1000
        Rig.ClearLog
        f.VListBox1.ListIndex = 3
        f.VListBox1.ListIndex = 3
        Expect.AreEqual "Click 3", Rig.Events(), "the events of ListIndex = 3, twice"
        Expect.AreEqual "Item 3", f.VListBox1.Text, "Text after ListIndex = 3"
        Expect.IsTrue f.VListBox1.Selected(3), "Selected(3) after ListIndex = 3"
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ListIndex_NoSuchItem_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.VListBox1.ListCount = 10
        On Error Resume Next
        Err.Clear
        f.VListBox1.ListIndex = 10
        Expect.AreEqual 380, Err.Number, "ListIndex = 10 in a list of ten"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Selected_NoSuchItem_Raises381()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim b As Boolean
        f.VListBox1.ListCount = 10
        On Error Resume Next
        Err.Clear
        b = f.VListBox1.Selected(10)
        Expect.AreEqual 381, Err.Number, "reading Selected(10) of a list of ten"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindItem_RaisesFindVirtualItem()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New VListBoxSink
        Set sink.List = f.VListBox1
        f.VListBox1.ListCount = 1000
        Rig.ClearLog
        Expect.AreEqual 9, f.VListBox1.FindItem("item 9"), "FindItem(""item 9""), with a handler that searches ""Item "" and the index"
        Expect.AreEqual 90, f.VListBox1.FindItem("item 9", 20, True), "FindItem(""item 9"", 20, True)"
        Expect.AreEqual -1, f.VListBox1.FindItem("zz"), "FindItem(""zz"")"
        Expect.AreEqual "FindVirtualItem -1 [item 9] False | FindVirtualItem 20 [item 9] True | FindVirtualItem -1 [zz] False", Rig.Events(), "the events of the three calls"
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Text_Assigned_RaisesFindVirtualItemAndSelects()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New VListBoxSink
        Set sink.List = f.VListBox1
        f.VListBox1.ListCount = 1000
        Rig.ClearLog
        f.VListBox1.Text = "Item 7"
        Expect.AreEqual "FindVirtualItem -1 [Item 7] False | Click 7", Rig.Events(), "the events of Text = ""Item 7"""
        Expect.AreEqual 7, f.VListBox1.ListIndex, "ListIndex after Text = ""Item 7"""
        f.VListBox1.Text = "mauve"
        Expect.AreEqual -1, f.VListBox1.ListIndex, "ListIndex after Text = ""mauve"", which the handler does not find"
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelectItem_SelectsWhatTheHandlerFound()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New VListBoxSink
        Set sink.List = f.VListBox1
        f.VListBox1.ListCount = 1000
        Rig.ClearLog
        Expect.AreEqual 12, f.VListBox1.SelectItem("item 12"), "SelectItem(""item 12"")"
        Expect.AreEqual "FindVirtualItem -1 [item 12] True | Click 12", Rig.Events(), "the events of SelectItem(""item 12"")"
        Expect.AreEqual 12, f.VListBox1.ListIndex, "ListIndex after SelectItem(""item 12"")"
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub TypedCharacter_RaisesIncrementalSearchAndSelects()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New VListBoxSink
        Set sink.List = f.VListBox1
        f.VListBox1.ListCount = 20
        f.VListBox1.ListIndex = 2
        Rig.ClearLog
        ' The user types "b"; the handler answers with item 5.
        SendMessageW f.VListBox1.hWnd, WM_CHAR, AscW("b"), 0
        Expect.AreEqual "IncrementalSearch [b] 2 | Click 5", Rig.Events(), "the events of a character typed with item 2 selected"
        Expect.AreEqual 5, f.VListBox1.ListIndex, "ListIndex after the handler set FoundIndex to 5"
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MultiSelect_AtRunTime_KeepsListCount()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.VListBox1.ListCount = 10
        f.VListBox1.MultiSelect = vbMultiSelectSimple
        Expect.AreEqual 1, CLng(f.VListBox1.MultiSelect), "MultiSelect after MultiSelect = vbMultiSelectSimple"
        Expect.AreEqual 10, f.VListBox1.ListCount, "ListCount after MultiSelect = vbMultiSelectSimple"
        f.VListBox1.Selected(1) = True
        f.VListBox1.Selected(4) = True
        Expect.AreEqual 2, f.VListBox1.SelCount, "SelCount with two items selected"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MultiSelect_AssignedToAnEmptyList_RaisesNoError()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim raised As Long
        On Error Resume Next
        Err.Clear
        f.VListBox1.MultiSelect = vbMultiSelectSimple
        raised = Err.Number
        On Error GoTo 0
        Expect.IsTrue raised <> 380, "MultiSelect = vbMultiSelectSimple on an empty list raises no error 380"
        Expect.AreEqual 1, CLng(f.VListBox1.MultiSelect), "MultiSelect after the assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub DrawMode_AtRunTime_Raises382()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.VListBox1.DrawMode = VlbDrawModeOwnerDrawFixed
        Expect.AreEqual 382, Err.Number, "DrawMode = VlbDrawModeOwnerDrawFixed at run time"
        Err.Clear
        f.VListBox1.DrawMode = 2
        Expect.AreEqual 380, Err.Number, "DrawMode = 2"
        On Error GoTo 0
        Expect.AreEqual 0, CLng(f.VListBox1.DrawMode), "DrawMode after the refused assignments"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub IntegralHeight_AtRunTime_Raises382()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.VListBox1.IntegralHeight = False
        Expect.AreEqual 382, Err.Number, "IntegralHeight = False at run time"
        On Error GoTo 0
        Expect.IsTrue f.VListBox1.IntegralHeight, "IntegralHeight after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub HitTest_EmptyList_ReturnsMinus1()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Expect.AreEqual -1, f.VListBox1.HitTest(0, 0), "HitTest(0, 0) of an empty list"
        f.VListBox1.ListCount = 5
        Expect.AreEqual 0, f.VListBox1.HitTest(0, 0), "HitTest(0, 0) of a list of five"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MouseMove_XAndY_AreInTwips()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New VListBoxSink
        Set sink.List = f.VListBox1
        f.ScaleMode = vbPixels
        Rig.ClearLog
        ' The pointer moves to the pixel (10, 5) of the list.
        SendMessageW f.VListBox1.hWnd, WM_MOUSEMOVE, 0, &H5000A
        Expect.AreEqual "MouseMove " & (10 * Screen.TwipsPerPixelX) & " " & (5 * Screen.TwipsPerPixelY), Rig.Events(), "MouseMove at the pixel (10, 5), on a form whose ScaleMode is vbPixels"
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

End Module

' A program's side of a VListBox: item n has the text "Item n". The events are written to
' Rig.Log, GetVirtualItem only while LogItems is True.
Class VListBoxSink

    Public WithEvents List As VBCCR18.VListBox
    Public LogItems As Boolean

    Private Sub List_GetVirtualItem(ByVal Item As Long, Text As String) Handles List.GetVirtualItem
        If LogItems Then Rig.Ev "GetVirtualItem " & Item
        Text = "Item " & Item
    End Sub

    Private Sub List_FindVirtualItem(ByVal StartIndex As Long, ByVal SearchText As String, ByVal Partial As Boolean, FoundIndex As Long) Handles List.FindVirtualItem
        Rig.Ev "FindVirtualItem " & StartIndex & " [" & SearchText & "] " & Partial
        Dim i As Long, candidate As String
        For i = StartIndex + 1 To List.ListCount - 1
            candidate = "Item " & i
            If Partial Then candidate = Left$(candidate, Len(SearchText))
            If StrComp(candidate, SearchText, vbTextCompare) = 0 Then
                FoundIndex = i
                Exit Sub
            End If
        Next
    End Sub

    Private Sub List_IncrementalSearch(ByVal SearchString As String, ByVal StartIndex As Long, FoundIndex As Long) Handles List.IncrementalSearch
        Rig.Ev "IncrementalSearch [" & SearchString & "] " & StartIndex
        FoundIndex = 5
    End Sub

    Private Sub List_Click() Handles List.Click
        Rig.Ev "Click " & List.ListIndex
    End Sub

    Private Sub List_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single) Handles List.MouseMove
        Rig.Ev "MouseMove " & X & " " & Y
    End Sub

End Class
