' TextBoxWTests: the text, the selection, the lines, the limits on typing and the network address
' check of the TextBoxW. A key the user presses is given to the box as a WM_CHAR or WM_KEYDOWN
' message, which is what the keyboard sends it.
[TestFixture]
Module TextBoxWTests

    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
    Private Const WM_KEYDOWN As Long = &H100
    Private Const WM_CHAR As Long = &H102

    ' Gives the box a character, as a key the user presses does.
    Private Sub TypeChar(ByVal Box As VBCCR18.TextBoxW, ByVal Character As String)
        SendMessageW Box.hWnd, WM_CHAR, AscW(Character), 0
    End Sub

    ' Twenty lines, "1" to "20".
    Private Function TwentyLines() As String
        Dim i As Long
        For i = 1 To 20
            TwentyLines = TwentyLines & IIf(i > 1, vbCrLf, "") & CStr(i)
        Next
    End Function

    [TestCase]
    Public Sub Text_LongerThanMaxLength_IsCutToIt()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.MaxLength = 3
        f.TextBoxW1.Text = "abcdef"
        Expect.AreEqual "abc", f.TextBoxW1.Text, "Text after Text = ""abcdef"" with MaxLength 3"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Typing_PastMaxLength_RaisesMaxText()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New TextBoxWSink
        Set sink.Box = f.TextBoxW1
        f.TextBoxW1.MaxLength = 2
        f.TextBoxW1.Text = "12"
        f.TextBoxW1.SelStart = 2
        Rig.ClearLog
        TypeChar f.TextBoxW1, "3"
        Expect.AreEqual "MaxText", Rig.Events(), "the events of typing a third character with MaxLength 2"
        Expect.AreEqual "12", f.TextBoxW1.Text, "Text after typing a third character with MaxLength 2"
        Set sink.Box = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MaxLength_Negative_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.TextBoxW1.MaxLength = -1
        Expect.AreEqual 380, Err.Number, "MaxLength = -1"
        On Error GoTo 0
        Expect.AreEqual 0, CLng(f.TextBoxW1.MaxLength), "MaxLength after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Typing_Locked_ChangesNothing()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.Text = "q"
        f.TextBoxW1.Locked = True
        TypeChar f.TextBoxW1, "b"
        Expect.AreEqual "q", f.TextBoxW1.Text, "Text after typing b into a locked box that holds q"
        f.TextBoxW1.Text = "set"
        Expect.AreEqual "set", f.TextBoxW1.Text, "Text after Text = ""set"" on a locked box"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Typing_AllowOnlyNumbers_RefusesALetter()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.Text = ""
        f.TextBoxW1.AllowOnlyNumbers = True
        TypeChar f.TextBoxW1, "c"
        TypeChar f.TextBoxW1, "7"
        Expect.AreEqual "7", f.TextBoxW1.Text, "Text after typing c and 7 with AllowOnlyNumbers"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Text_AllowOnlyNumbers_TakesLetters()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.AllowOnlyNumbers = True
        f.TextBoxW1.Text = "letters"
        Expect.AreEqual "letters", f.TextBoxW1.Text, "Text after Text = ""letters"" with AllowOnlyNumbers"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub CharacterCasing_Upper_ConvertsWhatIsAssignedAndTyped()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.CharacterCasing = TxtCharacterCasingUpper
        f.TextBoxW1.Text = "def"
        Expect.AreEqual "DEF", f.TextBoxW1.Text, "Text after Text = ""def"" with TxtCharacterCasingUpper"
        f.TextBoxW1.SelStart = 3
        TypeChar f.TextBoxW1, "g"
        Expect.AreEqual "DEFG", f.TextBoxW1.Text, "Text after typing g at the end"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub CharacterCasing_Upper_LeavesTheTextAlreadyThere()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.Text = "abc"
        f.TextBoxW1.CharacterCasing = TxtCharacterCasingUpper
        Expect.AreEqual "abc", f.TextBoxW1.Text, "Text ""abc"" after CharacterCasing = TxtCharacterCasingUpper"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub OverTypeMode_WithoutAllowOverType_StaysFalse()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.OverTypeMode = True
        Expect.IsFalse f.TextBoxW1.OverTypeMode, "OverTypeMode after OverTypeMode = True with AllowOverType False"
        f.TextBoxW1.AllowOverType = True
        f.TextBoxW1.OverTypeMode = True
        Expect.IsTrue f.TextBoxW1.OverTypeMode, "OverTypeMode after OverTypeMode = True with AllowOverType True"
        f.TextBoxW1.AllowOverType = False
        Expect.IsFalse f.TextBoxW1.OverTypeMode, "OverTypeMode after AllowOverType = False"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Typing_OverTypeMode_ReplacesTheNextCharacter()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.AllowOverType = True
        f.TextBoxW1.OverTypeMode = True
        f.TextBoxW1.Text = "abc"
        f.TextBoxW1.SelStart = 0
        TypeChar f.TextBoxW1, "X"
        Expect.AreEqual "Xbc", f.TextBoxW1.Text, "Text ""abc"" after typing X at the start in overtype mode"
        f.TextBoxW1.SelStart = 3
        TypeChar f.TextBoxW1, "Z"
        Expect.AreEqual "XbcZ", f.TextBoxW1.Text, "Text after typing Z at the end in overtype mode"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub InsertKey_AllowOverType_TogglesOverTypeMode()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.AllowOverType = True
        SendMessageW f.TextBoxW1.hWnd, WM_KEYDOWN, vbKeyInsert, 0
        Expect.IsTrue f.TextBoxW1.OverTypeMode, "OverTypeMode after the Insert key with AllowOverType True"
        SendMessageW f.TextBoxW1.hWnd, WM_KEYDOWN, vbKeyInsert, 0
        Expect.IsFalse f.TextBoxW1.OverTypeMode, "OverTypeMode after the Insert key again"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Text_Assigned_RaisesChangeOnlyWhenItDiffers()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New TextBoxWSink
        Set sink.Box = f.TextBoxW1
        f.TextBoxW1.Text = ""
        Rig.ClearLog
        f.TextBoxW1.Text = "x"
        f.TextBoxW1.Text = "x"
        f.TextBoxW1.Text = "y"
        Expect.AreEqual "Change x | Change y", Rig.Events(), "the events of Text = ""x"", Text = ""x"", Text = ""y"""
        Set sink.Box = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Text_Assigned_EmptiesUndoAndMovesTheInsertionPointToTheStart()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.Text = ""
        TypeChar f.TextBoxW1, "a"
        Expect.IsTrue f.TextBoxW1.CanUndo, "CanUndo after typing a"
        f.TextBoxW1.Text = "xyz"
        Expect.IsFalse f.TextBoxW1.CanUndo, "CanUndo after Text = ""xyz"""
        Expect.AreEqual 0, CLng(f.TextBoxW1.SelStart), "SelStart after Text = ""xyz"""
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Modified_TrueAfterTyping_FalseAfterText()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.Text = ""
        Expect.IsFalse f.TextBoxW1.Modified, "Modified after Text = """""
        TypeChar f.TextBoxW1, "a"
        Expect.IsTrue f.TextBoxW1.Modified, "Modified after typing a"
        f.TextBoxW1.Text = "q"
        Expect.IsFalse f.TextBoxW1.Modified, "Modified after Text = ""q"""
        f.TextBoxW1.SelText = "r"
        Expect.IsTrue f.TextBoxW1.Modified, "Modified after SelText = ""r"""
        f.TextBoxW1.Modified = False
        Expect.IsFalse f.TextBoxW1.Modified, "Modified after Modified = False"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Undo_TakesBackWhatWasTyped()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.Text = ""
        TypeChar f.TextBoxW1, "a"
        f.TextBoxW1.Undo
        Expect.AreEqual "", f.TextBoxW1.Text, "Text after typing a and Undo"
        f.TextBoxW1.Undo
        Expect.AreEqual "a", f.TextBoxW1.Text, "Text after a second Undo"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ResetUndoQueue_LeavesNothingToUndo()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.Text = ""
        TypeChar f.TextBoxW1, "a"
        f.TextBoxW1.ResetUndoQueue
        Expect.IsFalse f.TextBoxW1.CanUndo, "CanUndo after typing a and ResetUndoQueue"
        f.TextBoxW1.Undo
        Expect.AreEqual "a", f.TextBoxW1.Text, "Text after Undo with nothing to take back"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelText_Assigned_ReplacesTheSelection()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New TextBoxWSink
        Set sink.Box = f.TextBoxW1
        f.TextBoxW1.Text = "Hello world"
        f.TextBoxW1.SelStart = 6
        f.TextBoxW1.SelLength = 5
        Expect.AreEqual "world", f.TextBoxW1.SelText, "SelText with SelStart 6 and SelLength 5 in ""Hello world"""
        Rig.ClearLog
        f.TextBoxW1.SelText = "there"
        Expect.AreEqual "Hello there", f.TextBoxW1.Text, "Text after SelText = ""there"""
        Expect.AreEqual "Change Hello there", Rig.Events(), "the events of SelText = ""there"""
        Expect.AreEqual 11, CLng(f.TextBoxW1.SelStart), "SelStart after SelText = ""there"""
        Expect.AreEqual 0, CLng(f.TextBoxW1.SelLength), "SelLength after SelText = ""there"""
        f.TextBoxW1.Undo
        Expect.AreEqual "Hello world", f.TextBoxW1.Text, "Text after Undo"
        Set sink.Box = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelStart_PastTheEnd_IsTheEnd()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.Text = "Hello there"
        f.TextBoxW1.SelStart = 100
        Expect.AreEqual 11, CLng(f.TextBoxW1.SelStart), "SelStart after SelStart = 100 in a text of 11 characters"
        f.TextBoxW1.SelStart = 2
        f.TextBoxW1.SelLength = 100
        Expect.AreEqual 9, CLng(f.TextBoxW1.SelLength), "SelLength after SelLength = 100 from SelStart 2"
        Unload f
        Expect.Done
    End Sub

