    Public Sub OLEDropMode_OutOfRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.TextBoxW1.OLEDropMode = 3
        Expect.AreEqual 380, Err.Number, "OLEDropMode = 3"
