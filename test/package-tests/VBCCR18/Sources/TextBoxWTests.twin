    [TestCase]
    Public Sub MultiLine_Changed_MakesANewWindowAndKeepsTheText()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim before As LongPtr
        f.TextBoxW1.Text = "kept"
        f.TextBoxW1.SelStart = 1
        f.TextBoxW1.SelLength = 2
        before = f.TextBoxW1.hWnd
        f.TextBoxW1.MultiLine = True
        Expect.IsTrue f.TextBoxW1.hWnd <> 0, "hWnd after MultiLine = True is a window"
        Expect.IsTrue f.TextBoxW1.hWnd <> before, "hWnd after MultiLine = True is another window"
        Expect.AreEqual "kept", f.TextBoxW1.Text, "Text after MultiLine = True"
        Expect.AreEqual "ep", f.TextBoxW1.SelText, "SelText after MultiLine = True"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetLine_ReturnsTheLineOfThatNumber()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.MultiLine = True
        f.TextBoxW1.Text = "one" & vbCrLf & "two" & vbCrLf & vbCrLf & "four"
        Expect.AreEqual 4, CLng(f.TextBoxW1.GetLineCount), "GetLineCount of four lines"
        Expect.AreEqual "one", f.TextBoxW1.GetLine(1), "GetLine(1)"
        Expect.AreEqual "two", f.TextBoxW1.GetLine(2), "GetLine(2)"
        Expect.AreEqual "", f.TextBoxW1.GetLine(3), "GetLine(3), an empty line"
        Expect.AreEqual "four", f.TextBoxW1.GetLine(4), "GetLine(4)"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetLine_Zero_IsTheLineOfTheInsertionPoint()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.MultiLine = True
        f.TextBoxW1.Text = "one" & vbCrLf & "two" & vbCrLf & "three"
        f.TextBoxW1.SelStart = 6
        Expect.AreEqual "two", f.TextBoxW1.GetLine(0), "GetLine(0) with the insertion point in the second line"
        Expect.AreEqual 2, CLng(f.TextBoxW1.GetLineFromChar(-1)), "GetLineFromChar(-1) with the insertion point in the second line"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetLineFromChar_ReturnsTheLineNumber()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.MultiLine = True
        f.TextBoxW1.Text = "one" & vbCrLf & "two" & vbCrLf & "three"
        Expect.AreEqual 1, CLng(f.TextBoxW1.GetLineFromChar(0)), "GetLineFromChar(0)"
        Expect.AreEqual 2, CLng(f.TextBoxW1.GetLineFromChar(5)), "GetLineFromChar(5), the t of two"
        Expect.AreEqual 3, CLng(f.TextBoxW1.GetLineFromChar(999)), "GetLineFromChar(999), after the end of the text"
        Unload f
        Expect.Done
    End Sub

