    [TestCase]
    Public Sub PasswordChar_TwoCharacters_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.TextBoxW1.PasswordChar = "ab"
        Expect.AreEqual 380, Err.Number, "PasswordChar = ""ab"""
        On Error GoTo 0
        f.TextBoxW1.PasswordChar = "*"
        Expect.AreEqual "*", f.TextBoxW1.PasswordChar, "PasswordChar after PasswordChar = ""*"""
        f.TextBoxW1.UseSystemPasswordChar = True
        f.TextBoxW1.PasswordChar = "#"
        Expect.IsTrue f.TextBoxW1.PasswordChar <> "#", "PasswordChar after PasswordChar = ""#"" with UseSystemPasswordChar True is not #"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub PasswordChar_NoneSet_IsAnEmptyString()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Expect.AreEqual 0, Len(f.TextBoxW1.PasswordChar), "Len(PasswordChar) of a box with no password character"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowBalloonTip_IconOutOfRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim shown As Boolean
        On Error Resume Next
        Err.Clear
        shown = f.TextBoxW1.ShowBalloonTip("text", "title", 9)
        Expect.AreEqual 380, Err.Number, "ShowBalloonTip with the icon 9"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ValidateNetAddress_ValidatorOff_Raises5()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.Text = "example.com"
        On Error Resume Next
        Err.Clear
        f.TextBoxW1.ValidateNetAddress
        Expect.AreEqual 5, Err.Number, "ValidateNetAddress with NetAddressValidator False"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ValidateNetAddress_DnsName_GivesTheName()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.NetAddressValidator = True
        f.TextBoxW1.NetAddressType = TxtNetAddressTypeAnyService
        f.TextBoxW1.Text = "example.com:80"
        f.TextBoxW1.ValidateNetAddress
        Expect.AreEqual CLng(TxtNetAddressFormatDNSName), CLng(f.TextBoxW1.NetAddressFormat), "NetAddressFormat of example.com:80"
        Expect.AreEqual "example.com", f.TextBoxW1.NetAddressString, "NetAddressString of example.com:80"
        Expect.AreEqual 80, CLng(f.TextBoxW1.NetAddressPortNumber), "NetAddressPortNumber of example.com:80"
        f.TextBoxW1.Text = "[2001:db8::1]:443"
        f.TextBoxW1.ValidateNetAddress
        Expect.AreEqual CLng(TxtNetAddressFormatIPv6), CLng(f.TextBoxW1.NetAddressFormat), "NetAddressFormat of [2001:db8::1]:443"
        Expect.AreEqual "2001:DB8:0:0:0:0:0:1", f.TextBoxW1.NetAddressString, "NetAddressString of [2001:db8::1]:443"
        Expect.AreEqual 443, CLng(f.TextBoxW1.NetAddressPortNumber), "NetAddressPortNumber of [2001:db8::1]:443"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ValidateNetAddress_IPv4_GivesTheAddress()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.NetAddressValidator = True
        f.TextBoxW1.NetAddressType = TxtNetAddressTypeIPv4Service
        f.TextBoxW1.Text = "192.168.0.1:8080"
        f.TextBoxW1.ValidateNetAddress
        Expect.AreEqual CLng(TxtNetAddressFormatIPv4), CLng(f.TextBoxW1.NetAddressFormat), "NetAddressFormat of 192.168.0.1:8080"
        Expect.AreEqual 8080, CLng(f.TextBoxW1.NetAddressPortNumber), "NetAddressPortNumber of 192.168.0.1:8080"
        Expect.AreEqual "192.168.0.1", f.TextBoxW1.NetAddressString, "NetAddressString of 192.168.0.1:8080"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ValidateNetAddress_NotAnAddress_Raises5()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.NetAddressValidator = True
        f.TextBoxW1.NetAddressType = TxtNetAddressTypeIPv4Address
        f.TextBoxW1.Text = "not an address"
        On Error Resume Next
        Err.Clear
        f.TextBoxW1.ValidateNetAddress
        Expect.AreEqual 5, Err.Number, "ValidateNetAddress of ""not an address"""
        On Error GoTo 0
        Expect.AreEqual CLng(TxtNetAddressFormatNone), CLng(f.TextBoxW1.NetAddressFormat), "NetAddressFormat after the failed check"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ValidateNetAddress_Empty_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.TextBoxW1.NetAddressValidator = True
        f.TextBoxW1.NetAddressType = TxtNetAddressTypeAnyAddress
        f.TextBoxW1.Text = ""
        On Error Resume Next
        Err.Clear
        f.TextBoxW1.ValidateNetAddress
        Expect.AreEqual 380, Err.Number, "ValidateNetAddress of an empty box"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

End Module

' The events of a TextBoxW, written to Rig.Log.
Class TextBoxWSink

    Public WithEvents Box As VBCCR18.TextBoxW

    Private Sub Box_Change() Handles Box.Change
        Rig.Ev "Change " & Box.Text
    End Sub

    Private Sub Box_MaxText() Handles Box.MaxText
        Rig.Ev "MaxText"
    End Sub

    Private Sub Box_Scroll() Handles Box.Scroll
        Rig.Ev "Scroll"
    End Sub

End Class
