        Expect.Done
    End Sub

    [TestCase]
    Public Sub IntegralHeight_AtRunTime_Raises382()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ListBoxW1.IntegralHeight = False
        Expect.AreEqual 382, Err.Number, "IntegralHeight = False at run time"
        On Error GoTo 0
        Expect.IsTrue f.ListBoxW1.IntegralHeight, "IntegralHeight after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ItemChecked_StandardStyle_IsAlwaysFalse()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddColors f.ListBoxW1
        With f.ListBoxW1
            Expect.IsFalse .ItemChecked(0), "ItemChecked(0) in a LstStyleStandard list"
            .ItemChecked(0) = True
            Expect.IsFalse .ItemChecked(0), "ItemChecked(0) after ItemChecked(0) = True in a LstStyleStandard list"
            Expect.AreEqual 0, .CheckedIndices.Count, "CheckedIndices.Count in a LstStyleStandard list"
            .OptionIndex = 1
            Expect.AreEqual -1, .OptionIndex, "OptionIndex after OptionIndex = 1 in a LstStyleStandard list"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ItemChecked_NoSuchItem_Raises381()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim b As Boolean
        On Error Resume Next
        Err.Clear
        b = f.ListBoxW1.ItemChecked(99)
        Expect.AreEqual 381, Err.Number, "reading ItemChecked(99) of an empty list"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ItemData_NoSuchItem_Raises381()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim n As LongPtr
        On Error Resume Next
        Err.Clear
        n = f.ListBoxW1.ItemData(99)
        Expect.AreEqual 381, Err.Number, "reading ItemData(99) of an empty list"
        Err.Clear
        f.ListBoxW1.ItemData(99) = 1
        Expect.AreEqual 381, Err.Number, "ItemData(99) = 1 on an empty list"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub InsertMark_AssignedAndRead()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddColors f.ListBoxW1
        Dim after As Boolean
        With f.ListBoxW1
            Expect.AreEqual -1, .InsertMark, "InsertMark of a new control"
            .InsertMark = 2
            Expect.AreEqual 2, .InsertMark(after), "InsertMark after InsertMark = 2"
            Expect.IsFalse after, "After, read after InsertMark = 2"
            after = True
            .InsertMark(after) = 3
            after = False
            Expect.AreEqual 3, .InsertMark(after), "InsertMark after InsertMark(True) = 3"
            Expect.IsTrue after, "After, read after InsertMark(True) = 3"
            .RemoveItem 3
            Expect.AreEqual -1, .InsertMark, "InsertMark after RemoveItem of the last item, which had the mark"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub InsertMark_NoSuchItem_Raises381()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddColors f.ListBoxW1
        On Error Resume Next
        Err.Clear
        f.ListBoxW1.InsertMark = 99
        Expect.AreEqual 381, Err.Number, "InsertMark = 99 in a list of four"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub List_NoSuchItem_Raises5()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim s As String
        On Error Resume Next
        Err.Clear
        s = f.ListBoxW1.List(99)
        Expect.AreEqual 5, Err.Number, "reading List(99) of an empty list"
        Err.Clear
        f.ListBoxW1.List(99) = "q"
        Expect.AreEqual 5, Err.Number, "List(99) = ""q"" on an empty list"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub List_AssignedToTheSelectedItem_RaisesClick()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ListBoxWSink
        Set sink.List = f.ListBoxW1
        AddColors f.ListBoxW1
        With f.ListBoxW1
            .ItemData(1) = 77
            .ListIndex = 1
            Rig.ClearLog
            .List(1) = "GREEN"
            Expect.AreEqual "Click 1", Rig.Events(), "the events of List(1) = ""GREEN"" with item 1 selected"
            Expect.AreEqual "GREEN", .List(1), "List(1) after the assignment"
            Expect.AreEqual 1, .ListIndex, "ListIndex after the assignment"
            Expect.AreEqual 77, CLng(.ItemData(1)), "ItemData(1) after the assignment"
        End With
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindItem_WholeTextOrBeginning()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddColors f.ListBoxW1
        With f.ListBoxW1
            Expect.AreEqual 1, .FindItem("GREEN"), "FindItem(""GREEN"") among red, green, blue, white"
            Expect.AreEqual -1, .FindItem("gr"), "FindItem(""gr"")"
            Expect.AreEqual 1, .FindItem("gr", , True), "FindItem(""gr"", , True)"
            Expect.AreEqual 0, .FindItem("r", 0, True), "FindItem(""r"", 0, True): the search comes round to item 0"
            Expect.AreEqual -1, .FindItem("zz"), "FindItem(""zz"")"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelectItem_SelectsAndRaisesNoClick()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ListBoxWSink
        Set sink.List = f.ListBoxW1
        AddColors f.ListBoxW1
        Rig.ClearLog
        With f.ListBoxW1
            Expect.AreEqual 2, .SelectItem("bl"), "SelectItem(""bl"") among red, green, blue, white"
            Expect.AreEqual 2, .ListIndex, "ListIndex after SelectItem(""bl"")"
            Expect.AreEqual -1, .SelectItem("zz"), "SelectItem(""zz"")"
            Expect.AreEqual 2, .ListIndex, "ListIndex after SelectItem(""zz"")"
            Expect.AreEqual "", Rig.Events(), "the events of the two calls"
        End With
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub HitTest_EmptyList_ReturnsMinus1()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Expect.AreEqual -1, f.ListBoxW1.HitTest(0, 0), "HitTest(0, 0) of an empty list"
        f.ListBoxW1.AddItem "red"
        Expect.AreEqual 0, f.ListBoxW1.HitTest(0, 0), "HitTest(0, 0) of a list with an item"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MouseMove_XAndY_AreInTwips()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ListBoxWSink
        Set sink.List = f.ListBoxW1
        f.ScaleMode = vbPixels
        Rig.ClearLog
        ' The pointer moves to the pixel (10, 5) of the list.
        SendMessageW f.ListBoxW1.hWnd, WM_MOUSEMOVE, 0, &H5000A
        Expect.AreEqual "MouseMove " & (10 * Screen.TwipsPerPixelX) & " " & (5 * Screen.TwipsPerPixelY), Rig.Events(), "MouseMove at the pixel (10, 5), on a form whose ScaleMode is vbPixels"
        Set sink.List = Nothing
        Unload f
        Expect.Done
    End Sub

End Module

' The events of a ListBoxW, written to Rig.Log.
Class ListBoxWSink

    Public WithEvents List As VBCCR18.ListBoxW

    Private Sub List_Click() Handles List.Click
        Rig.Ev "Click " & List.ListIndex
    End Sub

    Private Sub List_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single) Handles List.MouseMove
        Rig.Ev "MouseMove " & X & " " & Y
    End Sub

End Class
