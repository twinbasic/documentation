    Public Sub Style_AtRunTime_Raises382()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ListBoxW1.Style = LstStyleCheckbox
        Expect.AreEqual 382, Err.Number, "Style = LstStyleCheckbox at run time"
        On Error GoTo 0
        Expect.AreEqual 0, CLng(f.ListBoxW1.Style), "Style after the refused assignment"
        Unload f
        Expect.Done
    End Sub

