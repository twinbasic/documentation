    Public Sub DrawMode_AtRunTime_Raises382()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ListBoxW1.DrawMode = LstDrawModeOwnerDrawFixed
        Expect.AreEqual 382, Err.Number, "DrawMode = LstDrawModeOwnerDrawFixed at run time"
