' SliderTests: the range, the selection, the ticks and the events of the Slider. A move of the user
' is a message sent to the control's window.
[TestFixture]
Module SliderTests

    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr

    Private Const WM_MOUSEMOVE As Long = &H200
    Private Const WM_KEYDOWN As Long = &H100
    Private Const WM_KEYUP As Long = &H101
    Private Const WM_HSCROLL As Long = &H114
    Private Const WM_CONTEXTMENU As Long = &H7B
    Private Const TBM_SETPOS As Long = &H405
    Private Const TB_THUMBTRACK As Long = 5
    Private Const TB_ENDTRACK As Long = 8

    ' A key pressed and released.
    Private Sub PressKey(ByVal Bar As VBCCR18.Slider, ByVal KeyCode As Long)
        SendMessageW Bar.hWnd, WM_KEYDOWN, KeyCode, 0
        SendMessageW Bar.hWnd, WM_KEYUP, KeyCode, 0
    End Sub

    [TestCase]
    Public Sub Value_OutsideTheRange_IsTheNearestEnd()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.Slider1
            .Max = 100: .Min = 10
            .Value = 500
            Expect.AreEqual 100, .Value, "Value after Value = 500 in a range of 10 to 100"
            .Value = -3
            Expect.AreEqual 10, .Value, "Value after Value = -3 in a range of 10 to 100"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Max_NotAboveMin_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.Slider1.Min = 0: f.Slider1.Max = 100
        On Error Resume Next
        Err.Clear
        f.Slider1.Max = 0
        Expect.AreEqual 380, Err.Number, "Max = 0 with Min 0"
        On Error GoTo 0
        Expect.AreEqual 100, f.Slider1.Max, "Max after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Min_NotBelowMax_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.Slider1.Min = 0: f.Slider1.Max = 100
        On Error Resume Next
        Err.Clear
        f.Slider1.Min = 100
        Expect.AreEqual 380, Err.Number, "Min = 100 with Max 100"
        On Error GoTo 0
        Expect.AreEqual 0, f.Slider1.Min, "Min after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Range_MovedPastTheValue_MovesTheValue()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.Slider1
            .Min = 0: .Max = 100
            .Value = 80
            .Max = 50
            Expect.AreEqual 50, .Value, "Value after Max = 50 with Value 80"
            .Value = 20
            .Max = 100: .Min = 30
            Expect.AreEqual 30, .Value, "Value after Min = 30 with Value 20"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub TickFrequency_NotPositive_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.Slider1.TickFrequency = 0
        Expect.AreEqual 380, Err.Number, "TickFrequency = 0"
        Err.Clear
        f.Slider1.TickFrequency = -2
        Expect.AreEqual 380, Err.Number, "TickFrequency = -2"
        On Error GoTo 0
        Expect.AreEqual 1, f.Slider1.TickFrequency, "TickFrequency after the refused assignments"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Orientation_Vertical_ExchangesWidthAndHeight()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim w As Single, h As Single
        w = f.Slider1.Width: h = f.Slider1.Height
        f.Slider1.Orientation = SldOrientationVertical
        Expect.AreEqual CLng(h), CLng(f.Slider1.Width), "Width after Orientation = SldOrientationVertical"
        Expect.AreEqual CLng(w), CLng(f.Slider1.Height), "Height after Orientation = SldOrientationVertical"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Thickness_AboveTheLimit_IsCut()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        ' 45 pixels at 96 dpi are 675 twips.
        f.Slider1.Height = 5000
        Expect.IsTrue Abs(f.Slider1.Height - 675) <= 15, "Height after Height = 5000 on a horizontal slider is about 675 twips, not " & f.Slider1.Height
        f.Slider1.Orientation = SldOrientationVertical
        f.Slider1.Width = 5000
        Expect.IsTrue Abs(f.Slider1.Width - 675) <= 15, "Width after Width = 5000 on a vertical slider is about 675 twips, not " & f.Slider1.Width
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Orientation_OutOfRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.Slider1.Orientation = 2
        Expect.AreEqual 380, Err.Number, "Orientation = 2"
        Err.Clear
        f.Slider1.TickStyle = 4
        Expect.AreEqual 380, Err.Number, "TickStyle = 4"
        Err.Clear
        f.Slider1.TipSide = 2
        Expect.AreEqual 380, Err.Number, "TipSide = 2"
        Err.Clear
        f.Slider1.DrawMode = 2
        Expect.AreEqual 380, Err.Number, "DrawMode = 2"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelStart_OutsideTheRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.Slider1
            .Min = 0: .Max = 100
            .SelectRange = True
            On Error Resume Next
            Err.Clear
            .SelStart = 101
            Expect.AreEqual 380, Err.Number, "SelStart = 101 in a range of 0 to 100"
            Err.Clear
            .SelStart = -1
            Expect.AreEqual 380, Err.Number, "SelStart = -1 in a range of 0 to 100"
            Err.Clear
            .SelStart = 10
            .SelLength = 91
            Expect.AreEqual 380, Err.Number, "SelLength = 91 from the start 10 in a range of 0 to 100"
            Err.Clear
            .SelLength = -1
            Expect.AreEqual 380, Err.Number, "SelLength = -1"
            On Error GoTo 0
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelLength_WithoutSelectRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.Slider1.SelLength = 3
        Expect.AreEqual 380, Err.Number, "SelLength = 3 with SelectRange False"
        On Error GoTo 0
        Expect.AreEqual 0, f.Slider1.SelLength, "SelLength after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelStart_WithoutSelectRange_IsTheValue()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.Slider1
            .Min = 0: .Max = 100: .Value = 30
            Expect.AreEqual 30, .SelStart, "SelStart with SelectRange False"
            .SelStart = 45
            Expect.AreEqual 45, .Value, "Value after SelStart = 45 with SelectRange False"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelectRange_True_StartsAtTheValueWithNoLength()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.Slider1
            .Min = 0: .Max = 100: .Value = 30
            .SelectRange = True
            Expect.AreEqual 30, .SelStart, "SelStart after SelectRange = True with Value 30"
            Expect.AreEqual 0, .SelLength, "SelLength after SelectRange = True"
            .SelStart = 20
            .SelLength = 50
            Expect.AreEqual 20, .SelStart, "SelStart after SelStart = 20"
            Expect.AreEqual 50, .SelLength, "SelLength after SelLength = 50"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Max_BelowTheSelection_CutsIt()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.Slider1
            .Min = 0: .Max = 100
            .SelectRange = True
            .SelStart = 20
            .SelLength = 50
            .Max = 60
            Expect.AreEqual 20, .SelStart, "SelStart after Max = 60"
            Expect.AreEqual 40, .SelLength, "SelLength after Max = 60"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Min_AboveTheSelection_MovesItsStart()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.Slider1
            .Min = 0: .Max = 100
            .SelectRange = True
            .SelStart = 20
            .SelLength = 50
            .Min = 30
            Expect.AreEqual 30, .SelStart, "SelStart after Min = 30"
            Expect.AreEqual 0, .SelLength, "SelLength after Min = 30"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ClearSel_LeavesNoLength()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.Slider1
            .Min = 0: .Max = 100
            .SelectRange = True
            .SelStart = 20
            .SelLength = 50
            .ClearSel
            Expect.AreEqual 0, .SelLength, "SelLength after ClearSel"
            Expect.IsTrue .SelectRange, "SelectRange after ClearSel"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetNumTicks_FollowsTickFrequencyAndTickStyle()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.Slider1
            .Min = 0: .Max = 100
            .TickFrequency = 10
            Expect.AreEqual 11, .GetNumTicks, "GetNumTicks for 0 to 100 with TickFrequency 10"
            .TickFrequency = 25
            Expect.AreEqual 5, .GetNumTicks, "GetNumTicks for 0 to 100 with TickFrequency 25"
            .TickStyle = SldTickStyleNone
            Expect.AreEqual 0, .GetNumTicks, "GetNumTicks with SldTickStyleNone"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetTickPosition_IndexBelowOne_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim t As Single
        On Error Resume Next
        Err.Clear
        t = f.Slider1.GetTickPosition(0)
        Expect.AreEqual 380, Err.Number, "GetTickPosition(0)"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Change_RaisedOnceForEachChangeOfValue()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New SliderSink
        Set sink.Bar = f.Slider1
        With f.Slider1
            .Min = 0: .Max = 100
            Rig.ClearLog
            .Value = 40
            .Value = 40
            .Value = 500
        End With
        Expect.AreEqual "Change 40 | Change 100", Rig.Events(), "the events of Value = 40, Value = 40, Value = 500"
        Set sink.Bar = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Keys_MoveByTheSmallAndTheLargeChange()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.Slider1
            .Min = 0: .Max = 100: .Value = 50
            .SmallChange = 7: .LargeChange = 25
            PressKey f.Slider1, vbKeyRight
            Expect.AreEqual 57, .Value, "Value after the Right key"
            PressKey f.Slider1, vbKeyLeft
            Expect.AreEqual 50, .Value, "Value after the Left key"
            PressKey f.Slider1, vbKeyPageDown
            Expect.AreEqual 75, .Value, "Value after the Page Down key"
            PressKey f.Slider1, vbKeyPageUp
            Expect.AreEqual 50, .Value, "Value after the Page Up key"
            PressKey f.Slider1, vbKeyEnd
            Expect.AreEqual 100, .Value, "Value after the End key"
            PressKey f.Slider1, vbKeyHome
            Expect.AreEqual 0, .Value, "Value after the Home key"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Change_ByTheKeyboard_RaisedWhenTheKeyIsReleased()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New SliderSink
        Set sink.Bar = f.Slider1
        With f.Slider1
            .Min = 0: .Max = 100: .Value = 50
            .SmallChange = 7
            Rig.ClearLog
            SendMessageW .hWnd, WM_KEYDOWN, vbKeyRight, 0
            Expect.AreEqual "", Rig.Events(), "the events of a key pressed"
            SendMessageW .hWnd, WM_KEYUP, vbKeyRight, 0
            Expect.AreEqual "Change 57", Rig.Events(), "the events of the key released"
        End With
        Set sink.Bar = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Scroll_WhileTheThumbIsDragged_ThenChangeWhenReleased()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New SliderSink
        Set sink.Bar = f.Slider1
        With f.Slider1
            .Min = 0: .Max = 100
            Rig.ClearLog
            ' The thumb moves to 30, then to 40, and is released there.
            SendMessageW .hWnd, TBM_SETPOS, 1, 30
            SendMessageW .hWndUserControl, WM_HSCROLL, TB_THUMBTRACK, .hWnd
            SendMessageW .hWnd, TBM_SETPOS, 1, 40
            SendMessageW .hWndUserControl, WM_HSCROLL, TB_THUMBTRACK, .hWnd
            SendMessageW .hWndUserControl, WM_HSCROLL, TB_ENDTRACK, .hWnd
            Expect.AreEqual "Scroll 30 | Scroll 40 | Change 40", Rig.Events(), "the events of a drag of the thumb to 30, to 40 and its release"
            Expect.AreEqual 40, .Value, "Value after the drag"
        End With
        Set sink.Bar = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MouseMove_XAndY_AreInTwips()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New SliderSink
        Set sink.Bar = f.Slider1
        f.ScaleMode = vbPixels
        Rig.ClearLog
        ' The pointer moves to the pixel (10, 5) of the control.
        SendMessageW f.Slider1.hWnd, WM_MOUSEMOVE, 0, &H5000A
        Expect.AreEqual "MouseMove " & (10 * Screen.TwipsPerPixelX) & " " & (5 * Screen.TwipsPerPixelY), Rig.Events(), "MouseMove at the pixel (10, 5), on a form whose ScaleMode is vbPixels"
        Set sink.Bar = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ContextMenu_ByTheKeyboard_GivesMinusOne()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New SliderSink
        Set sink.Bar = f.Slider1
        Rig.ClearLog
        SendMessageW f.Slider1.hWndUserControl, WM_CONTEXTMENU, f.Slider1.hWnd, -1
        Expect.AreEqual "ContextMenu -1 -1", Rig.Events(), "the event of a context menu asked for by the keyboard"
        Set sink.Bar = Nothing
        Unload f
        Expect.Done
    End Sub

End Module

' The events of a Slider, written to Rig.Log.
Class SliderSink

    Public WithEvents Bar As VBCCR18.Slider

    Private Sub Bar_Change() Handles Bar.Change
        Rig.Ev "Change " & Bar.Value
    End Sub

    Private Sub Bar_Scroll() Handles Bar.Scroll
        Rig.Ev "Scroll " & Bar.Value
    End Sub

    Private Sub Bar_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single) Handles Bar.MouseMove
        Rig.Ev "MouseMove " & X & " " & Y
    End Sub

    Private Sub Bar_ContextMenu(ByVal X As Single, ByVal Y As Single) Handles Bar.ContextMenu
        Rig.Ev "ContextMenu " & X & " " & Y
    End Sub

End Class
