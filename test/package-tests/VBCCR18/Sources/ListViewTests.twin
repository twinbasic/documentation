    [TestCase]
    Public Sub VirtualMode_RunTime_Raises382()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ListView1.VirtualMode = True
        Expect.AreEqual 382, Err.Number, "VirtualMode = True at run time"
        On Error GoTo 0
        Expect.IsFalse f.ListView1.VirtualMode, "VirtualMode after the refused assignment"
        Unload f
        Expect.Done
    End Sub

