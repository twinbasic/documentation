    [TestCase]
    Public Sub VirtualDisabledInfos_Negative_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ListView1.VirtualDisabledInfos = -1
        Expect.AreEqual 380, Err.Number, "VirtualDisabledInfos = -1"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub VirtualItemCount_Negative_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ListView1.VirtualItemCount = -1
        Expect.AreEqual 380, Err.Number, "VirtualItemCount = -1"
        Err.Clear
        f.ListView1.VirtualItemCount = 100000001
        Expect.AreEqual 380, Err.Number, "VirtualItemCount = 100000001"
        On Error GoTo 0
        f.ListView1.VirtualItemCount = 50
        Expect.AreEqual 50, f.ListView1.VirtualItemCount, "VirtualItemCount after VirtualItemCount = 50, not in virtual mode"
        Expect.AreEqual 0, f.ListView1.ListItems.Count, "ListItems.Count after VirtualItemCount = 50, not in virtual mode"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub InsertMark_After_IsKept()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim After As Boolean
        With f.ListView1
            .View = LvwViewReport
            .ColumnHeaders.Add , , "Name"
            .ListItems.Add , , "alpha"
            .ListItems.Add , , "beta"
            Set .InsertMark(True) = .ListItems(1)
            Expect.AreEqual "alpha", .InsertMark(After).Text, "InsertMark after Set InsertMark(True) = item 1"
            Expect.IsTrue After, "After of InsertMark after Set InsertMark(True) = item 1"
            Set .InsertMark = Nothing
            Expect.IsTrue .InsertMark Is Nothing, "InsertMark after Set InsertMark = Nothing"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Picture_Assigned_TurnsDoubleBufferOff()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ListView1
            Expect.IsTrue .DoubleBuffer, "DoubleBuffer of a new control"
            Set .Picture = Bitmap()
            Expect.IsFalse .DoubleBuffer, "DoubleBuffer after Set Picture = a bitmap"
            .PictureWatermark = True
            Expect.IsTrue .DoubleBuffer, "DoubleBuffer after PictureWatermark = True"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub BackColor_None_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ListView1.BackColor = -1
        Expect.AreEqual 380, Err.Number, "BackColor = -1"
        On Error GoTo 0
        Expect.AreEqual CLng(vbWindowBackground), CLng(f.ListView1.BackColor), "BackColor after the refused assignment"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub WorkAreas_Remove_RenumbersTheLaterAreas()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ListView1
            .View = LvwViewIcon
            .WorkAreas.Add 0, 0, 1500, 1500
            .WorkAreas.Add 1500, 0, 1500, 1500
            Expect.AreEqual 2, .WorkAreas.Count, "WorkAreas.Count after two Add"
            .WorkAreas.Remove 1
            Expect.AreEqual 1, .WorkAreas.Count, "WorkAreas.Count after Remove 1"
            Expect.IsTrue .WorkAreas(1).Left > 1000, "WorkAreas(1).Left after Remove 1 is the second area's"
            .WorkAreas.Clear
            Expect.AreEqual 0, .WorkAreas.Count, "WorkAreas.Count after Clear"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub WorkAreas_Item_OutOfRange_Raises35600()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As LvwWorkArea
        On Error Resume Next
        Err.Clear
        Set a = f.ListView1.WorkAreas(1)
        Expect.AreEqual 35600, Err.Number, "WorkAreas(1) with no work area"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub WorkAreas_Add_ZeroWidth_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ListView1.WorkAreas.Add 0, 0, 0, 100
        Expect.AreEqual 380, Err.Number, "WorkAreas.Add with a width of 0"
        Err.Clear
        f.ListView1.WorkAreas.Add 0, 0, 100, 100, 5
        Expect.AreEqual 35600, Err.Number, "WorkAreas.Add at Index 5 with no work area"
        On Error GoTo 0
        Expect.AreEqual 0, f.ListView1.WorkAreas.Count, "WorkAreas.Count after the refused calls"
        Unload f
        Expect.Done
    End Sub

End Module
