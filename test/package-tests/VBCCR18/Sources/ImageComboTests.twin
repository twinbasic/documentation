    [TestCase]
    Public Sub MaxLength_Zero_LimitsTheTextTo259()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim i As Long
        With f.ImageCombo1
            .Text = ""
            For i = 1 To 300
                SendMessageW .hWndEdit, WM_CHAR, 65, 0
            Next
            Expect.AreEqual 259, Len(.Text), "the length of the text after 300 characters were typed with MaxLength 0"
            .Text = String$(300, "y")
            Expect.AreEqual 259, Len(.Text), "the length of a text of 300 characters assigned with MaxLength 0"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Text_LongerThanMaxLength_IsCut()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageCombo1
            .MaxLength = 3
            .Text = "abcdef"
            Expect.AreEqual "abc", .Text, "Text after ""abcdef"" is assigned with MaxLength 3"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Locked_TextCanStillBeAssigned()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageCombo1
            AddItems f.ImageCombo1
            .Locked = True
            .Text = "xyz"
            Expect.AreEqual "xyz", .Text, "Text after an assignment with Locked"
            .ComboItems("b").Selected = True
            Expect.AreEqual "Beta", .Text, "Text after an item is selected with Locked"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetItemHeight_PicturesHigherThanTheText_IsAtLeastThePictureHeight()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim h0 As Single, h1 As Single
        h0 = f.ImageCombo1.GetItemHeight
        f.ImageList1.ImageWidth = 40
        f.ImageList1.ImageHeight = 40
        f.ImageList1.ListImages.Add , "big", ColorSquare(vbRed, 40, 40)
        f.ImageCombo1.ImageList = f.ImageList1
        h1 = f.ImageCombo1.GetItemHeight
        Expect.IsTrue h1 > h0, "GetItemHeight with pictures 40 pixels high is more than without a list"
        Expect.IsTrue h1 >= f.ScaleY(40, vbPixels, f.ScaleMode), "GetItemHeight with pictures 40 pixels high is at least 40 pixels"
        Unload f
        Expect.Done
    End Sub

