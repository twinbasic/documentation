' ImageComboTests: the ImageCombo control, its ImcComboItems collection and its ImcComboItem items.
' The user's keyboard is made by messages to the text box of the control; the pictures are bitmaps
' of one color made here, so that no case needs a file.
[TestFixture]
Module ImageComboTests

    Private Type PictDesc
        Size As Long
        Kind As Long
        Handle As LongPtr
        Palette As LongPtr
    End Type

    Private Type PictGuid
        Data1 As Long
        Data2 As Integer
        Data3 As Integer
        Data4(0 To 7) As Byte
    End Type

    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal Msg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
    Private Declare PtrSafe Function GetDC Lib "user32" (ByVal hWnd As LongPtr) As LongPtr
    Private Declare PtrSafe Function ReleaseDC Lib "user32" (ByVal hWnd As LongPtr, ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function CreateCompatibleDC Lib "gdi32" (ByVal hDC As LongPtr) As LongPtr
    Private Declare PtrSafe Function CreateCompatibleBitmap Lib "gdi32" (ByVal hDC As LongPtr, ByVal W As Long, ByVal H As Long) As LongPtr
    Private Declare PtrSafe Function SelectObject Lib "gdi32" (ByVal hDC As LongPtr, ByVal hObject As LongPtr) As LongPtr
    Private Declare PtrSafe Function CreateSolidBrush Lib "gdi32" (ByVal Color As Long) As LongPtr
    Private Declare PtrSafe Function PatBlt Lib "gdi32" (ByVal hDC As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal W As Long, ByVal H As Long, ByVal Rop As Long) As Long
    Private Declare PtrSafe Function DeleteObject Lib "gdi32" (ByVal hObject As LongPtr) As Long
    Private Declare PtrSafe Function DeleteDC Lib "gdi32" (ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function OleCreatePictureIndirect Lib "oleaut32" (ByRef Desc As PictDesc, ByRef IID As PictGuid, ByVal Own As Long, ByRef Pic As IPictureDisp) As Long

    Private Const PATCOPY As Long = &HF00021
    Private Const WM_SETFOCUS As Long = &H7
    Private Const WM_KILLFOCUS As Long = &H8
    Private Const WM_KEYDOWN As Long = &H100
    Private Const WM_CHAR As Long = &H102
    Private Const WM_MOUSEMOVE As Long = &H200
    Private Const VK_RETURN As Long = 13
    Private Const VK_ESCAPE As Long = 27
    Private Const VK_DOWN As Long = &H28

    ' A bitmap of one color.
    Private Function ColorSquare(ByVal Color As Long, Optional ByVal Width As Long = 16, Optional ByVal Height As Long = 16) As StdPicture
        Dim screenDC As LongPtr, memDC As LongPtr, bmp As LongPtr, brush As LongPtr, oldBmp As LongPtr, oldBrush As LongPtr
        screenDC = GetDC(0)
        memDC = CreateCompatibleDC(screenDC)
        bmp = CreateCompatibleBitmap(screenDC, Width, Height)
        brush = CreateSolidBrush(Color)
        oldBmp = SelectObject(memDC, bmp)
        oldBrush = SelectObject(memDC, brush)
        PatBlt memDC, 0, 0, Width, Height, PATCOPY
        SelectObject memDC, oldBrush
        SelectObject memDC, oldBmp
        DeleteObject brush
        DeleteDC memDC
        ReleaseDC 0, screenDC
        Dim desc As PictDesc, iid As PictGuid, pic As IPictureDisp
        desc.Size = LenB(desc)
        desc.Kind = 1
        desc.Handle = bmp
        ' IID_IPictureDisp, {7BF80981-BF32-101A-8BBB-00AA00300CAB}
        iid.Data1 = &H7BF80981
        iid.Data2 = &HBF32
        iid.Data3 = &H101A
        iid.Data4(0) = &H8B
        iid.Data4(1) = &HBB
        iid.Data4(3) = &HAA
        iid.Data4(5) = &H30
        iid.Data4(6) = &HC
        iid.Data4(7) = &HAB
        OleCreatePictureIndirect desc, iid, 1, pic
        Set ColorSquare = pic
    End Function

    ' Three pictures in the list of the form, red, green and blue, keys "red", "green" and "blue".
    Private Sub FillImageList(ByVal f As HostForm)
        f.ImageList1.ListImages.Add , "red", ColorSquare(vbRed)
        f.ImageList1.ListImages.Add , "green", ColorSquare(vbGreen)
        f.ImageList1.ListImages.Add , "blue", ColorSquare(vbBlue)
    End Sub

    Private Sub AddItems(ByVal Combo As VBCCR18.ImageCombo)
        Combo.ComboItems.Add , "a", "Alpha"
        Combo.ComboItems.Add , "b", "Beta"
        Combo.ComboItems.Add , "c", "Gamma"
    End Sub

    ' The number of times an event is in the log.
    Private Function CountOf(ByVal EventName As String) As Long
        Dim parts() As String = Split(Rig.Events(), " | ")
        Dim i As Long
        For i = 0 To UBound(parts)
            If parts(i) = EventName Then CountOf = CountOf + 1
        Next
    End Function

    ' The first event of the log.
    Private Function FirstEvent() As String
        Dim parts() As String = Split(Rig.Events(), " | ")
        FirstEvent = parts(0)
    End Function

    ' The last event of the log.
    Private Function LastEvent() As String
        Dim parts() As String = Split(Rig.Events(), " | ")
        LastEvent = parts(UBound(parts))
    End Function

    ' ---- the control ----

    [TestCase]
    Public Sub Defaults_OfANewControl()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageCombo1
            Expect.AreEqual 0, CLng(.Style), "Style of a new control"
            Expect.AreEqual 0, CLng(.Indentation), "Indentation of a new control"
            Expect.IsFalse .ExtendedUI, "ExtendedUI of a new control"
            Expect.AreEqual 9, CLng(.MaxDropDownItems), "MaxDropDownItems of a new control"
            Expect.IsTrue .ShowImages, "ShowImages of a new control"
            Expect.AreEqual 0, CLng(.MaxLength), "MaxLength of a new control"
            Expect.AreEqual 0, CLng(.EllipsisFormat), "EllipsisFormat of a new control"
            Expect.AreEqual 0, CLng(.AllowImageHighlight), "AllowImageHighlight of a new control"
            Expect.IsFalse .Locked, "Locked of a new control"
            Expect.IsTrue .ScrollTrack, "ScrollTrack of a new control"
            Expect.AreEqual 0, .ComboItems.Count, "ComboItems.Count of a new control"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Style_AtRunTime_Raises382()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ImageCombo1.Style = ImcStyleSimpleCombo
        Expect.AreEqual 382, Err.Number, "Style = ImcStyleSimpleCombo at run time"
        On Error GoTo 0
        Expect.AreEqual 0, CLng(f.ImageCombo1.Style), "Style after the refused assignment"
        Unload f
        Expect.Done
    End Sub

