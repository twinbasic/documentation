        Err.Clear
        it.Image = "nope"
        Expect.AreEqual 35601, Err.Number, "Image = ""nope"""
        On Error GoTo 0
        Expect.AreEqual 1, it.ImageIndex, "ImageIndex after the refused assignment"
        Unload f
        Expect.Done
    End Sub

