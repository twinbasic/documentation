    [TestCase]
    Public Sub Item_ByKey_IgnoresCase()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddItems f.ImageCombo1
        Expect.AreEqual "Beta", f.ImageCombo1.ComboItems("B").Text, "the text of ComboItems(""B"") for the key ""b"""
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Exists_SaysWhetherTheListHasTheNumberOrKey()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddItems f.ImageCombo1
        With f.ImageCombo1.ComboItems
            Expect.IsTrue .Exists("b"), "Exists(""b"") in a list with that key"
            Expect.IsTrue .Exists("B"), "Exists(""B"") in a list with the key ""b"""
            Expect.IsFalse .Exists("zz"), "Exists(""zz"") in a list without that key"
            Expect.IsTrue .Exists(3), "Exists(3) in a list of three"
            Expect.IsFalse .Exists(4), "Exists(4) in a list of three"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Remove_RenumbersTheLaterItems()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddItems f.ImageCombo1
        With f.ImageCombo1.ComboItems
            .Remove "a"
            Expect.AreEqual 2, .Count, "Count after one of three items is removed"
            Expect.AreEqual 1, .Item("b").Index, "Index of the item ""b"" after the item before it was removed"
            Expect.AreEqual 2, .Item("c").Index, "Index of the item ""c"" after the first item was removed"
            .Add 1, "n", "New"
            Expect.AreEqual 3, .Item("c").Index, "Index of the item ""c"" after an item was added before it"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Remove_NoSuchItem_RaisesTheErrorOfItem()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddItems f.ImageCombo1
        On Error Resume Next
        Err.Clear
        f.ImageCombo1.ComboItems.Remove 9
        Expect.AreEqual 9, Err.Number, "Remove 9 in a list of three"
        Err.Clear
        f.ImageCombo1.ComboItems.Remove "zz"
        Expect.AreEqual 5, Err.Number, "Remove ""zz"""
        On Error GoTo 0
        Expect.AreEqual 3, f.ImageCombo1.ComboItems.Count, "Count after the refused calls"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Clear_LeavesTheText()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ImageComboSink
        Set sink.Combo = f.ImageCombo1
        AddItems f.ImageCombo1
        f.ImageCombo1.ComboItems("a").Selected = True
        Rig.ClearLog
        f.ImageCombo1.ComboItems.Clear
        Expect.AreEqual "", Rig.Events(), "the events of Clear"
        Expect.AreEqual 0, f.ImageCombo1.ComboItems.Count, "Count after Clear"
        Expect.AreEqual "Alpha", f.ImageCombo1.Text, "Text after Clear with the first item selected"
        Expect.IsTrue f.ImageCombo1.SelectedItem Is Nothing, "SelectedItem after Clear"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Remove_SelectedItem_LeavesTheText()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddItems f.ImageCombo1
        f.ImageCombo1.ComboItems("b").Selected = True
        f.ImageCombo1.ComboItems.Remove "b"
        Expect.AreEqual "Beta", f.ImageCombo1.Text, "Text after the selected item is removed"
        Expect.IsTrue f.ImageCombo1.SelectedItem Is Nothing, "SelectedItem after the selected item is removed"
        Unload f
        Expect.Done
    End Sub

    ' ---- the selection and the text ----

    [TestCase]
    Public Sub Text_Assigned_SelectsNoItem()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddItems f.ImageCombo1
        f.ImageCombo1.Text = "Beta"
        Expect.IsTrue f.ImageCombo1.SelectedItem Is Nothing, "SelectedItem after Text = ""Beta"", the text of the second item"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Selected_True_PutsTheTextInTheTextBox()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddItems f.ImageCombo1
        f.ImageCombo1.ComboItems("b").Selected = True
        Expect.AreEqual "Beta", f.ImageCombo1.Text, "Text after the second item is selected"
        Expect.AreEqual "b", f.ImageCombo1.SelectedItem.Key, "the key of SelectedItem"
        Expect.IsTrue f.ImageCombo1.ComboItems("b").Selected, "Selected of the second item"
        Expect.IsFalse f.ImageCombo1.ComboItems("a").Selected, "Selected of the first item"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Selected_True_RaisesChangeThenClick()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ImageComboSink
        Set sink.Combo = f.ImageCombo1
        AddItems f.ImageCombo1
        Rig.ClearLog
        f.ImageCombo1.ComboItems("c").Selected = True
        Expect.AreEqual "Change", FirstEvent(), "the first event of Selected = True"
        Expect.AreEqual "Click", LastEvent(), "the last event of Selected = True"
        Expect.AreEqual 1, CountOf("Click"), "the number of Click events of Selected = True"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Selected_AlreadySelected_RaisesNoClick()
        Expect.Begin
