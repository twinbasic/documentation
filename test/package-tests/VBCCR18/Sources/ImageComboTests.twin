        AddItems f.ImageCombo1
        f.ImageCombo1.ComboItems("c").Selected = True
        Rig.ClearLog
        f.ImageCombo1.ComboItems("c").Selected = True
        Expect.AreEqual 0, CountOf("Click"), "the number of Click events of Selected = True for the selected item"
        Expect.IsTrue CountOf("Change") > 0, "Change is raised by Selected = True for the selected item"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
