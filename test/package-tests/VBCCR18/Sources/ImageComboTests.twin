    ' ---- the collection ----

    [TestCase]
    Public Sub Add_AtAnIndex_MovesTheLaterItemsUp()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageCombo1.ComboItems
            .Add , "open", "Open"
            .Add , "save", "Save"
            .Add 1, "new", "New"
            Expect.AreEqual "new open save", .Item(1).Key & " " & .Item(2).Key & " " & .Item(3).Key, "the keys of the items after Add 1, ""new"" to a list of two"
            Expect.AreEqual 3, .Item("save").Index, "Index of the item ""save"""
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_IndexOutOfRange_Raises35600()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.ImageCombo1.ComboItems.Add 5, , "X"
        Expect.AreEqual 35600, Err.Number, "Add with the index 5 to an empty list"
        Err.Clear
        f.ImageCombo1.ComboItems.Add -1, , "X"
        Expect.AreEqual 35600, Err.Number, "Add with the index -1"
        Err.Clear
        f.ImageCombo1.ComboItems.Add 2, , "X"
        Expect.AreEqual 35600, Err.Number, "Add with the index 2 to an empty list"
        On Error GoTo 0
        Expect.AreEqual 0, f.ImageCombo1.ComboItems.Count, "ComboItems.Count after the refused calls"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_DuplicateKey_Raises457()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        f.ImageCombo1.ComboItems.Add , "a", "Alpha"
        On Error Resume Next
        Err.Clear
        f.ImageCombo1.ComboItems.Add , "A", "Again"
        Expect.AreEqual 457, Err.Number, "Add with the key ""A"" to a list that has the key ""a"""
        On Error GoTo 0
        Expect.AreEqual 1, f.ImageCombo1.ComboItems.Count, "ComboItems.Count after the refused Add"
        Unload f
        Expect.Done
    End Sub

