    End Sub

    [TestCase]
    Public Sub Text_OfTheSelectedItem_Assigned_ChangesTheTextBox()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ImageComboSink
        Set sink.Combo = f.ImageCombo1
        AddItems f.ImageCombo1
        f.ImageCombo1.ComboItems("b").Selected = True
        Rig.ClearLog
        f.ImageCombo1.ComboItems("b").Text = "Bravo"
        Expect.AreEqual "Bravo", f.ImageCombo1.Text, "Text after the text of the selected item is changed"
        Expect.AreEqual "Change", Rig.Events(), "the events of a change of the text of the selected item"
        Rig.ClearLog
        f.ImageCombo1.ComboItems("c").Text = "Gimel"
        Expect.AreEqual "Bravo", f.ImageCombo1.Text, "Text after the text of another item is changed"
        Expect.AreEqual "", Rig.Events(), "the events of a change of the text of another item"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Item_AfterRemove_KeepsItsOldNumber()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As VBCCR18.ImcComboItem
        Set a = f.ImageCombo1.ComboItems.Add(, "a", "Alpha")
        f.ImageCombo1.ComboItems.Add , "b", "Beta"
        f.ImageCombo1.ComboItems.Remove "a"
        Expect.AreEqual 1, a.Index, "Index of an item kept in a variable after it was removed"
        Expect.AreEqual "Beta", a.Text, "Text of an item kept in a variable after it was removed, with another item at its number"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Data_NewItem_IsZeroAndAssignedIsKept()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim it As VBCCR18.ImcComboItem
        Set it = f.ImageCombo1.ComboItems.Add(, "a", "Alpha")
        Expect.AreEqual 0, CLng(it.Data), "Data of a new item"
        it.Data = 1234
        Expect.AreEqual 1234, CLng(it.Data), "Data after 1234 is assigned"
        Unload f
        Expect.Done
    End Sub

End Module

' The events of an ImageCombo, written to Rig.Log.
Class ImageComboSink

    Public WithEvents Combo As VBCCR18.ImageCombo

    Private Sub Combo_Click() Handles Combo.Click
        Rig.Ev "Click"
    End Sub

    Private Sub Combo_Change() Handles Combo.Change
        Rig.Ev "Change"
    End Sub

    Private Sub Combo_DropDown() Handles Combo.DropDown
        Rig.Ev "DropDown"
    End Sub

    Private Sub Combo_CloseUp() Handles Combo.CloseUp
        Rig.Ev "CloseUp"
    End Sub

    Private Sub Combo_Scroll() Handles Combo.Scroll
        Rig.Ev "Scroll"
    End Sub

    Private Sub Combo_BeginEdit() Handles Combo.BeginEdit
        Rig.Ev "BeginEdit"
    End Sub

    Private Sub Combo_EndEdit(ByVal Changed As Boolean, ByVal NewIndex As Long, ByVal NewText As String, ByVal Reason As ImcEndEditReasonConstants) Handles Combo.EndEdit
        Rig.Ev "EndEdit " & CStr(Changed) & " " & NewIndex & " " & NewText & " " & CLng(Reason)
    End Sub

    Private Sub Combo_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single) Handles Combo.MouseMove
        Rig.Ev "MouseMove " & X & " " & Y
    End Sub

End Class
