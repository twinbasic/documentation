    [TestCase]
    Public Sub SelImage_KeyGivenToAdd_CanBeRead()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        FillImageList f
        f.ImageCombo1.ImageList = f.ImageList1
        Dim it As VBCCR18.ImcComboItem
        Set it = f.ImageCombo1.ComboItems.Add(, "d", "Delta", , "blue")
        Expect.AreEqual 3, it.SelImageIndex, "SelImageIndex of an item added with the SelImage key ""blue"""
        Dim n As Long
        On Error Resume Next
        Err.Clear
        n = it.SelImage
        Expect.AreEqual 0, Err.Number, "reading SelImage of an item added with the SelImage key ""blue"""
        On Error GoTo 0
        Expect.AreEqual 3, n, "SelImage of an item added with the SelImage key ""blue"""
        Unload f
        Expect.Done
