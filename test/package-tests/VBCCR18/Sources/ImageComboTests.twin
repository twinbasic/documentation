    [TestCase]
    Public Sub Indentation_OfTheControl_IsTheIndentationOfNewItems()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageCombo1
            .Indentation = 2
            .ComboItems.Add , "a", "A"
            .Indentation = 0
            .ComboItems.Add , "b", "B"
            Expect.AreEqual 2, .ComboItems("a").Indentation, "Indentation of an item added while the control had 2"
            Expect.AreEqual 0, .ComboItems("b").Indentation, "Indentation of an item added while the control had 0"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Add_WithAnIndentation_OverridesTheControls()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.ImageCombo1
            .Indentation = 1
            .ComboItems.Add , "a", "A", , , 3
            Expect.AreEqual 3, .ComboItems("a").Indentation, "Indentation of an item added with an Indentation of 3 while the control had 1"
        End With
        Unload f
        Expect.Done
    End Sub

