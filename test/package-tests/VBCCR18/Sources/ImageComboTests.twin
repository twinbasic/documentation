    [TestCase]
    Public Sub TopItem_Assigned_ScrollsAndRaisesScroll()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ImageComboSink
        Dim i As Long
        For i = 1 To 40
            f.ImageCombo1.ComboItems.Add , , "Item " & i
        Next
        Set sink.Combo = f.ImageCombo1
        Rig.ClearLog
        Set f.ImageCombo1.TopItem = f.ImageCombo1.ComboItems(10)
        Expect.AreEqual 10, f.ImageCombo1.TopItem.Index, "the Index of TopItem after the tenth item is assigned"
        Expect.AreEqual "Scroll", Rig.Events(), "the events of Set TopItem to the tenth item"
        Rig.ClearLog
        Set f.ImageCombo1.TopItem = f.ImageCombo1.ComboItems(10)
        Expect.AreEqual "", Rig.Events(), "the events of Set TopItem to the item that is at the top"
        Rig.ClearLog
        Set f.ImageCombo1.TopItem = f.ImageCombo1.ComboItems(11)
        Expect.AreEqual "Scroll", Rig.Events(), "the events of Set TopItem to the eleventh item"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindItem_WholeTextOrPartOfIt()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim i As Long
        For i = 1 To 40
            f.ImageCombo1.ComboItems.Add , , "Item " & i
        Next
        With f.ImageCombo1
            Expect.AreEqual 5, .FindItem("item 5").Index, "FindItem(""item 5"")"
            Expect.AreEqual 5, .FindItem("ITEM 5").Index, "FindItem(""ITEM 5"")"
            Expect.AreEqual 5, .FindItem("item 5", , True).Index, "FindItem(""item 5"", , True)"
            Expect.AreEqual 5, .FindItem("5", , True).Index, "FindItem(""5"", , True)"
            Expect.IsTrue .FindItem("5") Is Nothing, "FindItem(""5"") for a text that is no whole text"
            Expect.IsTrue .FindItem("zzz") Is Nothing, "FindItem(""zzz"")"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindItem_StartsAtIndex()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim i As Long
        For i = 1 To 40
            f.ImageCombo1.ComboItems.Add , , "Item " & i
        Next
        With f.ImageCombo1
            Expect.AreEqual 11, .FindItem("item 1", 11, True).Index, "FindItem(""item 1"", 11, True)"
            Expect.IsTrue .FindItem("item 1", 20, True) Is Nothing, "FindItem(""item 1"", 20, True)"
            Expect.AreEqual 5, .FindItem("item 5", 5).Index, "FindItem(""item 5"", 5)"
            Expect.IsTrue .FindItem("item 5", 6) Is Nothing, "FindItem(""item 5"", 6)"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindItem_Wrap_GoesOnFromTheTop()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim i As Long
        For i = 1 To 40
            f.ImageCombo1.ComboItems.Add , , "Item " & i
        Next
        With f.ImageCombo1
            Expect.AreEqual 1, .FindItem("item 1", 20, True, True).Index, "FindItem(""item 1"", 20, True, True)"
            Expect.AreEqual 5, .FindItem("item 5", 6, , True).Index, "FindItem(""item 5"", 6, , True)"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindItem_IndexOutOfRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        AddItems f.ImageCombo1
        Dim it As VBCCR18.ImcComboItem
        On Error Resume Next
        Err.Clear
        Set it = f.ImageCombo1.FindItem("a", 4, True)
        Expect.AreEqual 380, Err.Number, "FindItem with the index 4 in a list of three"
        Err.Clear
        Set it = f.ImageCombo1.FindItem("a", -1, True)
        Expect.AreEqual 380, Err.Number, "FindItem with the index -1"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MouseMove_XAndY_AreInTwips()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New ImageComboSink
        Set sink.Combo = f.ImageCombo1
        f.ScaleMode = vbPixels
        Rig.ClearLog
        ' The pointer moves to the pixel (10, 5) of the combo box.
        SendMessageW f.ImageCombo1.hWndCombo, WM_MOUSEMOVE, 0, &H5000A
        Expect.AreEqual "MouseMove " & (10 * Screen.TwipsPerPixelX) & " " & (5 * Screen.TwipsPerPixelY), Rig.Events(), "MouseMove at the pixel (10, 5), on a form whose ScaleMode is vbPixels"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
    End Sub

    ' ---- one item ----

    [TestCase]
    Public Sub Image_Assigned_ChangesImageAndImageIndex()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        FillImageList f
        f.ImageCombo1.ImageList = f.ImageList1
        Dim it As VBCCR18.ImcComboItem
        Set it = f.ImageCombo1.ComboItems.Add(, "a", "Alpha", 1)
        Expect.AreEqual 1, CLng(it.Image), "Image of an item added with the number 1"
        it.Image = "green"
        Expect.AreEqual "green", CStr(it.Image), "Image after the key ""green"" is assigned"
        Expect.AreEqual 2, it.ImageIndex, "ImageIndex after the key ""green"" is assigned"
        it.Image = 3
        Expect.AreEqual 3, it.ImageIndex, "ImageIndex after the number 3 is assigned"
        it.Image = 0
        Expect.AreEqual 0, it.ImageIndex, "ImageIndex after 0 is assigned"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Image_UnknownKey_Raises35601()
