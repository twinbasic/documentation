    [TestCase]
    Public Sub Text_OfAnItem_IsCutTo259()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim it As VBCCR18.ImcComboItem
        Set it = f.ImageCombo1.ComboItems.Add(, "long", String$(300, "x"))
        Expect.AreEqual 259, Len(it.Text), "the length of the text of an item added with 300 characters"
        it.Text = String$(280, "y")
        Expect.AreEqual 259, Len(it.Text), "the length of the text of an item after 280 characters are assigned"
