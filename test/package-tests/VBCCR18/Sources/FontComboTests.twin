' FontComboTests: the FontCombo control: its list of fonts, the recent fonts, and the buddy that
' lists the sizes. No case depends on which fonts are installed: each compares the list with
' itself, or with the names it reads from it.
[TestFixture]
Module FontComboTests

    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal Msg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr

    Private Const WM_COMMAND As Long = &H111
    Private Const WM_CONTEXTMENU As Long = &H7B
    Private Const WM_MOUSEMOVE As Long = &H200
    Private Const CB_SETCURSEL As Long = &H14E
    Private Const CBN_SELCHANGE_AS_WPARAM As Long = &H10000

    ' The user picks the entry of an index: the combo box selects it and tells the control.
    Private Sub Pick(ByVal Combo As VBCCR18.FontCombo, ByVal Index As Long)
        SendMessageW Combo.hWnd, CB_SETCURSEL, Index, 0
        SendMessageW Combo.hWndUserControl, WM_COMMAND, CBN_SELCHANGE_AS_WPARAM, Combo.hWnd
    End Sub

    ' The user picks a font from the complete list, below the recent fonts.
    Private Sub PickByName(ByVal Combo As VBCCR18.FontCombo, ByVal Name As String)
        Pick Combo, Combo.FindItem(Name, Combo.RecentCount - 1)
    End Sub

    ' The number of times an event is in the log.
    Private Function CountOf(ByVal EventName As String) As Long
        Dim parts() As String = Split(Rig.Events(), " | ")
        Dim i As Long
        For i = 0 To UBound(parts)
            If parts(i) = EventName Then CountOf = CountOf + 1
        Next
    End Function

    ' The last event of the log.
    Private Function LastEvent() As String
        Dim parts() As String = Split(Rig.Events(), " | ")
        LastEvent = parts(UBound(parts))
    End Function

    ' ---- the control ----

    [TestCase]
    Public Sub Defaults_OfANewControl()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.FontCombo1
            Expect.AreEqual 2, CLng(.Style), "Style of a new control"
            Expect.AreEqual 0, CLng(.FontType), "FontType of a new control"
            Expect.AreEqual 0, CLng(.FontPitch), "FontPitch of a new control"
            Expect.IsFalse .ExtendedUI, "ExtendedUI of a new control"
            Expect.AreEqual 9, CLng(.MaxDropDownItems), "MaxDropDownItems of a new control"
            Expect.IsTrue .IntegralHeight, "IntegralHeight of a new control"
            Expect.AreEqual 0, CLng(.MaxLength), "MaxLength of a new control"
            Expect.IsTrue .AutoSelect, "AutoSelect of a new control"
            Expect.IsFalse .AlwaysFindExact, "AlwaysFindExact of a new control"
            Expect.AreEqual 0, CLng(.RecentMax), "RecentMax of a new control"
            Expect.AreEqual 0, .RecentCount, "RecentCount of a new control"
            Expect.AreEqual -1, .ListIndex, "ListIndex of a new control"
            Expect.AreEqual "", .Text, "Text of a new control with the style FtcStyleDropDownList"
            Expect.IsTrue .ListCount > 0, "ListCount of a new control is more than 0"
            Expect.IsTrue .hWndEdit = 0, "hWndEdit of a control with the style FtcStyleDropDownList"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Style_AtRunTime_Raises382()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.FontCombo1.Style = FtcStyleSimpleCombo
        Expect.AreEqual 382, Err.Number, "Style = FtcStyleSimpleCombo at run time"
        On Error GoTo 0
        Expect.AreEqual 2, CLng(f.FontCombo1.Style), "Style after the refused assignment"
        Unload f
        Expect.Done
    End Sub

