    [TestCase]
    Public Sub MouseMove_XAndY_AreInTwips()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New FontComboSink
        Set sink.Combo = f.FontCombo1
        f.ScaleMode = vbPixels
        Rig.ClearLog
        ' The pointer moves to the pixel (10, 5) of the combo box.
        SendMessageW f.FontCombo1.hWnd, WM_MOUSEMOVE, 0, &H5000A
        Expect.AreEqual "MouseMove " & (10 * Screen.TwipsPerPixelX) & " " & (5 * Screen.TwipsPerPixelY), Rig.Events(), "MouseMove at the pixel (10, 5), on a form whose ScaleMode is vbPixels"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
