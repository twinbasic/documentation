    [TestCase]
    Public Sub FindItem_WholeNameOrBeginning()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim name As String, r As Long
        name = f.FontCombo1.List(3)
        With f.FontCombo1
            r = .FindItem(name)
            Expect.IsTrue r >= 0 And r <= 3, "FindItem of the name of the fourth entry is that entry or one before it"
            Expect.AreEqual name, .List(r), "the name of the entry FindItem found"
            Expect.AreEqual r, .FindItem(UCase$(name)), "FindItem of the name in capital letters"
            Expect.IsTrue .FindItem(Left$(name, 2), , True) <= 3, "FindItem of the first two letters of the name, with Partial"
            Expect.AreEqual -1, .FindItem("no such font"), "FindItem of a name that no entry has"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FindItem_StartsAfterIndex_AndWraps()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim name As String, r As Long
        name = f.FontCombo1.List(2)
        r = f.FontCombo1.FindItem(name, 2)
        Expect.IsTrue r >= 0, "FindItem of the name of the third entry, from the index 2, goes round the list"
        Expect.AreEqual name, f.FontCombo1.List(r), "the name of the entry FindItem found from the index 2"
        Unload f
        Expect.Done
    End Sub

