        Expect.AreEqual -1, f.FontCombo1.SelectItem("zzzz no such"), "SelectItem of a text that no name begins with"
        Expect.AreEqual 3, f.FontCombo1.ListIndex, "ListIndex after a SelectItem that found nothing"
        Unload f
        Expect.Done
