        Expect.AreEqual "ContextMenu -1 -1", Rig.Events(), "the events of a request for the shortcut menu from the keyboard"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
    End Sub

    ' ---- the list of fonts ----

    [TestCase]
    Public Sub FontPitch_Fixed_ListsSomeOfTheFonts()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim all As Long, fixed As Long
        With f.FontCombo1
            all = .ListCount
            .FontPitch = FtcFontPitchFixed
            fixed = .ListCount
            Expect.IsTrue fixed > 0, "ListCount with FontPitch = FtcFontPitchFixed is more than 0"
            Expect.IsTrue fixed <= all, "ListCount with FontPitch = FtcFontPitchFixed is not more than with FtcFontPitchAll"
            .FontPitch = FtcFontPitchAll
            Expect.AreEqual all, .ListCount, "ListCount after FontPitch is FtcFontPitchAll again"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FontPitch_Changed_BuildsTheListAgain()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.FontCombo1
            .ListIndex = 3
            .FontPitch = FtcFontPitchVariable
            Expect.AreEqual -1, .ListIndex, "ListIndex after FontPitch is changed with a font selected"
            .ListIndex = 3
            .FontType = FtcFontTypeBitmapTrueType
            Expect.AreEqual -1, .ListIndex, "ListIndex after FontType is changed with a font selected"
        End With
        Unload f
        Expect.Done
    End Sub

