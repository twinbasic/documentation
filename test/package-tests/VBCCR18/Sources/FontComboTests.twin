    ' ---- recent fonts ----

    [TestCase]
    Public Sub RecentMax_OutOfRange_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.FontCombo1.RecentMax = 10
        Expect.AreEqual 380, Err.Number, "RecentMax = 10"
        Err.Clear
        f.FontCombo1.RecentMax = -1
        Expect.AreEqual 380, Err.Number, "RecentMax = -1"
        On Error GoTo 0
        Expect.AreEqual 0, CLng(f.FontCombo1.RecentMax), "RecentMax after the refused assignments"
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Recent_UserPicksAFont_IsAddedAtTheTop()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As String, b As String, before As Long
        With f.FontCombo1
            .RecentMax = 2
            before = .ListCount
            a = .List(5)
            b = .List(6)
            PickByName f.FontCombo1, a
            Expect.AreEqual 1, .RecentCount, "RecentCount after one pick"
            Expect.AreEqual 1, .ListCount - before, "the entries added to the list by one pick"
            Expect.AreEqual a, .List(0), "List(0) after the pick of a font"
            Expect.AreEqual a, .Text, "Text after the pick of a font"
            PickByName f.FontCombo1, b
            Expect.AreEqual 2, .RecentCount, "RecentCount after two picks"
            Expect.AreEqual b & " " & a, .List(0) & " " & .List(1), "the recent fonts after two picks, the last pick first"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Recent_PicksBeyondRecentMax_DropTheOldest()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As String, b As String, c As String, before As Long
        With f.FontCombo1
            .RecentMax = 2
            before = .ListCount
            a = .List(5)
            b = .List(6)
            c = .List(7)
            PickByName f.FontCombo1, a
            PickByName f.FontCombo1, b
            PickByName f.FontCombo1, c
            Expect.AreEqual 2, .RecentCount, "RecentCount after three picks with RecentMax 2"
            Expect.AreEqual 2, .ListCount - before, "the entries added to the list by three picks with RecentMax 2"
            Expect.AreEqual c & " " & b, .List(0) & " " & .List(1), "the recent fonts after three picks with RecentMax 2"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Recent_OriginalOfARecentFont_MovesToTheTop()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As String, b As String, before As Long
        With f.FontCombo1
            .RecentMax = 2
            before = .ListCount
            a = .List(5)
            b = .List(6)
            PickByName f.FontCombo1, a
            PickByName f.FontCombo1, b
            PickByName f.FontCombo1, a
            Expect.AreEqual 2, .RecentCount, "RecentCount after a recent font is picked again from the complete list"
            Expect.AreEqual 2, .ListCount - before, "the entries added to the list after a recent font is picked again"
            Expect.AreEqual a & " " & b, .List(0) & " " & .List(1), "the recent fonts after a recent font is picked again from the complete list"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Recent_APickedRecentFont_IsNotMoved()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As String, b As String, before As Long
        With f.FontCombo1
            .RecentMax = 2
            before = .ListCount
            a = .List(5)
            b = .List(6)
            PickByName f.FontCombo1, a
            PickByName f.FontCombo1, b
            Pick f.FontCombo1, 1
            Expect.AreEqual 2, .RecentCount, "RecentCount after a recent font is picked"
            Expect.AreEqual b & " " & a, .List(0) & " " & .List(1), "the recent fonts after the second one is picked"
            Expect.AreEqual a, .Text, "Text after the second recent font is picked"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Recent_ListIndexAssigned_AddsNothing()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        With f.FontCombo1
            .RecentMax = 2
            .ListIndex = 10
            Expect.AreEqual 0, .RecentCount, "RecentCount after ListIndex = 10"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RecentMax_Lowered_DropsTheOldest()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As String, b As String, c As String, before As Long
        With f.FontCombo1
            .RecentMax = 3
            before = .ListCount
            a = .List(5)
            b = .List(6)
            c = .List(7)
            PickByName f.FontCombo1, a
            PickByName f.FontCombo1, b
            PickByName f.FontCombo1, c
            .RecentMax = 1
            Expect.AreEqual 1, .RecentCount, "RecentCount after RecentMax is lowered to 1"
            Expect.AreEqual 1, .ListCount - before, "the entries added to the list after RecentMax is lowered to 1"
            Expect.AreEqual c, .List(0), "the recent font after RecentMax is lowered to 1"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SaveRecent_ReturnsTheNamesMostRecentFirst()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As String, b As String, v As Variant
        With f.FontCombo1
            .RecentMax = 3
            Expect.IsTrue IsEmpty(.SaveRecent), "SaveRecent with no recent font is Empty"
            a = .List(5)
            b = .List(6)
            PickByName f.FontCombo1, a
            PickByName f.FontCombo1, b
            v = .SaveRecent
            Expect.IsTrue IsArray(v), "SaveRecent with recent fonts is an array"
            Expect.AreEqual 0, LBound(v), "the lower bound of the array of SaveRecent"
            Expect.AreEqual 1, UBound(v), "the upper bound of the array of SaveRecent with two recent fonts"
            Expect.AreEqual b & " " & a, v(0) & " " & v(1), "the names of SaveRecent after two picks"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RestoreRecent_Names_BecomeTheRecentFonts()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As String, b As String, before As Long
        With f.FontCombo1
            .RecentMax = 3
            before = .ListCount
            a = .List(10)
            b = .List(4)
            .RestoreRecent Array(a, b)
            Expect.AreEqual 2, .RecentCount, "RecentCount after RestoreRecent of two names"
            Expect.AreEqual 2, .ListCount - before, "the entries added to the list by RestoreRecent of two names"
            Expect.AreEqual a & " " & b, .List(0) & " " & .List(1), "the recent fonts after RestoreRecent of two names"
            .RestoreRecent Array(b)
            Expect.AreEqual 1, .RecentCount, "RecentCount after RestoreRecent of one name replaces them"
            Expect.AreEqual b, .List(0), "the recent font after RestoreRecent of one name"
            Expect.AreEqual 1, .ListCount - before, "the entries added to the list after RestoreRecent of one name"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RestoreRecent_UnknownNames_AreSkipped()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As String, b As String, before As Long
        With f.FontCombo1
            .RecentMax = 3
            before = .ListCount
            a = .List(10)
            b = .List(4)
            .RestoreRecent Array(a, "", b, "no such font")
            Expect.AreEqual 2, .RecentCount, "RecentCount after RestoreRecent of two names, an empty one and an unknown one at the end"
            Expect.AreEqual 2, .ListCount - before, "the entries added to the list by RestoreRecent of two names, an empty one and an unknown one at the end"
            Expect.AreEqual a & " " & b, .List(0) & " " & .List(1), "the recent fonts after RestoreRecent skipped the empty and the unknown name"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RestoreRecent_UnknownNameBeforeAKnownOne_KeepsTheKnownOnes()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As String, b As String, before As Long
        With f.FontCombo1
            .RecentMax = 3
            before = .ListCount
            a = .List(10)
            b = .List(4)
            .RestoreRecent Array(a, "no such font", b)
            Expect.AreEqual 2, .RecentCount, "RecentCount after RestoreRecent of two names with an unknown one between them"
            Expect.AreEqual 2, .ListCount - before, "the entries added to the list by RestoreRecent of two names with an unknown one between them"
            Expect.AreEqual a & " " & b, .List(0) & " " & .List(1), "the recent fonts after RestoreRecent of two names with an unknown one between them"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RestoreRecent_NamesBeyondRecentMax_AreNotTaken()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim a As String, b As String, c As String
        With f.FontCombo1
            .RecentMax = 2
            a = .List(10)
            b = .List(4)
            c = .List(7)
            .RestoreRecent Array(a, b, c)
            Expect.AreEqual 2, .RecentCount, "RecentCount after RestoreRecent of three names with RecentMax 2"
            Expect.AreEqual a & " " & b, .List(0) & " " & .List(1), "the recent fonts after RestoreRecent of three names with RecentMax 2"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RestoreRecent_RecentMaxZero_KeepsTheFonts()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim first As String, before As Long
        With f.FontCombo1
            before = .ListCount
            first = .List(0)
            .RestoreRecent Array(.List(10))
            Expect.AreEqual before, .ListCount, "ListCount after RestoreRecent of one name with RecentMax 0"
            Expect.AreEqual first, .List(0), "List(0) after RestoreRecent of one name with RecentMax 0"
        End With
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RestoreRecent_NotAnArray_Raises380()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.FontCombo1.RestoreRecent 5
        Expect.AreEqual 380, Err.Number, "RestoreRecent 5"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RestoreRecent_TwoDimensionalArray_Raises5()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim m(1 To 2, 1 To 2) As String
        On Error Resume Next
        Err.Clear
        f.FontCombo1.RestoreRecent m
        Expect.AreEqual 5, Err.Number, "RestoreRecent of an array of two dimensions"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RestoreRecent_UnallocatedArray_Raises91()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim e() As String
        On Error Resume Next
        Err.Clear
        f.FontCombo1.RestoreRecent e
        Expect.AreEqual 91, Err.Number, "RestoreRecent of an array that is not allocated"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ClearRecent_RemovesTheRecentFonts()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim before As Long
        With f.FontCombo1
            .RecentMax = 3
            before = .ListCount
            .RestoreRecent Array(.List(10), .List(4))
            .ClearRecent
            Expect.AreEqual 0, .RecentCount, "RecentCount after ClearRecent"
            Expect.AreEqual before, .ListCount, "ListCount after ClearRecent"
        End With
        Unload f
        Expect.Done
    End Sub

    ' ---- the buddy ----

    [TestCase]
    Public Sub BuddyControl_Assigned_ListsTheSizesOfTheSelectedFont()
        Expect.Begin
        Dim f As HostForm, g As HostForm
        Set f = Rig.NewForm()
        Set g = Rig.NewForm()
        f.FontCombo1.BuddyControl = g.FontCombo1
        f.FontCombo1.ListIndex = 4
        Expect.AreEqual 16, g.FontCombo1.ListCount, "the sizes of the buddy after a TrueType font is selected"
        Expect.AreEqual "8 72", g.FontCombo1.List(0) & " " & g.FontCombo1.List(15), "the first and the last size of the buddy"
        Unload g
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub BuddyControl_NoSelectedFont_HasNoSizes()
        Expect.Begin
        Dim f As HostForm, g As HostForm
        Set f = Rig.NewForm()
        Set g = Rig.NewForm()
        f.FontCombo1.BuddyControl = g.FontCombo1
        Expect.AreEqual 0, g.FontCombo1.ListCount, "the sizes of the buddy before a font is selected"
        f.FontCombo1.ListIndex = 4
        f.FontCombo1.ListIndex = -1
        Expect.AreEqual 0, g.FontCombo1.ListCount, "the sizes of the buddy after the selection is removed"
        Unload g
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub BuddyControl_SelectedSize_IsKept()
        Expect.Begin
        Dim f As HostForm, g As HostForm
        Set f = Rig.NewForm()
        Set g = Rig.NewForm()
        f.FontCombo1.BuddyControl = g.FontCombo1
        f.FontCombo1.ListIndex = 4
        g.FontCombo1.ListIndex = 3
        Dim size As String
        size = g.FontCombo1.Text
        f.FontCombo1.ListIndex = 7
        Expect.AreEqual size, g.FontCombo1.Text, "the size selected in the buddy after another font is selected"
        Unload g
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SelectItem_UpdatesTheBuddy()
        Expect.Begin
        Dim f As HostForm, g As HostForm
        Set f = Rig.NewForm()
        Set g = Rig.NewForm()
        f.FontCombo1.BuddyControl = g.FontCombo1
        f.FontCombo1.SelectItem Left$(f.FontCombo1.List(3), 3)
        Expect.AreEqual 16, g.FontCombo1.ListCount, "the sizes of the buddy after a font is selected with SelectItem"
        Unload g
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub BuddyControl_Object_IsReturned()
        Expect.Begin
        Dim f As HostForm, g As HostForm
        Set f = Rig.NewForm()
        Set g = Rig.NewForm()
        Expect.AreEqual "Nothing", TypeName(f.FontCombo1.BuddyControl), "BuddyControl of a new control"
        f.FontCombo1.BuddyControl = g.FontCombo1
        Expect.AreEqual "FontCombo", TypeName(f.FontCombo1.BuddyControl), "TypeName of BuddyControl after a FontCombo is assigned"
        Expect.IsTrue f.FontCombo1.BuddyControl.hWnd = g.FontCombo1.hWnd, "BuddyControl is the control that was assigned"
        Unload g
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub BuddyControl_Nothing_RemovesTheBuddy()
        Expect.Begin
        Dim f As HostForm, g As HostForm
        Set f = Rig.NewForm()
        Set g = Rig.NewForm()
        f.FontCombo1.BuddyControl = g.FontCombo1
        f.FontCombo1.ListIndex = 4
        f.FontCombo1.BuddyControl = Nothing
        Expect.AreEqual "Nothing", TypeName(f.FontCombo1.BuddyControl), "BuddyControl after Nothing is assigned"
        Expect.AreEqual f.FontCombo1.ListCount, g.FontCombo1.ListCount, "the list of the former buddy after the buddy is removed, which lists the fonts again"
        Unload g
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub BuddyControl_NotAFontCombo_Raises35610()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.FontCombo1.BuddyControl = f.ImageCombo1
        Expect.AreEqual 35610, Err.Number, "BuddyControl = an ImageCombo"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub BuddyControl_AnotherType_Raises13()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        On Error Resume Next
        Err.Clear
        f.FontCombo1.BuddyControl = 5
        Expect.AreEqual 13, Err.Number, "BuddyControl = 5"
        On Error GoTo 0
        Unload f
        Expect.Done
    End Sub

End Module

' The events of a FontCombo, written to Rig.Log.
Class FontComboSink

    Public WithEvents Combo As VBCCR18.FontCombo

    Private Sub Combo_Click() Handles Combo.Click
        Rig.Ev "Click"
    End Sub

    Private Sub Combo_Change() Handles Combo.Change
        Rig.Ev "Change"
    End Sub

    Private Sub Combo_Scroll() Handles Combo.Scroll
        Rig.Ev "Scroll"
    End Sub

    Private Sub Combo_ContextMenu(ByRef Handled As Boolean, ByVal X As Single, ByVal Y As Single) Handles Combo.ContextMenu
        Rig.Ev "ContextMenu " & X & " " & Y
    End Sub

    Private Sub Combo_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single) Handles Combo.MouseMove
        Rig.Ev "MouseMove " & X & " " & Y
    End Sub

End Class
