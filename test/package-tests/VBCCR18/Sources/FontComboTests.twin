    ' ---- the selection and the text ----

    [TestCase]
    Public Sub ListIndex_Assigned_SetsTextAndRaisesClick()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New FontComboSink
        Set sink.Combo = f.FontCombo1
        Dim name As String
        name = f.FontCombo1.List(2)
        Rig.ClearLog
        f.FontCombo1.ListIndex = 2
        Expect.AreEqual name, f.FontCombo1.Text, "Text after ListIndex = 2"
        Expect.AreEqual 1, CountOf("Click"), "the number of Click events of ListIndex = 2"
        Expect.AreEqual "Click", LastEvent(), "the last event of ListIndex = 2"
        Rig.ClearLog
        f.FontCombo1.ListIndex = 2
        Expect.AreEqual 0, CountOf("Click"), "the number of Click events of ListIndex = 2 again"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ListIndex_MinusOne_RemovesTheSelection()
        Expect.Begin
