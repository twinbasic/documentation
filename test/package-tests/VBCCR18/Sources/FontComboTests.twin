    [TestCase]
    Public Sub SelectItem_SelectsTheFontThatBeginsWithTheText()
        Expect.Begin
        Dim f As HostForm
        Set f = Rig.NewForm()
        Dim sink As New FontComboSink
        Set sink.Combo = f.FontCombo1
        Dim name As String, r As Long
        name = f.FontCombo1.List(3)
        Rig.ClearLog
        r = f.FontCombo1.SelectItem(Left$(name, 4))
        Expect.IsTrue r >= 0, "SelectItem of the first four letters of a name finds an entry"
        Expect.AreEqual r, f.FontCombo1.ListIndex, "ListIndex after SelectItem"
        Expect.AreEqual 0, StrComp(Left$(f.FontCombo1.Text, 4), Left$(name, 4), vbTextCompare), "the first four letters of Text after SelectItem"
        Expect.AreEqual 1, CountOf("Click"), "the number of Click events of SelectItem"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
    End Sub

