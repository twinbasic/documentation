        f.FontCombo1.ListIndex = 2
        Rig.ClearLog
        f.FontCombo1.ListIndex = -1
        Expect.AreEqual "", f.FontCombo1.Text, "Text after ListIndex = -1"
        Expect.AreEqual 1, CountOf("Click"), "the number of Click events of ListIndex = -1"
        Set sink.Combo = Nothing
        Unload f
        Expect.Done
