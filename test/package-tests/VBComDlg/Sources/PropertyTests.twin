    Public Sub Margins_Negative_Raises380()
        Expect.Begin
        Dim dlg As New CommonDialog
        On Error Resume Next
        dlg.PageLeftMargin = -1
        Expect.AreEqual 380, Err.Number, "Err.Number assigning -1 to PageLeftMargin"
        Err.Clear
        dlg.PageTopMargin = -1
        Expect.AreEqual 380, Err.Number, "Err.Number assigning -1 to PageTopMargin"
        Err.Clear
        dlg.PageRightMargin = -1
        Expect.AreEqual 380, Err.Number, "Err.Number assigning -1 to PageRightMargin"
        Err.Clear
