' CommonDialog: the properties, their defaults, the values they refuse and the ones that cannot be written.
'
' No case here shows a dialog.
[TestFixture]
Module PropertyTests

    Private Declare PtrSafe Function GetLocaleInfoW Lib "kernel32" (ByVal Locale As Long, ByVal LCType As Long, ByVal lpLCData As LongPtr, ByVal cchData As Long) As Long

    ' ---- Action

    [TestCase]
    Public Sub Action_Read_Raises394()
        Expect.Begin
        Dim dlg As New CommonDialog
        Dim v As Integer
        On Error Resume Next
        v = dlg.Action
        Expect.AreEqual 394, Err.Number, "Err.Number reading Action"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Action_OutOfRange_Raises380()
        Expect.Begin
        Dim dlg As New CommonDialog
        On Error Resume Next
        dlg.Action = 0
        Expect.AreEqual 380, Err.Number, "Err.Number assigning 0 to Action"
        Err.Clear
        dlg.Action = 11
        Expect.AreEqual 380, Err.Number, "Err.Number assigning 11 to Action"
        Err.Clear
        dlg.Action = -1
        Expect.AreEqual 380, Err.Number, "Err.Number assigning -1 to Action"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Action_Nine_OpensFindDialog()
        Expect.Begin
        Dim dlg As New CommonDialog
        Dim snk As New FindSink
        snk.Attach dlg
        dlg.HookEvents = True
        dlg.Action = 9
        Expect.AreEqual 1, snk.InitDialogs, "InitDialog events raised by assigning 9 to Action"
        Expect.AreEqual 9, snk.LastInitAction, "Action argument of that InitDialog event (9 = Find)"
        DialogDriver.CloseDialog snk.LastInitHandle
        snk.Detach
        Expect.Done
    End Sub

    ' ---- read-only properties

    [TestCase]
    Public Sub HDC_Write_Raises383()
        Expect.Begin
        Dim dlg As New CommonDialog
        On Error Resume Next
        dlg.hDC = 1
        Expect.AreEqual 383, Err.Number, "Err.Number writing hDC"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FileTitle_Write_Raises383()
        Expect.Begin
        Dim dlg As New CommonDialog
        On Error Resume Next
        dlg.FileTitle = "x.txt"
        Expect.AreEqual 383, Err.Number, "Err.Number writing FileTitle"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FileOffset_Write_Raises383()
        Expect.Begin
        Dim dlg As New CommonDialog
        On Error Resume Next
        dlg.FileOffset = 1
        Expect.AreEqual 383, Err.Number, "Err.Number writing FileOffset"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Object_ReturnsTheInstance()
        Expect.Begin
        Dim dlg As New CommonDialog
        Expect.IsTrue dlg.Object Is dlg, "Object is the instance itself"
        Expect.Done
    End Sub

    ' ---- values that raise error 380

    [TestCase]
    Public Sub MaxFileSize_Zero_Raises380()
        Expect.Begin
        Dim dlg As New CommonDialog
        On Error Resume Next
        dlg.MaxFileSize = 0
        Expect.AreEqual 380, Err.Number, "Err.Number assigning 0 to MaxFileSize"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FilterIndex_Negative_Raises380()
        Expect.Begin
        Dim dlg As New CommonDialog
        On Error Resume Next
        dlg.FilterIndex = -1
        Expect.AreEqual 380, Err.Number, "Err.Number assigning -1 to FilterIndex"
        Err.Clear
        dlg.FilterIndex = 0
        Expect.AreEqual 0, Err.Number, "Err.Number assigning 0 to FilterIndex"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MinMaxFromPageToPage_Negative_Raises380()
        Expect.Begin
        Dim dlg As New CommonDialog
        On Error Resume Next
        dlg.Min = -1
        Expect.AreEqual 380, Err.Number, "Err.Number assigning -1 to Min"
        Err.Clear
        dlg.Max = -1
        Expect.AreEqual 380, Err.Number, "Err.Number assigning -1 to Max"
        Err.Clear
        dlg.FromPage = -1
        Expect.AreEqual 380, Err.Number, "Err.Number assigning -1 to FromPage"
        Err.Clear
        dlg.ToPage = -1
        Expect.AreEqual 380, Err.Number, "Err.Number assigning -1 to ToPage"
        Expect.Done
    End Sub

