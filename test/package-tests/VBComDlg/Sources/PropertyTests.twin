    Public Sub Copies_Zero_Raises380()
        Expect.Begin
        Dim dlg As New CommonDialog
        On Error Resume Next
        dlg.Copies = 0
        Expect.AreEqual 380, Err.Number, "Err.Number assigning 0 to Copies"
        Expect.Done
