    [TestCase]
    Public Sub AssignMultiplicationModulus_PositiveModulus()
        Expect.Begin
        Dim v As Variant
        Dim m As Variant
        Dim a As New BigNumber
        Dim b As New BigNumber
        Dim c As New BigNumber
        Dim r As New BigNumber
        Dim i As Long
        Dim j As Long
        Dim k As Long
        v = Operands()
        m = PositiveModuli()
        For i = LBound(v) To UBound(v)
            For j = LBound(v) To UBound(v)
                For k = LBound(m) To UBound(m)
                    a.ValueString = v(i)
                    b.ValueString = v(j)
                    c.ValueString = m(k)
                    r.AssignMultiplicationModulus a, b, c
                    Expect.AreEqual DecMod(DecMul(v(i), v(j)), m(k)), r.ValueString, "(" & v(i) & " * " & v(j) & ") Mod " & m(k)
                Next k
            Next j
        Next i
        Expect.Done
    End Sub

