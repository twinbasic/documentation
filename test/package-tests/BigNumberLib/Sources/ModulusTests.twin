    [TestCase]
    Public Sub AssignSquaredModulus_PositiveModulus()
        Expect.Begin
        Dim v As Variant
        Dim m As Variant
        Dim a As New BigNumber
        Dim c As New BigNumber
        Dim r As New BigNumber
        Dim i As Long
        Dim k As Long
        v = Operands()
        m = PositiveModuli()
        For i = LBound(v) To UBound(v)
            For k = LBound(m) To UBound(m)
                a.ValueString = v(i)
                c.ValueString = m(k)
                r.AssignSquaredModulus a, c
                Expect.AreEqual DecMod(DecMul(v(i), v(i)), m(k)), r.ValueString, "(" & v(i) & " * " & v(i) & ") Mod " & m(k)
            Next k
        Next i
        Expect.Done
    End Sub

    [TestCase]
    Public Sub AssignSquaredModulus_NegativeModulus()
        Expect.Begin
        Dim v As Variant
        Dim m As Variant
        Dim a As New BigNumber
        Dim c As New BigNumber
        Dim r As New BigNumber
        Dim i As Long
        Dim k As Long
        v = Operands()
        m = NegativeModuli()
        For i = LBound(v) To UBound(v)
            For k = LBound(m) To UBound(m)
                a.ValueString = v(i)
                c.ValueString = m(k)
                r.AssignSquaredModulus a, c
                Expect.AreEqual ForNegativeModulus(DecMod(DecMul(v(i), v(i)), m(k)), m(k)), r.ValueString, "(" & v(i) & " * " & v(i) & ") Mod " & m(k)
            Next k
        Next i
        Expect.Done
    End Sub

    [TestCase]
    Public Sub AssignAdditionModulus_ManualExamples()
        Expect.Begin
        Dim a As New BigNumber
        Dim b As New BigNumber
        Dim m As New BigNumber
        Dim r As New BigNumber
        a.ValueString = "-3"
        b.ValueString = "4"
        m.ValueString = "7"
        r.AssignAdditionModulus a, b, m
        Expect.AreEqual "1", r.ValueString, "(-3 + 4) Mod 7"
        r.AssignSubtractionModulus a, b, m
        Expect.AreEqual "0", r.ValueString, "(-3 - 4) Mod 7"
        r.AssignMultiplicationModulus a, b, m
        Expect.AreEqual "2", r.ValueString, "(-3 * 4) Mod 7"
        a.ValueString = "3"
        m.ValueString = "-7"
        r.AssignAdditionModulus a, b, m
        Expect.AreEqual "-7", r.ValueString, "(3 + 4) Mod -7"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub AssignMultiplicationModulus_LargeNumbers()
        Expect.Begin
        Dim a As New BigNumber
        Dim b As New BigNumber
        Dim m As New BigNumber
        Dim r As New BigNumber
        Dim q As New BigNumber
        Dim p As New BigNumber
        a.ValueString = Pattern(300, 1)
        b.ValueString = Pattern(280, 2)
        m.ValueString = Pattern(200, 3)
        r.AssignMultiplicationModulus a, b, m
        p.AssignMultiplication a, b
        q.AssignDivision p, m
        ' a * b = q * m + r, with 0 <= r < m
        Expect.AreEqual StrMul(Pattern(300, 1), Pattern(280, 2)), StrAdd(StrMul(q.ValueString, Pattern(200, 3)), r.ValueString), "q * m + r for q = (a * b) \ m and r = (a * b) Mod m"
        Expect.AreEqual -1, StrCmp(r.ValueString, Pattern(200, 3)), "(a * b) Mod m is less than m"
        Expect.Done
    End Sub

End Module
