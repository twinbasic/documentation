                    r.AssignMultiplicationModulus a, b, c
                    Expect.AreEqual ForNegativeModulus(DecMod(DecMul(v(i), v(j)), m(k)), m(k)), r.ValueString, "(" & v(i) & " * " & v(j) & ") Mod " & m(k)
                Next k
