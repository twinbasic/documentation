' cDialogPassword: the rules for a password, its rating, and the boxes that ask for it (the InputBox of
' the run-time library, masked by a timer, and a message box for each refused entry), operated with Pilot.
[TestFixture]
Module CDialogPasswordTests

    [TestCase]
    Public Sub Defaults_AreThoseOfThePage()
        Expect.Begin
        Dim box As New cDialogPassword
        Expect.AreEqual "Enter Password", box.Title, "Title of a new cDialogPassword"
        Expect.AreEqual "Please enter your password:", box.Prompt, "Prompt of a new cDialogPassword"
        Expect.AreEqual "*", box.PasswordChar, "PasswordChar of a new cDialogPassword"
        Expect.AreEqual 8, box.MinLength, "MinLength of a new cDialogPassword"
        Expect.AreEqual 128, box.MaxLength, "MaxLength of a new cDialogPassword"
        Expect.AreEqual 3, box.MaxAttempts, "MaxAttempts of a new cDialogPassword"
        Expect.IsTrue box.RequireUppercase And box.RequireLowercase And box.RequireNumber, "RequireUppercase, RequireLowercase and RequireNumber of a new cDialogPassword"
        Expect.IsFalse box.RequireSpecial Or box.RequireConfirm Or box.Cancelled, "RequireSpecial, RequireConfirm and Cancelled of a new cDialogPassword"
        Expect.IsTrue box.ShowStrength And box.AllowShowPassword, "ShowStrength and AllowShowPassword of a new cDialogPassword"
        Expect.AreEqual "", box.Password, "Password of a new cDialogPassword"
        Expect.AreEqual 0, box.OwnerHwnd, "OwnerHwnd of a new cDialogPassword"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub PasswordChar_KeepsTheFirstCharacterAndAnEmptyTextGivesTheDefault()
        Expect.Begin
        Dim box As New cDialogPassword
        box.PasswordChar = "#"
        Expect.AreEqual "#", box.PasswordChar, "PasswordChar after #"
        box.PasswordChar = "abc"
        Expect.AreEqual "a", box.PasswordChar, "PasswordChar after abc"
        box.PasswordChar = ""
        Expect.AreEqual "*", box.PasswordChar, "PasswordChar after an empty string"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Reset_RestoresTheStartingValuesButNotTheOwner()
        Expect.Begin
        Dim box As New cDialogPassword
        box.Title = "x"
        box.Prompt = "y"
        box.PasswordChar = "#"
        box.MinLength = 12
        box.MaxLength = 20
        box.MaxAttempts = 9
        box.RequireUppercase = False
        box.RequireLowercase = False
        box.RequireNumber = False
        box.RequireSpecial = True
        box.RequireConfirm = True
        box.ShowStrength = False
        box.AllowShowPassword = False
        box.OwnerHwnd = 31
        box.Reset
        Expect.AreEqual "Enter Password", box.Title, "Title after Reset"
        Expect.AreEqual "*", box.PasswordChar, "PasswordChar after Reset"
        Expect.AreEqual 8, box.MinLength, "MinLength after Reset"
        Expect.AreEqual 128, box.MaxLength, "MaxLength after Reset"
        Expect.AreEqual 3, box.MaxAttempts, "MaxAttempts after Reset"
        Expect.IsTrue box.RequireUppercase And box.RequireLowercase And box.RequireNumber And box.ShowStrength And box.AllowShowPassword, "the properties that start True, after Reset"
        Expect.IsFalse box.RequireSpecial Or box.RequireConfirm, "RequireSpecial and RequireConfirm after Reset"
        Expect.AreEqual 31, box.OwnerHwnd, "OwnerHwnd after Reset"
        Expect.Done
    End Sub

    ' ---- Validate

    [TestCase]
    Public Sub Validate_ChecksInTheDocumentedOrder()
        Expect.Begin
        Dim box As New cDialogPassword
        Expect.AreEqual "Password must be at least 8 characters", box.Validate("short"), "Validate of short"
        Expect.AreEqual "Password must contain at least one uppercase letter", box.Validate("alllowercase1"), "Validate of alllowercase1"
        Expect.AreEqual "Password must contain at least one lowercase letter", box.Validate("ALLUPPERCASE1"), "Validate of ALLUPPERCASE1"
        Expect.AreEqual "Password must contain at least one number", box.Validate("NoDigitsHere"), "Validate of NoDigitsHere"
        Expect.AreEqual "", box.Validate("Zq7-demo-xx"), "Validate of Zq7-demo-xx"
        box.MaxLength = 10
        Expect.AreEqual "Password must not exceed 10 characters", box.Validate("Zq7-demo-xxx"), "Validate of a text longer than MaxLength"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Validate_RequireSpecialAcceptsThePunctuationOfTheList()
        Expect.Begin
        Dim box As New cDialogPassword
        box.RequireSpecial = True
        Expect.AreEqual "Password must contain at least one special character", box.Validate("Zq7demoxx"), "Validate of Zq7demoxx with RequireSpecial"
        Expect.AreEqual "Password must contain at least one special character", box.Validate("Zq7 demo x"), "Validate of a text with a space only"
        Expect.AreEqual "", box.Validate("Zq7-demo"), "Validate of Zq7-demo with RequireSpecial"
        Dim specials As String = "!@#$%^&*()_+-=[]{}|;:',.<>?/~`"
        Dim i As Long
        For i = 1 To Len(specials)
            Expect.AreEqual "", box.Validate("Zq7demo" & Mid$(specials, i, 1)), "Validate with the special character " & Mid$(specials, i, 1)
        Next
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Validate_ARuleSwitchedOffIsNotChecked()
        Expect.Begin
        Dim box As New cDialogPassword
        box.RequireUppercase = False
        box.RequireLowercase = False
        box.RequireNumber = False
        box.MinLength = 0
        Expect.AreEqual "", box.Validate(""), "Validate of an empty text with MinLength 0 and no character rule"
        Expect.AreEqual "", box.Validate("x"), "Validate of x with no character rule"
        Expect.Done
    End Sub

    ' ---- GetStrength

    [TestCase]
    Public Sub GetStrength_AddsPointsForLengthAndKinds()
        Expect.Begin
        Dim box As New cDialogPassword
        Expect.AreEqual "Very Weak", box.GetStrengthDescription(box.GetStrength("abc")), "strength of abc"
        Expect.AreEqual "Weak", box.GetStrengthDescription(box.GetStrength("Password1")), "strength of Password1"
        Expect.AreEqual "Fair", box.GetStrengthDescription(box.GetStrength("Zq7-demo-xx")), "strength of Zq7-demo-xx"
        Expect.AreEqual "Strong", box.GetStrengthDescription(box.GetStrength("Zq7-demo-xxxx")), "strength of Zq7-demo-xxxx"
        Expect.AreEqual PasswordStrength.VeryWeak, box.GetStrength(""), "strength of an empty text"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetStrength_IgnoresTheRulesOfTheObject()
        Expect.Begin
        Dim box As New cDialogPassword
        Dim before As PasswordStrength = box.GetStrength("Zq7-demo-xx")
        box.MinLength = 50
        box.RequireSpecial = True
        Expect.AreEqual before, box.GetStrength("Zq7-demo-xx"), "strength of Zq7-demo-xx after the rules changed"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetStrength_TheBestPasswordIsVeryStrong()
        Expect.Begin
        Dim box As New cDialogPassword
        Expect.AreEqual PasswordStrength.VeryStrong, box.GetStrength("Zq7-demo-xxxxxxxxxxxx"), "strength of a password of 21 characters with every kind of character"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetStrengthDescription_NamesEachStrength()
        Expect.Begin
        Dim box As New cDialogPassword
        Expect.AreEqual "Very Weak", box.GetStrengthDescription(PasswordStrength.VeryWeak), "VeryWeak"
        Expect.AreEqual "Weak", box.GetStrengthDescription(PasswordStrength.Weak), "Weak"
        Expect.AreEqual "Fair", box.GetStrengthDescription(PasswordStrength.Fair), "Fair"
        Expect.AreEqual "Strong", box.GetStrengthDescription(PasswordStrength.Strong), "Strong"
        Expect.AreEqual "Very Strong", box.GetStrengthDescription(PasswordStrength.VeryStrong), "VeryStrong"
        Expect.AreEqual "", box.GetStrengthDescription(9), "a value that is no member"
        Expect.AreEqual 4, PasswordStrength.VeryStrong, "value of VeryStrong"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetRequirementsDescription_ListsTheRules()
        Expect.Begin
        Dim box As New cDialogPassword
        Expect.AreEqual "Password requirements:" & vbCrLf & "- 8 to 128 characters" & vbCrLf & "- At least one uppercase letter (A-Z)" & vbCrLf & "- At least one lowercase letter (a-z)" & vbCrLf & "- At least one number (0-9)", box.GetRequirementsDescription(), "GetRequirementsDescription of a new cDialogPassword"
        Expect.Done
    End Sub

    ' ---- the first box

    [TestCase]
    Public Sub ShowDialog_TheFirstBoxIsMaskedAndNamesTheRequirements()
        Expect.Begin
        Dim box As New cDialogPassword
        box.Title = "Create account"
        box.Prompt = "Choose a password:"
        box.RequireSpecial = True
        Pilot.Arm "wait=4|id=2"
        Dim r As Boolean = box.ShowDialog()
        Pilot.Disarm
        Expect.AreEqual "Create account", Pilot.Title(0), "title of the box"
        Expect.AreEqual "Choose a password:" & vbCrLf & vbCrLf & "Requirements:" & vbCrLf & "- Minimum 8 characters" & vbCrLf & "- At least one uppercase letter" & vbCrLf & "- At least one lowercase letter" & vbCrLf & "- At least one number" & vbCrLf & "- At least one special character", Pilot.Statics(0), "text of the box"
        Expect.AreEqual AscW("*"), Pilot.PasswordChar(0), "password character of the first box"
        Expect.IsFalse r, "ShowDialog after Cancel"
        Expect.IsTrue box.Cancelled, "Cancelled after Cancel"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowDialog_PasswordCharIsUsedForTheMask()
        Expect.Begin
        Dim box As New cDialogPassword
        box.PasswordChar = "#"
        Pilot.Arm "wait=4|id=2"
        box.ShowDialog
        Pilot.Disarm
        Expect.AreEqual AscW("#"), Pilot.PasswordChar(0), "password character of the first box with PasswordChar #"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowDialog_AGoodPasswordIsStored()
        Expect.Begin
        Dim box As New cDialogPassword
        Pilot.Arm "t=Zq7-demo-xx|id=1"
        Dim r As Boolean = box.ShowDialog()
        Pilot.Disarm
        Expect.IsTrue r, "ShowDialog after a good password"
        Expect.AreEqual "Zq7-demo-xx", box.Password, "Password after a good password"
        Expect.IsFalse box.Cancelled, "Cancelled after a good password"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowDialog_ARefusedPasswordShowsTheReasonAndTheAttemptsLeft()
        Expect.Begin
        Dim box As New cDialogPassword
        Pilot.Arm "t=short|id=1;close;t=Zq7-demo-xx|id=1"
        Dim r As Boolean = box.ShowDialog()
        Pilot.Disarm
        Expect.AreEqual 3, Pilot.WindowsSeen, "windows opened (the box, the message, the box again)"
        Expect.AreEqual "Password must be at least 8 characters" & vbCrLf & vbCrLf & "Attempts remaining: 2", Pilot.Statics(1), "text of the message"
        Expect.AreEqual "Enter Password", Pilot.Title(1), "title of the message"
        Expect.IsTrue r, "ShowDialog after a good second password"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowDialog_ThreeRefusedPasswordsEndTheCallAndKeepThePassword()
        Expect.Begin
        Dim box As New cDialogPassword
        Pilot.Arm "t=Zq7-demo-xx|id=1"
        box.ShowDialog
        Pilot.Disarm
        Pilot.Arm "t=short|id=1;close;t=short|id=1;close;t=short|id=1;close"
        Dim r As Boolean = box.ShowDialog()
        Pilot.Disarm
        Expect.AreEqual 6, Pilot.WindowsSeen, "windows opened (three boxes and three messages)"
        Expect.AreEqual "Password must be at least 8 characters" & vbCrLf & vbCrLf & "Maximum attempts reached.", Pilot.Statics(5), "text of the third message"
        Expect.IsFalse r, "ShowDialog after three refused passwords"
        Expect.IsTrue box.Cancelled, "Cancelled after three refused passwords"
        Expect.AreEqual "Zq7-demo-xx", box.Password, "Password after three refused passwords"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowDialog_MaxAttemptsOfZeroShowsNothing()
        Expect.Begin
        Dim box As New cDialogPassword
        box.MaxAttempts = 0
        Pilot.Arm "id=2"
        Dim r As Boolean = box.ShowDialog()
        Pilot.Disarm
        Expect.AreEqual 0, Pilot.WindowsSeen, "boxes ShowDialog opened with MaxAttempts 0"
        Expect.IsFalse r, "ShowDialog with MaxAttempts 0"
        Expect.IsTrue box.Cancelled, "Cancelled with MaxAttempts 0"
        Expect.Done
    End Sub

    ' ---- the confirmation box

    [TestCase]
    Public Sub ShowDialog_RequireConfirmAsksAgainInASecondBox()
        Expect.Begin
        Dim box As New cDialogPassword
        box.Title = "New"
        box.RequireConfirm = True
        Pilot.Arm "t=Zq7-demo-xx|id=1;t=Zq7-demo-xx|id=1"
        Dim r As Boolean = box.ShowDialog()
        Pilot.Disarm
        Expect.AreEqual 2, Pilot.WindowsSeen, "boxes ShowDialog opened with RequireConfirm"
        Expect.AreEqual "New - Confirm", Pilot.Title(1), "title of the confirmation box"
        Expect.AreEqual "Please confirm your password:", Pilot.Statics(1), "text of the confirmation box"
        Expect.IsTrue r, "ShowDialog after two equal entries"
        Expect.AreEqual "Zq7-demo-xx", box.Password, "Password after two equal entries"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowDialog_ADifferentConfirmationCountsAsAFailedAttempt()
        Expect.Begin
        Dim box As New cDialogPassword
        box.RequireConfirm = True
        box.MaxAttempts = 1
        Pilot.Arm "t=Zq7-demo-xx|id=1;t=Zq7-demo-yy|id=1;close"
        Dim r As Boolean = box.ShowDialog()
        Pilot.Disarm
        Expect.AreEqual 3, Pilot.WindowsSeen, "windows opened (two boxes and a message)"
        Expect.AreEqual "Passwords do not match!" & vbCrLf & vbCrLf & "Maximum attempts reached.", Pilot.Statics(2), "text of the message"
        Expect.IsFalse r, "ShowDialog after a different confirmation with MaxAttempts 1"
        Expect.IsTrue box.Cancelled, "Cancelled after that"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowDialog_TheConfirmationBoxIsMasked()
        Expect.Begin
        Dim box As New cDialogPassword
        box.RequireConfirm = True
        Pilot.Arm "t=Zq7-demo-xx|id=1;wait=4|id=2"
        box.ShowDialog
        Pilot.Disarm
        Expect.AreEqual 2, Pilot.WindowsSeen, "boxes ShowDialog opened with RequireConfirm"
        Expect.AreEqual AscW("*"), Pilot.PasswordChar(0), "password character of the first box"
        Expect.AreEqual AscW("*"), Pilot.PasswordChar(1), "password character of the confirmation box"
        Expect.Done
    End Sub

    ' ---- ShowChangeDialog

    [TestCase]
    Public Sub ShowChangeDialog_AsksForTheCurrentTheNewAndTheConfirmation()
        Expect.Begin
        Dim box As New cDialogPassword
        Dim stored As String = "Old-demo-pw1"
        Pilot.Arm "t=Old-demo-pw1|id=1;t=New-demo-pw2|id=1;t=New-demo-pw2|id=1"
        Dim r As Boolean = box.ShowChangeDialog(stored)
        Pilot.Disarm
        Expect.AreEqual 3, Pilot.WindowsSeen, "boxes ShowChangeDialog opened"
        Expect.AreEqual "Enter Password - Current Password", Pilot.Title(0), "title of the first box"
        Expect.AreEqual "Enter Password - New Password", Pilot.Title(1), "title of the second box"
        Expect.AreEqual "Enter Password - Confirm New Password", Pilot.Title(2), "title of the third box"
        Expect.IsTrue r, "ShowChangeDialog after good entries"
        Expect.AreEqual "New-demo-pw2", stored, "the old password variable after a good change"
        Expect.AreEqual "New-demo-pw2", box.Password, "Password after a good change"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowChangeDialog_AWrongCurrentPasswordStopsTheCall()
        Expect.Begin
        Dim box As New cDialogPassword
        Dim stored As String = "Old-demo-pw1"
        Pilot.Arm "t=Wrong-demo-pw1|id=1;close"
        Dim r As Boolean = box.ShowChangeDialog(stored)
        Pilot.Disarm
        Expect.AreEqual 2, Pilot.WindowsSeen, "windows opened (the first box and a message)"
        Expect.IsTrue InStr(Pilot.Statics(1), "Incorrect current password.") > 0, "text of the message: " & Pilot.Statics(1)
        Expect.IsFalse r, "ShowChangeDialog after a wrong current password"
        Expect.IsFalse box.Cancelled, "Cancelled after a wrong current password"
        Expect.AreEqual "Old-demo-pw1", stored, "the old password variable after a wrong current password"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowChangeDialog_ANewPasswordEqualToTheCurrentOneStopsTheCall()
        Expect.Begin
        Dim box As New cDialogPassword
        Dim stored As String = "Old-demo-pw1"
        Pilot.Arm "t=Old-demo-pw1|id=1;t=Old-demo-pw1|id=1;close"
        Dim r As Boolean = box.ShowChangeDialog(stored)
        Pilot.Disarm
        Expect.AreEqual 3, Pilot.WindowsSeen, "windows opened (two boxes and a message)"
        Expect.IsTrue InStr(Pilot.Statics(2), "New password must be different from the current password.") > 0, "text of the message: " & Pilot.Statics(2)
        Expect.IsFalse r, "ShowChangeDialog after a new password equal to the current one"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowChangeDialog_ADifferentConfirmationStopsTheCall()
        Expect.Begin
        Dim box As New cDialogPassword
        Dim stored As String = "Old-demo-pw1"
        Pilot.Arm "t=Old-demo-pw1|id=1;t=New-demo-pw2|id=1;t=New-demo-pw3|id=1;close"
        Dim r As Boolean = box.ShowChangeDialog(stored)
        Pilot.Disarm
        Expect.AreEqual 4, Pilot.WindowsSeen, "windows opened (three boxes and a message)"
        Expect.IsTrue InStr(Pilot.Statics(3), "Passwords do not match.") > 0, "text of the message: " & Pilot.Statics(3)
        Expect.IsFalse r, "ShowChangeDialog after a different confirmation"
        Expect.AreEqual "Old-demo-pw1", stored, "the old password variable after a different confirmation"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowChangeDialog_CancellingABoxSetsCancelled()
        Expect.Begin
        Dim box As New cDialogPassword
        Dim stored As String = "Old-demo-pw1"
        Pilot.Arm "id=2"
        Dim r As Boolean = box.ShowChangeDialog(stored)
        Pilot.Disarm
        Expect.IsFalse r, "ShowChangeDialog after Cancel"
        Expect.IsTrue box.Cancelled, "Cancelled after Cancel"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowChangeDialog_TheThreeBoxesAreMasked()
        Expect.Begin
        Dim box As New cDialogPassword
        Dim stored As String = "Old-demo-pw1"
        Pilot.Arm "wait=4|t=Old-demo-pw1|id=1;wait=4|t=New-demo-pw2|id=1;wait=4|id=2"
        box.ShowChangeDialog stored
        Pilot.Disarm
        Expect.AreEqual 3, Pilot.WindowsSeen, "boxes ShowChangeDialog opened"
        Expect.AreEqual AscW("*"), Pilot.PasswordChar(0), "password character of the box for the current password"
        Expect.AreEqual AscW("*"), Pilot.PasswordChar(1), "password character of the box for the new password"
        Expect.AreEqual AscW("*"), Pilot.PasswordChar(2), "password character of the box for the confirmation"
        Expect.Done
    End Sub

    ' ---- the properties that have no effect

    [TestCase]
    Public Sub OwnerHwnd_OwnsTheBoxes()
        Expect.Begin
        Dim owner As LongPtr = Fx.MakeOwner()
        Dim box As New cDialogPassword
        box.OwnerHwnd = owner
        Pilot.Arm "id=2"
        box.ShowDialog
        Pilot.Disarm
        Expect.IsTrue Pilot.OwnerOf(0) = owner, "the box is owned by the window set in OwnerHwnd"
        Fx.DestroyOwner owner
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ShowStrength_ShowsAStrengthIndicator()
        Expect.Begin
        Dim box As New cDialogPassword
        box.ShowStrength = True
        Pilot.Arm "id=2"
        box.ShowDialog
        Pilot.Disarm
        Expect.IsTrue InStr(Pilot.Classes(0), "msctls_progress32") > 0 Or InStr(LCase$(Pilot.Statics(0)), "strength") > 0, "the box has a strength indicator: " & Pilot.Classes(0)
        Expect.Done
    End Sub

    [TestCase]
    Public Sub AllowShowPassword_ShowsAControlThatRevealsThePassword()
        Expect.Begin
        Dim box As New cDialogPassword
        box.AllowShowPassword = True
        Pilot.Arm "id=2"
        box.ShowDialog
        Pilot.Disarm
        Expect.IsTrue InStr(LCase$(Pilot.Buttons(0)), "show") > 0, "the box has a control that shows the password; its buttons are: " & Replace(Pilot.Buttons(0), vbLf, "/")
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Password_StaysInTheObjectUntilReset()
        Expect.Begin
        Dim box As New cDialogPassword
        Pilot.Arm "t=Zq7-demo-xx|id=1"
        box.ShowDialog
        Pilot.Disarm
        Expect.AreEqual "Zq7-demo-xx", box.Password, "Password after a good entry"
        box.Reset
        Expect.AreEqual "", box.Password, "Password after Reset"
        Expect.Done
    End Sub

End Module
