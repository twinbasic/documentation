        Expect.AreEqual 2, p.adjustment, "adjustment after ColorCurve(params)"
        Expect.AreEqual 1, p.channel, "channel after ColorCurve(params)"
        Expect.AreEqual 20, p.value, "value after ColorCurve(params)"
        Expect.Done
    End Sub

