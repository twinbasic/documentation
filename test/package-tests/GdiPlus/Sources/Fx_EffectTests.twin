    ' ---- ColorLUT: the four-array form and ColorLUTParams( )

    [TestCase]
    Public Sub ColorLUT_NewWithFourArrays_TakesTheAlphaTableFromLutA()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim lutB(0 To 255) As Byte, lutG(0 To 255) As Byte, lutR(0 To 255) As Byte, lutA(0 To 255) As Byte
        Dim i As Long
        For i = 0 To 255
            lutB(i) = 255 - i
            lutG(i) = i
            lutR(i) = i
            lutA(i) = i
        Next
        Dim fx As ColorLUT = ColorLUT(lutB, lutG, lutR, lutA)
        Expect.AreEqual 0, fx.LastResult, "ColorLUT.LastResult after the four-array form"
        Dim p As ColorLUTParams = fx.Parameters(LenB(Of ColorLUTParams))
        Expect.AreEqual 245, p.lutB.b(10), "lutB.b(10) after the four-array form"
        Expect.AreEqual 10, p.lutG.b(10), "lutG.b(10) after the four-array form"
        Expect.AreEqual 10, p.lutR.b(10), "lutR.b(10) after the four-array form"
        Expect.AreEqual 10, p.lutA.b(10), "lutA.b(10) after the four-array form"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ColorLUTParams_FromFourArrays_TakesTheAlphaTableFromLutA()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim lutB(0 To 255) As Byte, lutG(0 To 255) As Byte, lutR(0 To 255) As Byte, lutA(0 To 255) As Byte
        Dim i As Long
        For i = 0 To 255
            lutB(i) = 255 - i
            lutG(i) = i
            lutR(i) = i
            lutA(i) = i
        Next
        Dim p As ColorLUTParams = ColorLUTParams(lutB, lutG, lutR, lutA)
        Expect.AreEqual 245, p.lutB.b(10), "lutB.b(10) of ColorLUTParams(...)"
        Expect.AreEqual 10, p.lutG.b(10), "lutG.b(10) of ColorLUTParams(...)"
        Expect.AreEqual 10, p.lutR.b(10), "lutR.b(10) of ColorLUTParams(...)"
        Expect.AreEqual 10, p.lutA.b(10), "lutA.b(10) of ColorLUTParams(...)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ColorLUT_ApplyEffectWithFourArrays_KeepsAlphaWithTheIdentityTable()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim lutB(0 To 255) As Byte, lutG(0 To 255) As Byte, lutR(0 To 255) As Byte, lutA(0 To 255) As Byte
        Dim i As Long
        For i = 0 To 255
            lutB(i) = 255 - i
            lutG(i) = i
            lutR(i) = i
            lutA(i) = i
        Next
        Dim bmp As Bitmap = Fx_Flat(200, 100, 50)
        Expect.AreEqual 0, bmp.ApplyEffect(ColorLUT(lutB, lutG, lutR, lutA), GpRect(0, 0, 4, 4)), "ApplyEffect with the four-array ColorLUT"
        Expect.AreEqual "FFC864CD", Fx_Px(bmp), "pixel after inverting blue and keeping alpha, red and green"
        Expect.Done
    End Sub

    ' ---- RedEyeCorrection

    [TestCase]
    Public Sub RedEyeCorrection_NewWithParams_StoresTheAreas()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim p As RedEyeCorrectionParams
        Expect.AreEqual 0, p.Allocate(2), "Allocate(2)"
        Set p.Area(1) = GpRect(0, 0, 5, 5)
        Set p.Area(2) = GpRect(5, 5, 4, 4)
        Dim fx As RedEyeCorrection = RedEyeCorrection(p)
        Expect.AreEqual 0, fx.LastResult, "RedEyeCorrection.LastResult after RedEyeCorrection(params)"
        Dim bmp As Bitmap = Fx_FlatSized(10, 220, 20, 20)
        Expect.AreEqual 0, bmp.ApplyEffect(fx, GpRect(0, 0, 10, 10)), "ApplyEffect with a RedEyeCorrection made from parameters"
        p.Free
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RedEyeCorrection_NewKeywordWithParams_StoresTheAreas()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim p As RedEyeCorrectionParams
        Expect.AreEqual 0, p.Allocate(1), "Allocate(1)"
        Set p.Area(1) = GpRect(0, 0, 10, 10)
        Dim fx As RedEyeCorrection = New RedEyeCorrection(p)
        Expect.AreEqual 0, fx.LastResult, "RedEyeCorrection.LastResult after New RedEyeCorrection(params)"
        Dim bmp As Bitmap = Fx_FlatSized(10, 220, 20, 20)
        Expect.AreEqual 0, bmp.ApplyEffect(fx, GpRect(0, 0, 10, 10)), "ApplyEffect with a RedEyeCorrection made from parameters"
        p.Free
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RedEyeCorrection_ParametersGet_AfterSettingAreas_ReturnsTheAreaCount()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim p As RedEyeCorrectionParams
        Expect.AreEqual 0, p.Allocate(2), "Allocate(2)"
        Set p.Area(1) = GpRect(0, 0, 5, 5)
        Set p.Area(2) = GpRect(5, 5, 4, 4)
        Dim fx As RedEyeCorrection = RedEyeCorrection()
        fx.Parameters = p
        fx.ClearResult
        Dim back As RedEyeCorrectionParams = fx.Parameters(LenB(Of RedEyeCorrectionParams))
        Expect.AreEqual 0, fx.LastResult, "RedEyeCorrection.LastResult after reading Parameters with a size"
        Expect.AreEqual 2, back.numberOfAreas, "numberOfAreas read back"
        p.Free
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RedEyeCorrection_ApplyEffectWithoutAreas_ReturnsInvalidParameter()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim fx As RedEyeCorrection = RedEyeCorrection()
        Expect.AreEqual Ok, fx.LastResult, "RedEyeCorrection.LastResult after RedEyeCorrection()"
        Dim bmp As Bitmap = Fx_FlatSized(10, 220, 20, 20)
        Expect.AreEqual InvalidParameter, bmp.ApplyEffect(fx, GpRect(0, 0, 10, 10)), "ApplyEffect with a RedEyeCorrection that has no areas"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RedEyeCorrection_ParametersLet_StoresTheAreas()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim p As RedEyeCorrectionParams
        Expect.AreEqual 0, p.Allocate(2), "Allocate(2)"
        Set p.Area(1) = GpRect(0, 0, 5, 5)
        Set p.Area(2) = GpRect(5, 5, 4, 4)
        Dim fx As RedEyeCorrection = RedEyeCorrection()
        fx.Parameters = p
        Expect.AreEqual 0, fx.LastResult, "RedEyeCorrection.LastResult after setting Parameters"
        Dim bmp As Bitmap = Fx_FlatSized(10, 220, 20, 20)
        Expect.AreEqual 0, bmp.ApplyEffect(fx, GpRect(0, 0, 10, 10)), "ApplyEffect after setting the areas"
        p.Free
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RedEyeCorrectionParams_FromArray_CopiesTheAreas()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim areas(1 To 2) As GpRect
        areas(1) = GpRect(0, 0, 5, 5)
        areas(2) = GpRect(5, 5, 4, 4)
        Dim p As RedEyeCorrectionParams = RedEyeCorrectionParams(areas)
        Expect.AreEqual 2, p.numberOfAreas, "numberOfAreas of RedEyeCorrectionParams(areas)"
        Expect.AreEqual 5, p.Area(1).Width, "Area(1).Width of RedEyeCorrectionParams(areas)"
        Expect.AreEqual 5, p.Area(2).X, "Area(2).X of RedEyeCorrectionParams(areas)"
        p.Free
        Expect.Done
    End Sub

    ' ---- ColorMatrix: the output component is the first index

    [TestCase]
    Public Sub ColorMatrix_FirstIndexIsTheOutputComponent_ImageAttributes()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim src As Bitmap = Bitmap(4!, 4!)
        src.Pixel(1, 1) = Color(255, 200, 100, 40)
        Dim dst As Bitmap = Bitmap(4!, 4!)
        Dim g As Graphics = Graphics(dst)
        Dim ia As ImageAttributes = New ImageAttributes()
        Dim cm As ColorMatrix = Fx_Identity()
        cm.m(2, 2) = 0
        cm.m(2, 0) = 1                      ' blue = red
        ia.SetColorMatrix cm
        g.DrawImage src, GpRect(0, 0, 4, 4), GpRect(0, 0, 4, 4), UnitPixel, ia
        Expect.AreEqual "FFC864C8", Fx_Px(dst), "m(2, 0) = 1 makes blue from red"

        Dim cm2 As ColorMatrix = Fx_Identity()
        cm2.m(0, 0) = 0
        cm2.m(0, 2) = 1                     ' red = blue
        ia.SetColorMatrix cm2
        g.Clear Color(0, 0, 0, 0)
        g.DrawImage src, GpRect(0, 0, 4, 4), GpRect(0, 0, 4, 4), UnitPixel, ia
        Expect.AreEqual "FF286428", Fx_Px(dst), "m(0, 2) = 1 makes red from blue"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ColorMatrix_FirstIndexIsTheOutputComponent_ColorMatrixEffect()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim cm As ColorMatrix = Fx_Identity()
        cm.m(2, 2) = 0
        cm.m(2, 0) = 1                      ' blue = red
        Dim fx As ColorMatrixEffect = ColorMatrixEffect()
        fx.Parameters = cm
        Dim bmp As Bitmap = Fx_Flat(200, 100, 40)
        Expect.AreEqual 0, bmp.ApplyEffect(fx, GpRect(0, 0, 4, 4)), "ApplyEffect with m(2, 0) = 1"
        Expect.AreEqual "FFC864C8", Fx_Px(bmp), "m(2, 0) = 1 makes blue from red"

        Dim cm2 As ColorMatrix = Fx_Identity()
        cm2.m(0, 0) = 0
        cm2.m(0, 2) = 1                     ' red = blue
        fx.Parameters = cm2
        Dim bmp2 As Bitmap = Fx_Flat(200, 100, 40)
        Expect.AreEqual 0, bmp2.ApplyEffect(fx, GpRect(0, 0, 4, 4)), "ApplyEffect with m(0, 2) = 1"
        Expect.AreEqual "FF286428", Fx_Px(bmp2), "m(0, 2) = 1 makes red from blue"
        Expect.Done
    End Sub

    ' ---- LevelsParams: the first field

    [TestCase]
    Public Sub LevelsParams_HighightField_HoldsTheHighlightLevel()
        Expect.Begin
        Dim p As LevelsParams = LevelsParams(90, 10, 5)
        Expect.AreEqual 90, p.highight, "LevelsParams(90, 10, 5).highight"
        Expect.AreEqual 10, p.midtone, "LevelsParams(90, 10, 5).midtone"
        Expect.AreEqual 5, p.shadow, "LevelsParams(90, 10, 5).shadow"
        Expect.Done
    End Sub

End Module
