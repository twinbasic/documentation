    [TestCase]
    Public Sub ColorMatrixEffect_ParametersGetWithoutSize_ReturnsTheParameters()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim cm As ColorMatrix = Fx_Identity()
        cm.m(2, 0) = 1
        Dim fx As ColorMatrixEffect = ColorMatrixEffect()
        fx.Parameters = cm
        Dim back As ColorMatrix = fx.Parameters
        Expect.AreEqual 0, fx.LastResult, "ColorMatrixEffect.LastResult after reading Parameters without a size"
        Expect.AreEqual 1, back.m(2, 0), "ColorMatrixEffect.Parameters.m(2, 0) read without a size"
        Expect.AreEqual 1, back.m(1, 1), "ColorMatrixEffect.Parameters.m(1, 1) read without a size"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ColorLUT_ParametersGetWithoutSize_ReturnsTheParameters()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim tables As ColorLUTParams
        Dim i As Long
        For i = 0 To 255
            tables.lutB.b(i) = 255 - i
            tables.lutG.b(i) = i
            tables.lutR.b(i) = i
            tables.lutA.b(i) = i
        Next
        Dim fx As ColorLUT = ColorLUT()
        fx.Parameters = tables
        Dim p As ColorLUTParams = fx.Parameters
        Expect.AreEqual 0, fx.LastResult, "ColorLUT.LastResult after reading Parameters without a size"
        Expect.AreEqual 245, p.lutB.b(10), "ColorLUT.Parameters.lutB.b(10) read without a size"
        Expect.AreEqual 10, p.lutG.b(10), "ColorLUT.Parameters.lutG.b(10) read without a size"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub RedEyeCorrection_ParametersGetWithoutSize_SetsNoError()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim fx As RedEyeCorrection = RedEyeCorrection()
        Dim p As RedEyeCorrectionParams = fx.Parameters
        Expect.AreEqual 0, fx.LastResult, "RedEyeCorrection.LastResult after reading Parameters without a size"
        Expect.Done
    End Sub

    ' ---- Effect.ParameterSize

    [TestCase]
    Public Sub ParameterSize_BrightnessContrast_IsTheSizeOfItsParameters()
