    ' ---- the constructors that take a parameters structure

    [TestCase]
    Public Sub ColorBalance_NewWithParams_StoresTheParameters()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim fx As ColorBalance = ColorBalance(ColorBalanceParams(10, -20, 30))
        Expect.AreEqual 0, fx.LastResult, "ColorBalance.LastResult after ColorBalance(params)"
        Dim p As ColorBalanceParams = fx.Parameters(LenB(Of ColorBalanceParams))
        Expect.AreEqual 10, p.cyanRed, "cyanRed after ColorBalance(params)"
        Expect.AreEqual -20, p.magentaGreen, "magentaGreen after ColorBalance(params)"
        Expect.AreEqual 30, p.yellowBlue, "yellowBlue after ColorBalance(params)"
        Expect.Done
    End Sub

