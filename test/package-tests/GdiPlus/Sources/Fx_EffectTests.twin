    [TestCase]
    Public Sub ColorCurve_ParametersGetWithoutSize_ReturnsTheParameters()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim fx As ColorCurve = ColorCurve(AdjustContrast, CurveChannelRed, 20)
        Dim p As ColorCurveParams = fx.Parameters
        Expect.AreEqual 0, fx.LastResult, "ColorCurve.LastResult after reading Parameters without a size"
        Expect.AreEqual 2, p.adjustment, "ColorCurve.Parameters.adjustment read without a size"
        Expect.AreEqual 1, p.channel, "ColorCurve.Parameters.channel read without a size"
        Expect.AreEqual 20, p.value, "ColorCurve.Parameters.value read without a size"
