' Fx_EffectTests: the image effects (Effect and its eleven classes) and their parameter types.
' The effects are applied to bitmaps of GdiPlus; the cases check what each one stores and returns.
[TestFixture]
Module Fx_EffectTests

    ' ---- Effect.Parameters: the getter without a size

    [TestCase]
    Public Sub Blur_ParametersGetWithoutSize_ReturnsTheParameters()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim fx As Blur = Blur(5!, False)
        Dim p As BlurParams = fx.Parameters
        Expect.AreEqual 0, fx.LastResult, "Blur.LastResult after reading Parameters without a size"
        Expect.AreEqual 5, p.radius, "Blur.Parameters.radius read without a size"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Sharpen_ParametersGetWithoutSize_ReturnsTheParameters()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim fx As Sharpen = Sharpen(5!, 50!)
        Dim p As SharpenParams = fx.Parameters
        Expect.AreEqual 0, fx.LastResult, "Sharpen.LastResult after reading Parameters without a size"
        Expect.AreEqual 5, p.radius, "Sharpen.Parameters.radius read without a size"
        Expect.AreEqual 50, p.amount, "Sharpen.Parameters.amount read without a size"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub BrightnessContrast_ParametersGetWithoutSize_ReturnsTheParameters()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim fx As BrightnessContrast = BrightnessContrast(10, 20)
        Dim p As BrightnessContrastParams = fx.Parameters
        Expect.AreEqual 0, fx.LastResult, "BrightnessContrast.LastResult after reading Parameters without a size"
        Expect.AreEqual 10, p.brightness, "BrightnessContrast.Parameters.brightness read without a size"
        Expect.AreEqual 20, p.contrast, "BrightnessContrast.Parameters.contrast read without a size"
        Expect.Done
    End Sub

