' GdiPlus, Bitmap: constructors, ConvertFormat and loading a saved picture.
[TestFixture]
Module Im_BitmapTests

    [TestCase]
    Public Sub New_TwoIntegerArgumentsMakeABitmap()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim bmp As Bitmap = Bitmap(8, 6)
        Expect.AreEqual 0, CLng(bmp.LastResult), "LastResult of Bitmap(8, 6) with two Integer arguments (0 is Ok, 7 is Win32Error)"
        Expect.AreEqual 8, CLng(bmp.Width), "Width of Bitmap(8, 6)"
        Expect.AreEqual 6, CLng(bmp.Height), "Height of Bitmap(8, 6)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub New_NewKeywordWithTwoIntegerArguments()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim bmp As Bitmap = New Bitmap(8, 6)
        Expect.AreEqual 0, CLng(bmp.LastResult), "LastResult of New Bitmap(8, 6) with two Integer arguments (0 is Ok, 7 is Win32Error)"
        Expect.AreEqual 8, CLng(bmp.Width), "Width of New Bitmap(8, 6)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub New_SingleArgumentsMakeABitmapOfThatSize()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim bmp As Bitmap = Bitmap(8!, 6!)
        Expect.AreEqual 0, CLng(bmp.LastResult), "LastResult of Bitmap(8!, 6!) (0 is Ok)"
        Expect.AreEqual 8, CLng(bmp.Width), "Width of Bitmap(8!, 6!)"
        Expect.AreEqual 6, CLng(bmp.Height), "Height of Bitmap(8!, 6!)"
        Dim withFormat As Bitmap = Bitmap(8, 6, PixelFormat24bppRGB)
        Expect.AreEqual 0, CLng(withFormat.LastResult), "LastResult of Bitmap(8, 6, PixelFormat24bppRGB) (0 is Ok)"
        Expect.AreEqual 8, CLng(withFormat.Width), "Width of Bitmap(8, 6, PixelFormat24bppRGB)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Clone_WholeBitmapWithItsRectangleKeepsPixels()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim bmp As Bitmap = Bitmap(4!, 3!)
        bmp.Pixel(1, 1) = Color(255, 60, 100, 7)
        Dim whole As Bitmap = bmp.Clone(GpRect(0, 0, 4, 3), PixelFormat32bppARGB)
        Expect.AreEqual 0, CLng(bmp.LastResult), "LastResult of Bitmap.Clone with the full rectangle (0 is Ok)"
        Expect.AreEqual 4, CLng(whole.Width), "Width of the copy"
        Expect.AreEqual &HFF3C6407, whole.Pixel(1, 1).argb, "the pixel of the copy"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub InitializePalette_FixedBW_FillsThePalette()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim pal As ColorPalette
        pal.count = 2
        Dim st As GpStatus = InitializePalette(pal, PaletteTypeFixedBW, 2, False)
        Expect.AreEqual 0, CLng(st), "InitializePalette of a palette of two entries with PaletteTypeFixedBW, without a bitmap, returns (0 is Ok)"
        Expect.AreEqual "FF000000", Ty_Hex8(pal.entries(0)), "first entry of the palette after InitializePalette with PaletteTypeFixedBW (black)"
        Expect.AreEqual "FFFFFFFF", Ty_Hex8(pal.entries(1)), "second entry of the palette after InitializePalette with PaletteTypeFixedBW (white)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub InitializePalette_OptimalWithABitmap_FillsThePalette()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim bmp As Bitmap = Bitmap(4!, 4!)
        Dim g As Graphics = Graphics(bmp)
        g.Clear Color(255, 200, 100, 50)
        Set g = Nothing
        Dim pal As ColorPalette
        pal.count = 16
        Dim st As GpStatus = InitializePalette(pal, PaletteTypeOptimal, 16, False, bmp)
        Expect.AreEqual 0, CLng(st), "InitializePalette of a palette of 16 entries with PaletteTypeOptimal and a bitmap returns (0 is Ok)"
        Expect.AreEqual 16, CLng(pal.count), "count of the palette after InitializePalette with PaletteTypeOptimal and a bitmap"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConvertFormat_FixedBWWithABlankPalette()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim bmp As Bitmap = Bitmap(4!, 4!)
        Dim g As Graphics = Graphics(bmp)
        g.Clear Color(255, 255, 255, 255)
        Set g = Nothing
        Dim blank As ColorPalette
        Dim st As GpStatus = bmp.ConvertFormat(PixelFormat1bppIndexed, DitherTypeSolid, PaletteTypeFixedBW, blank, 0!)
        Expect.AreEqual 0, CLng(st), "ConvertFormat to 1 bit with PaletteTypeFixedBW and a blank ColorPalette returns (0 is Ok)"
        Expect.AreEqual &H30101, CLng(bmp.PixelFormat), "the pixel format after the conversion with PaletteTypeFixedBW and a blank palette"
        Expect.AreEqual &HFFFFFFFF, bmp.Pixel(2, 2).argb, "the white pixel after the conversion with PaletteTypeFixedBW and a blank palette"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConvertFormat_OptimalWithABlankPalette()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim bmp As Bitmap = Bitmap(4!, 4!)
        Dim g As Graphics = Graphics(bmp)
        g.Clear Color(255, 200, 100, 50)
        Set g = Nothing
        Dim blank As ColorPalette
        blank.count = 16
        Dim st As GpStatus = bmp.ConvertFormat(PixelFormat8bppIndexed, DitherTypeSolid, PaletteTypeOptimal, blank, 0!)
        Expect.AreEqual 0, CLng(st), "ConvertFormat to 8 bits with PaletteTypeOptimal and a blank ColorPalette of 16 entries returns (0 is Ok)"
        Expect.AreEqual &HFFC86432, bmp.Pixel(1, 1).argb, "the pixel of a bitmap of one colour after the conversion with PaletteTypeOptimal and a blank palette"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConvertFormat_FixedPaletteTypeWithAFilledPalette()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim bmp As Bitmap = Bitmap(4!, 4!)
        Dim g As Graphics = Graphics(bmp)
        g.Clear Color(255, 255, 255, 255)
        Set g = Nothing
        bmp.Pixel(0, 0) = Color(255, 0, 0, 0)
        Dim pal As ColorPalette
        pal.flags = PaletteFlagsGrayScale
        pal.count = 2
        pal.entries(0) = &HFF000000
        pal.entries(1) = &HFFFFFFFF
        Dim st As GpStatus = bmp.ConvertFormat(PixelFormat1bppIndexed, DitherTypeSolid, PaletteTypeFixedBW, pal, 0!)
        Expect.AreEqual 0, CLng(st), "ConvertFormat to 1 bit with PaletteTypeFixedBW and a palette of two colours returns (0 is Ok)"
        Expect.AreEqual &H30101, CLng(bmp.PixelFormat), "the pixel format after the conversion with a filled-in palette"
        Expect.AreEqual &HFF000000, bmp.Pixel(0, 0).argb, "the black pixel after the conversion with a filled-in palette"
        Expect.AreEqual &HFFFFFFFF, bmp.Pixel(2, 2).argb, "the white pixel after the conversion with a filled-in palette"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConvertFormat_CustomPaletteFilledByTheProgram()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim bmp As Bitmap = Bitmap(4!, 4!)
        Dim g As Graphics = Graphics(bmp)
        g.Clear Color(255, 255, 255, 255)
        bmp.Pixel(0, 0) = Color(255, 0, 0, 0)
        Set g = Nothing
        Dim pal As ColorPalette
        pal.flags = PaletteFlagsGrayScale
        pal.count = 2
        pal.entries(0) = &HFF000000
        pal.entries(1) = &HFFFFFFFF
        Dim st As GpStatus = bmp.ConvertFormat(PixelFormat1bppIndexed, DitherTypeSolid, PaletteTypeCustom, pal, 0!)
        Expect.AreEqual 0, CLng(st), "ConvertFormat to 1 bit with PaletteTypeCustom and a palette of two colours returns (0 is Ok)"
        Expect.AreEqual &H30101, CLng(bmp.PixelFormat), "the pixel format after the conversion"
        Expect.AreEqual &HFF000000, bmp.Pixel(0, 0).argb, "the black pixel after the conversion"
        Expect.AreEqual &HFFFFFFFF, bmp.Pixel(2, 2).argb, "a white pixel after the conversion"
        Expect.Done
    End Sub

    ' ---- Saving a PNG without Image.Save

    [TestCase]
    Public Sub Load_PngWrittenThroughTheNativeCall()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim path As String = Im_Dir() & "\native.png"
        Dim bmp As Bitmap = Bitmap(16!, 8!)
        Dim g As Graphics = Graphics(bmp)
        g.Clear Color(255, 200, 100, 50)
        Set g = Nothing
        Expect.AreEqual 0, Im_SavePng(bmp, path), "saving a PNG through GdipSaveImageToFile with no parameters returns (0 is Ok)"
        Dim loaded As Bitmap = Bitmap(path)
        Expect.AreEqual 0, CLng(loaded.LastResult), "LastResult of Bitmap(filename) of the PNG (0 is Ok)"
        Expect.AreEqual 16, CLng(loaded.Width), "Width of the PNG that was written"
        Expect.AreEqual 8, CLng(loaded.Height), "Height of the PNG that was written"
        Expect.AreEqual &HFFC86432, loaded.Pixel(3, 3).argb, "the pixel of the PNG that was written"
        Set loaded = Nothing
        Set bmp = Nothing
        Im_Clean
        Expect.Done
    End Sub

End Module
