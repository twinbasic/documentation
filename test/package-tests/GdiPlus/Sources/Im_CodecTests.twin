' GdiPlus, ImageCodec and GpImageCodecInfo: the lists of encoders and decoders and the text
' properties of a codec. The lists are read through the declared GDI+ functions, which work.
[TestFixture]
Module Im_CodecTests

    ' Finds the encoder whose FormatDescription is "PNG" in the buffer that GetImageEncoders filled.
    Private Function PngEncoder(info As GpImageCodecInfo, buffer() As Byte) As Boolean
        Dim count As UINT, size As UINT
        GetImageEncodersSize count, size
        ReDim buffer(0 To size - 1)
        GetImageEncoders count, size, buffer(0)
        Dim i As Long
        For i = 0 To count - 1
            Im_Copy VarPtr(info), VarPtr(buffer(0)) + i * LenB(Of GpImageCodecInfo), LenB(Of GpImageCodecInfo)
            If Replace(info.FormatDescription, vbNullChar, "") = "PNG" Then Return True
        Next
        Return False
    End Function

    [TestCase]
    Public Sub GetImageEncoders_ReturnsTheInstalledEncoders()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim encoders() As GpImageCodecInfo = GetImageEncoders()
        Dim n As Long = UBound(encoders) - LBound(encoders) + 1
        Expect.IsTrue n >= 5, "the number of elements of the array that GetImageEncoders( ) returns is at least 5 (BMP, JPEG, GIF, TIFF, PNG); it is " & n
        Dim found As Boolean
        Dim i As Long
        For i = LBound(encoders) To UBound(encoders)
            Dim one As GpImageCodecInfo = encoders(i)
            If one.Clsid.Data1 = ImageCodecPNG().Data1 Then found = True
        Next
        Expect.IsTrue found, "the encoders that GetImageEncoders( ) returns include the PNG encoder"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetImageDecoders_ReturnsTheInstalledDecoders()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim decoders() As GpImageCodecInfo = GetImageDecoders()
        Dim n As Long = UBound(decoders) - LBound(decoders) + 1
        Expect.IsTrue n >= 5, "the number of elements of the array that GetImageDecoders( ) returns is at least 5; it is " & n
        Dim found As Boolean
        Dim i As Long
        For i = LBound(decoders) To UBound(decoders)
            Dim one As GpImageCodecInfo = decoders(i)
            If one.FormatID.Data1 = ImageFormatPNG().Data1 Then found = True
        Next
        Expect.IsTrue found, "the decoders that GetImageDecoders( ) returns include the PNG decoder"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetImageEncodersSize_ListsTheEncodersInABuffer()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim count As UINT, size As UINT
        Expect.AreEqual 0, CLng(GetImageEncodersSize(count, size)), "GetImageEncodersSize returns (0 is Ok)"
        Expect.IsTrue count >= 5, "the number of encoders is at least 5; it is " & count
        Dim buffer() As Byte
        ReDim buffer(0 To size - 1)
        Expect.AreEqual 0, CLng(GetImageEncoders(count, size, buffer(0))), "GetImageEncoders(count, size, buffer) returns (0 is Ok)"
        Dim info As GpImageCodecInfo
        Dim found As Boolean
        Dim i As Long
        For i = 0 To count - 1
            Im_Copy VarPtr(info), VarPtr(buffer(0)) + i * LenB(Of GpImageCodecInfo), LenB(Of GpImageCodecInfo)
            If info.Clsid.Data1 = ImageCodecPNG().Data1 Then found = True
        Next
        Expect.IsTrue found, "the buffer lists the PNG encoder"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Text_PropertiesHaveNoTerminatingNull()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim info As GpImageCodecInfo
        Dim buffer() As Byte
        If Not PngEncoder(info, buffer) Then
            Expect.Fail "the buffer that GetImageEncoders filled has no encoder with the FormatDescription ""PNG"""
        Else
            Expect.IsTrue info.FormatDescription = "PNG", "FormatDescription of the PNG encoder equals ""PNG"" (its length is " & Len(info.FormatDescription) & ")"
            Expect.IsTrue info.MimeType = "image/png", "MimeType of the PNG encoder equals ""image/png"" (its length is " & Len(info.MimeType) & ")"
            Expect.IsTrue info.FilenameExtension = "*.PNG", "FilenameExtension of the PNG encoder equals ""*.PNG"" (its length is " & Len(info.FilenameExtension) & ")"
            Expect.IsTrue info.CodecName = "Built-in PNG Codec", "CodecName of the PNG encoder equals ""Built-in PNG Codec"" (its length is " & Len(info.CodecName) & ")"
        End If
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Text_PropertiesHoldTheTextBeforeTheNull()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim info As GpImageCodecInfo
        Dim buffer() As Byte
        If Not PngEncoder(info, buffer) Then
            Expect.Fail "the buffer that GetImageEncoders filled has no encoder with the FormatDescription ""PNG"""
        Else
            Expect.AreEqual "image/png", Replace(info.MimeType, vbNullChar, ""), "MimeType of the PNG encoder without its null characters"
            Expect.AreEqual "*.PNG", Replace(info.FilenameExtension, vbNullChar, ""), "FilenameExtension of the PNG encoder without its null characters"
            Expect.IsTrue info.IsEncoder, "IsEncoder of the PNG encoder"
        End If
        Expect.Done
    End Sub

End Module
