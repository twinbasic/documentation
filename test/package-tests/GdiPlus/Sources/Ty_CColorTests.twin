' Ty_CColorTests: the CColor enumeration (page Enumerations/CColor). The member values are those of the
' CSS named colours, with Transparent (&H00FFFFFF) added.
[TestFixture]
Module Ty_CColorTests

    Private Sub Member(ByVal Name As String, ByVal Actual As Long, ByVal Expected As Long)
        Expect.AreEqual Ty_Hex8(Expected), Ty_Hex8(Actual), "CColor." & Name
    End Sub

