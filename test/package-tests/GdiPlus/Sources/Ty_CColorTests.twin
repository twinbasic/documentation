    ' CSS: darkseagreen is #8FBC8F.
    [TestCase]
    Public Sub DarkSeaGreen_HasTheCssValue()
        Expect.Begin
        Member "DarkSeaGreen", CColor.DarkSeaGreen, &HFF8FBC8F
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Members_CanBeWrittenWithoutTheEnumerationName()
        Expect.Begin
        Expect.AreEqual "FFFFA500", Ty_Hex8(Color(Orange).Value), "Value of Color(Orange)"
        Expect.AreEqual "FFFFFFFF", Ty_Hex8(Color(White).Value), "Value of Color(White)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Color_KeepsAllFourBytesOfAMember()
        Expect.Begin
        Dim orange As Color = Color(CColor.Orange)
        Expect.AreEqual "FFFFA500", Ty_Hex8(orange.Value), "Value of Color(CColor.Orange)"
        Expect.AreEqual "255 255 165 0", orange.Alpha & " " & orange.Red & " " & orange.Green & " " & orange.Blue, "Alpha Red Green Blue of Color(CColor.Orange)"
        Expect.AreEqual "0000A5FF", Ty_Hex8(orange.BGR), "BGR of Color(CColor.Orange)"
        Dim transparent As Color = Color(CColor.Transparent)
        Expect.AreEqual "00FFFFFF", Ty_Hex8(transparent.Value), "Value of Color(CColor.Transparent)"
        Expect.Done
    End Sub

    ' ---- A member given to a method that has a Long overload

    [TestCase]
    Public Sub SolidBrush_TransparentMemberDrawsNothing()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim px As Color = Ty_FillOver(Color(0, 0, 0), SolidBrush(CColor.Transparent))
        Expect.AreEqual "FF000000", Ty_Hex8(px.Value), "pixel of a black bitmap after FillRectangle with SolidBrush(CColor.Transparent)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SolidBrush_ColorOfTransparentMemberDrawsNothing()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim px As Color = Ty_FillOver(Color(0, 0, 0), SolidBrush(Color(CColor.Transparent)))
        Expect.AreEqual "FF000000", Ty_Hex8(px.Value), "pixel of a black bitmap after FillRectangle with SolidBrush(Color(CColor.Transparent))"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SolidBrush_OpaqueMemberHasItsColour()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim red As Color = Ty_FillOver(Color(255, 255, 255), SolidBrush(CColor.Red))
        Expect.AreEqual "FFFF0000", Ty_Hex8(red.Value), "pixel after SolidBrush(CColor.Red)"
        Dim orange As Color = Ty_FillOver(Color(255, 255, 255), SolidBrush(CColor.Orange))
        Expect.AreEqual "FFFFA500", Ty_Hex8(orange.Value), "pixel after SolidBrush(CColor.Orange)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Pen_TransparentMemberDrawsNothing()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim px As Color = Ty_LineOver(Color(0, 0, 0), Pen(CColor.Transparent))
        Expect.AreEqual "FF000000", Ty_Hex8(px.Value), "pixel of a black bitmap on the line of Pen(CColor.Transparent)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Pen_ColorOfTransparentMemberDrawsNothing()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim px As Color = Ty_LineOver(Color(0, 0, 0), Pen(Color(CColor.Transparent)))
        Expect.AreEqual "FF000000", Ty_Hex8(px.Value), "pixel of a black bitmap on the line of Pen(Color(CColor.Transparent))"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Clear_TransparentMemberClearsToTransparent()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim px As Color = Ty_ClearedWithLong(CColor.Transparent)
        Expect.AreEqual 0, px.Alpha, "alpha of the pixel after Graphics.Clear CColor.Transparent"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Clear_ColorOfTransparentMemberClearsToTransparent()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Dim px As Color = Ty_ClearedWith(Color(CColor.Transparent))
        Expect.AreEqual 0, px.Alpha, "alpha of the pixel after Graphics.Clear Color(CColor.Transparent)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Clear_OpaqueMemberHasItsColour()
        Expect.Begin
        Dim user As GdiPlusUser = GdiPlusUser()
        Expect.AreEqual "FFFF0000", Ty_Hex8(Ty_ClearedWithLong(CColor.Red).Value), "pixel after Graphics.Clear CColor.Red"
        Expect.Done
    End Sub

    ' ---- A member is not a VB colour

    [TestCase]
    Public Sub Members_AreNotVisualBasicColours()
        Expect.Begin
        Expect.IsTrue CColor.Red <> vbRed, "CColor.Red differs from vbRed"
        Expect.AreEqual "FFFF0000", Ty_Hex8(CColor.Red), "CColor.Red (alpha, then red in the second byte)"
        Expect.AreEqual "000000FF", Ty_Hex8(vbRed), "vbRed (red in the lowest byte)"
        Expect.AreEqual Ty_Hex8(vbRed), Ty_Hex8(Color(CColor.Red).BGR), "BGR of Color(CColor.Red) against vbRed"
        Expect.Done
    End Sub

End Module
