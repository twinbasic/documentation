' GdiPlus, value types: what the compiler refuses. Each line ends in a comment ' CASE <Name>: <code>.
Module Ty_CompileTests

    Public Sub Ty_PointFScale()
        Dim p As GpPointF = GpPointF(3, 4)
        p.Scale(2) ' CASE PointFScaleWithParenthesesIsASyntaxError: error
        p.Scale 2 ' CASE PointFScaleWithoutParenthesesIsAccepted: none
        Call p.Scale(2) ' CASE PointFScaleWithCallIsAccepted: none
        p.Scale2 1, 2 ' CASE PointFScale2IsAccepted: none
    End Sub

    Public Sub Ty_SizeFScale()
        Dim s As GpSizeF = GpSizeF(3, 4)
        s.Scale(2) ' CASE SizeFScaleWithParenthesesIsASyntaxError: error
        s.Scale 2 ' CASE SizeFScaleWithoutParenthesesIsAccepted: none
        Call s.Scale(2) ' CASE SizeFScaleWithCallIsAccepted: none
        s.Scale2 1, 2 ' CASE SizeFScale2IsAccepted: none
    End Sub

End Module
