' TBMANLIB: what the compiler refuses. Each line ends in a comment ' CASE <Name>: <code>.
Module CompileTests

    ' A 64-bit build stops at the package's own source, so this is the one case run for win64.
    ' CASE Win64_SubClassIsRefused: win64 package TB5001 Libs/SubClass/cSubClass.twin:21

    Public Sub RequestHeaders_AssignmentThroughTheDefaultMember()
        Dim Http As New cHttpClient
        Http.RequestHeaders("X-Key") = "1" ' CASE RequestHeadersDefaultMemberAssignment: TB5090
    End Sub

    Public Sub RequestHeaders_AssignmentWithItemWrittenOut()
        Dim Http As New cHttpClient
        Http.RequestHeaders.Item("X-Key") = "1" ' CASE RequestHeadersItemAssignment: none
    End Sub

    Public Sub RequestHeaders_ReadThroughTheDefaultMember()
        Dim Http As New cHttpClient
        Dim s As String
        s = Http.RequestHeaders("X-Key") ' CASE RequestHeadersDefaultMemberRead: none
    End Sub

End Module
