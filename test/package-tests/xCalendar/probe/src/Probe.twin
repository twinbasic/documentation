    '=========================================================================================
    ' 16: the repaint loop
    '=========================================================================================

    ' A run of the message loop for ms milliseconds: how many messages, and how many of them are
    ' WM_PAINT. Reports how long it really took.
    Private Sub Storm(ByVal what As String, ByVal ms As Long)
        Dim m As Win.MSG
        Dim t As Long = GetTickCount
        Dim n As Long
        Dim nPaint As Long
        Dim nOther As Long
        Dim other As String
        Do While GetTickCount - t < ms
            If Win.PeekMessageW(m, 0, 0, 0, 1) = 0 Then
                Sleep 5
            Else
                n = n + 1
                If m.message = &HF Then
                    nPaint = nPaint + 1
                Else
                    nOther = nOther + 1
                    If nOther <= 6 Then other = other & " 0x" & Hex$(m.message)
                End If
                Win.TranslateMessage m
                Win.DispatchMessageW m
            End If
        Loop
        Say "  storm[" & what & "]: " & n & " messages in " & (GetTickCount - t) & " ms, " & nPaint & " WM_PAINT; first others:" & other
    End Sub

    Private Sub S16()
        On Error Resume Next
        Storm "as loaded", 1500
        ' With 1.0.7.0 this DoEvents does not return, and the 30 s watchdog ends the process.
        Dim t0 As Long = GetTickCount
        DoEvents
        Say "  DoEvents with the selectors shown returned after " & (GetTickCount - t0) & " ms"
        Cal.ShowDateSelectors = False
        Storm "ShowDateSelectors = False", 1000
        Cal.ShowTitle = False
        Storm "ShowTitle = False as well", 1000
        Cal.ShowTitle = True
        Cal.ShowDateSelectors = True
        Cal.Refresh
        Storm "both back, after Refresh", 1000
        Form1.Hide
        Storm "form hidden", 1000
        Form1.Show
        Storm "form shown again", 1000
        Chk "S16"
    End Sub

    '=========================================================================================
    ' 17: what package 1.0.17.0 changed: the lists and the title area
    '=========================================================================================

    ' Where both lists are, in the control's client area.
    Private Sub Lists(ByVal what As String)
        Dim rc As RECT
        Dim rm As RECT
        Dim ry As RECT
        Win.GetWindowRect CalH, rc
        Win.GetWindowRect MonthH, rm
        Win.GetWindowRect YearH, ry
        Say "  lists[" & what & "]: control " & CalW & "x" & CalHt & "; month list x=" & (rm.Left - rc.Left) & ".." & (rm.Right - rc.Left) & " y=" & (rm.Top - rc.Top) & ".." & (rm.Bottom - rc.Top) & "; year list x=" & (ry.Left - rc.Left) & ".." & (ry.Right - rc.Left) & " y=" & (ry.Top - rc.Top) & ".." & (ry.Bottom - rc.Top) & "; space right of the year list " & (CalW - (ry.Right - rc.Left)) & "; visible " & Win.IsWindowVisible(MonthH) & "/" & Win.IsWindowVisible(YearH)
    End Sub

    ' The header (title area + day names) and the first pixel row of the day names' band.
    Private Sub Header(ByVal what As String)
        Pump
        Calibrate
        Say "  header[" & what & "]: " & gHeader & " px; the day names' band starts at y=" & FirstY(3, Cal.DayBackColor, 0, CalHt - 1)
    End Sub

    ' The control's window put to a new size, its top left corner kept.
    Private Sub ResizeControl(ByVal w As Long, ByVal h As Long)
        Dim rc As RECT
        Dim p As Win.POINT
        Win.GetWindowRect CalH, rc
        p.x = rc.Left
        p.y = rc.Top
        Win.ScreenToClient Form1.hWnd, p
        Win.MoveWindow CalH, p.x, p.y, w, h, 1
        Pump
        Win.GetClientRect CalH, rc
        CalW = rc.Right
        CalHt = rc.Bottom
    End Sub

    Private Sub S17()
        On Error Resume Next
        Dim f As New StdFont
        Say "dpi of the control window: " & Win.GetDpiForWindow(CalH)
        Header "as loaded"
        Lists "as loaded"
        TitleSpan "ShowDateSelectors = True", ListsLeft() - 2
        Cal.Value = DateSerial(2026, 10, 13)
        Cal.Month = 10
        TitleSpan "October 2026", ListsLeft() - 2
        Cal.MonthLength = 0
        TitleSpan "Oct 2026 (MonthLength = ShortLength)", ListsLeft() - 2
        Cal.MonthLength = 1
        Cal.Value = DateSerial(2026, 6, 15)
        Cal.Month = 6
        Say "-- the control's window resized with MoveWindow, its top left corner kept"
        ResizeControl 300, 288
        Lists "300 x 288"
        TitleSpan "ShowDateSelectors = True", ListsLeft() - 2
        ResizeControl 384, 250
        Lists "384 x 250"
        ResizeControl 384, 288
        Lists "384 x 288 again"
        Say "-- TitleMargin"
        Cal.TitleMargin = 15
        Header "TitleMargin = 15"
        Lists "TitleMargin = 15"
        Cal.TitleMargin = 5
        Header "TitleMargin = 5"
        Say "-- TitleFont: Set to a 24 pt font, changed in place to 10 pt, then Set again"
        f.Name = "Arial"
        f.Size = 24
        Set Cal.TitleFont = f
        Chk "Set TitleFont"
        Header "24 pt set"
        Lists "24 pt set"
        TitleSpan "24 pt set", ListsLeft() - 2
        f.Size = 10
        Header "f.Size = 10 in place"
        Lists "f.Size = 10 in place"
        TitleSpan "f.Size = 10 in place, no Refresh", ListsLeft() - 2
        Set Cal.TitleFont = f
        Header "Set TitleFont = f again"
        Lists "Set TitleFont = f again"
        TitleSpan "Set TitleFont = f again", ListsLeft() - 2
        f.Size = 16
        Set Cal.TitleFont = f
        Header "16 pt set, as at the start"
        Say "-- GridFont changed in place, no Refresh: is the grid drawn again?"
        Dim g As New StdFont
        Dim x0 As Long
        Dim y0 As Long
        Dim x1 As Long
        Dim y1 As Long
        g.Name = "Arial"
        g.Size = 8
        Set Cal.GridFont = g
        Pump
        Calibrate
        BBox 2, gHeader + 2, CLng(gColW) - 2, CLng(gHeader + gRowH) - 2, Cal.BackColor, x0, y0, x1, y1
        Say "  g.Size = 8 set: digits of the first cell span " & (x1 - x0 + 1) & " x " & (y1 - y0 + 1) & " pixels"
        g.Size = 20
        Pump
        Calibrate
        BBox 2, gHeader + 2, CLng(gColW) - 2, CLng(gHeader + gRowH) - 2, Cal.BackColor, x0, y0, x1, y1
        Say "  g.Size = 20 in place, a pump, no Refresh: digits of the first cell span " & (x1 - x0 + 1) & " x " & (y1 - y0 + 1) & " pixels"
        g.Size = 8
        Set Cal.GridFont = g
        Pump
        Say "-- ShowTitle and ShowDateSelectors"
        Cal.ShowTitle = False
        Header "ShowTitle = False, lists shown"
        Cal.ShowDateSelectors = False
        Header "ShowTitle = False, ShowDateSelectors = False"
        Cal.ShowTitle = True
        Header "ShowTitle = True again, lists hidden"
        Cal.ShowDateSelectors = True
        Header "ShowDateSelectors = True"
        Lists "ShowDateSelectors = True"
        Say "-- again, ended by TitleMargin in place of ShowDateSelectors"
        Cal.ShowTitle = False
        Cal.ShowDateSelectors = False
        Header "both False"
        Cal.ShowTitle = True
        Header "ShowTitle = True again, lists hidden"
        Cal.TitleMargin = 5
        Header "TitleMargin = 5 (the value it has)"
        Cal.ShowDateSelectors = True
        Header "ShowDateSelectors = True"
        Say "-- and a third time, ended by a change of the control's size"
        Cal.ShowTitle = False
        Cal.ShowDateSelectors = False
        Header "both False"
        Cal.ShowTitle = True
        Header "ShowTitle = True again, lists hidden"
        ResizeControl 380, 288
        Header "the control 380 wide"
        ResizeControl 384, 288
        Cal.ShowDateSelectors = True
        Header "ShowDateSelectors = True"
        Chk "S17"
    End Sub

    '=========================================================================================
    ' Pixels: read from the control's window DC with GetPixel (a COLORREF, 0x00BBGGRR, the same
    ' number as an OLE_COLOR property), after the control has painted.
    '=========================================================================================

    Private Sub PxOpen()
        gDC = Win.GetDC(CalH)
    End Sub

    Private Sub PxClose()
        Win.ReleaseDC CalH, gDC
        gDC = 0
    End Sub

    Private Function Hx(ByVal c As Long) As String
        Hx = "&H" & Hex$(c)
    End Function

    ' The runs of one colour down column x from y0 to y1, as "y0-y1:colour".
    Private Function ColRuns(ByVal x As Long, ByVal y0 As Long, ByVal y1 As Long) As String
        Dim y As Long
        Dim c As Long
        Dim prev As Long = -2
        Dim start As Long
        Dim s As String
        PxOpen
        For y = y0 To y1
            c = Win.GetPixel(gDC, x, y)
            If c <> prev Then
                If y > y0 Then s = s & start & "-" & (y - 1) & ":" & Hx(prev) & "  "
                start = y
                prev = c
            End If
        Next
        s = s & start & "-" & y1 & ":" & Hx(prev)
        PxClose
        ColRuns = s
    End Function

    ' The same along row y from x0 to x1.
    Private Function RowRuns(ByVal y As Long, ByVal x0 As Long, ByVal x1 As Long) As String
        Dim x As Long
        Dim c As Long
        Dim prev As Long = -2
        Dim start As Long
        Dim s As String
        PxOpen
        For x = x0 To x1
            c = Win.GetPixel(gDC, x, y)
            If c <> prev Then
                If x > x0 Then s = s & start & "-" & (x - 1) & ":" & Hx(prev) & "  "
                start = x
                prev = c
            End If
        Next
        s = s & start & "-" & x1 & ":" & Hx(prev)
        PxClose
        RowRuns = s
    End Function

    Private Function PxAt(ByVal x As Long, ByVal y As Long) As Long
        PxOpen
        PxAt = Win.GetPixel(gDC, x, y)
        PxClose
    End Function

    ' The first (or last) y from y0 to y1 at which column x has colour c; -1 when none.
    Private Function FirstY(ByVal x As Long, ByVal c As Long, ByVal y0 As Long, ByVal y1 As Long) As Long
        Dim y As Long
        FirstY = -1
        PxOpen
        For y = y0 To y1
            If Win.GetPixel(gDC, x, y) = c Then
                FirstY = y
                Exit For
            End If
        Next
        PxClose
    End Function

    Private Function LastY(ByVal x As Long, ByVal c As Long, ByVal y0 As Long, ByVal y1 As Long) As Long
        Dim y As Long
        LastY = -1
        PxOpen
        For y = y0 To y1
            If Win.GetPixel(gDC, x, y) = c Then LastY = y
        Next
        PxClose
    End Function

    Private Function CountPx(ByVal c As Long, ByVal x0 As Long, ByVal y0 As Long, ByVal x1 As Long, ByVal y1 As Long) As Long
        Dim x As Long
        Dim y As Long
        Dim n As Long
        PxOpen
        For y = y0 To y1
            For x = x0 To x1
                If Win.GetPixel(gDC, x, y) = c Then n = n + 1
            Next
        Next
        PxClose
        CountPx = n
    End Function

    ' The bounding box of the pixels that are not colour bg in the rectangle.
    Private Sub BBox(ByVal x0 As Long, ByVal y0 As Long, ByVal x1 As Long, ByVal y1 As Long, ByVal bg As Long, ByRef minX As Long, ByRef minY As Long, ByRef maxX As Long, ByRef maxY As Long)
        Dim x As Long
        Dim y As Long
        minX = 99999: minY = 99999: maxX = -1: maxY = -1
        PxOpen
        For y = y0 To y1
            For x = x0 To x1
                If Win.GetPixel(gDC, x, y) <> bg Then
                    If x < minX Then minX = x
                    If x > maxX Then maxX = x
                    If y < minY Then minY = y
                    If y > maxY Then maxY = y
                End If
            Next
        Next
        PxClose
    End Sub

    ' A number that changes when any sampled pixel of the control changes.
    Private Function Fingerprint() As Double
        Dim x As Long
        Dim y As Long
        Dim h As Double
        PxOpen
        For y = 0 To CalHt - 1 Step 5
            For x = 0 To CalW - 1 Step 5
                h = h + CDbl(Win.GetPixel(gDC, x, y)) * (1 + ((x * 7 + y * 13) Mod 17))
            Next
        Next
        PxClose
        Fingerprint = h
    End Function

    ' Re-bases the grid on a date: Value, then Month, whose setter recomputes the first date of
    ' the grid (Value's setter does not).
    Private Sub Rebase(ByVal d As Date)
        On Error Resume Next
        Cal.Value = d
        Cal.Month = VBA.Month(d)
        Pump
        gEvCount = 0
        gBefore = 0
    End Sub

    ' Where the keyboard focus is, by name.
    Private Function FocusName() As String
        Dim h As LongPtr = Win.GetFocus
        Dim s As String
        If h = 0 Then
            s = "nothing"
        ElseIf h = FocusH Then
            s = "the control's picture box (picFocus)"
        ElseIf h = CalH Then
            s = "the control window itself"
        ElseIf h = Cmd1H Then
            s = "Command1"
        ElseIf h = Cmd2H Then
            s = "Command2"
        ElseIf h = YearH Then
            s = "the year combo"
        ElseIf h = MonthH Then
            s = "the month combo"
        ElseIf h = Form1.hWnd Then
            s = "the form"
        Else
            s = "another window"
        End If
        FocusName = s & " [" & Win.ClassOf(h) & "]"
    End Function

    '=========================================================================================
    ' p2: the title with the selectors hidden (Q2)
    '=========================================================================================

    ' The left edge of the month list, in the control's client area: the title is drawn to its left.
    ' (A pixel under a list or a picture box reads as -1 from the control's DC, so a box that
    ' reaches the lists finds "text" there.)
    Private Function ListsLeft() As Long
        Dim rc As RECT
        Dim rm As RECT
        Win.GetWindowRect CalH, rc
        Win.GetWindowRect MonthH, rm
        ListsLeft = rm.Left - rc.Left
    End Function

    Private Sub TitleSpan(ByVal what As String, ByVal xmax As Long)
        Pump
        Calibrate
        Dim top As Long = FirstY(3, Cal.DayBackColor, 0, CalHt - 1)
        Dim x0 As Long
        Dim y0 As Long
        Dim x1 As Long
        Dim y1 As Long
        BBox 1, 2, xmax, top - 3, Cal.BackColor, x0, y0, x1, y1
        Say "  title[" & what & "]: day-names band starts at y=" & top & "; title text pixels in x=1.." & xmax & " span x=" & x0 & ".." & x1 & " (centre " & ((x0 + x1) / 2) & "), y=" & y0 & ".." & y1 & "; control width " & CalW & ": W/2 = " & (CalW / 2) & "; the month list starts at x=" & ListsLeft() & ", half of it " & (ListsLeft() / 2)
    End Sub

    Private Sub P2()
        On Error Resume Next
        TitleSpan "ShowDateSelectors = True", ListsLeft() - 2
        Cal.ShowDateSelectors = False
        TitleSpan "ShowDateSelectors = False", CalW - 1
        Shot "title_noselectors"
        Cal.ShowDateSelectors = True
        Chk "P2"
    End Sub

    '=========================================================================================
    ' p14: do the three text colours reach the text? Pixels of exactly those colours (not a hit
    ' of the page's questions: found in the pictures)
    '=========================================================================================

    ' The most frequent colours in a rectangle, "colour x count" each, the background first left out.
    Private Function TopColours(ByVal x0 As Long, ByVal y0 As Long, ByVal x1 As Long, ByVal y1 As Long, ByVal skip As Long) As String
        Dim cols(0 To 63) As Long
        Dim cnt(0 To 63) As Long
        Dim n As Long
        Dim x As Long
        Dim y As Long
        Dim c As Long
        Dim i As Long
        Dim j As Long
        Dim s As String
        PxOpen
        For y = y0 To y1
            For x = x0 To x1
                c = Win.GetPixel(gDC, x, y)
                If c <> skip Then
                    For i = 0 To n - 1
                        If cols(i) = c Then cnt(i) = cnt(i) + 1: Exit For
                    Next
                    If i = n And n <= 63 Then cols(n) = c: cnt(n) = 1: n = n + 1
                End If
            Next
        Next
        PxClose
        ' the five largest
        For j = 1 To 5
            Dim best As Long = -1
            Dim bi As Long = -1
            For i = 0 To n - 1
                If cnt(i) > best Then best = cnt(i): bi = i
            Next
            If bi >= 0 Then
                s = s & Hx(cols(bi)) & " x" & cnt(bi) & "  "
                cnt(bi) = -2
            End If
        Next
        TopColours = s
    End Function

    Private Sub TextColours(ByVal what As String)
        Pump
        Calibrate
        Say "  " & what & ": TitleFontColor=" & Hx(Cal.TitleFontColor) & ", the colours in the title text's box: " & TopColours(8, 8, ListsLeft() - 4, 36, Cal.BackColor)
        Say "  " & what & ": DayFontColor=" & Hx(Cal.DayFontColor) & ", the colours in the first day name's box: " & TopColours(4, 52, 50, gHeader - 4, Cal.DayBackColor)
        Say "  " & what & ": GridFontColor=" & Hx(Cal.GridFontColor) & ", the colours in the first cell's box: " & TopColours(4, gHeader + 3, 50, gHeader + 22, Cal.BackColor)
    End Sub

    Private Sub P14()
        On Error Resume Next
        TextColours "defaults"
        Cal.TitleFontColor = RGB(255, 0, 255)
        Cal.GridFontColor = RGB(0, 0, 255)
        Cal.DayFontColor = RGB(255, 255, 255)
        TextColours "magenta title, blue grid, white day names"
        Chk "P14"
    End Sub

    '=========================================================================================
    ' p3: a Value with a time of day (Q3)
    '=========================================================================================

    Private Sub P3()
        On Error Resume Next
        Dim hl As Long = &H82868E
        Calibrate
        Rebase DateSerial(2026, 3, 15)
        Say "  grid for March 2026, Value = 2026-03-15: pixels of the selected-cell colour " & Hx(hl) & " in the grid: " & CountPx(hl, 0, gHeader + 1, CalW - 1, CalHt - 1)
        St "date only"
        Cal.Value = DateSerial(2026, 3, 15) + TimeSerial(14, 30, 0)
        Pump
        Say "  Value = 2026-03-15 14:30:00: pixels of the selected-cell colour in the grid: " & CountPx(hl, 0, gHeader + 1, CalW - 1, CalHt - 1)
        St "with a time"
        Shot "timesel"
        Chk "P3"
    End Sub

    '=========================================================================================
    ' p5: Enabled = False, the colours and the keyboard focus (Q4, Q5)
    '=========================================================================================

    Private Sub BandColour(ByVal what As String)
        Pump
        Calibrate
        Say "  " & what & ": day-names band colour " & Hx(PxAt(3, gHeader - 6)) & " (enabled &HDCA86F, disabled &HEEEEEE); Enabled=" & Cal.Enabled & " window enabled=" & Win.IsWindowEnabled(CalH) & "; focus is " & FocusName()
    End Sub

    Private Sub P5()
        On Error Resume Next
        BandColour "enabled, nothing focused"
        Win.SetFocus Cmd1H
        Pump
        Win.SetFocus FocusH
        Pump
        BandColour "enabled, the control's picture box has the focus"
        Act "Enabled = False"
        Cal.Enabled = False
        Done
        BandColour "after Enabled = False"
        Say "  windows enabled now: control=" & Win.IsWindowEnabled(CalH) & " picture box=" & Win.IsWindowEnabled(FocusH) & " year combo=" & Win.IsWindowEnabled(YearH) & " month combo=" & Win.IsWindowEnabled(MonthH)
        Shot "disabled_nofocus_move"
        Act "the focus moves to Command2"
        Win.SetFocus Cmd2H
        Done
        BandColour "after the focus moved to Command2"
        Shot "disabled_after_blur"
        Act "the focus moves back to the picture box, then to Command1"
        Win.SetFocus FocusH
        Pump
        BandColour "after SetFocus on the picture box"
        Win.SetFocus Cmd1H
        Done
        BandColour "after the focus moved to Command1"
        Cal.Enabled = True
        Pump
        Say "-- the focus placed by a left click on a day cell (what puts it in the picture box), then Enabled = False"
        Win.SetFocus Cmd1H
        Pump
        Calibrate
        ClickCell 2, 2
        Pump
        BandColour "enabled, after a click"
        Act "Enabled = False"
        Cal.Enabled = False
        Done
        BandColour "after Enabled = False"
        Say "  windows enabled now: control=" & Win.IsWindowEnabled(CalH) & " picture box=" & Win.IsWindowEnabled(FocusH) & " year combo=" & Win.IsWindowEnabled(YearH) & " month combo=" & Win.IsWindowEnabled(MonthH)
        Act "the focus moves to Command2"
        Win.SetFocus Cmd2H
        Done
        BandColour "after the focus moved to Command2"
        Shot "disabled_blur2"
        Cal.Enabled = True
        Pump
        BandColour "Enabled = True again"
        Chk "P5"
    End Sub

    '=========================================================================================
    ' p7: hit-testing in a control 255 pixels wide (Q7)
    '=========================================================================================

    Private Sub P7()
        On Error Resume Next
        Dim r As RECT
        Dim pt As Win.POINT
        Win.GetWindowRect CalH, r
        pt.x = r.Left
        pt.y = r.Top
        Win.ScreenToClient Form1.hWnd, pt
        Win.MoveWindow CalH, pt.x, pt.y, 255, 292, 1
        Pump
        Win.GetClientRect CalH, r
        CalW = r.Right
        CalHt = r.Bottom
        Calibrate
        Say "control resized: client " & CalW & "x" & CalHt & ", header " & gHeader & ", cell width " & Format$(CalW / 7, "0.0000") & " (VBA rounds it to " & CLng(CalW / 7) & " for \), cell height " & Format$((CalHt - gHeader) / 6, "0.0000") & " (rounds to " & CLng((CalHt - gHeader) / 6) & ")"
        Dim base As Date = DateSerial(2026, 6, 1)
        Say "the grid is June 2026 with Monday first: the cell at row r, column c is 2026-06-01 + 7r + c days"
        Dim xs As Variant
        Dim ys As Variant
        Dim x As Variant
        Dim y As Variant
        For Each x In Array(3, 218, 219, 251, 252, 254)
            Rebase DateSerial(2026, 6, 15)
            Act "left press at x=" & x & ", y=" & (gHeader + 5) & " (first row, the middle of the top of the cell)"
            ClickAt CLng(x), gHeader + 5
            Pump
            Say "      Value is 2026-06-01 + " & CLng(Cal.Value - base) & " days = " & Dt(Cal.Value) & "  (a column of the grid is 0 to 6)"
        Next
        For Each y In Array(CalHt - 1, CalHt - 2, CalHt - 3, CalHt - 5)
            Rebase DateSerial(2026, 6, 15)
            Act "left press at x=3, y=" & y & " (column 0)"
            ClickAt 3, CLng(y)
            Pump
            Say "      Value is 2026-06-01 + " & CLng(Cal.Value - base) & " days = " & Dt(Cal.Value) & "  (a row of the grid is 0 to 5, so 0, 7, ... 35 are the valid first-column offsets)"
        Next
        Win.MoveWindow CalH, pt.x, pt.y, 384, 288, 1
        Pump
        Win.GetClientRect CalH, r
        CalW = r.Right
        CalHt = r.Bottom
        Calibrate
        Chk "P7"
    End Sub

    '=========================================================================================
    ' p10: Tab into the control; arrow keys after a click; the order of the key events (Q10, Q11)
    '=========================================================================================

    Private Sub P10()
        On Error Resume Next
        Dim i As Long
        Cal.ShowDateSelectors = False
        Pump
        Win.SetFocus Cmd1H
        Pump
        Say "focus: " & FocusName()
        Say "-- Tab, posted to the queue and dispatched through the form's dialog manager (IsDialogMessage)"
        For i = 1 To 3
            Win.PostKey Win.GetFocus, Win.VK_TAB
            Pump 0, True
            Say "  after Tab #" & i & ": focus is " & FocusName()
        Next
        Say "-- Shift+Tab"
        Win.SetMods 1
        Win.PostKey Win.GetFocus, Win.VK_TAB
        Pump 0, True
        Win.SetMods 0
        Say "  after Shift+Tab: focus is " & FocusName()
        Say "-- Tab through DoEvents (the runtime's own loop)"
        Win.SetFocus Cmd1H
        Pump
        Win.PostKey Win.GetFocus, Win.VK_TAB
        DoEvents
        Say "  after Tab: focus is " & FocusName()
        Cal.ShowDateSelectors = True
        Pump
        Say "-- arrow keys after a left click on a day cell (the click is sent as messages)"
        Win.SetFocus Cmd1H
        Pump
        Calibrate
        Rebase DateSerial(2026, 6, 15)
        ClickCell 2, 2
        Pump
        Say "  focus after the click: " & FocusName()
        St "after the click"
        Act "Right arrow sent to the window that has the focus"
        KeyTo Win.GetFocus, Win.VK_RIGHT
        Done
        St "after"
        Say "-- the order of the key events, with the focus in the picture box"
        Win.SetFocus FocusH
        Pump
        Rebase DateSerial(2026, 6, 15)
        gLogMouseMove = False
        Act "the A key posted to the queue: WM_KEYDOWN and WM_KEYUP, and TranslateMessage adds WM_CHAR"
        Win.PostKey FocusH, 65
        Pump
        St "after"
        Act "the Right arrow key posted to the queue"
        Win.PostKey FocusH, Win.VK_RIGHT
        Pump
        St "after"
        Act "WM_KEYDOWN, WM_CHAR 'a', WM_KEYUP sent in turn to the picture box"
        Win.SendMessageW FocusH, Win.WM_KEYDOWN, 65, Win.KeyLParam(65, False, False)
        Win.SendMessageW FocusH, Win.WM_CHAR, 97, 1
        Win.SendMessageW FocusH, Win.WM_KEYUP, 65, Win.KeyLParam(65, True, False)
        Done
        Act "WM_KEYDOWN, WM_CHAR 'a', WM_KEYUP sent in turn to the control window"
        Win.SendMessageW CalH, Win.WM_KEYDOWN, 65, Win.KeyLParam(65, False, False)
        Win.SendMessageW CalH, Win.WM_CHAR, 97, 1
        Win.SendMessageW CalH, Win.WM_KEYUP, 65, Win.KeyLParam(65, True, False)
        Done
        Chk "P10"
    End Sub

    '=========================================================================================
    ' p9: the keys, as the system sends them: posted to the queue and dispatched by the runtime's
    ' own loop (DoEvents), the key-down first, the key-up after it (Q8, Q9, Q11)
    '=========================================================================================

    ' A key press: WM_KEYDOWN (WM_SYSKEYDOWN with Alt) posted to the window h and dispatched by
    ' DoEvents, which also delivers the WM_CHAR that TranslateMessage makes from it, then the
    ' key-up the same way. mods: bit 0 Shift, bit 1 Ctrl, bit 2 Alt, held by SetKeyboardState.
    Private Sub KeyReal(ByVal h As LongPtr, ByVal vk As Long, Optional ByVal mods As Long = 0)
        Dim alt As Boolean = (mods And 4) <> 0
        If mods <> 0 Then Win.SetMods mods
        Win.PostMessageW h, IIf(alt, Win.WM_SYSKEYDOWN, Win.WM_KEYDOWN), vk, Win.KeyLParam(vk, False, alt)
        DoEvents
        Win.PostMessageW h, IIf(alt, Win.WM_SYSKEYUP, Win.WM_KEYUP), vk, Win.KeyLParam(vk, True, alt)
        DoEvents
        If mods <> 0 Then Win.SetMods 0
    End Sub

    Private Sub RealCase(ByVal h As LongPtr, ByVal vk As Long, ByVal mods As Long)
        On Error Resume Next
        Cal.Value = DateSerial(2026, 6, 15)
        Pump
        Act "key " & VkName(vk) & IIf((mods And 1) <> 0, " + Shift", "") & IIf((mods And 2) <> 0, " + Ctrl", "") & IIf((mods And 4) <> 0, " + Alt", "")
        KeyReal h, vk, mods
        Pump
        If gEvCount = 0 Then Say "      (no event)"
        St "after"
    End Sub

    Private Sub P9()
        On Error Resume Next
        Dim vk As Variant
        Dim h As LongPtr
        Cal.ShowDateSelectors = False
        Pump
        Calibrate
        ClickCell 2, 2
        Pump
        h = Win.GetFocus
        Say "after a click on a cell the focus is " & FocusName() & "; the keys are posted to it"
        Say "-- plain keys"
        For Each vk In Array(Win.VK_LEFT, Win.VK_RIGHT, Win.VK_UP, Win.VK_DOWN, Win.VK_PRIOR, Win.VK_NEXT, Win.VK_HOME, Win.VK_END, 65, 13, 32, 9)
            RealCase h, CLng(vk), 0
        Next
        Say "-- with Shift"
        For Each vk In Array(Win.VK_LEFT, Win.VK_PRIOR, Win.VK_NEXT, Win.VK_HOME)
            RealCase h, CLng(vk), 1
        Next
        Say "-- with Ctrl"
        For Each vk In Array(Win.VK_LEFT, Win.VK_PRIOR, Win.VK_NEXT, Win.VK_HOME)
            RealCase h, CLng(vk), 2
        Next
        Say "-- with Alt (WM_SYSKEYDOWN / WM_SYSKEYUP)"
        For Each vk In Array(Win.VK_LEFT, Win.VK_PRIOR, Win.VK_NEXT, Win.VK_HOME)
            RealCase h, CLng(vk), 4
        Next
        Say "-- with Shift and Ctrl"
        RealCase h, Win.VK_PRIOR, 3
        RealCase h, Win.VK_NEXT, 3
        Cal.ShowDateSelectors = True
        Pump
        Chk "P9"
    End Sub

    '=========================================================================================
    ' p11: which key events a real key press raises: keys posted to the queue (Q8, Q11)
    '=========================================================================================

    Private Sub P11()
        On Error Resume Next
        Dim h As LongPtr
        Calibrate
        Win.SetFocus Cmd1H
        Pump
        Rebase DateSerial(2026, 6, 15)
        ClickCell 2, 2
        Pump
        Say "after a click on a cell, focus is " & FocusName()
        h = Win.GetFocus
        Rebase DateSerial(2026, 6, 15)
        Act "only WM_KEYDOWN (Right) posted to the focus window and dispatched by the probe's loop"
        Win.PostMessageW h, Win.WM_KEYDOWN, Win.VK_RIGHT, Win.KeyLParam(Win.VK_RIGHT, False, False)
        Pump
        St "after"
        Act "only WM_KEYUP (Right) posted"
        Win.PostMessageW h, Win.WM_KEYUP, Win.VK_RIGHT, Win.KeyLParam(Win.VK_RIGHT, True, False)
        Pump
        St "after"
        Act "WM_KEYDOWN and WM_KEYUP (Right) posted, probe's loop"
        Win.PostKey h, Win.VK_RIGHT
        Pump
        St "after"
        Act "WM_KEYDOWN and WM_KEYUP ('A', 65) posted, probe's loop"
        Win.PostKey h, 65
        Pump
        Say "-- the same through DoEvents, the runtime's own loop (selectors hidden so that it returns)"
        Cal.ShowDateSelectors = False
        Pump
        Rebase DateSerial(2026, 6, 15)
        ClickCell 2, 2
        Pump
        h = Win.GetFocus
        Say "  focus is " & FocusName()
        Rebase DateSerial(2026, 6, 15)
        Act "WM_KEYDOWN and WM_KEYUP (Right) posted, DoEvents"
        Win.PostKey h, Win.VK_RIGHT
        DoEvents
        St "after"
        Act "WM_KEYDOWN and WM_KEYUP ('A') posted, DoEvents"
        Win.PostKey h, 65
        DoEvents
        Act "WM_KEYDOWN (Shift+Page Down) posted, DoEvents (Shift set with SetKeyboardState)"
        Win.SetMods 1
        Win.PostKey h, Win.VK_NEXT
        DoEvents
        Win.SetMods 0
        St "after"
        Cal.ShowDateSelectors = True
        Chk "P11"
    End Sub

    '=========================================================================================
    ' p12: where the keyboard focus is after a click, and whether the arrow keys then work (Q10)
    '=========================================================================================

    ' A click on a cell (focus first on `from`), then where the focus is, and what Right does.
    Private Sub FocusAfterClick(ByVal what As String, ByVal from As LongPtr, Optional ByVal outsideGrid As Boolean = False)
        On Error Resume Next
        Dim v0 As Date
        Win.SetFocus from
        Pump
        Rebase DateSerial(2026, 6, 15)
        Say "  " & what & ": focus before the click: " & FocusName()
        gQuiet = True
        If outsideGrid Then ClickAt 20, 4 Else ClickCell 2, 2
        Pump
        gQuiet = False
        v0 = Cal.Value
        Say "  " & what & ": focus after the click: " & FocusName() & "; Value " & Dt(v0)
        gEvCount = 0
        KeyReal Win.GetFocus, Win.VK_RIGHT, 0
        Pump
        Say "  " & what & ": after Right arrow (posted to the focus window, DoEvents): Value " & Dt(Cal.Value) & IIf(Cal.Value <> v0, "  -> the arrow key moved the selection", "  -> the arrow key did nothing") & "; events " & gEvCount
    End Sub

    Private Sub P12()
        On Error Resume Next
        Cal.ShowDateSelectors = False
        Pump
        Calibrate
        FocusAfterClick "1 from Command1", Cmd1H
        FocusAfterClick "2 from Command1 again", Cmd1H
        FocusAfterClick "3 from Command2", Cmd2H
        FocusAfterClick "4 from the form", Form1.hWnd
        FocusAfterClick "5 from the control window", CalH
        FocusAfterClick "6 from the picture box", FocusH
        Cal.Enabled = False
        Cal.Enabled = True
        Pump
        FocusAfterClick "7 after Enabled False then True, from Command1", Cmd1H
        gCancel = True
        FocusAfterClick "8 with BeforeUpdate cancelling the click, from Command1", Cmd1H
        gCancel = False
        FocusAfterClick "9 a click in the title band, from Command1", Cmd1H, True
        Say "-- clicks in a row: the first, then the second and third with the focus where the first left it"
        Win.SetFocus Cmd1H
        Pump
        Rebase DateSerial(2026, 6, 15)
        ClickCell 2, 2
        Pump
        Say "  after the 1st click: focus is " & FocusName()
        ClickCell 3, 3
        Pump
        Say "  after the 2nd click: focus is " & FocusName()
        ClickCell 1, 1
        Pump
        Say "  after the 3rd click: focus is " & FocusName()
        Cal.ShowDateSelectors = True
        Pump
        Chk "P12"
    End Sub

    '=========================================================================================
    ' p18: a font object changed in place (Q18)
    '=========================================================================================

    Private Sub P18()
        On Error Resume Next
        Dim f As Font
        Dim g As New StdFont
        Dim a As Long
        Dim b As Long
        Dim c As Long
        Dim d As Long
        Dim x0 As Long
        Dim y0 As Long
        Dim x1 As Long
        Dim y1 As Long
        Dim h0 As Long
        Say "-- selectors visible"
        Pump
        Calibrate
        h0 = gHeader
        Set f = Cal.TitleFont
        f.Size = 24
        Pump
        Calibrate
        Say "  header (title + day names) before: " & h0 & "; after f.Size = 24 on f = Cal.TitleFont (no Set) and a pump: " & gHeader
        f.Size = 16
        Pump
        Say "-- selectors hidden"
        Cal.ShowDateSelectors = False
        Pump
        Calibrate
        h0 = gHeader
        f.Size = 24
        Calibrate
        Say "  header before: " & h0 & "; right after f.Size = 24 (no message processed yet): " & gHeader
        Pump
        Calibrate
        Say "  after a pump of the message loop: " & gHeader & " (" & gPumped & " messages)"
        Cal.Refresh
        Calibrate
        Say "  right after Cal.Refresh: " & gHeader
        Pump
        Calibrate
        Say "  after another pump: " & gHeader
        f.Size = 16
        Cal.Refresh
        Pump
        Cal.ShowDateSelectors = True
        Pump
        Say "-- one font object (Arial) in DayFont and GridFont, changed in place"
        g.Name = "Arial"
        g.Size = 8
        Set Cal.DayFont = g
        Set Cal.GridFont = g
        Cal.Refresh
        Pump
        Calibrate
        h0 = gHeader
        BBox 2, gHeader + 2, CLng(gColW) - 2, CLng(gHeader + gRowH) - 2, Cal.BackColor, x0, y0, x1, y1
        Say "  g.Size = 8: header " & gHeader & "; digits of the first cell span " & (x1 - x0 + 1) & " x " & (y1 - y0 + 1) & " pixels"
        g.Size = 20
        Cal.Refresh
        Pump
        Calibrate
        BBox 2, gHeader + 2, CLng(gColW) - 2, CLng(gHeader + gRowH) - 2, Cal.BackColor, x0, y0, x1, y1
        Say "  g.Size = 20 (no Set): header " & gHeader & "; digits of the first cell span " & (x1 - x0 + 1) & " x " & (y1 - y0 + 1) & " pixels"
        Say "  Cal.DayFont Is Cal.GridFont: " & (Cal.DayFont Is Cal.GridFont)
        Shot "sharedfont"
        Set Cal.DayFont = Nothing
        Set Cal.GridFont = Nothing
        Chk "restoring"
    End Sub

    '=========================================================================================
    ' p19: TitleMargin and DaysMargin in pixels (Q19)
    '=========================================================================================

    Private Sub Edges(ByVal what As String)
        Pump
        Calibrate
        Say "  " & what & ": day-names band y=" & FirstY(3, Cal.DayBackColor, 0, CalHt - 1) & ".." & LastY(3, Cal.DayBackColor, 0, CalHt - 1) & "; hit-test header " & gHeader & " (dpi " & Win.GetDpiForWindow(CalH) & ")"
    End Sub

    Private Sub P19()
        On Error Resume Next
        Edges "defaults 5, 5"
        Cal.TitleMargin = 15
        Edges "TitleMargin = 15"
        Cal.TitleMargin = 5
        Cal.DaysMargin = 15
        Edges "DaysMargin = 15"
        Cal.DaysMargin = 5
        Edges "defaults again"
        Chk "P19"
    End Sub

    '=========================================================================================
    ' p20: FirstDay and the grid (Q20, Q31)
    '=========================================================================================

    Private Sub P20()
        On Error Resume Next
        Rebase DateSerial(2026, 6, 15)
        Calibrate
        Say "June 2026 with Monday first: row 0 is Mon 1 ... Sun 7"
        Shot "fd_monday"
        Act "FirstDay = 1 (Sunday)"
        Cal.FirstDay = 1
        Pump
        Shot "fd_sunday_stale"
        Act "Refresh"
        Cal.Refresh
        Pump
        Shot "fd_refresh"
        Act "NextMonth then PreviousMonth (a change of month places the dates again)"
        Cal.NextMonth
        Cal.PreviousMonth
        Pump
        Shot "fd_replaced"
        Say "-- the dates the stale grid holds, read through a click on cell (0, 0)"
        Cal.FirstDay = 2
        Rebase DateSerial(2026, 6, 15)
        Cal.FirstDay = 1
        Pump
        gLogMouseMove = False
        Act "left click on cell (0, 0) with FirstDay = 1 and no change of month since"
        ClickCell 0, 0
        Pump
        St "Value after the click is the first date the grid held"
        Cal.FirstDay = 2
        Chk "P20"
    End Sub

    '=========================================================================================
    ' p21: the grid-line colours (Q21)
    '=========================================================================================

    Private Sub P21()
        On Error Resume Next
        Dim y As Long
        Cal.GridCellEffect = 0
        Pump
        Calibrate
        y = CLng(gHeader + gRowH * 0.85)
        Say "GridCellEffect = 0 (Flat), default GridLinesColor " & Hx(Cal.GridLinesColor) & "; vertical lines near x = " & CLng(gColW) & ", " & CLng(2 * gColW) & ": colours along row y=" & y
        Say "  " & RowRuns(y, 0, CLng(2 * gColW) + 3)
        Say "  colours down column x=20 over the first two rows: " & ColRuns(20, gHeader - 2, CLng(gHeader + gRowH) + 3)
        Cal.GridLinesColor = RGB(255, 0, 0)
        Pump
        Say "GridLinesColor = RGB(255, 0, 0) = " & Hx(Cal.GridLinesColor) & ": colours along row y=" & y
        Say "  " & RowRuns(y, 0, CLng(2 * gColW) + 3)
        Say "  colours down column x=20 over the first two rows: " & ColRuns(20, gHeader - 2, CLng(gHeader + gRowH) + 3)
        Shot "linecolour"
        Cal.GridLinesColor = &H80000010
        Cal.GridCellEffect = 1
        Chk "P21"
    End Sub

    '=========================================================================================
    ' p24: Value and the grid (Q24)
    '=========================================================================================

    Private Sub P24()
        On Error Resume Next
        Calibrate
        Rebase DateSerial(2026, 3, 15)
        Shot "val_march"
        Act "Value = #2030-06-15#"
        Cal.Value = DateSerial(2030, 6, 15)
        Pump
        Say "  title says: " & Cal.Month & "/" & Cal.Year
        Shot "val_2030"
        Say "-- the first date the grid holds, read through a click on cell (0, 0)"
        ClickCell 0, 0
        Pump
        St "after the click on cell (0, 0)"
        Shot "val_afterclick"
        Chk "P24"
    End Sub

    '=========================================================================================
    ' p25: ValueIsNull and the drawing (Q25)
    '=========================================================================================

    Private Sub P25()
        On Error Resume Next
        Dim f0 As Double
        Dim f1 As Double
        Dim f2 As Double
        Pump
        f0 = Fingerprint()
        Act "ValueIsNull = True"
        Cal.ValueIsNull = True
        Chk "ValueIsNull = True"
        Done
        Pump
        f1 = Fingerprint()
        Say "  ValueIsNull reads " & Cal.ValueIsNull
        Act "ValueIsNull = False"
        Cal.ValueIsNull = False
        Chk "ValueIsNull = False"
        Done
        Pump
        f2 = Fingerprint()
        Say "  ValueIsNull reads " & Cal.ValueIsNull
        Say "  fingerprints of the control's pixels: before " & f0 & ", ValueIsNull = True " & f1 & ", False again " & f2 & ": identical = " & (f0 = f1 And f1 = f2)
        Chk "P25"
    End Sub

    '=========================================================================================
    ' p29: chains of NextMonth and PreviousMonth (Q29)
    '=========================================================================================

    Private Sub Step(ByVal op As String)
        On Error Resume Next
        Select Case op
            Case "NextMonth": Cal.NextMonth
            Case "PreviousMonth": Cal.PreviousMonth
            Case "NextYear": Cal.NextYear
            Case "PreviousYear": Cal.PreviousYear
        End Select
        Chk op
        Pump
        St "after"
    End Sub

    Private Sub P29()
        On Error Resume Next
        Cal.Value = DateSerial(2026, 1, 31)
        Pump
        Say "from 2026-01-31:"
        Step "NextMonth"
        Step "NextMonth"
        Step "NextMonth"
        Cal.Value = DateSerial(2026, 3, 31)
        Pump
        Say "from 2026-03-31:"
        Step "PreviousMonth"
        Step "PreviousMonth"
        Cal.Value = DateSerial(2024, 2, 29)
        Pump
        Say "from 2024-02-29:"
        Step "NextYear"
        Step "PreviousYear"
        Step "PreviousYear"
        Cal.Value = DateSerial(2024, 2, 29)
        Pump
        Step "PreviousYear"
        Chk "P29"
    End Sub

    '=========================================================================================
    ' p33: the value of Cancel in BeforeUpdate (Q33)
    '=========================================================================================

    Private Sub P33()
        On Error Resume Next
        Dim v As Variant
        Dim f0 As Double
        Calibrate
        gCancel = True
        For Each v In Array(-1, 1, 0)
            gCancelVal = CInt(v)
            Rebase DateSerial(2026, 6, 15)
            Pump
            f0 = Fingerprint()
            Act "left click on cell (1, 3) (2026-06-11), the handler sets Cancel = " & v
            ClickCell 1, 3
            Pump
            St "after"
            Say "      drawing unchanged: " & (Fingerprint() = f0)
        Next
        gCancel = False
        gCancelVal = -1
        Chk "P33"
    End Sub

    '=========================================================================================
    ' p22x: Month = 13 and then a repaint (Q22). Run on its own.
    '=========================================================================================

    Private Sub P22x()
        On Error Resume Next
        Act "Month = 13"
        Cal.Month = 13
        Chk "Month = 13"
        St "after"
        Say "  Month reads " & Cal.Month & " and the month list shows: [" & Win.TextOf(MonthH) & "]"
        Act "Refresh"
        Cal.Refresh
        Chk "Refresh"
        Done
        Say "  pumped " & gPumped & " messages"
        Cal.Month = 6
        Chk "Month = 6"
        St "after"
    End Sub

End Module
