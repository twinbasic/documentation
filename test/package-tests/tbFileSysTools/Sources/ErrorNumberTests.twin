' The error numbers that differ from the one the same failure raises elsewhere in the package:
' a file held open with exclusive access (access refused is error 70) and a reserved device name
' (an invalid name is error 52).
[TestFixture]
Module ErrorNumberTests

    ' The error that the named procedure raises for a file that this program holds open with
    ' exclusive access. -1 when the file could not be made.
    Private Function ReadHeld(ByVal Folder As String, ByVal Which As String) As Long
        Dim p As String, fn As Long, e As Long, s As String, b() As Byte, a() As String
        p = Folder & "\held.txt"
        StringToTextFile "some text", p
        fn = FreeFile()
        Open p For Binary Access Read Write Lock Read Write As #fn
        On Error Resume Next
        Select Case Which
            Case "TextFileToString": s = TextFileToString(p)
            Case "GetFileEncoding": s = CStr(GetFileEncoding(p))
            Case "GetFileLineEnding": s = CStr(GetFileLineEnding(p))
            Case "ReadStream": ReadStream p, b
            Case "TextFileToArray": a = TextFileToArray(p)
            Case "FileContainsText": s = CStr(FileContainsText(p, "text"))
            Case "StringToTextFile": StringToTextFile "new", p
            Case "OpenTextFile": s = CStr(OpenTextFile(p).AtEndOfStream)
        End Select
        e = Err.Number
        Err.Clear
        On Error GoTo 0
        Close #fn
        ReadHeld = e
    End Function

    [TestCase]
    Public Sub TextFileToString_ExclusiveFile_Raises70()
        Expect.Begin
        Dim w As String
        w = Sandbox.Fresh("TextFileToString_ExclusiveFile_Raises70")
        On Error GoTo Oops
        Expect.AreEqual 70, ReadHeld(w, "TextFileToString"), "TextFileToString of a file held open with exclusive access raises"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

