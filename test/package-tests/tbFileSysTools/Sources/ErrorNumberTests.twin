        On Error GoTo Oops
        StringToTextFile "x", w & "\a.txt"
        For Each name In Array("con", "nul")
            On Error Resume Next
            Rename w & "\a.txt", CStr(name)
            e = Sandbox.Caught()
            On Error GoTo Oops
            Expect.AreEqual 52, e, "Rename of a file to the name " & name & " raises"
        Next
        Expect.IsTrue FileExists(w & "\a.txt"), "the file is still there under its name"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

