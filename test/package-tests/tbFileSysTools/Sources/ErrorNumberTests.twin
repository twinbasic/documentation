    ' ---- reserved device names

    [TestCase]
    Public Sub StringToTextFile_ReservedName_Raises52()
        Expect.Begin
        Dim w As String, name As Variant, e As Long
        w = Sandbox.Fresh("StringToTextFile_ReservedName_Raises52")
        On Error GoTo Oops
        For Each name In Array("con", "nul")
            On Error Resume Next
            StringToTextFile "x", w & "\" & name
            e = Sandbox.Caught()
            On Error GoTo Oops
            Expect.AreEqual 52, e, "StringToTextFile to the file name " & name & " raises"
        Next
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ArrayToTextFile_ReservedName_Raises52()
        Expect.Begin
        Dim w As String, name As Variant, e As Long, lines() As String
        w = Sandbox.Fresh("ArrayToTextFile_ReservedName_Raises52")
        On Error GoTo Oops
        lines = Split("a,b", ",")
        For Each name In Array("con", "nul")
            On Error Resume Next
            ArrayToTextFile lines, w & "\" & name
            e = Sandbox.Caught()
            On Error GoTo Oops
            Expect.AreEqual 52, e, "ArrayToTextFile to the file name " & name & " raises"
