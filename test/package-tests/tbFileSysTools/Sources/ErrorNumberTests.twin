    [TestCase]
    Public Sub MoveFolder_ReservedName_Raises52()
        Expect.Begin
        Dim w As String, name As Variant, e As Long
        w = Sandbox.Fresh("MoveFolder_ReservedName_Raises52")
        On Error GoTo Oops
        CreateFolder w & "\f"
        For Each name In Array("con", "nul")
            On Error Resume Next
            MoveFolder w & "\f", w & "\" & name
            e = Sandbox.Caught()
            On Error GoTo Oops
            Expect.AreEqual 52, e, "MoveFolder to the folder name " & name & " raises"
        Next
        Expect.IsTrue FolderExists(w & "\f"), "the source folder is still there"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

    ' ---- the NUL device as the destination of a move: the file must not be lost

    [TestCase]
    Public Sub MoveFile_NulDevice_KeepsSourceFile()
        Expect.Begin
        Dim w As String, name As Variant, e As Long
        w = Sandbox.Fresh("MoveFile_NulDevice_KeepsSourceFile")
        On Error GoTo Oops
        For Each name In Array("nul", "NUL", "nul.txt")
            StringToTextFile "payload", w & "\a.txt"
            On Error Resume Next
            MoveFile w & "\a.txt", w & "\" & name
            e = Sandbox.Caught()
            On Error GoTo Oops
            Expect.AreEqual 52, e, "MoveFile to the file name " & name & " raises"
            Expect.IsTrue FileExists(w & "\a.txt"), "the source file is still there after MoveFile to the file name " & name
            DeleteFile w & "\a.txt", True, True
        Next
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FileMove_NulDevice_KeepsSourceFile()
        Expect.Begin
        Dim w As String, e As Long
        w = Sandbox.Fresh("FileMove_NulDevice_KeepsSourceFile")
        On Error GoTo Oops
        StringToTextFile "payload", w & "\a.txt"
        On Error Resume Next
        GetFile(w & "\a.txt").Move w & "\nul"
        e = Sandbox.Caught()
        On Error GoTo Oops
        Expect.AreEqual 52, e, "File.Move to the file name nul raises"
        Expect.IsTrue FileExists(w & "\a.txt"), "the source file is still there after File.Move to the file name nul"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

