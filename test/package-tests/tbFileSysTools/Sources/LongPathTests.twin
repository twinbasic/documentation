    ' ---- what works in a path of more than 260 characters

    [TestCase]
    Public Sub LongPath_Procedures_Work()
        Expect.Begin
        Dim w As String, deep As String, top As String, p As String, q As String, c As Collection
        w = Sandbox.Fresh("LongPath_Procedures_Work")
        On Error GoTo Oops
        deep = Sandbox.PathOfLength(w, 300)
        CreateFolder deep, True
        Expect.IsTrue FolderExists(deep), "FolderExists of a folder whose path has 300 characters"
        p = deep & "\note.txt"
        StringToTextFile "hello", p
        Expect.IsTrue FileExists(p), "FileExists of a file in it"
        Expect.AreEqual "hello", TextFileToString(p), "TextFileToString of that file"
        Expect.AreEqual p, GetFile(p).Path, "File.Path of GetFile of that file"
        Set c = GetFilePaths(deep)
        Expect.AreEqual 1, c.Count, "files that GetFilePaths lists in it"
        q = deep & "\copy.txt"
        CopyFile p, q
        Expect.IsTrue FileExists(q), "CopyFile to a path of more than 260 characters"
        MoveFile q, deep & "\moved.txt"
        Expect.IsTrue FileExists(deep & "\moved.txt"), "MoveFile to a path of more than 260 characters"
        Rename deep & "\moved.txt", "renamed.txt"
        Expect.IsTrue FileExists(deep & "\renamed.txt"), "Rename of a file with a path of more than 260 characters"
        DeleteFile deep & "\renamed.txt"
        Expect.IsFalse FileExists(deep & "\renamed.txt"), "DeleteFile of a file with a path of more than 260 characters"
        top = w & "\" & String$(100, "d")
        DeleteFolder top
        Expect.IsFalse FolderExists(top), "DeleteFolder of a tree whose paths have more than 260 characters"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

    ' ---- what stops at the limit

    [TestCase]
    Public Sub GetFileVersion_PathOver260_ReturnsEmpty()
        Expect.Begin
        Dim w As String, deep As String, kernel As String
        w = Sandbox.Fresh("GetFileVersion_PathOver260_ReturnsEmpty")
        On Error GoTo Oops
        kernel = GetSpecialFolderPath(sfSystemFolder) & "\kernel32.dll"
        CopyFile kernel, w & "\k.dll"
        Expect.IsTrue Len(GetFileVersion(w & "\k.dll")) > 0, "GetFileVersion of a copy of kernel32.dll under a short path is not empty"
        deep = Sandbox.PathOfLength(w, 300)
        CreateFolder deep, True
        CopyFile kernel, deep & "\k.dll"
        Expect.IsTrue FileExists(deep & "\k.dll"), "the copy of kernel32.dll under a path of 300 characters exists"
        Expect.AreEqual "", GetFileVersion(deep & "\k.dll"), "GetFileVersion of a file whose path has more than 260 characters"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

