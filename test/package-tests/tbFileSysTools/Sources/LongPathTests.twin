' Paths of more than 260 characters: what works, what stops at the limit, and the folders of 258
' characters or more whose Files, SubFolders and Size raise error 76.
[TestFixture]
Module LongPathTests

    ' ---- Folder.Files, SubFolders and Size

    [TestCase]
    Public Sub FolderFiles_Path258_ListsFiles()
        Expect.Begin
        Dim w As String, deep As String, n As Long, e As Long
        w = Sandbox.Fresh("FolderFiles_Path258_ListsFiles")
        On Error GoTo Oops
        deep = Sandbox.PathOfLength(w, 258)
        CreateFolder deep, True
        StringToTextFile "hello", deep & "\f.txt"
        On Error Resume Next
        n = GetFolder(deep).Files.Count
        e = Sandbox.Caught()
        On Error GoTo Oops
        Expect.AreEqual 0, e, "Folder.Files of a folder whose path has 258 characters raises error"
        Expect.AreEqual 1, n, "files in Folder.Files of that folder"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

