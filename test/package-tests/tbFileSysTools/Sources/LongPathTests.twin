    ' A folder of this path length with a file, and a subfolder when Sub is True.
    Private Function MakeFolderOfLength(ByVal W As String, ByVal Length As Long, ByVal WithSubfolder As Boolean) As String
        Dim deep As String
        deep = Sandbox.PathOfLength(W, Length)
        CreateFolder deep, True
        StringToTextFile "hello", deep & "\f.txt"
        If WithSubfolder Then CreateFolder deep & "\s"
        MakeFolderOfLength = deep
    End Function

    [TestCase]
    Public Sub FolderFilesAndSubFolders_Path256_Work()
        Expect.Begin
        Dim w As String, deep As String, n As Long, e As Long
        w = Sandbox.Fresh("FolderFilesAndSubFolders_Path256_Work")
        On Error GoTo Oops
        deep = MakeFolderOfLength(w, 256, True)
        On Error Resume Next
        n = GetFolder(deep).Files.Count
        e = Sandbox.Caught()
        On Error GoTo Oops
        Expect.AreEqual 0, e, "Folder.Files of a folder whose path has 256 characters raises error"
        Expect.AreEqual 1, n, "files in Folder.Files of that folder"
        On Error Resume Next
        n = GetFolder(deep).SubFolders.Count
        e = Sandbox.Caught()
        On Error GoTo Oops
        Expect.AreEqual 0, e, "Folder.SubFolders of that folder raises error"
        Expect.AreEqual 1, n, "folders in Folder.SubFolders of that folder"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

