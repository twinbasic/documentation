    [TestCase]
    Public Sub SetCurrentDir_PathOver260_Raises75()
        Expect.Begin
        Dim w As String, deep As String, here As String, e As Long
        here = GetCurrentDir()
        w = Sandbox.Fresh("SetCurrentDir_PathOver260_Raises75")
        On Error GoTo Oops
        deep = Sandbox.PathOfLength(w, 300)
        CreateFolder deep, True
        On Error Resume Next
        SetCurrentDir deep
        e = Sandbox.Caught()
        On Error GoTo Oops
        Expect.AreEqual 75, e, "SetCurrentDir of a folder whose path has 300 characters raises"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        On Error Resume Next
        SetCurrentDir here
        Sandbox.Remove w
        Expect.Done
    End Sub

    [TestCase]
    Public Sub DeleteFile_WildcardInLongFolder_Raises53()
        Expect.Begin
        Dim w As String, deep As String, e As Long
        w = Sandbox.Fresh("DeleteFile_WildcardInLongFolder_Raises53")
        On Error GoTo Oops
        deep = Sandbox.PathOfLength(w, 300)
        CreateFolder deep, True
        StringToTextFile "x", deep & "\a.dll"
        On Error Resume Next
        DeleteFile deep & "\*.dll"
        e = Sandbox.Caught()
        On Error GoTo Oops
        Expect.AreEqual 53, e, "DeleteFile of a pattern in a folder whose path has 300 characters raises"
        Expect.IsTrue FileExists(deep & "\a.dll"), "the file is still there"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

    [TestCase]
    Public Sub CopyFile_WildcardInLongFolder_Raises53()
        Expect.Begin
        Dim w As String, deep As String, e As Long
        w = Sandbox.Fresh("CopyFile_WildcardInLongFolder_Raises53")
        On Error GoTo Oops
        deep = Sandbox.PathOfLength(w, 300)
        CreateFolder deep, True
        CreateFolder w & "\dst"
        StringToTextFile "x", deep & "\a.dll"
        On Error Resume Next
        CopyFile deep & "\*.dll", w & "\dst"
        e = Sandbox.Caught()
        On Error GoTo Oops
        Expect.AreEqual 53, e, "CopyFile of a pattern in a folder whose path has 300 characters raises"
        Expect.IsFalse FileExists(w & "\dst\a.dll"), "no file was copied"
        GoTo Finish
Oops:
        Expect.Fail "unexpected run-time error " & Err.Number & ": " & Err.Description
        Resume Finish
Finish:
        Sandbox.Remove w
        Expect.Done
    End Sub

End Module
