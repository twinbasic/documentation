' TBMANLIB_ConsoleCore: the enumerations, structures and helper functions of the Types page.
[TestFixture]
Module TypesTests

    [TestCase]
    Public Sub ConsoleColor_Values()
        Expect.Begin
        Expect.AreEqual 0, CLng(ConsoleColor.Black), "ConsoleColor.Black"
        Expect.AreEqual 1, CLng(ConsoleColor.DarkBlue), "ConsoleColor.DarkBlue"
        Expect.AreEqual 2, CLng(ConsoleColor.DarkGreen), "ConsoleColor.DarkGreen"
        Expect.AreEqual 3, CLng(ConsoleColor.DarkCyan), "ConsoleColor.DarkCyan"
        Expect.AreEqual 4, CLng(ConsoleColor.DarkRed), "ConsoleColor.DarkRed"
        Expect.AreEqual 5, CLng(ConsoleColor.DarkMagenta), "ConsoleColor.DarkMagenta"
        Expect.AreEqual 6, CLng(ConsoleColor.DarkYellow), "ConsoleColor.DarkYellow"
        Expect.AreEqual 7, CLng(ConsoleColor.Gray), "ConsoleColor.Gray"
        Expect.AreEqual 8, CLng(ConsoleColor.DarkGray), "ConsoleColor.DarkGray"
        Expect.AreEqual 9, CLng(ConsoleColor.Blue), "ConsoleColor.Blue"
        Expect.AreEqual 10, CLng(ConsoleColor.Green), "ConsoleColor.Green"
        Expect.AreEqual 11, CLng(ConsoleColor.Cyan), "ConsoleColor.Cyan"
        Expect.AreEqual 12, CLng(ConsoleColor.Red), "ConsoleColor.Red"
        Expect.AreEqual 13, CLng(ConsoleColor.Magenta), "ConsoleColor.Magenta"
        Expect.AreEqual 14, CLng(ConsoleColor.Yellow), "ConsoleColor.Yellow"
        Expect.AreEqual 15, CLng(ConsoleColor.White), "ConsoleColor.White"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsoleColorAttribute_ForegroundInTheLowFourBitsBackgroundInTheNext()
        Expect.Begin
        Expect.AreEqual &H1E&, CLng(mConsoleAPI.ColorAttribute(ConsoleColor.Yellow, ConsoleColor.DarkBlue)), "ColorAttribute(Yellow, DarkBlue)"
        Expect.AreEqual &H7&, CLng(mConsoleAPI.ColorAttribute(ConsoleColor.Gray, ConsoleColor.Black)), "ColorAttribute(Gray, Black)"
        Expect.AreEqual &HF0&, CLng(mConsoleAPI.ColorAttribute(ConsoleColor.Black, ConsoleColor.White)), "ColorAttribute(Black, White)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsoleKey_Values()
        Expect.Begin
        Expect.AreEqual 13, CLng(ConsoleKey.KeyEnter), "ConsoleKey.KeyEnter"
        Expect.AreEqual 27, CLng(ConsoleKey.KeyEscape), "ConsoleKey.KeyEscape"
        Expect.AreEqual 32, CLng(ConsoleKey.KeySpace), "ConsoleKey.KeySpace"
        Expect.AreEqual 8, CLng(ConsoleKey.KeyBackspace), "ConsoleKey.KeyBackspace"
        Expect.AreEqual 9, CLng(ConsoleKey.KeyTab), "ConsoleKey.KeyTab"
        Expect.AreEqual 72, CLng(ConsoleKey.KeyUp), "ConsoleKey.KeyUp"
        Expect.AreEqual 80, CLng(ConsoleKey.KeyDown), "ConsoleKey.KeyDown"
        Expect.AreEqual 75, CLng(ConsoleKey.KeyLeft), "ConsoleKey.KeyLeft"
        Expect.AreEqual 77, CLng(ConsoleKey.KeyRight), "ConsoleKey.KeyRight"
        Expect.AreEqual 71, CLng(ConsoleKey.KeyHome), "ConsoleKey.KeyHome"
        Expect.AreEqual 79, CLng(ConsoleKey.KeyEnd), "ConsoleKey.KeyEnd"
        Expect.AreEqual 73, CLng(ConsoleKey.KeyPageUp), "ConsoleKey.KeyPageUp"
        Expect.AreEqual 81, CLng(ConsoleKey.KeyPageDown), "ConsoleKey.KeyPageDown"
        Expect.AreEqual 82, CLng(ConsoleKey.KeyInsert), "ConsoleKey.KeyInsert"
        Expect.AreEqual 83, CLng(ConsoleKey.KeyDelete), "ConsoleKey.KeyDelete"
        Expect.AreEqual 59, CLng(ConsoleKey.KeyF1), "ConsoleKey.KeyF1"
        Expect.AreEqual 60, CLng(ConsoleKey.KeyF2), "ConsoleKey.KeyF2"
        Expect.AreEqual 61, CLng(ConsoleKey.KeyF3), "ConsoleKey.KeyF3"
        Expect.AreEqual 62, CLng(ConsoleKey.KeyF4), "ConsoleKey.KeyF4"
        Expect.AreEqual 63, CLng(ConsoleKey.KeyF5), "ConsoleKey.KeyF5"
        Expect.AreEqual 64, CLng(ConsoleKey.KeyF6), "ConsoleKey.KeyF6"
        Expect.AreEqual 65, CLng(ConsoleKey.KeyF7), "ConsoleKey.KeyF7"
        Expect.AreEqual 66, CLng(ConsoleKey.KeyF8), "ConsoleKey.KeyF8"
        Expect.AreEqual 67, CLng(ConsoleKey.KeyF9), "ConsoleKey.KeyF9"
        Expect.AreEqual 68, CLng(ConsoleKey.KeyF10), "ConsoleKey.KeyF10"
        Expect.AreEqual 133, CLng(ConsoleKey.KeyF11), "ConsoleKey.KeyF11"
        Expect.AreEqual 134, CLng(ConsoleKey.KeyF12), "ConsoleKey.KeyF12"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsoleKey_FirstFiveMembersAreVirtualKeyCodes()
        Expect.Begin
        Expect.AreEqual CLng(vbKeyReturn), CLng(ConsoleKey.KeyEnter), "ConsoleKey.KeyEnter against vbKeyReturn"
        Expect.AreEqual CLng(vbKeyEscape), CLng(ConsoleKey.KeyEscape), "ConsoleKey.KeyEscape against vbKeyEscape"
        Expect.AreEqual CLng(vbKeySpace), CLng(ConsoleKey.KeySpace), "ConsoleKey.KeySpace against vbKeySpace"
        Expect.AreEqual CLng(vbKeyBack), CLng(ConsoleKey.KeyBackspace), "ConsoleKey.KeyBackspace against vbKeyBack"
        Expect.AreEqual CLng(vbKeyTab), CLng(ConsoleKey.KeyTab), "ConsoleKey.KeyTab against vbKeyTab"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsoleKey_NavigationAndFunctionMembersAreVirtualKeyCodes()
        ' The members of the other keys should be the codes ReadKey returns for them.
        Expect.Begin
        Expect.AreEqual CLng(vbKeyUp), CLng(ConsoleKey.KeyUp), "ConsoleKey.KeyUp against vbKeyUp"
        Expect.AreEqual CLng(vbKeyDown), CLng(ConsoleKey.KeyDown), "ConsoleKey.KeyDown against vbKeyDown"
        Expect.AreEqual CLng(vbKeyLeft), CLng(ConsoleKey.KeyLeft), "ConsoleKey.KeyLeft against vbKeyLeft"
        Expect.AreEqual CLng(vbKeyRight), CLng(ConsoleKey.KeyRight), "ConsoleKey.KeyRight against vbKeyRight"
        Expect.AreEqual CLng(vbKeyHome), CLng(ConsoleKey.KeyHome), "ConsoleKey.KeyHome against vbKeyHome"
        Expect.AreEqual CLng(vbKeyEnd), CLng(ConsoleKey.KeyEnd), "ConsoleKey.KeyEnd against vbKeyEnd"
        Expect.AreEqual CLng(vbKeyPageUp), CLng(ConsoleKey.KeyPageUp), "ConsoleKey.KeyPageUp against vbKeyPageUp"
        Expect.AreEqual CLng(vbKeyPageDown), CLng(ConsoleKey.KeyPageDown), "ConsoleKey.KeyPageDown against vbKeyPageDown"
        Expect.AreEqual CLng(vbKeyInsert), CLng(ConsoleKey.KeyInsert), "ConsoleKey.KeyInsert against vbKeyInsert"
        Expect.AreEqual CLng(vbKeyDelete), CLng(ConsoleKey.KeyDelete), "ConsoleKey.KeyDelete against vbKeyDelete"
        Expect.AreEqual CLng(vbKeyF1), CLng(ConsoleKey.KeyF1), "ConsoleKey.KeyF1 against vbKeyF1"
        Expect.AreEqual CLng(vbKeyF5), CLng(ConsoleKey.KeyF5), "ConsoleKey.KeyF5 against vbKeyF5"
        Expect.AreEqual CLng(vbKeyF10), CLng(ConsoleKey.KeyF10), "ConsoleKey.KeyF10 against vbKeyF10"
        Expect.AreEqual CLng(vbKeyF11), CLng(ConsoleKey.KeyF11), "ConsoleKey.KeyF11 against vbKeyF11"
        Expect.AreEqual CLng(vbKeyF12), CLng(ConsoleKey.KeyF12), "ConsoleKey.KeyF12 against vbKeyF12"
        Expect.Done
    End Sub

