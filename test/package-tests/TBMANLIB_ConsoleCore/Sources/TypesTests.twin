        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsoleRect_Create_ReturnsTheFourEdgesAsGiven()
        Expect.Begin
        Dim r As ConsoleRect
        r = ConsoleRect_Create(2, 1, 11, 4)
        Expect.AreEqual 2, r.Left, "Left of ConsoleRect_Create(2, 1, 11, 4)"
        Expect.AreEqual 1, r.Top, "Top"
        Expect.AreEqual 11, r.Right, "Right"
        Expect.AreEqual 4, r.Bottom, "Bottom"
        r = ConsoleRect_Create(9, 9, 3, 3)
        Expect.AreEqual 9, r.Left, "Left of ConsoleRect_Create(9, 9, 3, 3), whose right is less than its left"
        Expect.AreEqual 3, r.Right, "Right of ConsoleRect_Create(9, 9, 3, 3)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsoleRect_Width_And_Height_CountBothEdges()
        Expect.Begin
        Dim r As ConsoleRect
        r = ConsoleRect_Create(2, 1, 11, 4)
        Expect.AreEqual 10, ConsoleRect_Width(r), "ConsoleRect_Width of columns 2 to 11"
        Expect.AreEqual 4, ConsoleRect_Height(r), "ConsoleRect_Height of rows 1 to 4"
        r = ConsoleRect_Create(5, 5, 5, 5)
        Expect.AreEqual 1, ConsoleRect_Width(r), "ConsoleRect_Width of one column"
        Expect.AreEqual 1, ConsoleRect_Height(r), "ConsoleRect_Height of one row"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsoleRect_Contains_EdgesBelongToTheRectangle()
        Expect.Begin
        Dim r As ConsoleRect
        r = ConsoleRect_Create(2, 1, 11, 4)
        Expect.IsTrue ConsoleRect_Contains(r, 2, 1), "the upper left corner is in the rectangle"
        Expect.IsTrue ConsoleRect_Contains(r, 11, 4), "the lower right corner is in the rectangle"
        Expect.IsTrue ConsoleRect_Contains(r, 5, 2), "a point inside is in the rectangle"
        Expect.IsFalse ConsoleRect_Contains(r, 1, 1), "a point left of the rectangle is not in it"
        Expect.IsFalse ConsoleRect_Contains(r, 12, 4), "a point right of the rectangle is not in it"
        Expect.IsFalse ConsoleRect_Contains(r, 5, 0), "a point above the rectangle is not in it"
        Expect.IsFalse ConsoleRect_Contains(r, 5, 5), "a point below the rectangle is not in it"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsoleKeyInfo_EmptyStructure_HasNoKeyAndNoCharacter()
        Expect.Begin
        Dim k As ConsoleKeyInfo
        Expect.AreEqual 0, k.KeyCode, "KeyCode of an empty ConsoleKeyInfo"
        Expect.AreEqual "", k.KeyChar, "KeyChar of an empty ConsoleKeyInfo"
        Expect.IsFalse k.IsAltPressed, "IsAltPressed of an empty ConsoleKeyInfo"
        Expect.IsFalse k.IsCtrlPressed, "IsCtrlPressed of an empty ConsoleKeyInfo"
        Expect.IsFalse k.IsShiftPressed, "IsShiftPressed of an empty ConsoleKeyInfo"
        Expect.Done
    End Sub

End Module
