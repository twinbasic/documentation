    Public Sub ConsoleMode_And_ConsoleTextStyle_Values()
        Expect.Begin
        Expect.AreEqual 0, CLng(ConsoleMode.ModeNormal), "ConsoleMode.ModeNormal"
        Expect.AreEqual 1, CLng(ConsoleMode.ModeVirtualTerminal), "ConsoleMode.ModeVirtualTerminal"
        Expect.AreEqual 2, CLng(ConsoleMode.ModeFullScreen), "ConsoleMode.ModeFullScreen"
        Expect.AreEqual 4, CLng(ConsoleMode.ModeRaw), "ConsoleMode.ModeRaw"
        Expect.AreEqual 0, CLng(ConsoleTextStyle.StyleNone), "ConsoleTextStyle.StyleNone"
        Expect.AreEqual 1, CLng(ConsoleTextStyle.StyleBold), "ConsoleTextStyle.StyleBold"
        Expect.AreEqual 2, CLng(ConsoleTextStyle.StyleUnderline), "ConsoleTextStyle.StyleUnderline"
        Expect.AreEqual 4, CLng(ConsoleTextStyle.StyleReverse), "ConsoleTextStyle.StyleReverse"
        Expect.Done
    End Sub

