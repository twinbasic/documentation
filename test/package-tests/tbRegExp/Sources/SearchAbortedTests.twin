' tbRegExp: RegExp.SearchAborted for a pattern that is not catastrophic. A search that only has to
' try each start position finishes, however long the string; SearchAborted is for a search that
' backtracks without end (see SearchGivesUpTests).
[TestFixture]
Module SearchAbortedTests

    [TestCase]
    Public Sub SearchAborted_DigitsWithoutXFinishAt2000()
        Expect.Begin
        Dim re As New RegExp
        re.Pattern = "\d+x"
        Expect.IsFalse re.Test(String$(2000, "1")), "Test of \d+x on 2,000 digits and no x"
        Expect.IsFalse re.SearchAborted, "SearchAborted after Test of \d+x on 2,000 digits and no x"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SearchAborted_DigitsWithoutXFinishAt5000()
        Expect.Begin
        Dim re As New RegExp
        re.Pattern = "\d+x"
        Expect.IsFalse re.Test(String$(5000, "1")), "Test of \d+x on 5,000 digits and no x"
        Expect.IsFalse re.SearchAborted, "SearchAborted after Test of \d+x on 5,000 digits and no x"
        Expect.Done
    End Sub

End Module
