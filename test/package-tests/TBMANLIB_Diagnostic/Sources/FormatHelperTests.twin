' FormatHelper: the formatting functions and the two escaping functions.
[TestFixture]
Module FormatHelperTests

    ' The decimal separator of the user's regional settings, as Format writes it.
    Private Function Sep() As String
        Sep = Mid$(Format$(1.5, "0.0"), 2, 1)
    End Function

    ' ---- FormatBytes

    [TestCase]
    Public Sub FormatBytes_NoDecimals_LeavesNoDecimalSeparator()
        Expect.Begin
        Expect.AreEqual "4 KB", FormatHelper.FormatBytes(4096, 0), "FormatBytes(4096, 0)"
        Expect.AreEqual "1 MB", FormatHelper.FormatBytes(1048576, 0), "FormatBytes(1048576, 0)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FormatBytes_Decimals_WritesThatManyDigits()
        Expect.Begin
        Expect.AreEqual "1" & Sep() & "5 KB", FormatHelper.FormatBytes(1536), "FormatBytes(1536)"
        Expect.AreEqual "1" & Sep() & "500 KB", FormatHelper.FormatBytes(1536, 3), "FormatBytes(1536, 3)"
        Expect.AreEqual "1" & Sep() & "00 GB", FormatHelper.FormatBytes(1073741824, 2), "FormatBytes(1073741824, 2)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FormatBytes_BelowOneKilobyte_IsWholeBytes()
        Expect.Begin
        Expect.AreEqual "512 B", FormatHelper.FormatBytes(512), "FormatBytes(512)"
        Expect.AreEqual "512 B", FormatHelper.FormatBytes(512, 3), "FormatBytes(512, 3)"
        Expect.AreEqual "0 B", FormatHelper.FormatBytes(0), "FormatBytes(0)"
        Expect.AreEqual "-2048 B", FormatHelper.FormatBytes(-2048), "FormatBytes(-2048)"
        Expect.Done
    End Sub

    ' ---- the other formats

    [TestCase]
    Public Sub FormatUptime_LeavesOutLeadingZeroParts()
        Expect.Begin
        Expect.AreEqual "0s", FormatHelper.FormatUptime(0), "FormatUptime(0)"
        Expect.AreEqual "59s", FormatHelper.FormatUptime(59999), "FormatUptime(59999)"
        Expect.AreEqual "1h 0m 0s", FormatHelper.FormatUptime(3600000), "FormatUptime(3600000)"
        Expect.AreEqual "3d 12h 5m 32s", FormatHelper.FormatUptime(302732000), "FormatUptime(302732000)"
        Expect.AreEqual "1d 1h 1m 1s", FormatHelper.FormatUptime(90061000), "FormatUptime(90061000)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FormatPercent_WritesTheShare()
        Expect.Begin
        Expect.AreEqual "33" & Sep() & "3%", FormatHelper.FormatPercent(1, 3, 1), "FormatPercent(1, 3, 1)"
        Expect.AreEqual "50%", FormatHelper.FormatPercent(1, 2), "FormatPercent(1, 2)"
        Expect.AreEqual "0%", FormatHelper.FormatPercent(1, 0, 1), "FormatPercent(1, 0, 1)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FormatPercentValue_RoundsLikeCLng()
        Expect.Begin
        Expect.AreEqual "55%", FormatHelper.FormatPercentValue(54.6), "FormatPercentValue(54.6)"
        Expect.AreEqual "2%", FormatHelper.FormatPercentValue(2.5), "FormatPercentValue(2.5)"
        Expect.AreEqual "12" & Sep() & "3%", FormatHelper.FormatPercentValue(12.34, 1), "FormatPercentValue(12.34, 1)"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub DateFormats_WriteTheDocumentedForms()
        Expect.Begin
        Dim d As Date
        d = DateSerial(2026, 1, 4) + TimeSerial(15, 30, 45)
        Expect.AreEqual "2026-01-04 15:30:45", FormatHelper.FormatDateTime(d), "FormatHelper.FormatDateTime"
        Expect.AreEqual "2026-01-04T15:30:45", FormatHelper.FormatDateTimeISO(d), "FormatDateTimeISO"
        Expect.AreEqual "15:30:45", FormatHelper.FormatTime(d), "FormatTime"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub PadAndTruncate_FollowTheirDescriptions()
        Expect.Begin
        Expect.AreEqual "   42", FormatHelper.PadLeft("42", 5), "PadLeft(""42"", 5)"
        Expect.AreEqual "42...", FormatHelper.PadRight("42", 5, "."), "PadRight(""42"", 5, ""."")"
        Expect.AreEqual "A long ...", FormatHelper.Truncate("A long sentence", 10), "Truncate(""A long sentence"", 10)"
        Expect.AreEqual "...", FormatHelper.Truncate("abcdef", 3), "Truncate(""abcdef"", 3)"
        Expect.AreEqual "abcd~", FormatHelper.Truncate("abcdef", 5, "~"), "Truncate(""abcdef"", 5, ""~"")"
        Expect.AreEqual "abc", FormatHelper.Truncate("abc", 5), "Truncate(""abc"", 5)"
        Expect.Done
    End Sub

    ' ---- escaping

    [TestCase]
    Public Sub EscapeHtml_ReplacesTheFiveCharacters()
        Expect.Begin
        Expect.AreEqual "&lt;a href=&#39;x&#39;&gt;&amp;&lt;/a&gt;", FormatHelper.EscapeHtml("<a href='x'>&</a>"), "EscapeHtml of <a href='x'>&</a>"
        Expect.AreEqual "&quot;q&quot;", FormatHelper.EscapeHtml("""q"""), "EscapeHtml of a quoted word"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EscapeJson_NamedCharacters_AreEscaped()
        Expect.Begin
        Expect.AreEqual "a\\b\t\""q\""", FormatHelper.EscapeJson("a\b" & vbTab & """q"""), "EscapeJson of a backslash, a tab and quotes"
        Expect.AreEqual "x\r\ny", FormatHelper.EscapeJson("x" & vbCrLf & "y"), "EscapeJson of a carriage return and a line feed"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub EscapeJson_ControlCharacters_AreEscaped()
        Expect.Begin
        Dim code As Long, raw As String, escaped As String
        For code = 1 To 31
            escaped = FormatHelper.EscapeJson(Chr$(code))
            If InStr(escaped, Chr$(code)) > 0 Then raw = raw & IIf(Len(raw) > 0, ",", "") & code
        Next code
        Expect.AreEqual "", raw,"codes from 1 to 31 that EscapeJson returns as the raw character, which JSON does not allow in a string"
        Expect.Done
    End Sub

End Module
