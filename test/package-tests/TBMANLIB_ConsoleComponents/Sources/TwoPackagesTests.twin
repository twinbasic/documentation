' TBMANLIB_ConsoleComponents: the package used with the published TBMANLIB_ConsoleCore.
'
' The package carries a copy of ConsoleCore of its own, whose types the compiler treats as different
' from those of the published package. A component of the package is reached here by its library name
' (TBMANLIB_ConsoleComponents.cProgressBar), because the project compiles a copy of the code of seven
' components under their own names for the cases that draw (see ComponentSources). The cases that
' make a component with a cConsole are correct when they raise no error.
[TestFixture]
Module TwoPackagesTests

    [TestCase]
    Public Sub ProgressBar_New_AcceptsTheConsoleOfConsoleCore()
        Expect.Begin
        Rig.Acquire
        Dim con As New cConsole
        con.EnterFullScreenMode
        Dim obj As TBMANLIB_ConsoleComponents.cProgressBar
        On Error Resume Next
        Set obj = New TBMANLIB_ConsoleComponents.cProgressBar(con)
        Expect.AreEqual 0, Err.Number, "Err.Number of New cProgressBar given the cConsole of TBMANLIB_ConsoleCore"
        On Error GoTo 0
        Set obj = Nothing
        Set con = Nothing
        Rig.Release
        Expect.Done
    End Sub

