        Dim buf As cConsoleBuffer = New cConsoleBuffer(20, 10)
        On Error Resume Next
        panel.ClearContent buf
        Expect.AreEqual 0, Err.Number, "Err.Number of cConsolePanel.ClearContent given the cConsoleBuffer of TBMANLIB_ConsoleCore"
        On Error GoTo 0
        Expect.Done
    End Sub

    ' ---- what works with the package as it is

    [TestCase]
    Public Sub ConsolePanel_ContentSize_WorksWithThePackage()
        Expect.Begin
        Dim panel As TBMANLIB_ConsoleComponents.cConsolePanel = New TBMANLIB_ConsoleComponents.cConsolePanel("p", 1, 2, 10, 5)
        Expect.AreEqual 6, panel.ContentWidth(), "ContentWidth of a panel of 10 by 5 cells with a single border and a padding of 1"
        Expect.AreEqual 1, panel.ContentHeight(), "ContentHeight of that panel"
        panel.BorderStyle = 0
        Expect.AreEqual 8, panel.ContentWidth(), "ContentWidth with no border"
        Expect.AreEqual 3, panel.ContentHeight(), "ContentHeight with no border"
        panel.Padding = 0
        Expect.AreEqual 10, panel.ContentWidth(), "ContentWidth with no border and no padding"
        Expect.AreEqual 5, panel.ContentHeight(), "ContentHeight with no border and no padding"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsolePanel_ContentRect_CanBeReadThroughItsMemory()
        Expect.Begin
        Dim panel As TBMANLIB_ConsoleComponents.cConsolePanel = New TBMANLIB_ConsoleComponents.cConsolePanel("p", 1, 2, 10, 5)
        Dim cr = panel.ContentRect()
        Dim v(0 To 3) As Long
        Rig.ReadMemory VarPtr(cr), VarPtr(v(0)), 16
        Expect.AreEqual "3 4 8 4", v(0) & " " & v(1) & " " & v(2) & " " & v(3), "Left, Top, Right and Bottom of the content area of a panel at 1, 2 of 10 by 5 cells"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsolePanel_Constructor_SetsTheStyleFields()
        Expect.Begin
        Dim panel As TBMANLIB_ConsoleComponents.cConsolePanel = New TBMANLIB_ConsoleComponents.cConsolePanel("main", 3, 4, 20, 8)
        Expect.AreEqual "main", panel.Name, "Name"
        Expect.AreEqual 1, CLng(panel.BorderStyle), "BorderStyle"
        Expect.AreEqual CLng(ConsoleColor.Gray), CLng(panel.BorderColor), "BorderColor"
        Expect.AreEqual CLng(ConsoleColor.White), CLng(panel.TitleColor), "TitleColor"
        Expect.AreEqual 1, panel.Padding, "Padding"
        Expect.AreEqual "", panel.Title, "Title"
        Dim r = panel.Rect
        Dim v(0 To 3) As Long
        Rig.ReadMemory VarPtr(r), VarPtr(v(0)), 16
        Expect.AreEqual "3 4 22 11", v(0) & " " & v(1) & " " & v(2) & " " & v(3), "Left, Top, Right and Bottom of Rect"
        Expect.Done
    End Sub

End Module
