    [TestCase]
    Public Sub ConsolePanel_Render_AcceptsTheBufferOfConsoleCore()
        Expect.Begin
        Dim panel As TBMANLIB_ConsoleComponents.cConsolePanel = New TBMANLIB_ConsoleComponents.cConsolePanel("p", 0, 0, 10, 5)
        Dim buf As cConsoleBuffer = New cConsoleBuffer(20, 10)
        On Error Resume Next
        panel.Render buf
        Expect.AreEqual 0, Err.Number, "Err.Number of cConsolePanel.Render given the cConsoleBuffer of TBMANLIB_ConsoleCore"
        On Error GoTo 0
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ConsolePanel_ClearContent_AcceptsTheBufferOfConsoleCore()
        Expect.Begin
