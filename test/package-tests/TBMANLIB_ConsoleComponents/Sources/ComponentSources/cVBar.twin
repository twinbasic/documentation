' cVBar.twin of TBMANLIB_ConsoleComponents 1.0.0.1 (woeoio, MIT licence), compiled into this project.
' The package cannot take the cConsole of TBMANLIB_ConsoleCore (see the notes of its landing page), so the
' cases that draw run this copy of the code, which is the code of the package below the line of dashes.
' The package's own classes are reached as TBMANLIB_ConsoleComponents.<name>.
' ----------------------------------------------------------------------------
' =====================================================
' cVBar.twin - Vertical Bar Chart Component
' Modern Console Library for TwinBASIC - Components
' =====================================================

[COMCreatable(False)]
Public Class cVBar

    ' Bar character style enum
    Public Enum BarCharStyle
        Block = 0      ' █ full block
        Light = 1      ' ░ light shade
        Medium = 2     ' ▒ medium shade
        Dark = 3       ' ▓ dark shade
        Custom = 4     ' custom character
    End Enum

    Private m_Console As cConsole
    Private m_Buffer As cConsoleBuffer

    ' Constructor
    Public Sub New(ByVal console As cConsole)
        Set m_Console = console
        Set m_Buffer = console.Buffer
    End Sub

    ' Draw a single vertical bar
    Public Sub Render(ByVal col As Long, ByVal row As Long, _
                     ByVal height As Long, ByVal percent As Double, _
                     Optional ByVal fore As ConsoleColor = ConsoleColor.Green, _
                     Optional ByVal back As ConsoleColor = ConsoleColor.Black, _
                     Optional ByVal charStyle As BarCharStyle = BarCharStyle.Block)
        If percent < 0 Then percent = 0
        If percent > 100 Then percent = 100

        Dim filledHeight As Long = CLng((percent / 100) * height)
        If filledHeight = 0 AndAlso percent > 0 Then filledHeight = 1

        Dim i As Long
        Dim ch As String

        Select Case charStyle
            Case BarCharStyle.Block
                ch = "█"
            Case BarCharStyle.Light
                ch = "░"
            Case BarCharStyle.Medium
                ch = "▒"
            Case BarCharStyle.Dark
                ch = "▓"
            Case BarCharStyle.Custom
                ch = "█"
        End Select

        ' Draw filled portion from bottom
        For i = 1 To filledHeight
            m_Buffer.SetChar col, row + height - i, ch, fore, back
        Next i

        ' Draw empty portion
        For i = 0 To height - filledHeight - 1
            m_Buffer.SetChar col, row + i, " ", fore, back
        Next i
    End Sub

    ' Draw multiple vertical bars side by side
    Public Sub RenderBars(ByVal col As Long, ByVal row As Long, _
                          ByVal height As Long, ByRef values() As Double, _
                          Optional ByVal spacing As Long = 1, _
                          Optional ByVal minValue As Double = 0, _
                          Optional ByVal maxValue As Double = 100, _
                          Optional ByVal fore As ConsoleColor = ConsoleColor.Green, _
                          Optional ByVal back As ConsoleColor = ConsoleColor.Black, _
                          Optional ByVal charStyle As BarCharStyle = BarCharStyle.Block)
        Dim currentCol As Long = col
        Dim i As Long

        For i = LBound(values) To UBound(values)
            ' Normalize value to 0-100 percent
            Dim percent As Double = 100 * (values(i) - minValue) / (maxValue - minValue)
            If percent < 0 Then percent = 0
            If percent > 100 Then percent = 100

            Render currentCol, row, height, percent, fore, back, charStyle
            currentCol += 1 + spacing
        Next i
    End Sub

    ' Draw a vertical bar with label at bottom
    Public Sub RenderWithLabel(ByVal col As Long, ByVal row As Long, _
                               ByVal height As Long, ByVal percent As Double, _
                               ByVal label As String, _
                               Optional ByVal fore As ConsoleColor = ConsoleColor.Green, _
                               Optional ByVal back As ConsoleColor = ConsoleColor.Black, _
                               Optional ByVal charStyle As BarCharStyle = BarCharStyle.Block, _
                               Optional ByVal labelColor As ConsoleColor = ConsoleColor.Gray)
        ' Draw bar
        Render col, row, height, percent, fore, back, charStyle

        ' Draw label below bar
        Dim labelRow As Long = row + height + 1
        Dim labelWidth As Long = Len(label)
        Dim labelCol As Long = col - (labelWidth \ 2) + 1

        ' Ensure label doesn't go negative
        If labelCol < 0 Then labelCol = 0

        m_Buffer.WriteAt labelCol, labelRow, label, labelColor, back
    End Sub

    ' Draw multiple bars with gradient colors
    Public Sub RenderWithGradient(ByVal col As Long, ByVal row As Long, _
                                  ByVal height As Long, ByRef values() As Double, _
                                  Optional ByVal spacing As Long = 1, _
                                  Optional ByVal minValue As Double = 0, _
                                  Optional ByVal maxValue As Double = 100, _
                                  Optional ByVal lowColor As ConsoleColor = ConsoleColor.Green, _
                                  Optional ByVal midColor As ConsoleColor = ConsoleColor.Yellow, _
                                  Optional ByVal highColor As ConsoleColor = ConsoleColor.Red, _
                                  Optional ByVal back As ConsoleColor = ConsoleColor.Black, _
                                  Optional ByVal charStyle As BarCharStyle = BarCharStyle.Block)
        Dim currentCol As Long = col
        Dim i As Long

        For i = LBound(values) To UBound(values)
            ' Normalize value to 0-100 percent
            Dim percent As Double = 100 * (values(i) - minValue) / (maxValue - minValue)
            If percent < 0 Then percent = 0
            If percent > 100 Then percent = 100

            ' Get color based on value
            Dim barColor As ConsoleColor
            If percent < 50 Then
                barColor = lowColor
            ElseIf percent < 80 Then
                barColor = midColor
            Else
                barColor = highColor
            End If

            Render currentCol, row, height, percent, barColor, back, charStyle
            currentCol += 1 + spacing
        Next i
    End Sub

    ' Draw a history bar chart (CPU/Memory usage style)
    Public Sub RenderHistory(ByVal col As Long, ByVal row As Long, _
                             ByVal height As Long, ByRef history() As Double, _
                             Optional ByVal minValue As Double = 0, _
                             Optional ByVal maxValue As Double = 100, _
                             Optional ByVal fore As ConsoleColor = ConsoleColor.Green, _
                             Optional ByVal back As ConsoleColor = ConsoleColor.Black, _
                             Optional ByVal charStyle As BarCharStyle = BarCharStyle.Block)
        ' Draw from right to left (most recent on the right)
        Dim maxBars As Long = UBound(history) - LBound(history) + 1
        Dim barCount As Long
        If maxBars <= 0 Then Exit Sub

        Dim currentCol As Long = col
        Dim i As Long

        ' Draw most recent bars first (from right to left)
        For i = maxBars - 1 To 0 Step -1
            Dim percent As Double = 100 * (history(i) - minValue) / (maxValue - minValue)
            If percent < 0 Then percent = 0
            If percent > 100 Then percent = 100

            Render currentCol, row, height, percent, fore, back, charStyle
            currentCol -= 1

            If currentCol < col - maxBars Then Exit For
        Next i
    End Sub

End Class
