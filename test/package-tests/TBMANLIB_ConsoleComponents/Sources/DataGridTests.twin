    [TestCase]
    Public Sub Render_WithoutRows_DrawsNothing()
        Expect.Begin
        Dim con As cConsole = Screen.Open()
        Dim grid As cDataGrid = New cDataGrid(con)
        Dim widths(0 To 0) As Long
        Dim aligns(0 To 0) As ColumnAlignment
        Dim colors(0 To 1) As ConsoleColor
        widths(0) = 6
        grid.SetColumnWidths widths
        grid.SetColumnAlignments aligns
        grid.SetRowColors colors
        On Error Resume Next
        grid.Render 0, 0
        Expect.AreEqual 0, Err.Number, "Err.Number of Render when SetRows was never called"
        On Error GoTo 0
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SetRowColors_FirstDataRowTakesTheFirstColour()
        Expect.Begin
        Dim con As cConsole = Screen.Open()
        Dim grid As cDataGrid = New cDataGrid(con)
        Dim rows(0 To 2) As String
        Dim widths(0 To 0) As Long
        Dim aligns(0 To 0) As ColumnAlignment
        Dim colors(0 To 1) As ConsoleColor
        rows(0) = "head": rows(1) = "first": rows(2) = "second"
        widths(0) = 6
        colors(0) = ConsoleColor.Red: colors(1) = ConsoleColor.Green
        grid.SetRows rows
        grid.SetColumnWidths widths
        grid.SetColumnAlignments aligns
        grid.SetRowColors colors
        grid.Render 0, 0
        Expect.AreEqual CLng(ConsoleColor.Red), Cells.Fore(con.Buffer, 0, 2), "colour of the first data row, given colors(0) = Red"
        Expect.AreEqual CLng(ConsoleColor.Green), Cells.Fore(con.Buffer, 0, 3), "colour of the second data row, given colors(1) = Green"
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    [TestCase]
    Public Sub SetRowColors_HeaderRowIsCounted_SoColorsOfZeroIsNotUsed()
        Expect.Begin
        Dim con As cConsole = Screen.Open()
        Dim grid As cDataGrid = SampleGrid(con)
        grid.Render 0, 0
        Expect.AreEqual CLng(ConsoleColor.Cyan), Cells.Fore(con.Buffer, 0, 0), "colour of the header, colors(0) being Gray"
        Expect.AreEqual CLng(ConsoleColor.Green), Cells.Fore(con.Buffer, 0, 2), "colour of the first data row, colors(1) being Green"
        Expect.AreEqual CLng(ConsoleColor.Yellow), Cells.Fore(con.Buffer, 0, 3), "colour of the second data row, colors(2) being Yellow"
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    ' ---- the selection

    [TestCase]
    Public Sub SelectedRow_DefaultIsNoRow()
        Expect.Begin
        Dim con As cConsole = Screen.Open()
        Dim grid As cDataGrid = SampleGrid(con)
        grid.Render 0, 0
        Expect.AreEqual -1, RowWithBackground(con.Buffer, 0, 4, CLng(ConsoleColor.DarkBlue)), "the row with the selection colour of a new grid"
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MoveDown_FromNoSelection_SelectsTheFirstDataRow_AndStopsAtTheLast()
        Expect.Begin
        Dim con As cConsole = Screen.Open()
        Dim grid As cDataGrid = SampleGrid(con)
        grid.MoveDown 2
        grid.Render 0, 0
        Expect.AreEqual 2, RowWithBackground(con.Buffer, 0, 4, CLng(ConsoleColor.DarkBlue)), "the selected row after one MoveDown"
        grid.MoveDown 2
        grid.Render 0, 0
        Expect.AreEqual 3, RowWithBackground(con.Buffer, 0, 4, CLng(ConsoleColor.DarkBlue)), "the selected row after two MoveDown"
        grid.MoveDown 2
        grid.MoveDown 2
        grid.Render 0, 0
        Expect.AreEqual 3, RowWithBackground(con.Buffer, 0, 4, CLng(ConsoleColor.DarkBlue)), "the selected row after four MoveDown with maxRow 2"
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    [TestCase]
    Public Sub MoveUp_StopsAtTheFirstDataRow_AndDoesNothingWithoutASelection()
        Expect.Begin
        Dim con As cConsole = Screen.Open()
        Dim grid As cDataGrid = SampleGrid(con)
        grid.MoveUp
        grid.Render 0, 0
        Expect.AreEqual -1, RowWithBackground(con.Buffer, 0, 4, CLng(ConsoleColor.DarkBlue)), "the selected row after MoveUp with no selection"
        grid.SelectedRow = 1
        grid.MoveUp
        grid.Render 0, 0
        Expect.AreEqual 2, RowWithBackground(con.Buffer, 0, 4, CLng(ConsoleColor.DarkBlue)), "the selected row after MoveUp from the second data row"
        grid.MoveUp
        grid.Render 0, 0
        Expect.AreEqual 2, RowWithBackground(con.Buffer, 0, 4, CLng(ConsoleColor.DarkBlue)), "the selected row after MoveUp from the first data row"
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ScrollTo_SelectsTheRowLikeSelectedRow()
        Expect.Begin
        Dim con As cConsole = Screen.Open()
        Dim grid As cDataGrid = SampleGrid(con)
        grid.ScrollTo 1
        grid.Render 0, 0
        Expect.AreEqual 3, RowWithBackground(con.Buffer, 0, 4, CLng(ConsoleColor.DarkBlue)), "the selected row after ScrollTo 1"
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ScrollTo_ShowsTheRowInABufferTooSmallForTheTable()
        Expect.Begin
        Dim con As cConsole = Screen.Open(40, 6)
        Dim grid As cDataGrid = New cDataGrid(con)
        Dim rows(0 To 10) As String
        Dim widths(0 To 0) As Long
        Dim aligns(0 To 0) As ColumnAlignment
        Dim colors(0 To 10) As ConsoleColor
        Dim i As Long
        rows(0) = "head"
        For i = 1 To 10
            rows(i) = "row" & i
        Next
        widths(0) = 6
        grid.SetRows rows
        grid.SetColumnWidths widths
        grid.SetColumnAlignments aligns
        grid.SetRowColors colors
        grid.ScrollTo 8
        grid.Render 0, 0
        Dim found As Boolean
        For i = 0 To 5
            If Cells.Text(con.Buffer, i, 0, 4) = "row9" Then found = True
        Next
        Expect.IsTrue found, "the row row9 (data row 8) is in the buffer of 6 rows after ScrollTo 8"
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    ' ---- GetRowCount

    [TestCase]
    Public Sub GetRowCount_IsTheNumberOfDataRows()
        Expect.Begin
        Dim con As cConsole = Screen.Open()
        Dim grid As cDataGrid = SampleGrid(con)
        Expect.AreEqual 2, grid.GetRowCount(), "GetRowCount with a header"
        grid.ShowHeader = False
        Expect.AreEqual 3, grid.GetRowCount(), "GetRowCount without a header"
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    [TestCase]
    Public Sub GetRowCount_RowsNeverSet_RaisesError9()
        Expect.Begin
        Dim con As cConsole = Screen.Open()
        Dim grid As cDataGrid = New cDataGrid(con)
        On Error Resume Next
        Dim n As Long = grid.GetRowCount()
        Expect.AreEqual 9, Err.Number, "Err.Number of GetRowCount before SetRows"
        On Error GoTo 0
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    ' ---- the buffer

    [TestCase]
    Public Sub Render_RowsBelowTheBuffer_AreDropped()
        Expect.Begin
        Dim con As cConsole = Screen.Open(40, 3)
        Dim grid As cDataGrid = SampleGrid(con)
        On Error Resume Next
        grid.Render 0, 0
        Expect.AreEqual 0, Err.Number, "Err.Number of Render of a table of 4 rows in a buffer of 3 rows"
        On Error GoTo 0
        Expect.AreEqual "readme.txt", Cells.Text(con.Buffer, 2, 0, 10), "the last row that fits"
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Render_GridMadeBeforeFullScreenMode_RaisesError91()
        Expect.Begin
        Dim con As cConsole = Screen.Open(100, 30, False)
        Dim grid As cDataGrid = SampleGrid(con)
        con.EnterFullScreenMode
        On Error Resume Next
        grid.Render 0, 0
        Expect.AreEqual 91, Err.Number, "Err.Number of Render of a grid made before EnterFullScreenMode"
        On Error GoTo 0
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Render_ThenRefresh_ShowsTheTableOnTheScreenBuffer()
        Expect.Begin
        Dim con As cConsole = Screen.Open()
        Dim grid As cDataGrid = SampleGrid(con)
        grid.SelectedRow = 1
        grid.Render 2, 1
        con.Refresh
        Expect.AreEqual "Name        " & Bar() & "    Size", Rig.TextAt(Rig.OutHandle, 2, 1, 21), "screen text of the header"
        Expect.AreEqual "setup.exe   " & Bar() & "  88,512", Rig.TextAt(Rig.OutHandle, 2, 4, 21), "screen text of the selected row"
        Expect.AreEqual &H1F&, Rig.AttrAt(Rig.OutHandle, 2, 4), "screen attribute of the selected row (white on dark blue)"
        Set grid = Nothing
        Set con = Nothing
        Screen.Close
        Expect.Done
    End Sub

End Module
