        ' Variable-length in C: its size is not compared.
        Expect.AreEqual 0, Off(b, VarPtr(t.Name(0))), "offset of IMAGE_ARCHIVE_MEMBER_HEADER.Name"
        Expect.AreEqual 16, Off(b, VarPtr(t.Date(0))), "offset of IMAGE_ARCHIVE_MEMBER_HEADER.Date"
        Expect.AreEqual 28, Off(b, VarPtr(t.UserID(0))), "offset of IMAGE_ARCHIVE_MEMBER_HEADER.UserID"
        Expect.AreEqual 34, Off(b, VarPtr(t.GroupID(0))), "offset of IMAGE_ARCHIVE_MEMBER_HEADER.GroupID"
        Expect.AreEqual 40, Off(b, VarPtr(t.Mode(0))), "offset of IMAGE_ARCHIVE_MEMBER_HEADER.Mode"
        Expect.AreEqual 48, Off(b, VarPtr(t.Size(0))), "offset of IMAGE_ARCHIVE_MEMBER_HEADER.Size"
        Expect.AreEqual 58, Off(b, VarPtr(t.EndHeader(0))), "offset of IMAGE_ARCHIVE_MEMBER_HEADER.EndHeader"
        Expect.Done
    End Sub

