[TestFixture]
Module ImageLayoutTests

    ' Each structure's size and its fields' offsets, against the WDK's headers (10.0.22621.0).
    ' Generated by wdk/wdkcheck.mjs modImage: do not edit, run it again.

    Private Function Off(ByVal base As LongPtr, ByVal field As LongPtr) As Long
        Off = CLng(field - base)
    End Function

    [TestCase]
    Public Sub ANON_OBJECT_HEADER_Layout()
        Expect.Begin
        Dim t As ANON_OBJECT_HEADER
        Dim b As LongPtr = VarPtr(t)
        Expect.AreEqual 32, LenB(t), "LenB of ANON_OBJECT_HEADER"
        Expect.AreEqual 0, Off(b, VarPtr(t.Sig1)), "offset of ANON_OBJECT_HEADER.Sig1"
        Expect.AreEqual 2, Off(b, VarPtr(t.Sig2)), "offset of ANON_OBJECT_HEADER.Sig2"
        Expect.AreEqual 4, Off(b, VarPtr(t.Version)), "offset of ANON_OBJECT_HEADER.Version"
        Expect.AreEqual 6, Off(b, VarPtr(t.Machine)), "offset of ANON_OBJECT_HEADER.Machine"
        Expect.AreEqual 8, Off(b, VarPtr(t.TimeDateStamp)), "offset of ANON_OBJECT_HEADER.TimeDateStamp"
        Expect.AreEqual 12, Off(b, VarPtr(t.ClassID)), "offset of ANON_OBJECT_HEADER.ClassID"
        Expect.AreEqual 28, Off(b, VarPtr(t.SizeOfData)), "offset of ANON_OBJECT_HEADER.SizeOfData"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ANON_OBJECT_HEADER_BIGOBJ_Layout()
        Expect.Begin
        Dim t As ANON_OBJECT_HEADER_BIGOBJ
        Dim b As LongPtr = VarPtr(t)
        Expect.AreEqual 56, LenB(t), "LenB of ANON_OBJECT_HEADER_BIGOBJ"
        Expect.AreEqual 0, Off(b, VarPtr(t.Sig1)), "offset of ANON_OBJECT_HEADER_BIGOBJ.Sig1"
        Expect.AreEqual 2, Off(b, VarPtr(t.Sig2)), "offset of ANON_OBJECT_HEADER_BIGOBJ.Sig2"
        Expect.AreEqual 4, Off(b, VarPtr(t.Version)), "offset of ANON_OBJECT_HEADER_BIGOBJ.Version"
        Expect.AreEqual 6, Off(b, VarPtr(t.Machine)), "offset of ANON_OBJECT_HEADER_BIGOBJ.Machine"
        Expect.AreEqual 8, Off(b, VarPtr(t.TimeDateStamp)), "offset of ANON_OBJECT_HEADER_BIGOBJ.TimeDateStamp"
        Expect.AreEqual 12, Off(b, VarPtr(t.ClassID)), "offset of ANON_OBJECT_HEADER_BIGOBJ.ClassID"
        Expect.AreEqual 28, Off(b, VarPtr(t.SizeOfData)), "offset of ANON_OBJECT_HEADER_BIGOBJ.SizeOfData"
        Expect.AreEqual 32, Off(b, VarPtr(t.Flags)), "offset of ANON_OBJECT_HEADER_BIGOBJ.Flags"
        Expect.AreEqual 36, Off(b, VarPtr(t.MetaDataSize)), "offset of ANON_OBJECT_HEADER_BIGOBJ.MetaDataSize"
        Expect.AreEqual 40, Off(b, VarPtr(t.MetaDataOffset)), "offset of ANON_OBJECT_HEADER_BIGOBJ.MetaDataOffset"
        Expect.AreEqual 44, Off(b, VarPtr(t.NumberOfSections)), "offset of ANON_OBJECT_HEADER_BIGOBJ.NumberOfSections"
        Expect.AreEqual 48, Off(b, VarPtr(t.PointerToSymbolTable)), "offset of ANON_OBJECT_HEADER_BIGOBJ.PointerToSymbolTable"
        Expect.AreEqual 52, Off(b, VarPtr(t.NumberOfSymbols)), "offset of ANON_OBJECT_HEADER_BIGOBJ.NumberOfSymbols"
        Expect.Done
    End Sub

