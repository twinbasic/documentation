    [TestCase]
    Public Sub IMAGE_DYNAMIC_RELOCATION_Layout()
        Expect.Begin
        Dim t As IMAGE_DYNAMIC_RELOCATION
        Dim b As LongPtr = VarPtr(t)
        #If Win64 Then
            Expect.AreEqual 12, LenB(t), "LenB of IMAGE_DYNAMIC_RELOCATION"
        #Else
            Expect.AreEqual 8, LenB(t), "LenB of IMAGE_DYNAMIC_RELOCATION"
        #End If
        Expect.AreEqual 0, Off(b, VarPtr(t.Symbol)), "offset of IMAGE_DYNAMIC_RELOCATION.Symbol"
        #If Win64 Then
            Expect.AreEqual 8, Off(b, VarPtr(t.BaseRelocSize)), "offset of IMAGE_DYNAMIC_RELOCATION.BaseRelocSize"
        #Else
            Expect.AreEqual 4, Off(b, VarPtr(t.BaseRelocSize)), "offset of IMAGE_DYNAMIC_RELOCATION.BaseRelocSize"
        #End If
        Expect.Done
    End Sub

