[TestFixture]
Module WDMFieldTests

    ' modWDM's fields that the generated WDMLayoutTests cannot check from offsets alone, each
    ' checked as the WDK declares it. The sizes are the WDK's (10.0.28000.0), from its headers
    ' compiled for x86 and for x64.

    ' wdm.h declares Parameters a POB_PRE_OPERATION_PARAMETERS, a pointer to the union of
    ' OB_PRE_CREATE_HANDLE_INFORMATION and OB_PRE_DUPLICATE_HANDLE_INFORMATION, and the structure's
    ' last field. The callback reads the union through it.
    [TestCase]
    Public Sub OB_PRE_OPERATION_INFORMATION_ParametersIsAPointer()
        Expect.Begin
        Dim t As OB_PRE_OPERATION_INFORMATION
        Dim n As Long = LenB(t.Parameters)
        Expect.AreEqual CLng(LenB(Of LongPtr)), n, "size of OB_PRE_OPERATION_INFORMATION.Parameters (a POB_PRE_OPERATION_PARAMETERS in wdm.h)"
        #If Win64 Then
            Expect.AreEqual 40, LenB(t), "LenB of OB_PRE_OPERATION_INFORMATION"
        #Else
            Expect.AreEqual 24, LenB(t), "LenB of OB_PRE_OPERATION_INFORMATION"
        #End If
        Expect.Done
    End Sub

End Module
