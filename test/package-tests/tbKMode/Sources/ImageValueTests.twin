    [TestCase]
    Public Sub Constants_Values()
        Expect.Begin
        Expect.AreEqual "`" & Chr$(&HA), IMAGE_ARCHIVE_END, "IMAGE_ARCHIVE_END"
        Expect.AreEqual "/<HYBRIDMAP>/   ", IMAGE_ARCHIVE_HYBRIDMAP_MEMBER, "IMAGE_ARCHIVE_HYBRIDMAP_MEMBER"
        Expect.AreEqual "/               ", IMAGE_ARCHIVE_LINKER_MEMBER, "IMAGE_ARCHIVE_LINKER_MEMBER"
        Expect.AreEqual "//              ", IMAGE_ARCHIVE_LONGNAMES_MEMBER, "IMAGE_ARCHIVE_LONGNAMES_MEMBER"
        Expect.AreEqual Chr$(&HA), IMAGE_ARCHIVE_PAD, "IMAGE_ARCHIVE_PAD"
        Expect.AreEqual "!<arch>" & Chr$(&HA), IMAGE_ARCHIVE_START, "IMAGE_ARCHIVE_START"
        Expect.AreEqual 8, CLng(IMAGE_ARCHIVE_START_SIZE), "IMAGE_ARCHIVE_START_SIZE"
        Expect.AreEqual 23117, CLng(IMAGE_DOS_SIGNATURE), "IMAGE_DOS_SIGNATURE"
        Expect.AreEqual 17744, CLng(IMAGE_NT_SIGNATURE), "IMAGE_NT_SIGNATURE"
        Expect.AreEqual 16, CLng(IMAGE_NUMBEROF_DIRECTORY_ENTRIES), "IMAGE_NUMBEROF_DIRECTORY_ENTRIES"
        #If Win64 Then
            Expect.AreEqual &H8000000000000000^, CLngLng(IMAGE_ORDINAL_FLAG), "IMAGE_ORDINAL_FLAG"
        #Else
            Expect.AreEqual &HFFFFFFFF80000000^, CLngLng(IMAGE_ORDINAL_FLAG), "IMAGE_ORDINAL_FLAG"
        #End If
        Expect.AreEqual &H80000000&, CLng(IMAGE_ORDINAL_FLAG32), "IMAGE_ORDINAL_FLAG32"
        Expect.AreEqual &H8000000000000000^, CLngLng(IMAGE_ORDINAL_FLAG64), "IMAGE_ORDINAL_FLAG64"
        Expect.AreEqual 17742, CLng(IMAGE_OS2_SIGNATURE), "IMAGE_OS2_SIGNATURE"
        Expect.AreEqual 17740, CLng(IMAGE_OS2_SIGNATURE_LE), "IMAGE_OS2_SIGNATURE_LE"
        Expect.AreEqual 1, CLng(IMAGE_POLICY_METADATA_VERSION), "IMAGE_POLICY_METADATA_VERSION"
        Expect.AreEqual ".tPolicy", IMAGE_POLICY_SECTION_NAME, "IMAGE_POLICY_SECTION_NAME"
        Expect.AreEqual &H80000000&, CLng(IMAGE_RESOURCE_DATA_IS_DIRECTORY), "IMAGE_RESOURCE_DATA_IS_DIRECTORY"
        Expect.AreEqual &H80000000&, CLng(IMAGE_RESOURCE_NAME_IS_STRING), "IMAGE_RESOURCE_NAME_IS_STRING"
        Expect.AreEqual 1, CLng(IMAGE_SCN_SCALE_INDEX), "IMAGE_SCN_SCALE_INDEX"
        Expect.AreEqual 60, CLng(IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR), "IMAGE_SIZEOF_ARCHIVE_MEMBER_HDR"
        Expect.AreEqual 20, CLng(IMAGE_SIZEOF_FILE_HEADER), "IMAGE_SIZEOF_FILE_HEADER"
        Expect.AreEqual 40, CLng(IMAGE_SIZEOF_SECTION_HEADER), "IMAGE_SIZEOF_SECTION_HEADER"
        Expect.AreEqual 8, CLng(IMAGE_SIZEOF_SHORT_NAME), "IMAGE_SIZEOF_SHORT_NAME"
        Expect.AreEqual 18, CLng(IMAGE_SIZEOF_SYMBOL), "IMAGE_SIZEOF_SYMBOL"
        Expect.AreEqual 17740, CLng(IMAGE_VXD_SIGNATURE), "IMAGE_VXD_SIGNATURE"
        Expect.AreEqual 15, CLng(N_BTMASK), "N_BTMASK"
        Expect.AreEqual 4, CLng(N_BTSHFT), "N_BTSHFT"
        Expect.AreEqual 48, CLng(N_TMASK), "N_TMASK"
        Expect.AreEqual 192, CLng(N_TMASK1), "N_TMASK1"
        Expect.AreEqual 240, CLng(N_TMASK2), "N_TMASK2"
        Expect.AreEqual 2, CLng(N_TSHIFT), "N_TSHIFT"
        Expect.AreEqual 16, CLng(SIZEOF_RFPO_DATA), "SIZEOF_RFPO_DATA"
        Expect.AreEqual 12, CLng(UNWIND_HISTORY_TABLE_SIZE), "UNWIND_HISTORY_TABLE_SIZE"
        Expect.Done
    End Sub

