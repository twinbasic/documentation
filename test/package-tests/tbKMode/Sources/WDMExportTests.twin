[TestFixture]
Module WDMExportTests

    ' modWDM's Declares against the export table of the x64 kernel, %SystemRoot%\System32\ntoskrnl.exe
    ' (Sysnative from a 32-bit process). The file is mapped as an image resource, which runs none of
    ' its code and resolves none of its imports, and its export names are read from its headers. A
    ' driver whose import names a routine the kernel does not export does not load.

    Private Declare PtrSafe Function LoadLibraryExW Lib "kernel32" (ByVal lpLibFileName As LongPtr, ByVal hFile As LongPtr, ByVal dwFlags As Long) As LongPtr
    Private Declare PtrSafe Function FreeLibrary Lib "kernel32" (ByVal hLibModule As LongPtr) As Long
    Private Declare PtrSafe Function lstrlenA Lib "kernel32" (ByVal lpString As LongPtr) As Long
    Private Declare PtrSafe Sub GetMem Lib "kernel32" Alias "RtlMoveMemory" (Destination As Any, ByVal Source As LongPtr, ByVal Length As LongPtr)

    Private Const LOAD_LIBRARY_AS_DATAFILE As Long = &H2
    Private Const LOAD_LIBRARY_AS_IMAGE_RESOURCE As Long = &H20

    ' The entry point of each Declare that a 64-bit build of the package compiles: its Alias, or its
    ' name. (InterlockedIncrement is a Sub of the package there; ZwCreateUserProcess's Alias, "#2",
    ' is an ordinal, checked by ZwCreateUserProcess_IsTheKernelsUnnamedOrdinal2.)
    Private Function EntryPoints() As String
        Dim s As String
        s = "CmCallbackGetKeyObjectID CmCallbackGetKeyObjectIDEx CmCallbackReleaseKeyObjectIDEx CmGetBoundTransaction CmGetCallbackVersion CmRegisterCallback CmRegisterCallbackEx CmSetCallbackObjectContext "
        s &= "CmUnRegisterCallback DbgPrint DbgPrintEx EtwActivityIdControl EtwEventEnabled EtwProviderEnabled EtwRegister EtwSetInformation "
        s &= "EtwUnregister EtwWrite EtwWriteEx EtwWriteString EtwWriteTransfer ExAcquireFastMutex ExAcquireResourceExclusiveLite ExAcquireResourceSharedLite "
        s &= "ExAcquireSharedStarveExclusive ExAcquireSharedWaitForExclusive ExAllocatePool2 ExAllocatePool3 ExAllocatePoolWithTag ExAllocatePoolWithTagPriority ExDeleteNPagedLookasideList ExDeleteResourceLite "
        s &= "ExEnterCriticalRegionAndAcquireResourceExclusive ExEnterCriticalRegionAndAcquireResourceShared ExEnterCriticalRegionAndAcquireSharedWaitForExclusive ExFreePool2 ExFreePoolWithTag ExGetPreviousMode ExInitializeNPagedLookasideList ExInitializeResourceLite "
        s &= "ExInterlockedAddLargeInteger ExInterlockedAddUlong ExIsResourceAcquiredExclusiveLite ExIsResourceAcquiredSharedLite ExRaiseHardError ExRaiseStatus ExReinitializeResourceLite ExReleaseFastMutex "
        s &= "ExReleaseResourceAndLeaveCriticalRegion ExReleaseResourceForThreadLite ExReleaseResourceLite ExSetResourceOwnerPointer ExTryToAcquireFastMutex ExpInterlockedPopEntrySList FsRtlGetFileNameInformation FsRtlGetFileSize "
        s &= "FsRtlIsNameInExpression FsRtlIsNameInUnUpcasedExpression FsRtlIsPagingFile FsRtlIsSystemPagingFile IoAcquireRemoveLockEx IoAllocateDriverObjectExtension IoAttachDeviceToDeviceStack IoAttachDeviceToDeviceStackSafe "
        s &= "IoCompleteRequest IoCreateDevice IoCreateSymbolicLink IoDeleteDevice IoDeleteSymbolicLink IoDetachDevice IoGetCurrentProcess IoGetDriverObjectExtension "
        s &= "IoGetRequestorProcess IoGetTopLevelIrp IoInitializeRemoveLockEx IoReleaseRemoveLockAndWaitEx IoReleaseRemoveLockEx IoSetDeviceInterfaceState IoThreadToProcess IofCallDriver "
        s &= "KeAcquireSpinLockRaiseToDpc KeAttachProcess KeDelayExecutionThread KeDetachProcess KeGetCurrentIrql KeGetCurrentThread KeInitializeEvent KeInitializeSpinLock "
        s &= "KeLowerIrql KeQuerySystemTimePrecise KeRaiseIrqlToDpcLevel KeReleaseSpinLock KeSetEvent KeSetPriorityThread KeStackAttachProcess KeUnstackDetachProcess "
        s &= "KeWaitForSingleObject KfRaiseIrql MmCopyMemory MmGetSystemRoutineAddress MmIsAddressValid MmMapLockedPagesSpecifyCache ObCloseHandle ObDereferenceObjectDeferDelete "
        s &= "ObDereferenceObjectDeferDeleteWithTag ObGetFilterVersion ObGetObjectSecurity ObIsKernelHandle ObMakeTemporaryObject ObOpenObjectByPointer ObQueryNameString ObReferenceObjectByHandle "
        s &= "ObReferenceObjectByHandleWithTag ObReferenceObjectByPointer ObReferenceObjectByPointerWithTag ObReferenceObjectSafe ObReferenceObjectSafeWithTag ObRegisterCallbacks ObReleaseObjectSecurity ObUnRegisterCallbacks "
        s &= "ObfDereferenceObject ObfDereferenceObjectWithTag ObfReferenceObject ObfReferenceObjectWithTag PoCallDriver PoStartNextPowerIrp ProbeForRead ProbeForWrite "
        s &= "PsGetCurrentProcessId PsGetCurrentThreadId PsGetProcessId PsGetThreadProcessId PsLookupProcessByProcessId PsLookupThreadByThreadId PsRemoveCreateThreadNotifyRoutine PsRemoveLoadImageNotifyRoutine "
        s &= "PsSetCreateProcessNotifyRoutine PsSetCreateProcessNotifyRoutineEx PsSetCreateThreadNotifyRoutine PsSetCreateThreadNotifyRoutineEx PsSetLoadImageNotifyRoutine RtlAllocateHeap RtlAppendUnicodeStringToString RtlAppendUnicodeToString "
        s &= "RtlAreBitsClear RtlAreBitsSet RtlClearAllBits RtlClearAllBitsEx RtlClearBit RtlClearBitEx RtlClearBits RtlCompareMemory "
        s &= "RtlCompareUnicodeString RtlCompareUnicodeStrings RtlCopyBitMap RtlCopyUnicodeString RtlCreateHeap RtlCreateSecurityDescriptor RtlDeriveCapabilitySidsFromName RtlDestroyHeap "
        s &= "RtlDuplicateUnicodeString RtlEqualUnicodeString RtlExtractBitMap RtlFindClearBits RtlFindClearBitsAndSet RtlFindClearRuns RtlFindExportedRoutineByName RtlFindFirstRunClear "
        s &= "RtlFindLastBackwardRunClear RtlFindLeastSignificantBit RtlFindLongestRunClear RtlFindMostSignificantBit RtlFindNextForwardRunClear RtlFindSetBits RtlFindSetBitsAndClear RtlFindSetBitsAndClearEx "
        s &= "RtlFindSetBitsEx RtlFreeHeap RtlFreeUnicodeString RtlGUIDFromString RtlGetControlSecurityDescriptor RtlGetDaclSecurityDescriptor RtlGetSaclSecurityDescriptor "
        s &= "RtlGetVersion RtlImageDirectoryEntryToData RtlImageNtHeader RtlInitUnicodeString RtlInitializeBitMap RtlInitializeBitMapEx RtlInitializeSid RtlInitializeSidEx "
        s &= "RtlInterlockedClearBitRun RtlInterlockedSetBitRun RtlIsElevatedRid RtlIsNameLegalDOS8Dot3 RtlLengthSecurityDescriptor RtlLocalTimeToSystemTime RtlMoveMemory RtlNtStatusToDosError "
        s &= "RtlNumberOfClearBits RtlNumberOfClearBitsInRange RtlNumberOfSetBits RtlNumberOfSetBitsInRange RtlNumberOfSetBitsUlongPtr RtlQueryRegistryValues RtlSetAllBits RtlSetBit "
        s &= "RtlSetBitEx RtlSetBits RtlSetControlSecurityDescriptor RtlSetDaclSecurityDescriptor RtlSetSaclSecurityDescriptor RtlSidHashInitialize RtlSidHashLookup RtlTestBit "
        s &= "RtlTestBitEx RtlUpcaseUnicodeString RtlValidRelativeSecurityDescriptor RtlValidSecurityDescriptor RtlValidSid RtlZeroMemory SeAccessCheck SeAssignSecurity "
        s &= "SeAssignSecurityEx SeComputeAutoInheritByObjectType SeEtwWriteKMCveEvent SeLocateProcessImageName SeLockSubjectContext SeQueryInformationToken SeUnlockSubjectContext ZwClose "
        s &= "ZwCommitRegistryTransaction ZwCreateDirectoryObject ZwCreateFile ZwCreateKey ZwCreateKeyTransacted ZwCreateRegistryTransaction ZwCreateSection ZwDeleteFile "
        s &= "ZwDeleteKey ZwDeleteValueKey ZwDuplicateObject ZwEnumerateKey ZwEnumerateValueKey ZwFlushKey ZwFsControlFile ZwLoadKey "
        s &= "ZwLoadKeyEx ZwLockFile ZwLockProductActivationKeys ZwMapViewOfSection ZwNotifyChangeKey ZwOpenDirectoryObject ZwOpenKey ZwOpenKeyEx "
        s &= "ZwOpenKeyTransacted ZwOpenKeyTransactedEx ZwOpenProcess ZwOpenRegistryTransaction ZwOpenSection ZwOpenSymbolicLinkObject ZwQueryDirectoryFile ZwQueryDirectoryFileEx "
        s &= "ZwQueryDirectoryObject ZwQueryKey ZwQuerySymbolicLinkObject ZwQueryValueKey ZwReadFile ZwRenameKey ZwReplaceKey ZwRestoreKey "
        s &= "ZwRollbackRegistryTransaction ZwSaveKey ZwSaveKeyEx ZwSetInformationKey ZwSetValueKey ZwUnloadKey ZwUnloadKey2 ZwUnloadKeyEx "
        s &= "ZwUnlockFile ZwUnmapViewOfSection ZwWriteFile _wcslwr _wcsrev _wcsupr towlower towupper "
        s &= "wcscat wcscat_s wcschr wcscmp wcscpy wcslen wcsnlen wcsstr"
        Return s
    End Function

    Private Function ReadLong(ByVal p As LongPtr) As Long
        GetMem ReadLong, p, 4
    End Function

    Private Function ReadInteger(ByVal p As LongPtr) As Integer
        GetMem ReadInteger, p, 2
    End Function

    Private Function ReadAnsi(ByVal p As LongPtr) As String
        Dim n As Long = lstrlenA(p)
        If n = 0 Then Return ""
        Dim b() As Byte
        ReDim b(n - 1)
        GetMem b(0), p, n
        Return StrConv(b, vbUnicode)
    End Function

    ' The export names of the x64 kernel, each between spaces; "" when the file cannot be read.
    Private Function KernelExports() As String
        Dim folder As String = Environ$("SystemRoot") & If(LenB(Of LongPtr) = 8, "\System32\", "\Sysnative\")
        Dim h As LongPtr = LoadLibraryExW(StrPtr(folder & "ntoskrnl.exe"), 0, LOAD_LIBRARY_AS_DATAFILE Or LOAD_LIBRARY_AS_IMAGE_RESOURCE)
        If h = 0 Then Return ""
        Dim base As LongPtr = h And (Not CLngPtr(3))
        Dim nt As LongPtr = base + ReadLong(base + &H3C)
        Dim opt As LongPtr = nt + 24
        Dim result As String
        If ReadLong(nt) = &H4550 And ReadInteger(opt) = &H20B And ReadLong(opt + 112) <> 0 Then
            Dim dir As LongPtr = base + ReadLong(opt + 112)
            Dim count As Long = ReadLong(dir + 24)
            Dim names As LongPtr = base + ReadLong(dir + 32)
            Dim parts() As String
            ReDim parts(count - 1)
            For i As Long = 0 To count - 1
                parts(i) = ReadAnsi(base + ReadLong(names + 4 * i))
            Next
            result = " " & Join(parts, " ") & " "
        End If
        FreeLibrary h
        Return result
    End Function

    ' Every Declare names a routine that the x64 kernel exports.
    [TestCase]
    Public Sub Declares_NameExportsOfTheKernel()
        Expect.Begin
        Dim exports As String = KernelExports()
        Expect.IsTrue Len(exports) > 0, "the export table of the x64 ntoskrnl.exe is read"
        If Len(exports) = 0 Then Expect.Done: Exit Sub
        Dim e As Variant
        For Each e In Split(EntryPoints(), " ")
            Expect.IsTrue VBA.InStr(1, exports, " " & e & " ", vbBinaryCompare) > 0, "the x64 kernel exports " & e
        Next
        Expect.Done
    End Sub

    Private Function ReadByte(ByVal p As LongPtr) As Byte
        GetMem ReadByte, p, 1
    End Function

    ' The export directory of an x64 image mapped at base, or 0.
    Private Function ExportDirectoryOf(ByVal base As LongPtr) As LongPtr
        Dim nt As LongPtr = base + ReadLong(base + &H3C)
        Dim opt As LongPtr = nt + 24
        If ReadLong(nt) <> &H4550 Or ReadInteger(opt) <> &H20B Then Return 0
        If ReadLong(opt + 112) = 0 Then Return 0
        Return base + ReadLong(opt + 112)
    End Function

    ' The address of the routine an x64 image mapped at base exports under name, or 0.
    Private Function ExportByName(ByVal base As LongPtr, ByVal name As String) As LongPtr
        Dim dir As LongPtr = ExportDirectoryOf(base)
        If dir = 0 Then Return 0
        Dim names As LongPtr = base + ReadLong(dir + 32)
        Dim ords As LongPtr = base + ReadLong(dir + 36)
        For i As Long = 0 To ReadLong(dir + 24) - 1
            If ReadAnsi(base + ReadLong(names + 4 * i)) = name Then
                Dim index As Long = CLng(ReadInteger(ords + 2 * i)) And &HFFFF&
                Return base + ReadLong(base + ReadLong(dir + 28) + 4 * index)
            End If
        Next
        Return 0
    End Function

    ' The address of the routine an x64 image mapped at base exports as ordinal n, or 0; named is
    ' set when an export name refers to it.
    Private Function ExportByOrdinal(ByVal base As LongPtr, ByVal n As Long, ByRef named As Boolean) As LongPtr
        Dim dir As LongPtr = ExportDirectoryOf(base)
        If dir = 0 Then Return 0
        Dim index As Long = n - ReadLong(dir + 16)
        If index < 0 Or index >= ReadLong(dir + 20) Then Return 0
        Dim ords As LongPtr = base + ReadLong(dir + 36)
        For i As Long = 0 To ReadLong(dir + 24) - 1
            If (CLng(ReadInteger(ords + 2 * i)) And &HFFFF&) = index Then named = True
        Next
        Return base + ReadLong(base + ReadLong(dir + 28) + 4 * index)
    End Function

    ' The system service number a Zw routine of the x64 kernel loads before it jumps to the
    ' service dispatcher (mov eax, n; jmp), or -1.
    Private Function KernelServiceNumber(ByVal p As LongPtr) As Long
        If p = 0 Then Return -1
        For i As Long = 0 To 32
            If ReadByte(p + i) = &HB8 And ReadByte(p + i + 5) = &HE9 Then Return ReadLong(p + i + 1)
        Next
        Return -1
    End Function

    ' The system service number an Nt routine of the x64 ntdll.dll loads (mov r10, rcx; mov eax, n),
    ' or -1.
    Private Function NtdllServiceNumber(ByVal p As LongPtr) As Long
        If p = 0 Then Return -1
        If ReadLong(p) <> &HB8D18B4C Then Return -1
        Return ReadLong(p + 4)
    End Function

    ' The x64 kernel exports ZwCreateUserProcess with no name, as ordinal 2: the routine there loads
    ' the service number of ntdll's NtCreateUserProcess. A Declare that imports it by name names no
    ' export; Alias "#2" imports it by ordinal. ZwClose, exported by name, is the control for the
    ' reading of the two kinds of stub.
    [TestCase]
    Public Sub ZwCreateUserProcess_IsTheKernelsUnnamedOrdinal2()
        Expect.Begin
        Dim folder As String = Environ$("SystemRoot") & If(LenB(Of LongPtr) = 8, "\System32\", "\Sysnative\")
        Dim flags As Long = LOAD_LIBRARY_AS_DATAFILE Or LOAD_LIBRARY_AS_IMAGE_RESOURCE
        Dim hk As LongPtr = LoadLibraryExW(StrPtr(folder & "ntoskrnl.exe"), 0, flags)
        Dim hn As LongPtr = LoadLibraryExW(StrPtr(folder & "ntdll.dll"), 0, flags)
        Expect.IsTrue hk <> 0, "the x64 ntoskrnl.exe is mapped"
        Expect.IsTrue hn <> 0, "the x64 ntdll.dll is mapped"
        If hk <> 0 And hn <> 0 Then
            Dim k As LongPtr = hk And (Not CLngPtr(3))
            Dim n As LongPtr = hn And (Not CLngPtr(3))
            Dim control As Long = NtdllServiceNumber(ExportByName(n, "NtClose"))
            Expect.IsTrue control >= 0, "ntdll's NtClose is read as a system-service stub"
            Expect.AreEqual control, KernelServiceNumber(ExportByName(k, "ZwClose")), "the service number of the kernel's ZwClose, against ntdll's NtClose"
            Dim named As Boolean
            Dim p As LongPtr = ExportByOrdinal(k, 2, named)
            Expect.IsTrue p <> 0, "the kernel exports ordinal 2"
            Expect.IsFalse named, "ordinal 2 of the kernel has an export name"
            Expect.IsTrue ExportByName(k, "ZwCreateUserProcess") = 0, "the kernel exports no name ZwCreateUserProcess"
            Dim want As Long = NtdllServiceNumber(ExportByName(n, "NtCreateUserProcess"))
            Expect.IsTrue want >= 0, "ntdll's NtCreateUserProcess is read as a system-service stub"
            Expect.AreEqual want, KernelServiceNumber(p), "the service number of the kernel's ordinal 2, against ntdll's NtCreateUserProcess"
        End If
        If hk <> 0 Then FreeLibrary hk
        If hn <> 0 Then FreeLibrary hn
        Expect.Done
    End Sub

End Module
