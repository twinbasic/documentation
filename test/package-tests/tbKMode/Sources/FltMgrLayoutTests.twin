    [TestCase]
    Public Sub FLT_REGISTRATION_Layout()
        Expect.Begin
        Dim t As FLT_REGISTRATION
        Dim b As LongPtr = VarPtr(t)
        #If Win64 Then
            Expect.AreEqual 104, LenB(t), "LenB of FLT_REGISTRATION"
        #Else
            Expect.AreEqual 56, LenB(t), "LenB of FLT_REGISTRATION"
        #End If
        Expect.AreEqual 0, Off(b, VarPtr(t.Size)), "offset of FLT_REGISTRATION.Size"
        Expect.AreEqual 2, Off(b, VarPtr(t.Version)), "offset of FLT_REGISTRATION.Version"
        Expect.AreEqual 4, Off(b, VarPtr(t.Flags)), "offset of FLT_REGISTRATION.Flags"
        Expect.AreEqual 8, Off(b, VarPtr(t.ContextRegistration)), "offset of FLT_REGISTRATION.ContextRegistration"
