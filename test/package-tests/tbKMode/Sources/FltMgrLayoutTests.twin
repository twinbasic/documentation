    [TestCase]
    Public Sub FLT_IO_PARAMETER_BLOCK_Layout()
        Expect.Begin
        Dim t As FLT_IO_PARAMETER_BLOCK
        Dim b As LongPtr = VarPtr(t)
        ' Variable-length in C: its size is not compared.
        Expect.AreEqual 0, Off(b, VarPtr(t.IrpFlags)), "offset of FLT_IO_PARAMETER_BLOCK.IrpFlags"
        Expect.AreEqual 4, Off(b, VarPtr(t.MajorFunction)), "offset of FLT_IO_PARAMETER_BLOCK.MajorFunction"
        Expect.AreEqual 5, Off(b, VarPtr(t.MinorFunction)), "offset of FLT_IO_PARAMETER_BLOCK.MinorFunction"
        Expect.AreEqual 6, Off(b, VarPtr(t.OperationFlags)), "offset of FLT_IO_PARAMETER_BLOCK.OperationFlags"
        Expect.AreEqual 7, Off(b, VarPtr(t.Reserved)), "offset of FLT_IO_PARAMETER_BLOCK.Reserved"
        Expect.AreEqual 8, Off(b, VarPtr(t.TargetFileObject)), "offset of FLT_IO_PARAMETER_BLOCK.TargetFileObject"
        #If Win64 Then
            Expect.AreEqual 16, Off(b, VarPtr(t.TargetInstance)), "offset of FLT_IO_PARAMETER_BLOCK.TargetInstance"
        #Else
            Expect.AreEqual 12, Off(b, VarPtr(t.TargetInstance)), "offset of FLT_IO_PARAMETER_BLOCK.TargetInstance"
        #End If
        #If Win64 Then
            Expect.AreEqual 24, Off(b, VarPtr(t.Parameters(0))), "offset of FLT_IO_PARAMETER_BLOCK.Parameters"
        #Else
            Expect.AreEqual 16, Off(b, VarPtr(t.Parameters(0))), "offset of FLT_IO_PARAMETER_BLOCK.Parameters"
        #End If
        Expect.Done
    End Sub

