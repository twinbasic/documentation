[TestFixture]
Module FltMgrLayoutTests

    ' Each structure's size and its fields' offsets, against the WDK's headers (10.0.28000.0).
    ' Generated by wdk/wdkcheck.mjs modFltMgr: do not edit, run it again.

    Private Function Off(ByVal base As LongPtr, ByVal field As LongPtr) As Long
        Off = CLng(field - base)
    End Function

    [TestCase]
    Public Sub FLT_CALLBACK_DATA_Layout()
        Expect.Begin
        Dim t As FLT_CALLBACK_DATA
        Dim b As LongPtr = VarPtr(t)
        #If Win64 Then
            Expect.AreEqual 88, LenB(t), "LenB of FLT_CALLBACK_DATA"
        #Else
            Expect.AreEqual 44, LenB(t), "LenB of FLT_CALLBACK_DATA"
        #End If
        Expect.AreEqual 0, Off(b, VarPtr(t.Flags)), "offset of FLT_CALLBACK_DATA.Flags"
        #If Win64 Then
            Expect.AreEqual 8, Off(b, VarPtr(t.Thread)), "offset of FLT_CALLBACK_DATA.Thread"
        #Else
            Expect.AreEqual 4, Off(b, VarPtr(t.Thread)), "offset of FLT_CALLBACK_DATA.Thread"
        #End If
        #If Win64 Then
            Expect.AreEqual 16, Off(b, VarPtr(t.Iopb)), "offset of FLT_CALLBACK_DATA.Iopb"
        #Else
            Expect.AreEqual 8, Off(b, VarPtr(t.Iopb)), "offset of FLT_CALLBACK_DATA.Iopb"
        #End If
        #If Win64 Then
            Expect.AreEqual 24, Off(b, VarPtr(t.IoStatus)), "offset of FLT_CALLBACK_DATA.IoStatus"
        #Else
            Expect.AreEqual 12, Off(b, VarPtr(t.IoStatus)), "offset of FLT_CALLBACK_DATA.IoStatus"
        #End If
        #If Win64 Then
            Expect.AreEqual 40, Off(b, VarPtr(t.TagData)), "offset of FLT_CALLBACK_DATA.TagData"
        #Else
            Expect.AreEqual 20, Off(b, VarPtr(t.TagData)), "offset of FLT_CALLBACK_DATA.TagData"
        #End If
        #If Win64 Then
            Expect.AreEqual 48, Off(b, VarPtr(t.FilterCtxOrQueueLnkCtx(0))), "offset of FLT_CALLBACK_DATA.FilterCtxOrQueueLnkCtx"
        #Else
            Expect.AreEqual 24, Off(b, VarPtr(t.FilterCtxOrQueueLnkCtx(0))), "offset of FLT_CALLBACK_DATA.FilterCtxOrQueueLnkCtx"
        #End If
        #If Win64 Then
            Expect.AreEqual 80, Off(b, VarPtr(t.RequestorMode)), "offset of FLT_CALLBACK_DATA.RequestorMode"
        #Else
            Expect.AreEqual 40, Off(b, VarPtr(t.RequestorMode)), "offset of FLT_CALLBACK_DATA.RequestorMode"
        #End If
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FLT_CONTEXT_REGISTRATION_Layout()
        Expect.Begin
        Dim t As FLT_CONTEXT_REGISTRATION
        Dim b As LongPtr = VarPtr(t)
        #If Win64 Then
            Expect.AreEqual 56, LenB(t), "LenB of FLT_CONTEXT_REGISTRATION"
        #Else
            Expect.AreEqual 28, LenB(t), "LenB of FLT_CONTEXT_REGISTRATION"
        #End If
        Expect.AreEqual 0, Off(b, VarPtr(t.ContextType)), "offset of FLT_CONTEXT_REGISTRATION.ContextType"
        Expect.AreEqual 2, Off(b, VarPtr(t.Flags)), "offset of FLT_CONTEXT_REGISTRATION.Flags"
        #If Win64 Then
            Expect.AreEqual 8, Off(b, VarPtr(t.ContextCleanupCallback)), "offset of FLT_CONTEXT_REGISTRATION.ContextCleanupCallback"
        #Else
            Expect.AreEqual 4, Off(b, VarPtr(t.ContextCleanupCallback)), "offset of FLT_CONTEXT_REGISTRATION.ContextCleanupCallback"
        #End If
        #If Win64 Then
            Expect.AreEqual 16, Off(b, VarPtr(t.Size)), "offset of FLT_CONTEXT_REGISTRATION.Size"
        #Else
            Expect.AreEqual 8, Off(b, VarPtr(t.Size)), "offset of FLT_CONTEXT_REGISTRATION.Size"
        #End If
        #If Win64 Then
            Expect.AreEqual 24, Off(b, VarPtr(t.PoolTag)), "offset of FLT_CONTEXT_REGISTRATION.PoolTag"
        #Else
            Expect.AreEqual 12, Off(b, VarPtr(t.PoolTag)), "offset of FLT_CONTEXT_REGISTRATION.PoolTag"
        #End If
        #If Win64 Then
            Expect.AreEqual 32, Off(b, VarPtr(t.ContextAllocateCallback)), "offset of FLT_CONTEXT_REGISTRATION.ContextAllocateCallback"
        #Else
            Expect.AreEqual 16, Off(b, VarPtr(t.ContextAllocateCallback)), "offset of FLT_CONTEXT_REGISTRATION.ContextAllocateCallback"
        #End If
        #If Win64 Then
            Expect.AreEqual 40, Off(b, VarPtr(t.ContextFreeCallback)), "offset of FLT_CONTEXT_REGISTRATION.ContextFreeCallback"
        #Else
            Expect.AreEqual 20, Off(b, VarPtr(t.ContextFreeCallback)), "offset of FLT_CONTEXT_REGISTRATION.ContextFreeCallback"
        #End If
        #If Win64 Then
            Expect.AreEqual 48, Off(b, VarPtr(t.Reserved1)), "offset of FLT_CONTEXT_REGISTRATION.Reserved1"
        #Else
            Expect.AreEqual 24, Off(b, VarPtr(t.Reserved1)), "offset of FLT_CONTEXT_REGISTRATION.Reserved1"
        #End If
        Expect.Done
    End Sub

