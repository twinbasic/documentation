    [TestCase]
    Public Sub EVENT_DATA_DESCRIPTOR_Layout()
        Expect.Begin
        Dim t As EVENT_DATA_DESCRIPTOR
        Dim b As LongPtr = VarPtr(t)
        Expect.AreEqual 16, LenB(t), "LenB of EVENT_DATA_DESCRIPTOR"
        Expect.AreEqual 0, Off(b, VarPtr(t.Ptr)), "offset of EVENT_DATA_DESCRIPTOR.Ptr"
        Expect.AreEqual 8, Off(b, VarPtr(t.Size)), "offset of EVENT_DATA_DESCRIPTOR.Size"
        Expect.AreEqual 12, Off(b, VarPtr(t.Type)), "offset of EVENT_DATA_DESCRIPTOR.Type"
        Expect.AreEqual 13, Off(b, VarPtr(t.Reserved1)), "offset of EVENT_DATA_DESCRIPTOR.Reserved1"
        Expect.AreEqual 14, Off(b, VarPtr(t.Reserved2)), "offset of EVENT_DATA_DESCRIPTOR.Reserved2"
        Expect.Done
    End Sub

