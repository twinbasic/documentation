    [TestCase]
    Public Sub RESOURCE_PERFORMANCE_DATA_Layout()
        Expect.Begin
        Dim t As RESOURCE_PERFORMANCE_DATA
        Dim b As LongPtr = VarPtr(t)
        ' Variable-length in C: its size is not compared.
        Expect.AreEqual 0, Off(b, VarPtr(t.ActiveResourceCount)), "offset of RESOURCE_PERFORMANCE_DATA.ActiveResourceCount"
        Expect.AreEqual 4, Off(b, VarPtr(t.TotalResourceCount)), "offset of RESOURCE_PERFORMANCE_DATA.TotalResourceCount"
        Expect.AreEqual 8, Off(b, VarPtr(t.ExclusiveAcquire)), "offset of RESOURCE_PERFORMANCE_DATA.ExclusiveAcquire"
        Expect.AreEqual 12, Off(b, VarPtr(t.SharedFirstLevel)), "offset of RESOURCE_PERFORMANCE_DATA.SharedFirstLevel"
        Expect.AreEqual 16, Off(b, VarPtr(t.SharedSecondLevel)), "offset of RESOURCE_PERFORMANCE_DATA.SharedSecondLevel"
