[TestFixture]
Module WDMLayoutTests

    ' Each structure's size and its fields' offsets, against the WDK's headers (10.0.22621.0).
    ' Generated by wdk/wdkcheck.mjs modWDM: do not edit, run it again.

    Private Function Off(ByVal base As LongPtr, ByVal field As LongPtr) As Long
        Off = CLng(field - base)
    End Function

    [TestCase]
    Public Sub ACCESS_STATE_Layout()
        Expect.Begin
        Dim t As ACCESS_STATE
        Dim b As LongPtr = VarPtr(t)
        #If Win64 Then
            Expect.AreEqual 160, LenB(t), "LenB of ACCESS_STATE"
        #Else
            Expect.AreEqual 116, LenB(t), "LenB of ACCESS_STATE"
        #End If
        Expect.AreEqual 0, Off(b, VarPtr(t.OperationID)), "offset of ACCESS_STATE.OperationID"
        Expect.AreEqual 8, Off(b, VarPtr(t.SecurityEvaluated)), "offset of ACCESS_STATE.SecurityEvaluated"
        Expect.AreEqual 9, Off(b, VarPtr(t.GenerateAudit)), "offset of ACCESS_STATE.GenerateAudit"
        Expect.AreEqual 10, Off(b, VarPtr(t.GenerateOnClose)), "offset of ACCESS_STATE.GenerateOnClose"
        Expect.AreEqual 11, Off(b, VarPtr(t.PrivilegesAllocated)), "offset of ACCESS_STATE.PrivilegesAllocated"
        Expect.AreEqual 12, Off(b, VarPtr(t.Flags)), "offset of ACCESS_STATE.Flags"
        Expect.AreEqual 16, Off(b, VarPtr(t.RemainingDesiredAccess)), "offset of ACCESS_STATE.RemainingDesiredAccess"
        Expect.AreEqual 20, Off(b, VarPtr(t.PreviouslyGrantedAccess)), "offset of ACCESS_STATE.PreviouslyGrantedAccess"
        Expect.AreEqual 24, Off(b, VarPtr(t.OriginalDesiredAccess)), "offset of ACCESS_STATE.OriginalDesiredAccess"
        #If Win64 Then
            Expect.AreEqual 32, Off(b, VarPtr(t.SubjectSecurityContext)), "offset of ACCESS_STATE.SubjectSecurityContext"
        #Else
            Expect.AreEqual 28, Off(b, VarPtr(t.SubjectSecurityContext)), "offset of ACCESS_STATE.SubjectSecurityContext"
        #End If
        #If Win64 Then
            Expect.AreEqual 64, Off(b, VarPtr(t.SecurityDescriptor)), "offset of ACCESS_STATE.SecurityDescriptor"
        #Else
            Expect.AreEqual 44, Off(b, VarPtr(t.SecurityDescriptor)), "offset of ACCESS_STATE.SecurityDescriptor"
        #End If
        #If Win64 Then
            Expect.AreEqual 72, Off(b, VarPtr(t.AuxData)), "offset of ACCESS_STATE.AuxData"
        #Else
            Expect.AreEqual 48, Off(b, VarPtr(t.AuxData)), "offset of ACCESS_STATE.AuxData"
        #End If
        #If Win64 Then
            Expect.AreEqual 80, Off(b, VarPtr(t.Privileges)), "offset of ACCESS_STATE.Privileges"
        #Else
            Expect.AreEqual 52, Off(b, VarPtr(t.Privileges)), "offset of ACCESS_STATE.Privileges"
        #End If
        #If Win64 Then
            Expect.AreEqual 124, Off(b, VarPtr(t.AuditPrivileges)), "offset of ACCESS_STATE.AuditPrivileges"
        #Else
            Expect.AreEqual 96, Off(b, VarPtr(t.AuditPrivileges)), "offset of ACCESS_STATE.AuditPrivileges"
        #End If
        #If Win64 Then
            Expect.AreEqual 128, Off(b, VarPtr(t.ObjectName)), "offset of ACCESS_STATE.ObjectName"
        #Else
            Expect.AreEqual 100, Off(b, VarPtr(t.ObjectName)), "offset of ACCESS_STATE.ObjectName"
        #End If
        #If Win64 Then
            Expect.AreEqual 144, Off(b, VarPtr(t.ObjectTypeName)), "offset of ACCESS_STATE.ObjectTypeName"
        #Else
            Expect.AreEqual 108, Off(b, VarPtr(t.ObjectTypeName)), "offset of ACCESS_STATE.ObjectTypeName"
        #End If
        Expect.Done
    End Sub

    [TestCase]
    Public Sub ANSI_STRING_Layout()
        Expect.Begin
        Dim t As ANSI_STRING
        Dim b As LongPtr = VarPtr(t)
        #If Win64 Then
            Expect.AreEqual 16, LenB(t), "LenB of ANSI_STRING"
        #Else
            Expect.AreEqual 8, LenB(t), "LenB of ANSI_STRING"
        #End If
        Expect.AreEqual 0, Off(b, VarPtr(t.Length)), "offset of ANSI_STRING.Length"
        Expect.AreEqual 2, Off(b, VarPtr(t.MaximumLength)), "offset of ANSI_STRING.MaximumLength"
        #If Win64 Then
            Expect.AreEqual 8, Off(b, VarPtr(t.Buffer)), "offset of ANSI_STRING.Buffer"
        #Else
            Expect.AreEqual 4, Off(b, VarPtr(t.Buffer)), "offset of ANSI_STRING.Buffer"
        #End If
        Expect.Done
    End Sub

