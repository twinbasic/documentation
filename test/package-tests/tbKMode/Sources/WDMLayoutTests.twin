    [TestCase]
    Public Sub DRIVER_OBJECT_Layout()
        Expect.Begin
        Dim t As DRIVER_OBJECT
        Dim b As LongPtr = VarPtr(t)
        ' Variable-length in C: its size is not compared.
        Expect.AreEqual 0, Off(b, VarPtr(t.Type)), "offset of DRIVER_OBJECT.Type"
        Expect.AreEqual 2, Off(b, VarPtr(t.Size)), "offset of DRIVER_OBJECT.Size"
        #If Win64 Then
            Expect.AreEqual 8, Off(b, VarPtr(t.DeviceObject)), "offset of DRIVER_OBJECT.DeviceObject"
