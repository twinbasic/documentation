        #Else
            Expect.AreEqual 184, LenB(t), "LenB of DEVICE_OBJECT"
        #End If
        Expect.AreEqual 0, Off(b, VarPtr(t.Type)), "offset of DEVICE_OBJECT.Type"
        Expect.AreEqual 2, Off(b, VarPtr(t.Size)), "offset of DEVICE_OBJECT.Size"
        Expect.AreEqual 4, Off(b, VarPtr(t.ReferenceCount)), "offset of DEVICE_OBJECT.ReferenceCount"
        Expect.AreEqual 8, Off(b, VarPtr(t.DriverObject)), "offset of DEVICE_OBJECT.DriverObject"
        #If Win64 Then
