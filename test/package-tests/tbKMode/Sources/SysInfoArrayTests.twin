[TestFixture]
Module SysInfoArrayTests

    ' The structures whose C definitions end in an array of one element, held inline: the data a
    ' routine returns follows the fixed fields. The first two are the WDK's (ntifs.h); the others
    ' are not in the WDK, and their C definitions are those of the NT headers they come from (phnt). A twinBASIC dynamic array is a pointer to a
    ' SAFEARRAY instead, so it has no element until ReDim, and none at the C array's place.

    [TestCase]
    Public Sub FILE_TRACKING_INFORMATION_ObjectInformationIsInline()
        Expect.Begin
        Dim t As FILE_TRACKING_INFORMATION
        Dim p As LongPtr
        On Error Resume Next
        p = VarPtr(t.ObjectInformation(0))
        Expect.AreEqual 0, Err.Number, "VarPtr(ObjectInformation(0)) of a new FILE_TRACKING_INFORMATION (C: UCHAR ObjectInformation[1], inline)"
        On Error GoTo 0
        #If Win64 Then
            If p Then Expect.AreEqual 12, CLng(p - VarPtr(t)), "offset of FILE_TRACKING_INFORMATION.ObjectInformation"
        #Else
            If p Then Expect.AreEqual 8, CLng(p - VarPtr(t)), "offset of FILE_TRACKING_INFORMATION.ObjectInformation"
        #End If
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FILE_PROCESS_IDS_USING_FILE_INFORMATION_ProcessIdListIsInline()
        Expect.Begin
        Dim t As FILE_PROCESS_IDS_USING_FILE_INFORMATION
        Dim p As LongPtr
        On Error Resume Next
        p = VarPtr(t.ProcessIdList(0))
        Expect.AreEqual 0, Err.Number, "VarPtr(ProcessIdList(0)) of a new FILE_PROCESS_IDS_USING_FILE_INFORMATION (C: ULONG_PTR ProcessIdList[1], inline)"
        On Error GoTo 0
        #If Win64 Then
            If p Then Expect.AreEqual 8, CLng(p - VarPtr(t)), "offset of FILE_PROCESS_IDS_USING_FILE_INFORMATION.ProcessIdList"
        #Else
            If p Then Expect.AreEqual 4, CLng(p - VarPtr(t)), "offset of FILE_PROCESS_IDS_USING_FILE_INFORMATION.ProcessIdList"
        #End If
        Expect.Done
    End Sub

