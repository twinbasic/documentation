[TestFixture]
Module SysInfoLayoutTests

    ' Each structure's size and its fields' offsets, against the WDK's headers (10.0.28000.0).
    ' Generated by wdk/wdkcheck.mjs modSysInfo: do not edit, run it again.

    Private Function Off(ByVal base As LongPtr, ByVal field As LongPtr) As Long
        Off = CLng(field - base)
    End Function

    [TestCase]
    Public Sub FILE_ACCESS_INFORMATION_Layout()
        Expect.Begin
        Dim t As FILE_ACCESS_INFORMATION
        Dim b As LongPtr = VarPtr(t)
        Expect.AreEqual 4, LenB(t), "LenB of FILE_ACCESS_INFORMATION"
        Expect.AreEqual 0, Off(b, VarPtr(t.AccessFlags)), "offset of FILE_ACCESS_INFORMATION.AccessFlags"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub FILE_ALIGNMENT_INFORMATION_Layout()
        Expect.Begin
        Dim t As FILE_ALIGNMENT_INFORMATION
