    [TestCase]
    Public Sub FILE_BOTH_DIR_INFORMATION_Layout()
        Expect.Begin
        Dim t As FILE_BOTH_DIR_INFORMATION
        Dim b As LongPtr = VarPtr(t)
        ' Variable-length in C: its size is not compared.
        Expect.AreEqual 0, Off(b, VarPtr(t.NextEntryOffset)), "offset of FILE_BOTH_DIR_INFORMATION.NextEntryOffset"
        Expect.AreEqual 4, Off(b, VarPtr(t.FileIndex)), "offset of FILE_BOTH_DIR_INFORMATION.FileIndex"
        Expect.AreEqual 8, Off(b, VarPtr(t.CreationTime)), "offset of FILE_BOTH_DIR_INFORMATION.CreationTime"
        Expect.AreEqual 16, Off(b, VarPtr(t.LastAccessTime)), "offset of FILE_BOTH_DIR_INFORMATION.LastAccessTime"
        Expect.AreEqual 24, Off(b, VarPtr(t.LastWriteTime)), "offset of FILE_BOTH_DIR_INFORMATION.LastWriteTime"
        Expect.AreEqual 32, Off(b, VarPtr(t.ChangeTime)), "offset of FILE_BOTH_DIR_INFORMATION.ChangeTime"
        Expect.AreEqual 40, Off(b, VarPtr(t.EndOfFile)), "offset of FILE_BOTH_DIR_INFORMATION.EndOfFile"
        Expect.AreEqual 48, Off(b, VarPtr(t.AllocationSize)), "offset of FILE_BOTH_DIR_INFORMATION.AllocationSize"
        Expect.AreEqual 56, Off(b, VarPtr(t.FileAttributes)), "offset of FILE_BOTH_DIR_INFORMATION.FileAttributes"
        Expect.AreEqual 60, Off(b, VarPtr(t.FileNameLength)), "offset of FILE_BOTH_DIR_INFORMATION.FileNameLength"
        Expect.AreEqual 64, Off(b, VarPtr(t.EaSize)), "offset of FILE_BOTH_DIR_INFORMATION.EaSize"
        Expect.AreEqual 68, Off(b, VarPtr(t.ShortNameLength)), "offset of FILE_BOTH_DIR_INFORMATION.ShortNameLength"
        Expect.AreEqual 70, Off(b, VarPtr(t.ShortName(0))), "offset of FILE_BOTH_DIR_INFORMATION.ShortName"
        Expect.AreEqual 94, Off(b, VarPtr(t.FileName(0))), "offset of FILE_BOTH_DIR_INFORMATION.FileName"
        Expect.Done
    End Sub

