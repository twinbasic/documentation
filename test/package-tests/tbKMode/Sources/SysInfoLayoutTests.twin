    [TestCase]
    Public Sub FILE_ALL_INFORMATION_Layout()
        Expect.Begin
        Dim t As FILE_ALL_INFORMATION
        Dim b As LongPtr = VarPtr(t)
        ' Variable-length in C: its size is not compared.
        Expect.AreEqual 0, Off(b, VarPtr(t.BasicInformation)), "offset of FILE_ALL_INFORMATION.BasicInformation"
        Expect.AreEqual 40, Off(b, VarPtr(t.StandardInformation)), "offset of FILE_ALL_INFORMATION.StandardInformation"
        Expect.AreEqual 64, Off(b, VarPtr(t.InternalInformation)), "offset of FILE_ALL_INFORMATION.InternalInformation"
        Expect.AreEqual 72, Off(b, VarPtr(t.EaInformation)), "offset of FILE_ALL_INFORMATION.EaInformation"
        Expect.AreEqual 76, Off(b, VarPtr(t.AccessInformation)), "offset of FILE_ALL_INFORMATION.AccessInformation"
        Expect.AreEqual 80, Off(b, VarPtr(t.PositionInformation)), "offset of FILE_ALL_INFORMATION.PositionInformation"
        Expect.AreEqual 88, Off(b, VarPtr(t.ModeInformation)), "offset of FILE_ALL_INFORMATION.ModeInformation"
        Expect.AreEqual 92, Off(b, VarPtr(t.AlignmentInformation)), "offset of FILE_ALL_INFORMATION.AlignmentInformation"
        Expect.AreEqual 96, Off(b, VarPtr(t.NameInformation)), "offset of FILE_ALL_INFORMATION.NameInformation"
        Expect.Done
    End Sub

