        Expect.AreEqual 72, Off(b, VarPtr(t.AvailableCommittedAllocationUnits)), "offset of FILE_FS_FULL_SIZE_INFORMATION_EX.AvailableCommittedAllocationUnits"
        Expect.AreEqual 80, Off(b, VarPtr(t.PoolAvailableAllocationUnits)), "offset of FILE_FS_FULL_SIZE_INFORMATION_EX.PoolAvailableAllocationUnits"
