    [TestCase]
    Public Sub ALTERNATIVE_ARCHITECTURE_TYPE_Values()
        Expect.Begin
        Expect.AreEqual 0, CLng(StandardDesign), "StandardDesign"
        Expect.AreEqual 1, CLng(NEC98x86), "NEC98x86"
        Expect.AreEqual 2, CLng(EndAlternatives), "EndAlternatives"
        Expect.Done
    End Sub

