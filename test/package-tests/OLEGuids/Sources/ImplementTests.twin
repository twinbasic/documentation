        Expect.Begin
        Expect.IsTrue Guids.Supports(New ImplVB, "{D5D3BBE3-DB60-4522-AF5B-D767FE736DDB}"), "an object of a class that implements IPerPropertyBrowsingVB answers for {D5D3BBE3-DB60-4522-AF5B-D767FE736DDB}"
        Expect.Done
