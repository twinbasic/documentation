        Expect.Begin
        Expect.IsTrue Guids.Supports(New ImplVB, "{061D3A2F-A213-4016-9756-B89140604819}"), "an object of a class that implements IOleInPlaceObjectWindowlessVB answers for {061D3A2F-A213-4016-9756-B89140604819}"
        Expect.Done
    End Sub

    ' ---- the HRESULT of a Sub is hidden

    [TestCase]
    Public Sub Sub_SuccessCodeRaisesNoErrorAndIsReadWithLastHresult()
        Expect.Begin
        Dim impl As New ImplSimple
        impl.PagesResult = S_FALSE
        Dim sp As ISpecifyPropertyPages = impl
        Dim pages As OLECAUUID
        On Error Resume Next
        sp.GetPages pages
        Dim errNum As Long = Err.Number
        Dim hr As Long = Err.LastHresult
        On Error GoTo 0
        Expect.AreEqual 0, errNum, "Err.Number after GetPages of a class that sets Err.ReturnHResult to S_FALSE"
        Expect.AreEqual S_FALSE, hr, "Err.LastHresult after GetPages of a class that sets Err.ReturnHResult to S_FALSE"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Sub_FailureCodeRaisesAnError()
        Expect.Begin
        Dim impl As New ImplSimple
        impl.PagesResult = E_FAIL
        Dim sp As ISpecifyPropertyPages = impl
        Dim pages As OLECAUUID
        On Error Resume Next
        sp.GetPages pages
        Dim errNum As Long = Err.Number
        Dim hr As Long = Err.LastHresult
        On Error GoTo 0
        Expect.AreEqual E_FAIL, errNum, "Err.Number after GetPages of a class that sets Err.ReturnHResult to E_FAIL"
        Expect.AreEqual E_FAIL, hr, "Err.LastHresult after GetPages of a class that sets Err.ReturnHResult to E_FAIL"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub Function_ResultTakesThePlaceOfTheOutputParameter()
        Expect.Begin
        Dim impl As New ImplSimple
        impl.WindowToReturn = 77
        Dim w As IOleWindow = impl
        Expect.AreEqual 77, w.GetWindow(), "GetWindow of a class that returns 77"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub VBInterface_ClassCanBeCalledThroughIt()
        Expect.Begin
        Dim impl As New ImplVB
        Dim v As IOleInPlaceActiveObjectVB = impl
        Dim handled As Boolean = False
        Dim retVal As Long = 0
        v.TranslateAccelerator handled, retVal, 0, 0, 0, 0, 0
        Expect.IsTrue handled, "Handled after TranslateAccelerator through IOleInPlaceActiveObjectVB"
        Expect.AreEqual 1, retVal, "RetVal after TranslateAccelerator through IOleInPlaceActiveObjectVB"
        Dim p As IPerPropertyBrowsingVB = impl
        Dim shown As String = ""
        p.GetDisplayString handled, 1, shown
        Expect.AreEqual "shown", shown, "DisplayName after GetDisplayString through IPerPropertyBrowsingVB"
        Expect.Done
    End Sub

End Module
