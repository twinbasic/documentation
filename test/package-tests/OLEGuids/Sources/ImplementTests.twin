    Public Sub IDataObject_AnswersToItsIdentifier()
        Expect.Begin
        Expect.IsTrue Guids.Supports(New ImplSimple, "{0000010E-0000-0000-C000-000000000046}"), "an object of a class that implements IDataObject answers for {0000010E-0000-0000-C000-000000000046}"
        Expect.Done
    End Sub

