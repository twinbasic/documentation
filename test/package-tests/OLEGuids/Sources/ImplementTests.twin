' The interfaces a class can implement: the interface identifiers they answer to, the HRESULT that a Sub
' hides, the result of a Function that replaces an output parameter, and the four Visual Basic-style
' interfaces.
[TestFixture]
Module ImplementTests

    Private Const S_FALSE As Long = 1
    Private Const E_NOTIMPL As Long = &H80004001
    Private Const E_FAIL As Long = &H80004005

    ' ---- interface identifiers: a class that implements the interface answers QueryInterface for it

    [TestCase]
    Public Sub IOleClientSite_AnswersToItsIdentifier()
        Expect.Begin
        Expect.IsTrue Guids.Supports(New ImplSimple, "{00000118-0000-0000-C000-000000000046}"), "an object of a class that implements IOleClientSite answers for {00000118-0000-0000-C000-000000000046}"
        Expect.Done
    End Sub

    [TestCase]
    Public Sub IStorage_AnswersToItsIdentifier()
        Expect.Begin
        Expect.IsTrue Guids.Supports(New ImplSimple, "{0000000B-0000-0000-C000-000000000046}"), "an object of a class that implements IStorage answers for {0000000B-0000-0000-C000-000000000046}"
        Expect.Done
    End Sub

