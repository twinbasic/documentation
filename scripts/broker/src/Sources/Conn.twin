' One instance of the pipe: listening for a client, then connected to one.
Class Conn
    Private Declare PtrSafe Sub RtlMoveMemory Lib "kernel32" (ByVal Destination As LongPtr, ByVal Source As LongPtr, ByVal Length As LongPtr)

    Public Id As Long
    Public Handle As LongPtr
    Public Listening As Boolean
    Public Open As Boolean
    ' A read or a connect is outstanding on Block's OVERLAPPED.
    Public Pending As Boolean
    ' Closed by the broker while Pending: freed when the cancelled request's packet arrives.
    Public Closing As Boolean
    Public ClientPid As Long
    Public ClientName As String
    ' HeapAlloc'd and never moved while the system may write to it: the OVERLAPPED of the
    ' connect and the reads, then the read buffer.
    Public Block As LongPtr
    ' The OVERLAPPED of the writes, and its event.
    Public WriteBlock As LongPtr
    Public WriteEvent As LongPtr

    ' The bytes read and not yet ended by a line feed.
    Private mIn() As Byte
    Private mInLen As Long

    Public Property Get Buffered() As Long
        Buffered = mInLen
    End Property

    Public Sub Append(ByVal source As LongPtr, ByVal count As Long)
        Dim size As Long
        If count <= 0 Then Exit Sub
        If mInLen = 0 Then
            ReDim mIn(0 To count - 1)
        Else
            size = UBound(mIn) + 1
            If mInLen + count > size Then
                Do While size < mInLen + count
                    size = size * 2
                Loop
                ReDim Preserve mIn(0 To size - 1)
            End If
        End If
        RtlMoveMemory VarPtr(mIn(mInLen)), source, count
        mInLen = mInLen + count
    End Sub

    ' The first whole line, its line feed (and a carriage return before it) taken off, and
    ' removed from what is buffered; False when no line feed has come yet.
    Public Function TakeLine(ByRef line As String) As Boolean
        Dim i As Long, n As Long
        For i = 0 To mInLen - 1
            If mIn(i) = 10 Then
                n = i
                If n > 0 Then
                    If mIn(n - 1) = 13 Then n = n - 1
                End If
                line = Text.FromUtf8(mIn, 0, n)
                If i + 1 < mInLen Then RtlMoveMemory VarPtr(mIn(0)), VarPtr(mIn(i + 1)), mInLen - i - 1
                mInLen = mInLen - i - 1
                TakeLine = True
                Exit Function
            End If
        Next
    End Function
End Class
