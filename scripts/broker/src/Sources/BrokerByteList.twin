' Bytes gathered from reads, for a reply that may arrive in pieces.
Class BrokerByteList
    Private Declare PtrSafe Sub RtlMoveMemory Lib "kernel32" (ByVal Destination As LongPtr, ByVal Source As LongPtr, ByVal Length As LongPtr)

    Private mData() As Byte
    Private mCount As Long

    Public Property Get Count() As Long
        Count = mCount
    End Property

    Public Sub Append(ByVal source As LongPtr, ByVal n As Long)
        If n <= 0 Then Exit Sub
        ReDim Preserve mData(0 To mCount + n - 1)
        RtlMoveMemory VarPtr(mData(mCount)), source, n
        mCount = mCount + n
    End Sub

    Public Function EndsWithLineFeed() As Boolean
        If mCount > 0 Then EndsWithLineFeed = mData(mCount - 1) = 10
    End Function

    ' The text, without the line ending at its end.
    Public Function AsText() As String
        Dim n As Long
        n = mCount
        Do While n > 0
            If mData(n - 1) <> 10 And mData(n - 1) <> 13 Then Exit Do
            n = n - 1
        Loop
        AsText = BrokerText.FromUtf8(mData, 0, n)
    End Function
End Class
