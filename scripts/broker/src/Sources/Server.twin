' The pipe server. One thread: every pipe instance is tied to one I/O completion port, which this
' loop waits on for a quarter of a second at a time, and between packets the pool looks at the
' processes it holds for. No thread of the runtime's is involved, and there is no limit of 64
' handles to wait on.
Module Server
    Private Declare PtrSafe Function CreateNamedPipeW Lib "kernel32" (ByVal lpName As LongPtr, ByVal dwOpenMode As Long, ByVal dwPipeMode As Long, ByVal nMaxInstances As Long, ByVal nOutBufferSize As Long, ByVal nInBufferSize As Long, ByVal nDefaultTimeOut As Long, ByVal lpSecurityAttributes As LongPtr) As LongPtr
    Private Declare PtrSafe Function ConnectNamedPipe Lib "kernel32" (ByVal hNamedPipe As LongPtr, ByVal lpOverlapped As LongPtr) As Long
    Private Declare PtrSafe Function GetNamedPipeClientProcessId Lib "kernel32" (ByVal Pipe As LongPtr, ByRef ClientProcessId As Long) As Long
    Private Declare PtrSafe Function CreateIoCompletionPort Lib "kernel32" (ByVal FileHandle As LongPtr, ByVal ExistingCompletionPort As LongPtr, ByVal CompletionKey As LongPtr, ByVal NumberOfConcurrentThreads As Long) As LongPtr
    Private Declare PtrSafe Function GetQueuedCompletionStatus Lib "kernel32" (ByVal CompletionPort As LongPtr, ByRef lpNumberOfBytesTransferred As Long, ByRef lpCompletionKey As LongPtr, ByRef lpOverlapped As LongPtr, ByVal dwMilliseconds As Long) As Long
    Private Declare PtrSafe Function ReadFile Lib "kernel32" (ByVal hFile As LongPtr, ByVal lpBuffer As LongPtr, ByVal nNumberOfBytesToRead As Long, ByVal lpNumberOfBytesRead As LongPtr, ByVal lpOverlapped As LongPtr) As Long
    Private Declare PtrSafe Function WriteFile Lib "kernel32" (ByVal hFile As LongPtr, ByVal lpBuffer As LongPtr, ByVal nNumberOfBytesToWrite As Long, ByVal lpNumberOfBytesWritten As LongPtr, ByVal lpOverlapped As LongPtr) As Long
    Private Declare PtrSafe Function GetOverlappedResult Lib "kernel32" (ByVal hFile As LongPtr, ByVal lpOverlapped As LongPtr, ByRef lpNumberOfBytesTransferred As Long, ByVal bWait As Long) As Long
    Private Declare PtrSafe Function CancelIoEx Lib "kernel32" (ByVal hFile As LongPtr, ByVal lpOverlapped As LongPtr) As Long
    Private Declare PtrSafe Function CloseHandle Lib "kernel32" (ByVal hObject As LongPtr) As Long
    Private Declare PtrSafe Function CreateEventW Lib "kernel32" (ByVal lpEventAttributes As LongPtr, ByVal bManualReset As Long, ByVal bInitialState As Long, ByVal lpName As LongPtr) As LongPtr
    Private Declare PtrSafe Function WaitForSingleObject Lib "kernel32" (ByVal hHandle As LongPtr, ByVal dwMilliseconds As Long) As Long
    Private Declare PtrSafe Function GetProcessHeap Lib "kernel32" () As LongPtr
    Private Declare PtrSafe Function HeapAlloc Lib "kernel32" (ByVal hHeap As LongPtr, ByVal dwFlags As Long, ByVal dwBytes As LongPtr) As LongPtr
    Private Declare PtrSafe Function HeapFree Lib "kernel32" (ByVal hHeap As LongPtr, ByVal dwFlags As Long, ByVal lpMem As LongPtr) As Long
    Private Declare PtrSafe Sub RtlZeroMemory Lib "kernel32" (ByVal Destination As LongPtr, ByVal Length As LongPtr)
    Private Declare PtrSafe Sub RtlMoveMemory Lib "kernel32" (ByVal Destination As LongPtr, ByVal Source As LongPtr, ByVal Length As LongPtr)
    Private Declare PtrSafe Function GetTickCount64 Lib "kernel32" () As LongLong
    Private Declare PtrSafe Function GetCurrentProcessId Lib "kernel32" () As Long

    Private Const PIPE_ACCESS_DUPLEX As Long = 3
    Private Const FILE_FLAG_OVERLAPPED As Long = &H40000000
    Private Const FILE_FLAG_FIRST_PIPE_INSTANCE As Long = &H80000
    Private Const PIPE_REJECT_REMOTE_CLIENTS As Long = 8
    Private Const PIPE_UNLIMITED_INSTANCES As Long = 255
    Private Const PIPE_BUFFER As Long = 65536
    Private Const HEAP_ZERO_MEMORY As Long = 8
    Private Const ERROR_ACCESS_DENIED As Long = 5
    Private Const ERROR_PIPE_CONNECTED As Long = 535
    Private Const ERROR_IO_PENDING As Long = 997
    Private Const WAIT_TIMEOUT As Long = 258
    Private Const INVALID_HANDLE_VALUE As LongPtr = -1
    ' The OVERLAPPED is at most 32 bytes; the read buffer follows it.
    Private Const OVERLAPPED_SPACE As Long = 64
    Private Const READ_SIZE As Long = 4096
    ' A request longer than this closes its connection.
    Private Const LINE_LIMIT As Long = 65536
    ' A client that has not taken a reply in this long is cut off.
    Private Const WRITE_TIMEOUT_MS As Long = 5000
    Private Const TICK_MS As Long = 250

    Public Const PROTOCOL As Long = 1
    Public Const VERSION As String = "1.0"

    ' Exit codes of Serve.
    Public Const SERVE_STOPPED As Long = 0
    Public Const SERVE_FAILED As Long = 1
    Public Const SERVE_ALREADY_RUNNING As Long = 3

    Private mPipeName As String
    Private mPort As LongPtr
    Private mConns As New Collection
    Private mNextConn As Long
    Private mNeedListener As Boolean
    Private mStopping As Boolean
    Private mStarted As Date

    Public Property Get PipeName() As String
        PipeName = mPipeName
    End Property

    ' Serves until a stop request; the exit code.
    Public Function Serve(ByVal pipeName As String) As Long
        Dim ok As Long, bytes As Long, key As LongPtr, ov As LongPtr, lastTick As LongLong, now64 As LongLong
        mPipeName = pipeName
        mStarted = Now
        mPort = CreateIoCompletionPort(INVALID_HANDLE_VALUE, 0, 0, 1)
        If mPort = 0 Then
            Text.Log "CreateIoCompletionPort failed with error " & Err.LastDllError
            Serve = SERVE_FAILED
            Exit Function
        End If
        Select Case Listen(True)
            Case 0
            Case ERROR_ACCESS_DENIED
                Serve = SERVE_ALREADY_RUNNING
                Exit Function
            Case Else
                Serve = SERVE_FAILED
                Exit Function
        End Select
        Text.Log "serving " & mPipeName & ": slots " & Pool.Prefix & "1-" & Pool.MaxSlots & _
            IIf(Len(Pool.PortRange()) > 0, ", ports " & Pool.PortRange(), ", no ports")
        lastTick = GetTickCount64()
        Do
            ov = 0
            key = 0
            bytes = 0
            ok = GetQueuedCompletionStatus(mPort, bytes, key, ov, TICK_MS)
            If ov <> 0 Then Completed ok <> 0, bytes, CLng(key)
            If mStopping Then Exit Do
            now64 = GetTickCount64()
            If now64 - lastTick >= TICK_MS Then
                lastTick = now64
                If mNeedListener Then Listen False
                Pool.Tick
            End If
        Loop Until mStopping
        Text.Log "stopped"
        Serve = SERVE_STOPPED
    End Function

    ' A new pipe instance, waiting for a client. 0, or the error that stopped it.
    Private Function Listen(ByVal first As Boolean) As Long
        Dim c As Conn, h As LongPtr, mode As Long, e As Long
        mode = PIPE_ACCESS_DUPLEX Or FILE_FLAG_OVERLAPPED
        If first Then mode = mode Or FILE_FLAG_FIRST_PIPE_INSTANCE
        h = CreateNamedPipeW(StrPtr(mPipeName), mode, PIPE_REJECT_REMOTE_CLIENTS, PIPE_UNLIMITED_INSTANCES, PIPE_BUFFER, PIPE_BUFFER, 0, 0)
        If h = INVALID_HANDLE_VALUE Then
            e = Err.LastDllError
            If Not first Or e <> ERROR_ACCESS_DENIED Then Text.Log "CreateNamedPipe failed with error " & e
            mNeedListener = True
            Listen = e
            Exit Function
        End If
        mNeedListener = False
        mNextConn = mNextConn + 1
        Set c = New Conn
        c.Id = mNextConn
        c.Handle = h
        c.Listening = True
        c.Open = True
        c.Block = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, OVERLAPPED_SPACE + READ_SIZE)
        c.WriteBlock = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, OVERLAPPED_SPACE)
        c.WriteEvent = CreateEventW(0, 1, 0, 0)
        mConns.Add c, CStr(c.Id)
        CreateIoCompletionPort h, mPort, c.Id, 0
        If ConnectNamedPipe(h, c.Block) = 0 Then
            e = Err.LastDllError
            If e = ERROR_IO_PENDING Then
                c.Pending = True
            ElseIf e = ERROR_PIPE_CONNECTED Then
                ' A client came between the two calls; no packet will say so.
                Connected c
            Else
                Text.Log "ConnectNamedPipe failed with error " & e
                Drop c
                mNeedListener = True
            End If
        Else
            Connected c
        End If
    End Function

    Private Function Find(ByVal id As Long) As Conn
        On Error Resume Next
        Set Find = mConns(CStr(id))
    End Function

    Private Sub Completed(ByVal ok As Boolean, ByVal bytes As Long, ByVal id As Long)
        Dim c As Conn
        Set c = Find(id)
        If c Is Nothing Then Exit Sub
        c.Pending = False
        If c.Closing Then
            Free c
            Exit Sub
        End If
        If c.Listening Then
            If ok Then
                Connected c
            Else
                Drop c
                mNeedListener = True
            End If
            Exit Sub
        End If
        If Not ok Or bytes = 0 Then
            Drop c
            Exit Sub
        End If
        c.Append c.Block + OVERLAPPED_SPACE, bytes
        Dim line As String
        Do While c.Open
            If Not c.TakeLine(line) Then Exit Do
            Answer c, line
            If mStopping Then Exit Sub
        Loop
        If Not c.Open Then Exit Sub
        If c.Buffered > LINE_LIMIT Then
            SendError c.Id, "", "too-long", "a request longer than " & LINE_LIMIT & " bytes"
            Drop c
            Exit Sub
        End If
        Read c
    End Sub

    Private Sub Connected(ByVal c As Conn)
        Dim pid As Long
        c.Listening = False
        GetNamedPipeClientProcessId c.Handle, pid
        c.ClientPid = pid
        Text.Log "connection " & c.Id & " from pid " & pid
        ' The next client needs an instance of its own to connect to.
        Listen False
        Read c
    End Sub

    Private Sub Read(ByVal c As Conn)
        Dim e As Long
        RtlZeroMemory c.Block, OVERLAPPED_SPACE
        If ReadFile(c.Handle, c.Block + OVERLAPPED_SPACE, READ_SIZE, 0, c.Block) = 0 Then
            e = Err.LastDllError
            If e <> ERROR_IO_PENDING Then
                Drop c
                Exit Sub
            End If
        End If
        ' Done at once or not, the result comes as a packet.
        c.Pending = True
    End Sub

    ' Closes the connection, and gives back what it kept.
    Private Sub Drop(ByVal c As Conn)
        If Not c.Open Then Exit Sub
        c.Open = False
        If Not c.Listening Then
            Text.Log "connection " & c.Id & " closed"
            Pool.ConnClosed c.Id
        End If
        If c.Pending Then
            ' The cancelled request still owes a packet, and its memory is not ours until then.
            c.Closing = True
            CancelIoEx c.Handle, 0
            CloseHandle c.Handle
        Else
            CloseHandle c.Handle
            Free c
        End If
    End Sub

    Private Sub Free(ByVal c As Conn)
        If c.Open Then CloseHandle c.Handle
        c.Open = False
        HeapFree GetProcessHeap(), 0, c.Block
        HeapFree GetProcessHeap(), 0, c.WriteBlock
        CloseHandle c.WriteEvent
        On Error Resume Next
        mConns.Remove CStr(c.Id)
    End Sub

    ' Writes a line to the connection and waits for it to be taken. A client that does not read
    ' its replies is cut off rather than allowed to stop the broker.
    Private Sub Send(ByVal c As Conn, ByVal json As String)
        Dim b() As Byte, n As Long, e As Long, done As Long, ev As LongPtr, pEvent As LongPtr
        If Not c.Open Or c.Listening Then Exit Sub
        n = Text.ToUtf8(json & vbLf, b)
        RtlZeroMemory c.WriteBlock, OVERLAPPED_SPACE
        ' The event's handle with its lowest bit set: the write's completion then goes to the
        ' event and not to the completion port, which has nothing to do with it.
        ev = c.WriteEvent Or 1
        pEvent = c.WriteBlock + 2 * LenB(pEvent) + 8
        RtlMoveMemory pEvent, VarPtr(ev), LenB(ev)
        If WriteFile(c.Handle, VarPtr(b(0)), n, 0, c.WriteBlock) = 0 Then
            e = Err.LastDllError
            If e <> ERROR_IO_PENDING Then
                Drop c
                Exit Sub
            End If
            If WaitForSingleObject(c.WriteEvent, WRITE_TIMEOUT_MS) = WAIT_TIMEOUT Then
                CancelIoEx c.Handle, c.WriteBlock
                GetOverlappedResult c.Handle, c.WriteBlock, done, 1
                Text.Log "connection " & c.Id & " took no reply for " & WRITE_TIMEOUT_MS & " ms"
                Drop c
                Exit Sub
            End If
            If GetOverlappedResult(c.Handle, c.WriteBlock, done, 0) = 0 Then Drop c
        End If
    End Sub

    Private Function Reply(ByVal idText As String, ByVal ok As Boolean, ByVal members As String) As String
        Dim s As String
        s = "{"
        If Len(idText) > 0 Then s = s & Text.Member("id", idText) & ","
        s = s & Text.Member("ok", Text.Bool(ok))
        If Len(members) > 0 Then s = s & "," & members
        Reply = s & "}"
    End Function

    Public Sub SendOk(ByVal connId As Long, ByVal idText As String, ByVal members As String)
        Dim c As Conn
        Set c = Find(connId)
        If Not c Is Nothing Then Send c, Reply(idText, True, members)
    End Sub

    Public Sub SendError(ByVal connId As Long, ByVal idText As String, ByVal code As String, ByVal message As String)
        Dim c As Conn
        Set c = Find(connId)
        If Not c Is Nothing Then Send c, Reply(idText, False, Text.Member("error", Text.Quote(code)) & "," & Text.Member("message", Text.Quote(message)))
    End Sub

    Private Sub Answer(ByVal c As Conn, ByVal line As String)
        Dim r As New Request, op As String, result As String, code As String, message As String
        If Len(Trim$(line)) = 0 Then Exit Sub
        r.Parse line
        If Not r.Valid Then
            SendError c.Id, r.IdText, "bad-request", r.Problem
            Exit Sub
        End If
        op = r.StringOf("op")
        Select Case op
            Case "hello"
                If r.Has("client") Then c.ClientName = r.StringOf("client")
                SendOk c.Id, r.IdText, Text.Member("protocol", CStr(PROTOCOL)) & "," & Text.Member("version", Text.Quote(VERSION)) & "," & _
                    Text.Member("pid", CStr(GetCurrentProcessId())) & "," & Text.Member("client", CStr(c.ClientPid))
            Case "lease"
                result = Pool.Take(c.Id, c.ClientPid, r.IdText, r.Flag("port"), r.StringOf("tag"), r.Flag("wait"), code, message)
                If Len(result) > 0 Then
                    SendOk c.Id, r.IdText, result
                ElseIf Len(code) > 0 Then
                    SendError c.Id, r.IdText, code, message
                End If
            Case "hold"
                If Not r.IsNumber("lease") Or Not r.IsNumber("pid") Then
                    SendError c.Id, r.IdText, "bad-request", "hold takes a lease and a pid"
                    Exit Sub
                End If
                code = Pool.Hold(c.Id, CLng(r.Number("lease")), CLng(r.Number("pid")), message)
                If Len(code) = 0 Then SendOk c.Id, r.IdText, "" Else SendError c.Id, r.IdText, code, message
            Case "release"
                If Not r.IsNumber("lease") Then
                    SendError c.Id, r.IdText, "bad-request", "release takes a lease"
                    Exit Sub
                End If
                code = Pool.Release(c.Id, CLng(r.Number("lease")), message)
                If Len(code) = 0 Then SendOk c.Id, r.IdText, "" Else SendError c.Id, r.IdText, code, message
            Case "status"
                SendOk c.Id, r.IdText, StatusMembers()
            Case "stop"
                Text.Log "stop requested by pid " & c.ClientPid
                SendOk c.Id, r.IdText, ""
                mStopping = True
            Case ""
                SendError c.Id, r.IdText, "bad-request", "no op"
            Case Else
                SendError c.Id, r.IdText, "unknown-op", "unknown op: " & op
        End Select
    End Sub

    Private Function StatusMembers() As String
        Dim s As String, c As Conn, items As String
        s = Text.Member("broker", "{" & Text.Member("pid", CStr(GetCurrentProcessId())) & "," & _
            Text.Member("protocol", CStr(PROTOCOL)) & "," & Text.Member("version", Text.Quote(VERSION)) & "," & _
            Text.Member("pipe", Text.Quote(mPipeName)) & "," & Text.Member("prefix", Text.Quote(Pool.Prefix)) & "," & _
            Text.Member("max", CStr(Pool.MaxSlots)) & "," & Text.Member("ports", Text.Quote(Pool.PortRange())) & "," & _
            Text.Member("started", Text.Quote(Format$(mStarted, "yyyy-mm-dd hh:nn:ss"))) & "," & _
            Text.Member("log", Text.Quote(Text.LogPath)) & "}")
        For Each c In mConns
            If c.Open And Not c.Listening Then
                If Len(items) > 0 Then items = items & ","
                items = items & "{" & Text.Member("connection", CStr(c.Id)) & "," & Text.Member("pid", CStr(c.ClientPid)) & "," & _
                    Text.Member("client", Text.Quote(c.ClientName)) & "}"
            End If
        Next
        StatusMembers = s & "," & Text.Member("connections", "[" & items & "]") & "," & Pool.StatusMembers()
    End Function
End Module
