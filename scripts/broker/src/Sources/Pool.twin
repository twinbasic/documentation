' The slots and what they hold. Slot n is the desktop <prefix>n, made the first time a lease needs
' it and held open from then until the broker ends, so that each desktop is made once: DWM keeps
' state for every desktop ever made and never lets it go, and walks all of it on every window
' change. A slot is free, leased, or dirty: a desktop whose lease has ended while windows are still
' on it is not handed out again until they have gone.
Module Pool
    Private Declare PtrSafe Function CreateDesktopW Lib "user32" (ByVal lpszDesktop As LongPtr, ByVal lpszDevice As LongPtr, ByVal pDevmode As LongPtr, ByVal dwFlags As Long, ByVal dwDesiredAccess As Long, ByVal lpsa As LongPtr) As LongPtr
    Private Declare PtrSafe Function OpenDesktopW Lib "user32" (ByVal lpszDesktop As LongPtr, ByVal dwFlags As Long, ByVal fInherit As Long, ByVal dwDesiredAccess As Long) As LongPtr
    Private Declare PtrSafe Function EnumDesktopWindows Lib "user32" (ByVal hDesktop As LongPtr, ByVal lpfn As LongPtr, ByVal lParam As LongPtr) As Long
    Private Declare PtrSafe Function OpenProcess Lib "kernel32" (ByVal dwDesiredAccess As Long, ByVal bInheritHandle As Long, ByVal dwProcessId As Long) As LongPtr
    Private Declare PtrSafe Function WaitForSingleObject Lib "kernel32" (ByVal hHandle As LongPtr, ByVal dwMilliseconds As Long) As Long
    Private Declare PtrSafe Function CloseHandle Lib "kernel32" (ByVal hObject As LongPtr) As Long
    Private Declare PtrSafe Function WSAStartup Lib "ws2_32" (ByVal wVersionRequested As Integer, ByVal lpWSAData As LongPtr) As Long
    Private Declare PtrSafe Function socket Lib "ws2_32" (ByVal af As Long, ByVal sockType As Long, ByVal protocol As Long) As LongPtr
    Private Declare PtrSafe Function setsockopt Lib "ws2_32" (ByVal s As LongPtr, ByVal level As Long, ByVal optname As Long, ByRef optval As Long, ByVal optlen As Long) As Long
    Private Declare PtrSafe Function bind Lib "ws2_32" (ByVal s As LongPtr, ByRef name As SOCKADDR_IN, ByVal namelen As Long) As Long
    Private Declare PtrSafe Function closesocket Lib "ws2_32" (ByVal s As LongPtr) As Long
    Private Declare PtrSafe Function htons Lib "ws2_32" (ByVal hostshort As Integer) As Integer

    Private Type SOCKADDR_IN
        sin_family As Integer
        sin_port As Integer
        sin_addr As Long
        sin_zero1 As Long
        sin_zero2 As Long
    End Type

    Private Const GENERIC_ALL As Long = &H10000000
    Private Const SYNCHRONIZE As Long = &H100000
    Private Const PROCESS_QUERY_LIMITED_INFORMATION As Long = &H1000
    Private Const WAIT_OBJECT_0 As Long = 0
    Private Const AF_INET As Long = 2
    Private Const SOCK_STREAM As Long = 1
    Private Const IPPROTO_TCP As Long = 6
    Private Const SOL_SOCKET As Long = &HFFFF&
    Private Const SO_EXCLUSIVEADDRUSE As Long = -5
    ' 127.0.0.1 as it lies in memory.
    Private Const LOOPBACK As Long = &H100007F

    Public Const STATE_NONE As Long = 0
    Public Const STATE_FREE As Long = 1
    Public Const STATE_LEASED As Long = 2
    Public Const STATE_DIRTY As Long = 3

    Private mPrefix As String
    Private mMax As Long
    Private mPortFirst As Long
    Private mPortLast As Long
    Private mDesk() As LongPtr
    Private mState() As Long
    Private mLeaseOf() As Long
    Private mWindows() As Long
    Private mLeases As New Collection
    Private mWaiting As New Collection
    Private mNextLease As Long
    Private mCounted As Long

    Public Sub Init(ByVal prefix As String, ByVal max As Long, ByVal portFirst As Long, ByVal portLast As Long)
        Dim i As Long, h As LongPtr, wsa(0 To 511) As Byte
        mPrefix = prefix
        mMax = max
        mPortFirst = portFirst
        mPortLast = portLast
        ReDim mDesk(1 To mMax)
        ReDim mState(1 To mMax)
        ReDim mLeaseOf(1 To mMax)
        ReDim mWindows(1 To mMax)
        WSAStartup &H202, VarPtr(wsa(0))
        ' A desktop of the pool that is already there was made by a broker that has ended while
        ' something still ran on it. It is held from now on, and handed out once it is empty.
        For i = 1 To mMax
            h = OpenDesktopW(StrPtr(DesktopName(i)), 0, 0, GENERIC_ALL)
            If h <> 0 Then
                mDesk(i) = h
                mState(i) = STATE_DIRTY
                Text.Log "found " & DesktopName(i) & " already there; held"
            End If
        Next
        CheckDirty
    End Sub

    Public Function DesktopName(ByVal slot As Long) As String
        DesktopName = mPrefix & slot
    End Function

    Public Property Get Prefix() As String
        Prefix = mPrefix
    End Property

    Public Property Get MaxSlots() As Long
        MaxSlots = mMax
    End Property

    Public Function PortRange() As String
        If mPortFirst > 0 Then PortRange = mPortFirst & "-" & mPortLast
    End Function

    ' The windows on a desktop, top-level ones, of every process.
    Private Function WindowCount(ByVal h As LongPtr) As Long
        mCounted = 0
        EnumDesktopWindows h, AddressOf CountWindow, 0
        WindowCount = mCounted
    End Function

    Private Function CountWindow(ByVal hwnd As LongPtr, ByVal lParam As LongPtr) As Long
        mCounted = mCounted + 1
        CountWindow = 1
    End Function

    ' A dirty desktop with no windows left is free again.
    Private Sub CheckDirty()
        Dim i As Long
        For i = 1 To mMax
            If mState(i) = STATE_DIRTY Then
                mWindows(i) = WindowCount(mDesk(i))
                If mWindows(i) = 0 Then
                    mState(i) = STATE_FREE
                    Text.Log DesktopName(i) & " is empty again"
                End If
            End If
        Next
    End Sub

    ' Whether nothing holds the port on the loopback address: the test a listener would make.
    Private Function PortFree(ByVal port As Long) As Boolean
        Dim s As LongPtr, one As Long, sa As SOCKADDR_IN
        s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP)
        If s = -1 Then Exit Function
        one = 1
        setsockopt s, SOL_SOCKET, SO_EXCLUSIVEADDRUSE, one, 4
        sa.sin_family = AF_INET
        sa.sin_port = htons(CInt(IIf(port > 32767, port - 65536, port)))
        sa.sin_addr = LOOPBACK
        PortFree = bind(s, sa, LenB(sa)) = 0
        closesocket s
    End Function

    Private Function PortLeased(ByVal port As Long) As Boolean
        Dim l As Lease
        For Each l In mLeases
            If l.Port = port Then
                PortLeased = True
                Exit Function
            End If
        Next
    End Function

    Private Function FreePort() As Long
        Dim p As Long
        If mPortFirst <= 0 Then Exit Function
        For p = mPortFirst To mPortLast
            If Not PortLeased(p) Then
                If PortFree(p) Then
                    FreePort = p
                    Exit Function
                End If
            End If
        Next
    End Function

    ' The lowest free slot, its desktop made if it has none yet; 0 when every slot is taken.
    ' failure says why a desktop could not be made.
    Private Function FreeSlot(ByRef failure As String) As Long
        Dim i As Long, h As LongPtr
        For i = 1 To mMax
            If mState(i) = STATE_FREE Then
                FreeSlot = i
                Exit Function
            End If
        Next
        For i = 1 To mMax
            If mState(i) = STATE_NONE Then
                ' CreateDesktop opens a desktop of that name if there is one.
                h = CreateDesktopW(StrPtr(DesktopName(i)), 0, 0, 0, GENERIC_ALL, 0)
                If h = 0 Then
                    failure = "CreateDesktop " & DesktopName(i) & " failed with error " & Err.LastDllError
                    Exit Function
                End If
                mDesk(i) = h
                mState(i) = STATE_FREE
                Text.Log "made " & DesktopName(i)
                FreeSlot = i
                Exit Function
            End If
        Next
    End Function

    ' Takes a slot for the connection. On success the reply's members, else "" with code and
    ' message set. A request that may wait and finds no slot is queued and answered later; then
    ' the result is "" and code is "".
    Public Function Take(ByVal connId As Long, ByVal clientPid As Long, ByVal idText As String, ByVal wantPort As Boolean, ByVal tag As String, ByVal mayWait As Boolean, ByRef code As String, ByRef message As String) As String
        Dim slot As Long, port As Long, failure As String, l As Lease, w As Waiter
        code = ""
        ' A request that may wait goes behind those already waiting.
        If Not (mayWait And mWaiting.Count > 0) Then slot = FreeSlot(failure)
        If slot = 0 Then
            If Len(failure) > 0 Then
                code = "desktop"
                message = failure
            ElseIf mayWait Then
                Set w = New Waiter
                w.ConnId = connId
                w.ClientPid = clientPid
                w.IdText = idText
                w.WantPort = wantPort
                w.Tag = tag
                mWaiting.Add w
                Text.Log "connection " & connId & " waits for a slot (" & tag & ")"
            Else
                code = "full"
                message = "all " & mMax & " slots are leased or not yet empty"
            End If
            Exit Function
        End If
        If wantPort Then
            If mPortFirst <= 0 Then
                code = "no-port"
                message = "the broker was started with no port range"
                Exit Function
            End If
            port = FreePort()
            If port = 0 Then
                code = "no-port"
                message = "no port in " & PortRange() & " is free"
                Exit Function
            End If
        End If
        mNextLease = mNextLease + 1
        Set l = New Lease
        l.Id = mNextLease
        l.Slot = slot
        l.Port = port
        l.Tag = tag
        l.ConnId = connId
        l.ClientPid = clientPid
        l.Taken = Now
        mLeases.Add l, CStr(l.Id)
        mState(slot) = STATE_LEASED
        mLeaseOf(slot) = l.Id
        Text.Log "lease " & l.Id & ": " & DesktopName(slot) & IIf(port > 0, " port " & port, "") & " to pid " & clientPid & " (" & tag & ")"
        Take = Text.Member("lease", CStr(l.Id)) & "," & Text.Member("slot", CStr(slot)) & "," & _
            Text.Member("desktop", Text.Quote(DesktopName(slot))) & "," & Text.Member("port", CStr(port))
    End Function

    Private Function Find(ByVal leaseId As Long) As Lease
        On Error Resume Next
        Set Find = mLeases(CStr(leaseId))
    End Function

    ' "" when done, else the error code; message says more.
    Public Function Hold(ByVal connId As Long, ByVal leaseId As Long, ByVal pid As Long, ByRef message As String) As String
        Dim l As Lease, h As LongPtr
        Set l = Find(leaseId)
        If l Is Nothing Then
            Hold = "no-lease"
            message = "no lease " & leaseId
            Exit Function
        End If
        If l.ConnId <> connId Then
            Hold = "not-yours"
            message = "lease " & leaseId & " was not taken on this connection, or was released"
            Exit Function
        End If
        h = OpenProcess(SYNCHRONIZE Or PROCESS_QUERY_LIMITED_INFORMATION, 0, pid)
        If h = 0 Then
            Hold = "no-process"
            message = "no process " & pid & " (error " & Err.LastDllError & ")"
            Exit Function
        End If
        If WaitForSingleObject(h, 0) = WAIT_OBJECT_0 Then
            CloseHandle h
            Hold = "no-process"
            message = "process " & pid & " has ended"
            Exit Function
        End If
        l.Holds.Add Array(pid, h)
        Text.Log "lease " & leaseId & ": holds pid " & pid
    End Function

    Public Function Release(ByVal connId As Long, ByVal leaseId As Long, ByRef message As String) As String
        Dim l As Lease
        Set l = Find(leaseId)
        If l Is Nothing Then
            Release = "no-lease"
            message = "no lease " & leaseId
            Exit Function
        End If
        If l.ConnId <> connId Then
            Release = "not-yours"
            message = "lease " & leaseId & " was not taken on this connection, or was released"
            Exit Function
        End If
        l.ConnId = 0
        Text.Log "lease " & leaseId & ": released by its connection"
        Settle
    End Function

    ' A connection has closed: what it took is no longer kept by it, and what it waits for is
    ' no longer wanted.
    Public Sub ConnClosed(ByVal connId As Long)
        Dim l As Lease, i As Long, w As Waiter
        For Each l In mLeases
            If l.ConnId = connId Then l.ConnId = 0
        Next
        For i = mWaiting.Count To 1 Step -1
            Set w = mWaiting(i)
            If w.ConnId = connId Then mWaiting.Remove i
        Next
        Settle
    End Sub

    ' Ends each lease nothing keeps any more: no connection, and no held process still running.
    Private Sub Settle()
        Dim i As Long, j As Long, l As Lease, hold As Variant
        For i = mLeases.Count To 1 Step -1
            Set l = mLeases(i)
            For j = l.Holds.Count To 1 Step -1
                hold = l.Holds(j)
                If WaitForSingleObject(hold(1), 0) = WAIT_OBJECT_0 Then
                    CloseHandle hold(1)
                    l.Holds.Remove j
                    Text.Log "lease " & l.Id & ": pid " & hold(0) & " has ended"
                End If
            Next
            If l.ConnId = 0 And l.Holds.Count = 0 Then
                mLeases.Remove i
                mLeaseOf(l.Slot) = 0
                mWindows(l.Slot) = WindowCount(mDesk(l.Slot))
                If mWindows(l.Slot) = 0 Then
                    mState(l.Slot) = STATE_FREE
                    Text.Log "lease " & l.Id & " ended; " & DesktopName(l.Slot) & " is free"
                Else
                    mState(l.Slot) = STATE_DIRTY
                    Text.Log "lease " & l.Id & " ended; " & DesktopName(l.Slot) & " still has " & mWindows(l.Slot) & " windows"
                End If
            End If
        Next
    End Sub

    ' Run every quarter of a second: ended processes, emptied desktops, and the requests waiting.
    Public Sub Tick()
        Settle
        CheckDirty
        ServeWaiting
    End Sub

    Private Sub ServeWaiting()
        Dim w As Waiter, result As String, code As String, message As String
        ' First come, first served: the first waiter that finds no slot stops the rest.
        Do While mWaiting.Count > 0
            Set w = mWaiting(1)
            result = Take(w.ConnId, w.ClientPid, w.IdText, w.WantPort, w.Tag, False, code, message)
            If code = "full" Then Exit Do
            mWaiting.Remove 1
            If Len(result) > 0 Then
                Server.SendOk w.ConnId, w.IdText, result
            Else
                Server.SendError w.ConnId, w.IdText, code, message
            End If
        Loop
    End Sub

    Public Function StatusMembers() As String
        Dim i As Long, l As Lease, j As Long, s As String, items As String, hold As Variant, state As String
        For i = 1 To mMax
            If mState(i) <> STATE_NONE Then
                Select Case mState(i)
                    Case STATE_FREE
                        state = "free"
                    Case STATE_LEASED
                        state = "leased"
                    Case Else
                        state = "dirty"
                End Select
                If Len(items) > 0 Then items = items & ","
                items = items & "{" & Text.Member("slot", CStr(i)) & "," & Text.Member("desktop", Text.Quote(DesktopName(i))) & "," & _
                    Text.Member("state", Text.Quote(state)) & "," & Text.Member("lease", CStr(mLeaseOf(i))) & "," & _
                    Text.Member("windows", CStr(WindowCount(mDesk(i)))) & "}"
            End If
        Next
        s = Text.Member("slots", "[" & items & "]")
        items = ""
        For Each l In mLeases
            Dim holds As String
            holds = ""
            For j = 1 To l.Holds.Count
                hold = l.Holds(j)
                If Len(holds) > 0 Then holds = holds & ","
                holds = holds & hold(0)
            Next
            If Len(items) > 0 Then items = items & ","
            items = items & "{" & Text.Member("lease", CStr(l.Id)) & "," & Text.Member("slot", CStr(l.Slot)) & "," & _
                Text.Member("desktop", Text.Quote(DesktopName(l.Slot))) & "," & Text.Member("port", CStr(l.Port)) & "," & _
                Text.Member("tag", Text.Quote(l.Tag)) & "," & Text.Member("client", CStr(l.ClientPid)) & "," & _
                Text.Member("connected", Text.Bool(l.ConnId <> 0)) & "," & Text.Member("holds", "[" & holds & "]") & "," & _
                Text.Member("taken", Text.Quote(Format$(l.Taken, "yyyy-mm-dd hh:nn:ss"))) & "}"
        Next
        s = s & "," & Text.Member("leases", "[" & items & "]") & "," & Text.Member("waiting", CStr(mWaiting.Count))
        StatusMembers = s
    End Function
End Module
