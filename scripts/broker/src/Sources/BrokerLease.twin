' One lease: a slot, its desktop, perhaps a port, and who keeps it. It ends once the connection
' that took it has closed or released it, and every process held for it has ended.
Class BrokerLease
    Public Id As Long
    Public Slot As Long
    Public Port As Long
    Public Tag As String
    ' The connection that took it; 0 once that connection has closed or released it.
    Public ConnId As Long
    ' The process at the other end of that connection, for status.
    Public ClientPid As Long
    Public Taken As Date
    ' Each an Array(pid, process handle).
    Public Holds As New Collection
End Class
